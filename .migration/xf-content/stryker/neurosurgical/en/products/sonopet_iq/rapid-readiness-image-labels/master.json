        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">A.&nbsp; <span style=\"color: #ffb500;\">Performance</span></span></span></p>\n<ul>\n<li>Handpiece refinements designed for power and reliability</li>\n<li>Designed for controlled suction pinch valve</li>\n<li>Greater irrigation control and auto prime ability</li>\n</ul>\n<p>&nbsp;</p>\n",
        "jcr:lastModified": "Fri Jul 19 2024 18:51:36 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "showDimensionalBox": "true",
