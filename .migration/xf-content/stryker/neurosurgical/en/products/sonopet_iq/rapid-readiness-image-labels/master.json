        "hideComponent": "false",
        "rightMargin": "0",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">B.&nbsp; <span style=\"color: #ffb500;\">Customization</span></span></span></p>\n<ul>\n<li>RFID technology instantly changes settings based on connected tip or user profile</li>\n<li>One-step retrieval of surgeon profile</li>\n<li>Independent or synchronized settings for power and suction<br>\n</li>\n</ul>\n",
        "jcr:lastModified": "Fri Nov 15 2024 15:49:55 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
