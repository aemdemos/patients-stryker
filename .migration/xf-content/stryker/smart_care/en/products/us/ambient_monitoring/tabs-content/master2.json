      "jcr:created": "Tue Oct 28 2025 16:25:18 GMT+0000",
      "alt": "A nurse talking to a patient through the care.ai intelligence hub",
      "srcFileRef": "/content/dam/stryker/acute-care/products/care-ai/images/virtual-monitoring/care.ai Virtual_Command_Center_680x400_DRAFT-v1.jpg",
      "borderColor": "rgba(76,125,122,1)",
      "jcr:lastModified": "Wed Jan 07 2026 16:23:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/standaloneimage",
      "enableBorder": "false",
      "cq:responsive": {
