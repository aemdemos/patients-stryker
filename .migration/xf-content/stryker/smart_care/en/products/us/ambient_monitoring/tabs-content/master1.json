    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "jcr:created": "Tue Oct 28 2025 16:25:22 GMT+0000",
      "text": "<h4>Align with your protocols and processes</h4>\n<p><span class=\"fontsize-1-25em\">We don’t just deliver tools; we want to be your partner, aligning with your leadership and care teams to co-design solutions that align with your protocols and processes.</span></p>\n<h4>Integrate seamlessly</h4>\n<p><span class=\"fontsize-1-25em\">Our implementation teams work to integrate your care.ai solutions seamlessly with your existing systems.</span></p>\n<h4>Help ensure solution adoption</h4>\n<p><span class=\"fontsize-1-25em\">Our clinical specialists collaborate with your clinical leaders to help ensure solution adoption, support your team training and education efforts and work with you to quantify outcomes.<br>\n </span>&nbsp;</p>\n<p>&nbsp;</p>\n",
      "jcr:lastModified": "Tue Oct 28 2025 16:41:04 GMT+0000",
