    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "text": "<h3><span class=\"fontsize-1-25em\">Break through the language barrier</span></h3>\n<p><span class=\"fontsize-1-25em\">Our hands-free, AI-based interpretation service helps care teams focus on patients, rather than searching for translation tools. Accessible directly from the badge, it connects without delays or additional steps or devices. From simple questions to daily non-clinical needs, it helps keep conversations clear and empowers care teams to deliver thoughtful, routine care.</span></p>\n",
