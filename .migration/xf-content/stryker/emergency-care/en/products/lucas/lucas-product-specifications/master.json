    "text_120283145": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Tue Jan 28 2025 15:58:21 GMT+0000",
      "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Configure multiple device parameters to better meet your protocols**</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The LUCAS 3, v3.1, allows for tailored rates to meet your protocols, alerts configuration, Post-Event Reports to your inbox, and asset notifications by e-mail.</span></p>\n<p><span class=\"fontsize-1-25em\">If setup options are not applied, the device will operate according to its factory default settings, which are identical to LUCAS 3, v3.0 and LUCAS 2, v2.2.</span></p>\n<p><span class=\"fontsize-1-25em\">The training, application steps and user interface remain the same as for LUCAS 3 and LUCAS 2.&nbsp;</span></p>\n",
      "jcr:lastModified": "Mon Mar 10 2025 20:13:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
