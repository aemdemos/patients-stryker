    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:title": "Connecting",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Mon Jan 20 2025 16:38:44 GMT+0000",
      "jcr:lastModified": "Mon Jan 20 2025 16:39:30 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text8817046777960201": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
        "hideComponent": "false",
        "gradientDirection": "left-to-right",
        "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Connecting LUCAS to LIFENET</span></span></h3>\n<p><span class=\"fontsize-1-25em\">With your LUCAS purchase you will get a LUCAS LIFENET Asset account. <a href=\"/content/dam/stryker/ems/resources/training-materials/LUCAS_3-v3.1_Connectivity_Guide_EN.pdf\" target=\"_blank\">Read how to connect and set up your LUCAS in the Connectivity guide</a></span></p>\n",
