    "text_copy88156986000": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Cath",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:lastModified": "Tue Feb 11 2025 23:12:24 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text_copy8815698600010741420276501731": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
        "hideComponent": "false",
        "gradientDirection": "left-to-right",
        "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Cath lab compatible*</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Optional carbon fiber back plate to allow for interventional life-saving procedures and bridge to definitive care.</span></p>\n<h4><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Allows various angles</span></span></h4>\n<p><span class=\"fontsize-1-25em\">Most radiological projection angles can be used during LUCAS CPR.<sup>36</sup></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-25em\"><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/clinical-material/LUCAS-3-v3.1-Cath-Lab-Brochure_US-Canada.pdf\" target=\"_blank\"><span class=\"standalone-link\">LUCAS in the Cath Lab</span></a></span></p>\n<p><i>US version - for Europe/MEA version, see&nbsp;<a href=\"/content/stryker/us/en/emergency-care/products/lucas-3/resources.html\">Resources</a></i></p>\n",
        "jcr:lastModified": "Tue Mar 25 2025 20:56:34 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      },
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "0",
          "width": "6"
        }
      },
      "text_copy_copy": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "chris.kleckner@stryker.com",
        "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
        "jcr:created": "Mon Feb 10 2025 20:16:23 GMT+0000",
        "text": "<p>* Caution – adjunctive therapies: The use of other medical equipment or drugs in conjunction with the LUCAS device can affect the treatment. Always consult the instructions for use for the other equipment and/or drugs to make sure that they are applicable in conjunction with CPR.<br>\n</p>\n",
        "jcr:lastModified": "Thu Mar 13 2025 17:36:38 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      }
    },
