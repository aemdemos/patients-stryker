    "text_1569435023": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Mon Feb 10 2025 21:14:42 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p>**Setup options should be changed only under the direction of a physician knowledgeable in cardiopulmonary resuscitation who is familiar with the literature in this area.&nbsp;</p>\n",
