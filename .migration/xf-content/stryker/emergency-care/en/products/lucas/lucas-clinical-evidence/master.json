    "text_copy_331412359": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:title": "LUCAS allows",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Jan 14 2025 21:41:35 GMT+0000",
      "jcr:lastModified": "Mon Jan 20 2025 15:59:41 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text_copy_3314123598814657855530679": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
        "text": "<h3><span class=\"futura-bold\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">LUCAS allows for defibrillation during ongoing compressions</span></span></span></h3>\n<p><span class=\"fontsize-1-25em\">LUCAS allows for application of the defibrillation electrodes outside the suction cup.<sup>20</sup> The LUCAS device does not need to be stopped when delivering the shock (only stop when doing the rhythm analysis).<sup>11</sup></span></p>\n<p><span class=\"fontsize-1-25em\"><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/clinical-material/LUCAS-Defibrillation-Ventilation_US-Canada.pdf\" target=\"_blank\"><span class=\"standalone-link\">Defibrillation and ventilation with LUCAS</span></a></span></p>\n<p><i>US version - for Europe/MEA version, see <a href=\"/content/stryker/us/en/emergency-care/products/lucas-3/resources.html\" target=\"_blank\">Resources</a></i></p>\n",
        "jcr:lastModified": "Thu Dec 04 2025 20:31:57 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      },
      "item8814657855778393": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "user-f123ca2978@example.invalid",
        "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
        "hideComponent": "false",
        "topMargin": "3",
        "jcr:created": "Thu Jan 16 2025 21:02:23 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<h3><span class=\"fontsize-1-25em\">More CPR time with LUCAS</span></h3>\n<p><span class=\"fontsize-1-25em\">LUCAS has documented chest compression fractions of up to 93%, leading to significantly more flow time compared to manual CPR.<sup>16,31-33,41</sup></span></p>\n",
        "jcr:lastModified": "Thu Mar 13 2025 17:28:53 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      },
