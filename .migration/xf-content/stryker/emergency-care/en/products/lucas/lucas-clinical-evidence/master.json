  "root": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "user-ceb741eed8@example.invalid",
    "jcr:lastModified": "Fri Aug 23 2019 18:13:48 GMT+0000",
    "sling:resourceType": "wcm/foundation/components/responsivegrid",
    "text_copy88134704121": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "hideComponent": "false",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Randomized controlled trials</span></span></p>\n",
      "jcr:lastModified": "Mon Mar 10 2025 20:08:02 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:title": "Randomized",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Jan 14 2025 21:25:10 GMT+0000",
      "jcr:lastModified": "Mon Jan 20 2025 15:39:54 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text_copy8813470412151498": {
        "jcr:primaryType": "nt:unstructured",
        "bottomPadding": "2",
        "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
        "hideComponent": "false",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"fontsize-1-25em\">The highest level of evidence<sup>21</sup>, randomized, controlled LINC (LUCAS in Cardiac Arrest)<sup>11</sup> trial on 2,589 pre-hospital cardiac arrest patients shows:</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">LUCAS is as safe and effective as high-quality manual CPR</span></li>\n<li><span class=\"fontsize-1-25em\">Good neurological outcomes (CPC Scale Score of 1-2)</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">Another randomized, controlled trial on 259 cardiac arrest patients has shown:</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">LUCAS did not cause more injuries than manual CPR<sup>22</sup></span></li>\n</ul>\n",
        "jcr:lastModified": "Fri Mar 21 2025 21:15:48 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      },
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "0",
          "width": "8"
        },
        "phone": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "0",
          "width": "12"
        }
      },
      "text_copy88134704121": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
        "hideComponent": "false",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"fontsize-1-25em\"><a href=\"https://www.lucas-cpr.com/files/7716962_LINC%20Clinical%20Summary_3317390_D.pdf\" target=\"_blank\"><span class=\"standalone-link\">Read more in LINC summary</span></a></span></p>\n<p><span class=\"fontsize-1-25em\"><a href=\"https://www.lucas-cpr.com/files/1447134_Koster%20Summary_US_3344773_A_LR.pdf\" target=\"_blank\"><span class=\"standalone-link\">Koster Clinical Summary</span></a></span></p>\n<p>US versions - for Europe/MEA version, see <a href=\"/content/stryker/us/en/emergency-care/products/lucas-3/resources.html\" target=\"_blank\">Resources</a></p>\n",
        "jcr:lastModified": "Tue Mar 25 2025 20:55:00 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      }
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:title": "Randomized Sidebar",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Mon Jan 20 2025 15:41:23 GMT+0000",
      "jcr:lastModified": "Mon Jan 20 2025 15:42:03 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text8813599639930703": {
        "jcr:primaryType": "nt:unstructured",
        "bottomPadding": "5",
        "leftPadding": "5",
        "topPadding": "5",
        "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
        "hideComponent": "false",
        "gradientDirection": "left-to-right",
        "text": "<p style=\"text-align: left;\"><span class=\"futura-bold\"><span class=\"fontsize-2em\">&gt;99%</span></span><br>\n<span class=\"fontsize-1-25em\">of the survivors treated with LUCAS had good neurological outcomes (CPC Scale Score of 1-2) at <span style=\"white-space: nowrap;\">6 months follow up</span><sup>11</sup></span></p>\n",
        "jcr:lastModified": "Fri Mar 21 2025 21:16:20 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "5",
        "backgroundColor": "rgb(255,181,0)",
        "textIsRich": "true"
      },
      "cq:responsive": {
