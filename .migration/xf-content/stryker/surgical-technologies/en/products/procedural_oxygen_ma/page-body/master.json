    "text_888598716_copy_45027862": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Thu Feb 19 2026 16:48:38 GMT+0000",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Sizes</span></span></p>\n<p>POM is now available in three sizes: large&nbsp;(adult), medium, and small (pediatric). For more information on the models available, see the resources section below for the full part number guide.&nbsp;</p>\n",
      "jcr:lastModified": "Thu Feb 19 2026 17:11:12 GMT+0000",
