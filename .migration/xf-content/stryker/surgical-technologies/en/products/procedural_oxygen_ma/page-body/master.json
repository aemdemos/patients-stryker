        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "gradientDirection": "left-to-right",
        "line1": "<h2 style=\"text-align: left;\"><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\">Innovative oxygen delivery for procedures requiring sedation*</span></span><br>\r\n</h2>\r\n",
