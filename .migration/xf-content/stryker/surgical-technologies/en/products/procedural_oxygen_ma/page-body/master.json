      "largeheadline_copy_c_14605536302027286555872845": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "gradientDirection": "left-to-right",
        "line1": "<h2 style=\"text-align: left;\"><span class=\"futura-bold\"><span class=\"fontsize-3vw\">POM Procedural Oxygen Mask<sup><span class=\"fontsize-1-5-vw\">®</span></sup></span></span><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\"><br>\r\n </span></span><span class=\"futura-bold\"><span class=\"fontsize-2vw\">Safety. Simplicity. Innovation. All in the same breath.</span></span></h2>\r\n",
