    "text_170058219": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "7",
      "jcr:createdBy": "hannah.white@stryker.com",
      "leftPadding": "7",
      "topPadding": "7",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Thu Feb 19 2026 16:43:24 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">A)&nbsp;&nbsp;<span style=\"color: #ffb500;\">Nose clip</span><br>\n</span> </b></span><span class=\"urw-egyptienne\">Secures the mask to the patient’s face.</span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">B)&nbsp;&nbsp;<span style=\"color: #ffb500;\">Oral &amp; nasal membrane access ports</span><br>\n </span></span><span class=\"urw-egyptienne\">Allows an instrument (scope, tube or probe) to enter either a patient’s oral or nasal passage.</span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">C)&nbsp;&nbsp;<span style=\"color: #ffb500;\">Oxygen adaptor port</span><br>\n </span></span><span class=\"urw-egyptienne\">Allows for the insertion of a medium or high O2 concentration adaptor to facilitate oxygen delivery.</span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">D)&nbsp;&nbsp;<span style=\"color: #ffb500;\">Exhalation valve</span><br>\n </span></span><span class=\"urw-egyptienne\">A one-way flap that allows the patient’s exhalation to vent or exit the mask. The valve closes during inhalation.</span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">E)&nbsp;&nbsp;<span style=\"color: #ffb500;\">EtCO2 sampling port with tethered cap</span><br>\n </span></span><span class=\"urw-egyptienne\">Allows for the secure attachment of the EtCO2 sampling line to facilitate EtCO2 monitoring.</span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">F)&nbsp;&nbsp;<span style=\"color: #ffb500;\">Head strap</span><br>\n </span></span><span class=\"urw-egyptienne\">Adjusts to accommodate appropriate size.</span></p>\n",
      "jcr:lastModified": "Wed Apr 01 2026 17:22:44 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "7",
      "showDimensionalBox": "true",
