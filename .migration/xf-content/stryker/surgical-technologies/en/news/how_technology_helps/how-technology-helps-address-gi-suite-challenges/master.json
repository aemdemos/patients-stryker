    "text_1737277237": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:title": "Building Block",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Tue Jun 09 2026 19:13:30 GMT+0000",
      "jcr:lastModified": "Tue Jun 09 2026 19:13:41 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text_173727723751746988666230": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "text": "<p>&quot;If a polyp is collected in the canister on the wall, then it’s not a great opportunity for the nurse or the tech in the room to have to sift through the waste,” she said. “If we lose a polyp, it’s imperative that the physician tells the patient at the end of the colonoscopy…and that’s a hard conversation.”</p>\n<p>Another product to help support patient safety in the GI suite is the POM Procedural Oxygen Mask. POM is intended to deliver supplemental oxygen and allow for the monitoring of expired gases in non-intubated, spontaneously breathing patients. The mask has helped decrease severe and prolonged hypoxic episodes and in-case interruptions, delay and cancellations.*³,⁴</p>\n",
        "jcr:lastModified": "Tue Jun 09 2026 19:57:53 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
          "jcr:primaryType": "nt:unstructured",
