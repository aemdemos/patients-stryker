      "text_877776992_copy": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "hannah.white@stryker.com",
        "topPadding": "3",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "hideComponent": "false",
        "jcr:created": "Tue Jun 09 2026 19:07:15 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Help transform staff safety and efficiency at your facility.</span></span></p>\n",
        "jcr:lastModified": "Tue Jun 09 2026 20:02:57 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
          "jcr:primaryType": "nt:unstructured",
          "default": {
