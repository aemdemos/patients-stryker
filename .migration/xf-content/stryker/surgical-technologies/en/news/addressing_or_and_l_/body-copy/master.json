    "text_1407680889": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-73104d59b2@example.invalid",
      "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
      "jcr:created": "Wed Jun 10 2026 16:52:56 GMT+0000",
      "text": "<ol>\n<li><span class=\"fontsize-8em\">Gawande, A. A., Studdert, D. M., Orav, E. J., Brennan, T. A., &amp; Zinner, M. J. (2003). Risk factors for retained instruments and sponges after surgery. The New England Journal of Medicine, 348(3), 229–235. https://doi.org/10.1056/NEJMsa021721</span></li>\n<li><span class=\"fontsize-8em\">Corbetta-Rastelli CM, Friedman AM, Sobhani NC, Arditi B, Goffman D, Wen T. Postpartum Hemorrhage Trends and Outcomes in the United States, 2000-2019. Obstet Gynecol. 2023 Jan 1;141(1):152-161. doi: 10.1097/AOG.0000000000004972. Epub 2022 Nov 30. PMID: 36701615.</span></li>\n<li><span class=\"fontsize-8em\">This is a paid interview with a Stryker consultant, conducted 9/26/2024, on behalf of Stryker.</span></li>\n<li><span class=\"fontsize-8em\">Patra KP, De Jesus O. Sentinel Event. [Updated 2023 Mar 29]. In: StatPearls [Internet]. Treasure Island (FL): StatPearls Publishing; 2024 Jan-. Available from: https://www.ncbi.nlm.nih.gov/books/NBK564388/</span></li>\n<li><span class=\"fontsize-8em\">Callaghan, W. M., Creanga, A. A., &amp; Kuklina, E. V. (2012). Severe maternal morbidity among delivery and postpartum hospitalizations in the United States. Obstetrics and Gynecology, 120(5), 1029–1036. https://doi.org/10.1097/aog.0b013e31826d60c5</span></li>\n</ol>\n<p><span class=\"fontsize-8em\">ST-GSNPS-ARTI-1461902_REV-0</span></p>\n",
