    "text_137063497": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-73104d59b2@example.invalid",
      "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
      "jcr:created": "Wed Jun 10 2026 16:42:42 GMT+0000",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Take the first step to help reduce harm.</span></span></p>\n",
      "jcr:lastModified": "Wed Jun 10 2026 16:42:57 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
