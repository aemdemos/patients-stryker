    "text_676674775": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-73104d59b2@example.invalid",
      "topPadding": "2",
      "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Thu Jun 11 2026 15:50:04 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">‍Take the first step toward a smoke-free OR today</span></span></p>\n",
      "jcr:lastModified": "Thu Jun 11 2026 16:06:45 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
