    "text_1899236356_copy_1893527263": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Fri May 29 2026 20:27:31 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p>Surgery is not appropriate for everyone and outcomes vary. Decision-making is individualized and physician-led.</p>\n",
      "jcr:lastModified": "Tue Jun 09 2026 19:24:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
