    "text_1963947648_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Fri May 29 2026 19:27:03 GMT+0000",
      "text": "<h2 style=\"text-align: left;\"><span class=\"futura-bold\">Misconception</span>:&nbsp;Arthritis is exclusively a condition of old age.</h2>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Reality</span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">:&nbsp;About two-thirds of those living with arthritis are aged 65 and under.<sup>1</sup></span></span></p>\n",
      "jcr:lastModified": "Tue Jun 02 2026 19:01:10 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "1",
          "width": "5"
        },
        "tablet": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "0",
          "width": "6"
        },
        "phone": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "0",
          "width": "12"
        }
      }
    },
    "text_1695513619": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Tue Jun 02 2026 18:59:48 GMT+0000",
      "text": "<p>And as many as <b>88% of people report that arthritis affects their quality of life.</b></p>\n<p>For those living with hip or knee arthritis, the daily reality can be relentless, and when conservative treatments — physical therapy, medications, injections — no longer provide adequate relief, joint replacement surgery becomes a meaningful option worth exploring.</p>\n",
      "jcr:lastModified": "Tue Jun 09 2026 19:15:57 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
