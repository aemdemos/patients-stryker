        }
      }
    },
    "text_654264884": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Fri May 29 2026 20:22:41 GMT+0000",
      "text": "<p>Over 50% of people with knee osteoarthritis will undergo a total knee replacement during their lifetime, and 99% of all hip and knee replacements are performed specifically to address pain and functional limitations. Many patients who pursue joint replacement wish they had done it sooner. But it is not right for everyone.</p>\n",
      "jcr:lastModified": "Fri May 29 2026 20:22:57 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
