    "text_176367440": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Fri May 29 2026 20:30:45 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p>If conservative treatments are no longer working, joint replacement surgery has come a long way. And with Mako, patients have access to more precision and personalization that is not available with manual surgery.</p>\n<p>Getting back to some of the activities you love starts with understanding your options. Talk to your doctor to find out whether Mako robotic-arm assisted surgery might be right for you.</p>\n",
      "jcr:lastModified": "Tue Jun 02 2026 19:20:34 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "8",
