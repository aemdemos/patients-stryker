    "text_1963947648_copy_98258441": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Fri May 29 2026 19:27:03 GMT+0000",
      "text": "<h2><span class=\"futura-bold\">Misconception</span>:&nbsp;Knee and hip joint replacement surgery is a last resort for the most extreme cases.</h2>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Reality</span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">:&nbsp;Knee and hip joint replacement has advanced significantly, especially in recent years, and for the right candidates can be the most effective path.</span></span></p>\n",
      "jcr:lastModified": "Fri May 29 2026 20:22:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "1",
          "width": "5"
        },
        "tablet": {
          "jcr:primaryType": "nt:unstructured",
