    "text_1963947648_copy_1758931034": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Fri May 29 2026 19:27:03 GMT+0000",
      "text": "<h2><span class=\"futura-bold\">Misconception</span>:&nbsp;Arthritis is just a little joint stiffness. No big deal.</h2>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Reality</span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">:&nbsp;For millions of people, arthritis isn't a minor inconvenience.</span></span></p>\n",
      "jcr:lastModified": "Fri May 29 2026 20:21:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "1",
          "width": "5"
        },
        "tablet": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "0",
          "width": "6"
        },
        "phone": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "0",
          "width": "12"
        }
      }
    },
    "text_525029154": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Fri May 29 2026 20:21:27 GMT+0000",
      "text": "<p>It's the reason they can't open a jar, button a shirt, walk to the mailbox or sleep through the night. It's chronic, progressive and sometimes completely debilitating. You can look completely fine and be in significant pain. The gap between what arthritis looks like from the outside and what it feels like from the inside is wide, and that gap is exactly why so many people suffer longer than they should before seeking treatment.</p>\n",
      "jcr:lastModified": "Fri May 29 2026 20:21:43 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
