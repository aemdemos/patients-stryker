      "largeheadline12776076078409763": {
        "jcr:primaryType": "nt:unstructured",
        "topPadding": "5",
        "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
        "topMargin": "5",
        "gradientDirection": "left-to-right",
        "line1": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">More about World Patient Safety Day<sup>1</sup></span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">·</span>&nbsp;</span>Established by the World Health Organization in 2019</p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">·</span>&nbsp;</span>The goal of the day is to&nbsp;enhance global understanding of patient safety,&nbsp;<span style=\"background-color: transparent;\">increase public engagement in the safety of health care and&nbsp;</span>promote global actions to enhance patient safety&nbsp;<span style=\"background-color: transparent;\">and reduce patient harm.</span></p>\r\n",
        "jcr:lastModified": "Wed Sep 15 2021 15:14:23 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
        "backgroundColor": "rgba(237,238,236,1)",
