        "line1": "<span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\">Anywhere from</span> <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">30</span></span> <span style=\"color: rgb(255,255,255);\">to</span> <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">51</span></span> <span style=\"color: rgb(255,255,255);\">percent of in-hospital falls result in injuries<sup>3</sup></span><br>\r\n </span>",
        "jcr:lastModified": "Thu Nov 12 2020 19:44:39 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
        "backgroundColor": "rgba(84,88,87,1)",
