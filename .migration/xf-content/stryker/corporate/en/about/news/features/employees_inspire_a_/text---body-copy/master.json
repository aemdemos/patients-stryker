        "jcr:created": "Mon Jan 18 2021 21:35:45 GMT+0000",
        "text": "<p style=\"text-align: right;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">What has the experience meant to you?</span></span></p>\n",
