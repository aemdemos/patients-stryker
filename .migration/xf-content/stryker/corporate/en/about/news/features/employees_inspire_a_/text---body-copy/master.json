      "text2931680875030613": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">We started in 2016 and lost right away. There wasn’t a 2017 season, but 2018 was our breakout year. We won a lot of fights and made it to the single elimination tournament round. In 2019 we went back with some major upgrades and had some really good fights. For 2020, the season airing now, we made even more upgrades—and it’s going to be a great season. &nbsp;</span></span></p>\n",
        "jcr:lastModified": "Mon Jan 18 2021 21:37:02 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
