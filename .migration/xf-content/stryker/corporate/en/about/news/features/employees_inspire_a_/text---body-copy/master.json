        "jcr:created": "Mon Jan 18 2021 21:35:45 GMT+0000",
        "text": "<p style=\"text-align: right;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">How does this all intersect with your work on Mako SmartRobotics</span><sup>TM</sup><span class=\"fontsize-1-5em\">?</span></span></p>\n",
        "jcr:lastModified": "Tue Jan 26 2021 20:07:03 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
