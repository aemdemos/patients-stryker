        "jcr:created": "Mon Jan 18 2021 21:35:45 GMT+0000",
        "text": "<p style=\"text-align: right;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">What has the BattleBots competition been like over the years?</span></span></p>\n",
        "jcr:lastModified": "Tue Jan 19 2021 15:49:05 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
