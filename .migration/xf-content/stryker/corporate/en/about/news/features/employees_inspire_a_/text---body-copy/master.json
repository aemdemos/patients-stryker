      "text2931680875030613_1686828769": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">It’s been fantastic. We aren’t just working on a hobby. We’re bringing awareness of Stryker to the world, and also inspiring the new generation of engineers.</span></span></p>\n",
