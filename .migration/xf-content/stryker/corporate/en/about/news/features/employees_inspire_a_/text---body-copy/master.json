        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">In 2016, we started calling ourselves “Team Revolution” because our robot is named Rotator.</span></span><br>\n</p>\n",
