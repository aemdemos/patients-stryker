      "text2931680875030613_1869912719": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">I hand-picked people based on their backgrounds – like electrical or mechanical engineering – and we get together on certain days to strategize how we’re going to attack the build plan. We treat it like a mini project where we have a pre-determined number of months to finish.</span></span></p>\n",
