      },
      "text2931680875030613_1090097265": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">We have a lot of talented engineers in our Florida office because we work on robotics on a day-to-day basis. Most of the BattleBot components are off the shelf—simple parts. But sometimes we don’t like the way they perform so one of the engineers will modify something to make it behave differently. We use a lot of the same engineering principles we use with Mako to strengthen Rotator. &nbsp;</span></span></p>\n",
        "jcr:lastModified": "Mon Jan 18 2021 21:42:40 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
          "jcr:primaryType": "nt:unstructured",
