        "jcr:created": "Mon Jan 18 2021 21:35:45 GMT+0000",
        "text": "<p style=\"text-align: right;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">What does the engineering process look like?</span></span></p>\n",
        "jcr:lastModified": "Mon Jan 18 2021 21:41:29 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
