      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "jcr:created": "Mon Mar 16 2020 18:43:15 GMT+0000",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><br>\nBringing expertise and resources home</span><span class=\"fontsize-2-5em\"><br>\n </span></span><span style=\"color: rgb(255, 181, 0);\">_______________________________________________________________________________________________________________</span></p>\n",
      "jcr:lastModified": "Fri Jun 05 2020 15:36:35 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
