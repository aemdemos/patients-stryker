      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\">Restoring spines and hope</span><br>\n <span style=\"color: #ffb500;\">______________________________________________________________________________________________________________<br>\n <br>\n &nbsp;</span></span></p>\n",
      "jcr:lastModified": "Thu Jul 02 2020 18:15:09 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
