    "largeheadline1277607": {
      "jcr:primaryType": "nt:unstructured",
      "topPadding": "5",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">Did you know?<br>\r\n</span></span><span class=\"fontsize-1-5-vw\"><br>\r\nWhen actors on television yell phrases like 'Code Blue!', 'Get the crash cart!', 'We need to shock him!' or 'Clear!', they're referring to treating a victim of sudden cardiac arrest.</span>",
      "jcr:lastModified": "Mon Oct 11 2021 14:20:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(237,238,236,1)",
      "textIsRich": [
        "true",
        "true"
      ],
      "cq:responsive": {
