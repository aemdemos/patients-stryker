      "gradientDirection": "left-to-right",
      "line1": "<span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">How quick thinking and proper use of an AED can save lives</span></span>",
      "jcr:lastModified": "Thu Oct 07 2021 18:19:37 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,0)",
      "textIsRich": [
        "true",
        "true"
      ],
      "cq:responsive": {
