      "jcr:created": "Tue Aug 11 2020 15:40:23 GMT+0000",
      "title": "Our partnership with Project C.U.R.E.",
      "jcr:lastModified": "Tue Aug 11 2020 15:43:53 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
