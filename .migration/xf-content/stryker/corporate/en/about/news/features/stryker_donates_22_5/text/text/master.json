    "text_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Tue Aug 11 2020 15:40:39 GMT+0000",
      "text": "<p>The new ERB Kit is the latest addition to an array of kits available via Project C.U.R.E. to medical professionals engaging in humanitarian missions, which includes a Neuro Kit, an Orthopaedic Drill Kit, a Spine Kit, an ENT Kit, and more.<br>\n</p>\n<p>Learn more about Project C.U.R.E. <a href=\"https://projectcure.org/\">here</a>.<br>\n</p>\n",
      "jcr:lastModified": "Tue Aug 11 2020 19:52:39 GMT+0000",
