      "jcr:created": "Thu Jul 15 2021 17:14:25 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">Common signs and symptoms of Goldenhar syndrome<sup>3</sup></span></span></span></p>\n<ul>\n<li>Cleft lip and/or palate</li>\n<li>Difficulty eating</li>\n<li>Difficulty breathing</li>\n<li>Ear abnormalities, like a partially formed or completely absent ear</li>\n<li>Growths on the eyes, also called eipbulbar tumors</li>\n<li>Hearing loss</li>\n<li>Speech impediment</li>\n<li>Underdeveloped jaw, cheekbone and/or temple bone</li>\n</ul>\n",
      "jcr:lastModified": "Thu Jul 15 2021 20:08:52 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "3",
      "showDimensionalBox": "true",
