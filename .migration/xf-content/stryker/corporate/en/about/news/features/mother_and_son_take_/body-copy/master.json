      "jcr:created": "Thu Jul 15 2021 17:23:47 GMT+0000",
      "title": "A treatment for one of the world’s most rare diseases",
      "jcr:lastModified": "Thu Jul 15 2021 17:40:15 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title",
      "cq:responsive": {
