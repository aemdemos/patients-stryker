    },
    "standaloneimage": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "preset": "max_width_1440",
      "jcr:created": "Mon Feb 15 2021 16:28:11 GMT+0000",
      "srcFileRef": "/content/dam/stryker/about/news/features/80-years-together/images/IMG_2672_Dr Stryker crutches_clipped.png",
      "jcr:lastModified": "Mon Feb 15 2021 16:28:22 GMT+0000",
      "sling:resourceType": "stryker/components/content/standaloneimage",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
