        "hideComponent": "false",
        "jcr:created": "Mon Aug 23 2021 20:35:55 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"fontsize-2em\"><span style=\"color: #ffffff;\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">“I didn’t know if I would be good enough to be an Olympic athlete,</span></span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\"><span style=\"color: #ffffff;\"> but it gave me something to look forward after treatment,” she recalls.</span></span></span></p>\n",
        "jcr:lastModified": "Tue Aug 24 2021 16:12:51 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "4",
        "backgroundColor": "rgba(84,88,87,1)",
