    "text_1835260685_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:title": "1",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "jcr:created": "Mon Aug 23 2021 20:30:40 GMT+0000",
      "jcr:lastModified": "Mon Aug 23 2021 20:49:59 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text_1835260685_copy10809385578941566": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "garrett.shue@stryker.com",
        "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\"><br>\nJillian Williams enjoys a busy life—working a job, chasing around two goldendoodles at home and planning her trip to Tokyo for the Paralympic games. But the U.S. sitting volleyball team isn’t the only team Jillian is on. She also works with diverse healthcare teams, impacting patients every day as a Mako Product Specialist at Stryker.</span></span></p>\n",
        "jcr:lastModified": "Tue Aug 24 2021 16:14:07 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
          "jcr:primaryType": "nt:unstructured",
          "default": {
