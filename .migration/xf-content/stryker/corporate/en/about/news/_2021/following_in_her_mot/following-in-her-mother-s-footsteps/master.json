    "text_997616368": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "hideComponent": "false",
      "topMargin": "2",
      "jcr:created": "Tue Nov 23 2021 19:39:05 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\">Half</span>&nbsp;of these caregivers are providing help to someone with Alzheimer’s or another dementia.<sup>1</sup></p>\n",
      "jcr:lastModified": "Tue Nov 23 2021 19:41:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
