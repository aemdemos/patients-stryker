    "text_1670421672": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "hideComponent": "false",
      "topMargin": "2",
      "jcr:created": "Tue Nov 23 2021 19:38:44 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\">83%</span>&nbsp;of the help provided to older adults in the United States comes from family members, friends or unpaid caregivers.<sup>1</sup></p>\n",
      "jcr:lastModified": "Tue Nov 23 2021 19:41:37 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
