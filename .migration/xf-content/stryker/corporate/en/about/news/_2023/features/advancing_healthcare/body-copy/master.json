    "text_700924328": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Mon Jan 09 2023 15:34:22 GMT+0000",
      "text": "<p>The flexible setup provides an ideal environment for learning opportunities, such as product demonstrations, educational courses, and customer feedback sessions for next-generation products. Serving our purpose of making healthcare better, the NTME has been extremely well received by healthcare professionals and will continue touring Europe in 2023.</p>\n",
      "jcr:lastModified": "Mon Jan 09 2023 16:05:25 GMT+0000",
