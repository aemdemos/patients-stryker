    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:title": "Each",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Mon Dec 04 2023 19:50:02 GMT+0000",
      "jcr:lastModified": "Mon Dec 04 2023 19:56:08 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text6647125034676309": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Each day, </span></span><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Naomi Murray</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"> wakes up wondering, “What will we learn today? How will we translate that into making healthcare better?” As the Senior Director of Disruptive Research Solutions at Stryker, Naomi is continually working with her team to leverage technologies that can improve patient outcomes. One of those solutions is additive manufacturing (AM).</span></span></p>\n",
        "jcr:lastModified": "Wed Dec 13 2023 14:09:11 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
          "jcr:primaryType": "nt:unstructured",
          "default": {
            "jcr:primaryType": "nt:unstructured",
            "offset": "0",
            "width": "10"
          },
          "phone": {
            "jcr:primaryType": "nt:unstructured",
            "offset": "0",
            "width": "12"
          }
        }
      },
      "text_772930884": {
        "jcr:primaryType": "nt:unstructured",
        "bottomPadding": "2",
        "jcr:createdBy": "hannah.white@stryker.com",
        "leftPadding": "3",
        "topPadding": "3",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "hideComponent": "false",
        "rightMargin": "0",
        "topMargin": "0",
        "jcr:created": "Mon Dec 04 2023 19:52:43 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><b><span style=\"color: #1c5687;\"><span class=\"futura-bold\">AM, also known as 3D printing</span>,</span> </b>uses computer-aided design software to create objects one layer at a time. In contrast to subtractive manufacturing, in which a manufacturer creates a product by cutting away at a block of material, AM produces less waste, allows for greater product customization and provides novel design features.<sup>1</sup></span></span></p>\n",
        "jcr:lastModified": "Tue Dec 05 2023 21:39:41 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "3",
        "showDimensionalBox": "true",
        "textIsRich": "true",
        "leftMargin": "0",
        "bottomMargin": "0",
        "cq:responsive": {
          "jcr:primaryType": "nt:unstructured",
          "default": {
            "jcr:primaryType": "nt:unstructured",
            "offset": "0",
            "width": "10"
          },
          "phone": {
            "jcr:primaryType": "nt:unstructured",
            "offset": "0",
            "width": "12"
