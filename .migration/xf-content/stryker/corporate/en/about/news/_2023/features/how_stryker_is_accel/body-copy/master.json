      "jcr:created": "Mon Dec 04 2023 19:44:33 GMT+0000",
      "gradientDirection": "left-to-right",
      "line2": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\"> </span></span></p>\r\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">Stryker's Senior Director of Disruptive Research Solutions gets detailed about 3D printing</span></span></p>\r\n",
      "jcr:lastModified": "Fri Dec 08 2023 15:05:07 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
