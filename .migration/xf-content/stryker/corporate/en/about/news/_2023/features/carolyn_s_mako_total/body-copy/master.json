      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "largeheadline_copy535073122524281840": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "gradientDirection": "left-to-right",
        "line2": "<p><span class=\"fontsize-1-5-vw\">Osteoarthritis is the most common form of arthritis, impacting more than 500 million people worldwide.<sup>1</sup> After a successful 20-year career as an operating room nurse, Carolyn was diagnosed with osteoarthritis in her hip.</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">&nbsp;</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">Now, after working with her doctor to get a Mako Total Hip surgery, Carolyn’s back to the things she loves, like enjoying time with her grandchild. Watch her story.</span></p>\r\n",
        "jcr:lastModified": "Thu Nov 16 2023 16:21:46 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
