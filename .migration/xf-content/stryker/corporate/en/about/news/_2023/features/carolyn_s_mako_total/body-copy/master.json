      "item1089953560363234": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "gradientDirection": "left-to-right",
        "line1": "<span class=\"urw-egyptienne\"></span> ",
        "line2": "<p><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">“</span></span><span style=\"font-size: 21.0px; background-color: transparent; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"urw-egyptienne\"><span class=\"futura-bold\">The Mako Total Hip replacement was a great choice for me. I feel better than I have in a long time, I can get back to the activities that I love to do. I never should have put it off for so long.</span></span></span></span><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">”&nbsp;</span></span><br>\r\n</p>\r\n<p>______________<br>\r\n<br>\r\n<span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Carolyn</span><br>\r\n</span></span></span><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\">Mako Total Hip replacement patient</span></span></span></span></p>\r\n",
