    "text3142042791616759": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Employees",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
      "jcr:lastModified": "Mon Nov 29 2021 18:52:32 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "user-1f15d09fdf@example.invalid",
        "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
        "jcr:created": "Fri Nov 21 2025 00:04:29 GMT+0000",
        "text": "<h2><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Employee match program multiplies donations</span></span></h2>\n",
        "jcr:lastModified": "Fri Nov 21 2025 00:05:23 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      },
      "text31420427916167593590962660395290": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
        "text": "<p><span class=\"fontsize-1-25em\">Stryker amplifies the generosity of our employees with a year-round 1:1 company match, and elevated match rates for specific annual campaigns. Through Impact, employees can multiply their donations to support nonprofits they are passionate about.</span></p>\n<p><span class=\"fontsize-1-25em\">Employees can put their match dollars toward any nonprofit on Impact so we can make an even bigger impact together. It also allows us to raise awareness and additional funds for signature partners whose work aligns closely with our mission and social impact strategy. Our signature partners - Operation Smile, Project C.U.R.E., the American Red Cross and Dr. Lorna Breen Heroes Foundation - work to advance healthcare and support disaster relief and recovery efforts in communities worldwide.</span></p>\n<p><span class=\"fontsize-1-25em\">“The nonprofit that I like to support is <a href=\"/content/stryker/us/en/about/news/2023/features/transforming-confidence-and-care-in-partnership-with-operation-smile.html\">Operation Smile</a>, an organization that provides critically-needed surgical care in countries that don’t have access to care,” says Jessica Lee, Senior Manager, Cybersecurity. “To know that my donation will be matched by Stryker makes me proud.”<br>\n </span><br>\n</p>\n",
        "jcr:lastModified": "Mon Nov 24 2025 19:22:14 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
