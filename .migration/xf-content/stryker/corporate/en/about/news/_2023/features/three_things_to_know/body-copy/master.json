      "text_1001708579": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "user-73104d59b2@example.invalid",
        "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
        "jcr:created": "Wed Nov 24 2021 14:16:53 GMT+0000",
        "text": "<p><span class=\"fontsize-1-25em\">Impact, our global employee giving and volunteering platform, enables our employees to give back in their communities through the click of a button. As employees fill out their profiles, they can see customized volunteer options such as virtual, skills-based and in-person opportunities. In addition, when a disaster strikes anywhere across the globe, we can quickly assemble our employees to support relief efforts and get funds to the places that need it most through our enterprise disaster relief partner, <a href=\"/content/stryker/us/en/about/news/2023/features/how-stryker-supports-the-red-cross-lifesaving-mission.html\">Red Cross</a>.</span></p>\n<p><span class=\"fontsize-1-25em\">Employees also use Impact to organize group giving and volunteer events, allowing teams to strengthen their working relationships by uniting around a shared purpose of making a difference.</span></p>\n",
        "jcr:lastModified": "Fri Nov 21 2025 21:04:54 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
