    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "4",
      "jcr:createdBy": "user-73104d59b2@example.invalid",
      "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Thu Nov 18 2021 21:19:37 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\">Our passionate employees are behind everything we do, including our corporate responsibility objective to create a better, healthier world. They are driven to give of their time and talents, working to improve healthcare and support communities around the world. Through Stryker’s employee giving program, employees also have a direct path to donate to nonprofits they care about and participate in a variety of volunteer opportunities that improve the lives of others.</span></p>\n<p><span class=\"fontsize-1-25em\">Stryker’s social impact strategy is guided by our areas of focus, enabling us to make a meaningful difference by advancing healthcare, supporting education and improving environmental health. As employees donate and volunteer on behalf of Stryker, they help amplify our efforts. Here’s how we support employees who are driven to positively impact people and our planet.</span><br>\n<br>\n</p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Three ways Stryker employees give back</span></span><br>\n</p>\n",
      "jcr:lastModified": "Fri Nov 21 2025 00:26:07 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
