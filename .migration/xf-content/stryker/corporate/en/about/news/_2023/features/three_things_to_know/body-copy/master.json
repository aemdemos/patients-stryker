        "jcr:created": "Thu Nov 20 2025 23:48:17 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<h2><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Employees ‘Impact’ communities via a giving and volunteering program</span></span></h2>\n",
        "jcr:lastModified": "Fri Nov 21 2025 00:05:03 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
