    "text_454210911": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-73104d59b2@example.invalid",
      "jcr:title": "Eligible",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
      "jcr:created": "Wed Nov 24 2021 14:17:05 GMT+0000",
      "jcr:lastModified": "Mon Nov 29 2021 18:27:34 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "user-1f15d09fdf@example.invalid",
        "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
        "jcr:created": "Fri Nov 21 2025 00:05:52 GMT+0000",
        "text": "<h2><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Volunteer leave of absence (LOA)</span></span></h2>\n",
        "jcr:lastModified": "Fri Nov 21 2025 00:06:14 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      },
      "text_454210911358946": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
        "text": "<p><span class=\"fontsize-1-25em\">Volunteering for nonprofits is an important way employees get to know and engage with one another outside of their daily work. With the volunteer leave of absence (LOA) benefit, eligible employees* can request a volunteer leave of absense (LOA) one day per year to volunteer on their own or with their teammates. LOA time is paid time off for volunteering with a qualifying organization.</span></p>\n<p><span class=\"fontsize-1-25em\">“Our employees feel a great sense of responsibility to give back in their communities,” says Anita Mehta, Director of Social Impact at Stryker. “We are excited to offer the volunteer leave of absence benefit to employees so they can continue to support charitable organizations that align with their personal passions.”</span><br>\n</p>\n",
        "jcr:lastModified": "Fri Nov 21 2025 00:05:43 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
        "cq:responsive": {
