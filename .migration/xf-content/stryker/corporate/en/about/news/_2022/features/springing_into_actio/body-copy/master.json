      "item1089953560363234": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "hannah.white@stryker.com",
        "gradientDirection": "left-to-right",
        "line1": "<span class=\"urw-egyptienne\"></span> ",
        "line2": "<p><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">“</span></span><span style=\"font-size: 21.0px; background-color: transparent; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\">I told Sue in person how very grateful I was that she’d made a big difference to me: the difference between life and death, and I’m very grateful for what she did that night.</span></span></span><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">”</span></span><br>\r\n</p>\r\n<p>______________<br>\r\n<br>\r\n<span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Andy</span><br>\r\n</span></span></span><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\">Sudden cardiac arrest survivor</span></span></span></span></p>\r\n",
        "jcr:lastModified": "Tue Jul 26 2022 19:06:21 GMT+0000",
