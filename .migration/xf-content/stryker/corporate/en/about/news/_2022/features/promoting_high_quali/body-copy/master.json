    },
    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Wed Apr 27 2022 18:28:58 GMT+0000",
      "text": "<p>Latin America and the Caribbean is made up of 33 countries, each of which has their own unique healthcare system.<sup>1,2</sup> Ranging from universal to private healthcare, and big cities to rural communities, access to quality care for patients varies.<sup>2</sup></p>\n",
      "jcr:lastModified": "Wed Apr 27 2022 18:29:49 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "2",
          "width": "8"
