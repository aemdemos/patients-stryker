    "text_copy_copy_copy_2095659306": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Wed Apr 27 2022 18:28:58 GMT+0000",
      "text": "<p><a href=\"/content/stryker/us/en/about/corporate-responsibility/promoting-global-health.html\">Operation Smile</a> believes that every child suffering from cleft lip or cleft palate deserves exceptional surgical care. At Stryker, we believe the same. That’s why we support their efforts to provide critically needed surgical care for children with cleft conditions in under-resourced communities. We’ve been a loyal partner of Operation Smile since the early 1990s, providing cash and gifts in kind to deliver the highest quality surgical care to the world’s most <a href=\"https://www.stryker.com/us/en/about/news/features/changing-the-course-of-healthcare-in-under-resourced-communities.html\">marginalized populations</a>. Together with Operation Smile, we’ve helped them grow their reach to more than 60 countries worldwide, including countries in Latin America.<br>\n</p>\n",
      "jcr:lastModified": "Fri Apr 19 2024 14:51:16 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "2",
