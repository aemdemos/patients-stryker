      "jcr:created": "Wed Apr 27 2022 18:28:58 GMT+0000",
      "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #1c5687;\">Healing smiles by spreading awareness of cleft lip and palate in Bogotá, Columbia</span></span></span><br>\n</p>\n",
      "jcr:lastModified": "Wed Apr 27 2022 18:37:58 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
