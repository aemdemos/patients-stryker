        "gradientDirection": "left-to-right",
        "line1": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">Did you know?</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\">41% of the top hospitals in Latin America are located in Colombia.<sup>2</sup></span></p>\r\n",
