        "jcr:created": "Wed Apr 27 2022 18:33:12 GMT+0000",
        "gradientDirection": "left-to-right",
        "line1": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">Did you know?</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\">The country with the highest reported prevalence of cleft lip is <span class=\"futura-bold\">Bolivia</span>.<sup>3</sup></span></p>\r\n",
