    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-c26bb7a766@example.invalid",
      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Mon Jun 13 2022 18:58:59 GMT+0000",
      "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">To foster an inclusive environment where everybody belongs, SAFE provides networking, education, training and resources that support sexual orientation, gender identity and expression awareness to employees. Erin Mack – a supply chain analyst at Stryker – has been the event lead for SAFE’s Kalamazoo, Michigan chapter for three years now, facilitating events hosted across campuses.</span></span></p>\n",
      "jcr:lastModified": "Mon Jun 13 2022 19:06:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
