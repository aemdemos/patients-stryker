      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Mon Jun 13 2022 18:58:59 GMT+0000",
      "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">At Stryker, we believe that Pride is more than a single month or moment. We’re committed to championing the LGBTQIA+ community all year round, and SAFE (Stryker’s Allies for Equality) helps us listen to important voices, challenge bias and create an equitable culture where every employee can achieve their full potential.</span></span></p>\n",
      "jcr:lastModified": "Mon Jun 13 2022 19:06:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
