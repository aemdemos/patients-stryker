        "topMargin": "6",
        "jcr:created": "Mon Jun 13 2022 19:32:13 GMT+0000",
        "gradientDirection": "left-to-right",
        "line1": "<span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">“To accomplish our mission of making healthcare better, one of the biggest things is being able to bring your authentic self to work,” Erin says. “It’s important that we’re showing Stryker is a space where you can be yourself.”</span></span></span></span>",
        "jcr:lastModified": "Mon Jun 13 2022 19:34:41 GMT+0000",
