        "text_1438791674_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-73104d59b2@example.invalid",
          "jcr:title": "“The",
          "cq:masterBuildingBlock": true,
          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "jcr:created": "Thu Aug 08 2024 17:10:25 GMT+0000",
          "jcr:lastModified": "Mon Aug 12 2024 16:52:08 GMT+0000",
          "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
          "text_732501391448135": {
            "jcr:primaryType": "nt:unstructured",
            "bottomPadding": "2",
            "leftPadding": "3",
            "topPadding": "4",
            "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
            "hideComponent": "false",
            "rightMargin": "0",
            "topMargin": "1",
            "gradientDirection": "left-to-right",
            "text": "<p>“The Dr. Lorna Breen Heroes’ Foundation is proud to be a Signature Partner of Stryker to accelerate solutions and advocate for policies that put our healthcare workforce’s wellbeing first,” said Corey Feist, Co-Founder of the Foundation. “Over the next year, we look forward to growing our partnership with Stryker to help support all 15 million U.S. health workers caring for the health of our entire country. Together, we can address this mental health crisis our health workers are experiencing and make a lasting impact on our healthcare workforce’s wellbeing.”</p>\n",
            "jcr:lastModified": "Mon Aug 12 2024 16:58:47 GMT+0000",
            "sling:resourceType": "stryker/components/content/text",
            "rightPadding": "3",
            "showDimensionalBox": "true",
            "textIsRich": "true",
            "leftMargin": "0",
            "bottomMargin": "2",
