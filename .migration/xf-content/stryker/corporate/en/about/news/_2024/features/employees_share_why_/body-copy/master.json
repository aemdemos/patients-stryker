        "jcr:created": "Thu Aug 15 2024 19:16:36 GMT+0000",
        "gradientDirection": "left-to-right",
        "line1": "<p><span class=\"fontsize-1-5-vw\">“Knowing that everyone has the power to be the spark for change motivates me to challenge my own biases and create a more welcoming environment for all colleagues.&quot;&nbsp;</span></p>\r\n<p>&nbsp;</p>\r\n<p>–<span class=\"futura-bold\">Chris Camacho</span>, Associate Manager for Inventory Accounting</p>\r\n",
        "jcr:lastModified": "Thu Aug 15 2024 19:28:21 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
