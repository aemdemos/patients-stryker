    },
    "text_232231332": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Thu Aug 15 2024 18:56:41 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2>Stryker employees use learnings to advance DE&amp;I</h2>\n<p>Collective action is the cornerstone of meaningful change. By actively listening, sharing experiences, and adapting individual behaviors, we’re creating a ripple effect that transforms our workplace. Employee reflections highlight the power of shared stories in fostering new perspectives and inspiring positive actions. Here's what some team members shared:</p>\n",
      "jcr:lastModified": "Thu Aug 15 2024 19:21:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "5",
