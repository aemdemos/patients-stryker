    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Thu Aug 15 2024 18:55:36 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Back in 2021, we hosted our <a href=\"/content/stryker/us/en/about/news/features/stryker-holds-diversity--equity-and-inclusion-summit.html\"><span style=\"color: #4c7d7a;\">first global Diversity, Equity and Inclusion (DE&amp;I) Summit</span></a> for Stryker employees—and we’ve been on an inspiring journey ever since.</span><span class=\"urw-egyptienne\"> For two immersive days, employees dive into the value of diversity, equity and inclusion. And because we believe each one of us should feel seen, heard and valued, our 2024 Summit invited each attendee to share why DE&amp;I is important to them.</span></span></p>\n",
      "jcr:lastModified": "Thu Aug 15 2024 20:09:49 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "3",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "2",
          "width": "8"
        },
        "tablet": {
          "jcr:primaryType": "nt:unstructured",
          "offset": "1",
          "width": "10"
        },
