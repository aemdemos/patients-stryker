        "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
        "jcr:created": "Thu Aug 15 2024 19:16:36 GMT+0000",
        "gradientDirection": "left-to-right",
        "line1": "<p><span class=\"fontsize-1-5-vw\">&quot;Together we are stronger,” she said. “We must continue to learn from, inspire and support one another.”&nbsp;<br>\r\n <br>\r\n <br>\r\n</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">&nbsp;</span></p>\r\n<p>–<span class=\"futura-bold\">Franziska de Rooij</span>, Finance Director</p>\r\n",
        "jcr:lastModified": "Thu Aug 15 2024 19:28:27 GMT+0000",
