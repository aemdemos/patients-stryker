      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "largeheadline_copy_2090605135090469031298764": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
        "gradientDirection": "left-to-right",
        "line1": "<p><span class=\"fontsize-1-5-vw\">&quot;The stories are inspiring and serve as a good reminder of how I can make a difference when it comes to DE&amp;I. Being a minority myself, it also encourages me to continue speaking up and sharing my thoughts.”&nbsp;</span></p>\r\n<p>&nbsp;</p>\r\n<p>–<span class=\"futura-bold\">Vanessa Niederleig, </span>Senior Human Resources Manager</p>\r\n",
        "jcr:lastModified": "Thu Aug 15 2024 19:28:15 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
        "backgroundColor": "rgb(237,238,236)",
        "textIsRich": [
          "true",
          "true"
        ],
