        "text_531283438": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-1f15d09fdf@example.invalid",
          "topPadding": "3",
          "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Nov 27 2024 22:41:03 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-8em\"><span style=\"color: #85458a;\">Creating care packages for hospitalized children</span></span></span></h3>\n<p>130 employees in New Jersey and Michigan created over 250 care packages for hospitalized children for the Happy Hope Foundation, a nonprofit committed to supporting children impacted by health and safety crises. The care packages are disseminated to hospitals in the local community.&nbsp;</p>\n<p>“My younger son had 3 surgeries between the ages of 1 and 5,” a New Jersey employee said. “I remember looking for things to make his stay in the hospital fun and not scary. This was a great moment for me to remember our time together!”</p>\n",
          "jcr:lastModified": "Wed Nov 27 2024 23:05:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
