      "gradientDirection": "left-to-right",
      "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-3-5-vw\">Stryker's <br />\r\n<span style=\"color: rgb(255,181,0);\">Global Volunteer Network </span>highlights importance of volunteerism</span></span></h1>\r\n",
      "jcr:lastModified": "Wed Nov 27 2024 21:57:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
