          "hideComponent": "false",
          "topMargin": "-5",
          "jcr:created": "Tue Sep 17 2024 19:50:30 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-8em\">Bettye Brewer (center) and her family survived a fire in their Alabama home in December 2022, thanks to smoke alarms that Red Cross volunteers Robert Jay Wortley (left) and Mike Turner (right) had installed just two months earlier. Photo courtesy of the Red Cross.</span></p>\n",
          "jcr:lastModified": "Tue Sep 17 2024 20:25:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:responsive": {
