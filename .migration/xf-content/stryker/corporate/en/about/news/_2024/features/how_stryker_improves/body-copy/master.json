          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-8em\">Dr. Clovis Baramburiye performs surgery while surgical residents observe in Rwanda, Africa. Photo courtesy of the Operation Smile.</span></p>\n",
          "jcr:lastModified": "Tue Sep 17 2024 20:24:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
