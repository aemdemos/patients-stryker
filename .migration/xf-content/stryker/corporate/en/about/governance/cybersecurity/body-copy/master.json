      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Wed Mar 24 2021 19:48:14 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><span class=\"futura-bold\"><span class=\"fontsize-2vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: #ffffff;\">Our commitment to cybersecurity</span></span></span></span></h2>\r\n",
      "jcr:lastModified": "Fri Mar 26 2021 13:55:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(84,88,87,1)",
