      "text_copy_1436085849": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "carolyn.lee@stryker.com",
        "leftPadding": "0",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "hideComponent": "false",
        "jcr:created": "Wed Apr 10 2024 21:53:56 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p>In certain circumstances, such as limited component availability or unanticipated third-party software obsolescence, a product may enter Limited Support. During this support phase, Stryker will provide best-effort service solutions to support the intended use of the cyber device.&nbsp;</p>\n",
        "jcr:lastModified": "Wed Jun 12 2024 23:25:59 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "0",
        "textIsRich": "true"
      }
    },
