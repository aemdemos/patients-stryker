      "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
      "jcr:created": "Thu Apr 11 2024 21:40:57 GMT+0000",
      "text": "<p>&nbsp;&nbsp;</p>\n",
      "jcr:lastModified": "Thu Apr 11 2024 21:41:03 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
