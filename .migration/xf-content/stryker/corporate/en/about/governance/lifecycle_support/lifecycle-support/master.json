      "text_copy_1473035096": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "carolyn.lee@stryker.com",
        "leftPadding": "0",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "hideComponent": "false",
        "jcr:created": "Wed Apr 10 2024 21:54:04 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p>Upon End of Support, cyber devices will no longer be improved, repaired, maintained, or supported. Customers will be notified by Stryker as the End of Support date approaches.</p>\n",
        "jcr:lastModified": "Wed Apr 10 2024 22:11:47 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "0",
        "textIsRich": "true"
