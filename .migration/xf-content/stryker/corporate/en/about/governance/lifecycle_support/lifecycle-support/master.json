      "text_copy_1640162915": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "carolyn.lee@stryker.com",
        "leftPadding": "0",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "hideComponent": "false",
        "jcr:created": "Wed Apr 10 2024 21:53:30 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p>Stryker cyber devices are in Guaranteed Support immediately upon launch. During this support phase, customers can expect Stryker to restore cyber devices to their intended use, including situations in which the creation and deployment of software patches may be required.&nbsp;</p>\n",
        "jcr:lastModified": "Wed May 01 2024 16:20:12 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "0",
        "textIsRich": "true"
      }
    },
