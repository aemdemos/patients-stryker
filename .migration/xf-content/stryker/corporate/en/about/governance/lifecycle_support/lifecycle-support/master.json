    "section_title": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "carolyn.lee@stryker.com",
      "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
      "deepLinkingId": "our-support-commitment",
      "jcr:created": "Wed Apr 10 2024 21:26:23 GMT+0000",
      "title": "Our support commitment",
      "jcr:lastModified": "Wed Apr 10 2024 21:26:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title"
    },
    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
      "text": "<p>Stryker is committed to ensuring the safety, effectiveness, and security of our cyber devices through defined support phases over the life of a Stryker product. At a high level, cyber devices are medical devices that include software or are software, can connect to the internet, or can be vulnerable to cyber threats.&nbsp;Stryker has aligned with emerging cybersecurity and medical device regulation best practices to define a planned End of Support for our cyber devices, a fixed calendar date on which all units of a cyber device will no longer receive software improvements or maintenance.&nbsp;<br>\n</p>\n",
      "jcr:lastModified": "Wed Jun 12 2024 14:48:19 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
