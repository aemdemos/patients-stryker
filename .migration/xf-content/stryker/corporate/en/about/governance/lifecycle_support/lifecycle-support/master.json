      "topMargin": "2",
      "jcr:created": "Wed Apr 10 2024 21:25:40 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h1><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Stryker Lifecycle Support</span></span></h1>\r\n",
      "jcr:lastModified": "Fri Nov 21 2025 19:34:12 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,0)",
