    "text_copy_copy_copy__46557074": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "ray.maniaci@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Mon Jan 20 2020 19:32:29 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h1><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">Emily&nbsp;</span>Baculik</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\"><br>\n</span></span></h1>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Vice President, Corporate Controller</span></span></p>\n<p>Emily Baculik became Vice President, Corporate Controller in November 2024.<br>\n</p>\n<p>&nbsp;</p>\n<p>Emily is responsible for our internal and external financial reporting, ensuring compliance with internal control and financial statement audit requirements, technical accounting and other accounting policy and compliance-related matters. She also oversees our finance training and development programs and finance indirect channel management.</p>\n<p>Emily has more than 20 years of finance and accounting experience with publicly traded companies. Prior to her current role as Corporate Controller, she spent several years in various positions spanning the Instruments Division and Enterprise FP&amp;A, as well as Vice President, Finance for the Spine Division. Emily also has prior experience in FP&amp;A, external financial reporting, technical accounting, compliance and controllership at Wabtec Corporation, Eaton, Rockwell Collins, Ingersoll Rand and U.S. Steel.</p>\n<p>She earned her bachelor’s degree from the University of Notre Dame and a master’s degree in accounting from The Ohio State University. She is a Certified Public Accountant (CPA) and Certified Management Accountant (CMA).<br>\n</p>\n",
      "jcr:lastModified": "Fri Sep 11 2026 01:08:14 GMT+0000",
