    "text_copy_copy_copy_": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "ray.maniaci@stryker.com",
      "jcr:created": "Mon Jan 20 2020 19:32:29 GMT+0000",
      "text": "<h1><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">Dylan&nbsp;</span>Crotty</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\"><br>\n</span></span></h1>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Group President, Orthopaedics</span></span></p>\n<p>Dylan Crotty became Group President, Orthopaedics in January 2026.<br>\n</p>\n<p>&nbsp;</p>\n<p>Dylan oversees our Joint Replacement, Trauma &amp; Extremities and Ortho Tech Businesses.</p>\n<p>In his previous role as President, Instruments, Dylan oversaw Orthopaedic Instruments, Surgical Technologies, Neurosurgical, Craniomaxillofacial, Interventional Spine and ENT.</p>\n<p>Dylan began his career with Stryker in 1999 and has held a series of senior leadership positions including Vice President and General Manager roles in Surgical, Neuro Spine and ENT, and Foot &amp; Ankle. Earlier in his career, he served as Managing Director for Stryker UK, Ireland, South Africa and General Manager of Trauma and Craniomaxillofacial across Europe.</p>\n<p>Dylan serves on the Board of StacheStrong, supporting research and initiatives dedicated to combating brain cancer.</p>\n<p>He holds a bachelor's degree in business administration from Hope College and has served on multiple healthcare and nonprofit boards in southwest Michigan.</p>\n",
      "jcr:lastModified": "Fri Jan 02 2026 22:36:40 GMT+0000",
