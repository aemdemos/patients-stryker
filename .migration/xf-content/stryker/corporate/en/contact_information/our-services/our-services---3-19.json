      "text_copy_1651919597": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-f9c250736c@example.invalid",
        "text": "<h4>Open source</h4>\n<p>We are fully committed to fulfilling its obligations per licensing requirements set forth by the open source community. If you have questions regarding the use of Open Source, or wish to request a copy of the Open Source software used in a product, please send an e-mail to:&nbsp;<b><a href=\"mailto:OpenSourceRequest@stryker.com\">OpenSourceRequest@stryker.com</a>.</b><br>\n</p>\n",
        "jcr:lastModified": "Tue Oct 08 2019 17:25:57 GMT+0000",
