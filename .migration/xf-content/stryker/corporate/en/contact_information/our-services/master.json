        "jcr:lastModifiedBy": "user-f9c250736c@example.invalid",
        "text": "<h4>Product information</h4>\n<p>For information about our products or to place an order, please contact our divisions by using the contact list below or the customer support centers tab.If you are uncertain which division to contact, please call the corporate office at +1&nbsp;269 385 2600.<br>\n</p>\n",
        "jcr:lastModified": "Tue Oct 08 2019 17:27:44 GMT+0000",
