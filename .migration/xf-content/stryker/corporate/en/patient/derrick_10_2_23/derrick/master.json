      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "largeheadline_copy531197258726621426": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
        "gradientDirection": "left-to-right",
        "line1": "<h1><span class=\"fontsize-2vw\"><span class=\"futura-bold\">Knowing the <b>warning</b> signs of sudden cardiac arrest helped saved his life<br>\r\n</span></span>Derrick’s sudden cardiac arrest story</h1>\r\n",
        "line2": "After going on a morning run, Derrick began to feel some chest discomfort. His wife, Melissa, a healthcare professional trained in resuscitation, quickly recognized the warning signs of a sudden cardiac arrest. Although he wasn’t having a heart attack, she knew there was no time to wait. On the way to the hospital, Derrick started turning red and became unresponsive. Melissa immediately pulled the car to the side of the road and began administering CPR. Luckily, an off-duty firefighter pulled over from traffic and began assisting. Soon EMS and Fire/Rescue units arrived to apply a LUCAS device. Watch this video to hear Derrick's story.",
        "jcr:lastModified": "Mon Oct 02 2023 18:26:42 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
