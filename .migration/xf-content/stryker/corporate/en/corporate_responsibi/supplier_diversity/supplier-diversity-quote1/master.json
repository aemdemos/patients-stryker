    "text_424300003_copy2_903924010": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
      "hideComponent": "false",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">Our efforts</span></span></h2>\n<p><span class=\"fontsize-1-25em\">We embed supplier inclusion across major spend categories through our Supplier Inclusion Council and integration with enterprise activities.</span></p>\n<p><span class=\"fontsize-1-25em\">We identify potential suppliers in many ways, including:</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Participating in industry trade shows, manufacturing expos and other events.</span></li>\n<li><span class=\"fontsize-1-25em\">Engaging inclusion advocacy groups.</span></li>\n<li><span class=\"fontsize-1-25em\">Reviewing suppliers registered in our Supplier Inclusion Portal.<br>\n </span>&nbsp;</li>\n</ul>\n",
      "jcr:lastModified": "Thu May 07 2026 20:49:10 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "2",
