        "jcr:created": "Fri Nov 17 2023 14:51:32 GMT+0000",
        "CTATitle": "Access our Supplier Inclusion Portal",
        "ctaExternalLink": "https://stryker.supplierone.co/",
        "jcr:lastModified": "Tue May 12 2026 14:54:27 GMT+0000",
        "sling:resourceType": "stryker/components/content/curatedcta",
