      "text": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:createdBy": "carolyn.lee@stryker.com",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "hideComponent": "false",
        "rightMargin": "2",
        "topMargin": "3",
        "jcr:created": "Thu May 07 2026 20:30:37 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"fontsize-1-25em\">Registration in this portal is separate from other onboarding and sourcing systems (e.g., Ariba) in which you may also be asked to register.</span></p>\n<p><span class=\"fontsize-1-25em\">We select suppliers for each need based on a range of factors, such as capabilities, quality, cost and demonstrated performance.</span></p>\n",
        "jcr:lastModified": "Fri May 15 2026 18:17:19 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
