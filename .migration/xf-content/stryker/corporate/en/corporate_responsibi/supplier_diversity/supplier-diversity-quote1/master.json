    "text_424300003_copy2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:title": "Register",
      "cq:masterBuildingBlock": true,
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:lastModified": "Fri Nov 17 2023 14:51:59 GMT+0000",
      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text_424300003_copy25160076173547740": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "hideComponent": "false",
        "rightMargin": "2",
        "gradientDirection": "left-to-right",
        "text": "<h2><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">Supplier Inclusion Portal</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Our Supplier Inclusion Portal allows suppliers to create a free profile.</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">For suppliers interested in doing business with us, registering allows you to:</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Share information about your company and its capabilities.</span></li>\n<li><span class=\"fontsize-1-25em\">Maintain your profile so your information stays accurate and accessible to our procurement teams.</span><br>\n</li>\n</ul>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">For suppliers already doing business with us, registering allows you to:</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Support our reporting obligations to stakeholders, including the U.S. Government and other customers, related to supplier classifications collected in the portal.</span></li>\n<li><span class=\"fontsize-1-25em\">Increase your visibility, as other organizations use the same portal to identify potential suppliers.</span><br>\n&nbsp;</li>\n</ul>\n",
        "jcr:lastModified": "Tue May 12 2026 17:27:40 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true",
