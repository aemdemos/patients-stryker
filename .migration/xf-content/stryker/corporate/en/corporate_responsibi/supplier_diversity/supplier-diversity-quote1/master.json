      "jcr:created": "Thu Aug 18 2022 13:46:41 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span style=\"color: #ffb500;\"><span style=\"color: #000000;\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">“</span><span class=\"urw-egyptienne\">Supporting supplier inclusion aligns with our values and </span><span class=\"futura-bold\">strengthens our ability to make healthcare better.”</span></span></span></span></p>\n<p style=\"text-align: right;\"><span class=\"fontsize-1-25em\">—<span class=\"futura-bold\"> Kathleen Ward<br>\n </span><span class=\"urw-egyptienne\">Vice President, Division Sourcing, Stryker</span></span></p>\n",
      "jcr:lastModified": "Tue May 12 2026 15:01:41 GMT+0000",
