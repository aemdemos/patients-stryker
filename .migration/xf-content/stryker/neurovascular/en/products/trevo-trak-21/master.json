      "largeheadline_copy_c9603800667174345": {
        "jcr:primaryType": "nt:unstructured",
        "leftPadding": "0",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "gradientDirection": "left-to-right",
        "line1": "<h1><span style=\"font-size: 70.0px;\"><b><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"fontsize-4vw\">Trevo Trak<sup>® </sup>21 Microcatheter</span></span></span></span></b></span></h1>\r\n",
        "line2": "<span class=\"fontsize-2-5-vw\">Making a difference by going distal with ease</span>",
        "jcr:lastModified": "Wed Feb 19 2025 21:14:49 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
        "backgroundColor": "rgba(255,255,255,1)",
        "textIsRich": [
          "true",
          "true"
        ],
        "leftMargin": "0"
      },
      "text_copy_copy": {
        "jcr:primaryType": "nt:unstructured",
        "bottomPadding": "1",
        "jcr:createdBy": "cedu.ocson@stryker.com",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "hideComponent": "false",
        "jcr:created": "Mon Jun 24 2024 20:41:13 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">You want a microcatheter that confidently gets you to the clot and helps simplify the procedure. The Trevo Trak 21 Microcatheter delivers all sizes of Trevo NXT ProVue Retriever for thrombectomy procedures. It’s designed to help you reach distal neurovasculature with its extra-long 162cm length, while providing support for aspiration catheters. This .021in ID microcatheter is compatible with all Trevo NXT sizes while maintaining a low clot crossing profile.&nbsp;</span></span></p>\n",
        "jcr:lastModified": "Wed Feb 19 2025 21:14:34 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "textIsRich": "true"
      },
