        "jcr:created": "Mon Apr 07 2025 18:33:50 GMT+0000",
        "text": "<p>&nbsp;&nbsp;</p>\n",
        "jcr:lastModified": "Mon Apr 07 2025 21:53:18 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
