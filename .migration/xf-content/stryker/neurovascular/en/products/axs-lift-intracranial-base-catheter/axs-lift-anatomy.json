      "text_122053434411357": {
        "jcr:primaryType": "nt:unstructured",
        "bottomPadding": "5",
        "leftPadding": "5",
        "topPadding": "7",
        "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
        "hideComponent": "false",
        "rightMargin": "10",
        "topMargin": "5",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">1)&nbsp;</span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Atraumatic tip</span></span></span><span class=\"fontsize-1-25em\"><br>\n <span class=\"urw-egyptienne\">Gentle for distal navigation<br>\n &nbsp;</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">2)&nbsp;</span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Low profile outer diameter 7Fr compatible (0.097in OD)</span></span></span><br>\n<span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Low-profile OD minimizes puncture size<br>\n &nbsp;</span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">3) </span></span><span class=\"fontsize-1-25em\">Large 0.074&quot; inner diameter</span></span></span><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">Seamless compatibility with parallel techniques<br>\n &nbsp;</span></span></span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">4) </span></span><span class=\"fontsize-1-25em\">Distal 15cm construction featuring nitinol round wire coils and ultra soft polymers</span></span></span><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">Highly trackable and supportive intracranially<br>\n &nbsp;</span></span></span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">5) </span></span><span class=\"fontsize-1-25em\">Proximal construction featuring nitinol round wire coils, stainless steel braid and stiffer polymers</span></span></span><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">Pushable and supportive in the arch which eliminates the need for a guide</span></span></span></span></p>\n",
        "jcr:lastModified": "Tue Apr 29 2025 23:26:26 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
