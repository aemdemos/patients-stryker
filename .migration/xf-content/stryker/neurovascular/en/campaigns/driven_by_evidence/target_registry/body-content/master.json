    "text_2053505301": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "jcr:created": "Mon Mar 21 2022 18:24:57 GMT+0000",
      "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Zaidat et al. Target Intracranial Aneurysm Registry, Frontiers in Neurology, July 2019/Volume10/Article 737&nbsp;<br>\n Target Registry is an Investigator Initiated Study that received grant funding from Stryker Neurovascular.</span></span></p>\n<p>&nbsp;</p>\n",
      "jcr:lastModified": "Mon Mar 21 2022 19:54:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "text_2084961831_copy_1954425191": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "jcr:created": "Mon Mar 21 2022 18:25:37 GMT+0000",
      "text": "<p><span class=\"futura-bold\">Target® Detachable Coil </span><br>\nSee package insert for complete indications, contraindications, warnings and instructions for use.<br>\n<b>RX ONLY</b><br>\n<b>Intended use / indications for use</b></p>\n<ul>\n<li>Target Detachable Coils are intended to endovascularly obstruct or occlude blood flow in vascular abnormalities of the neurovascular and peripheral vessels.</li>\n<li>Target Detachable Coils are indicated for endovascular embolization of:</li>\n<li>Intracranial aneurysms</li>\n<li>Other neurovascular abnormalities such as arteriovenous malformations and arteriovenous fistulae</li>\n<li>Arterial and venous embolizations in the peripheral vasculature</li>\n</ul>\n<p><b>Contraindications</b><br>\nNone known.<br>\nPotential adverse events<br>\nPotential complications include, but are not limited to: allergic reaction, aneurysm perforation and rupture, arrhythmia, death, edema, embolus, headache, hemorrhage, infection, ischemia, neurological/intracranial sequelae, post-embolization syndrome (fever, increased white blood cell count, discomfort), TIA/stroke, vasospasm, vessel occlusion or closure, vessel perforation, dissection, trauma or damage, vessel rupture, vessel thrombosis. Other procedural complications including but not limited to: anesthetic and contrast media risks, hypotension, hypertension, access site complications.<br>\n<b><br>\n Warnings</b></p>\n<ul>\n<li>Contents supplied STERILE using an ethylene oxide (EO) process. Do not use if sterile barrier is damaged. If damage is found, call your Stryker Neurovascular representative.</li>\n<li>For single use only. Do not reuse, reprocess or resterilize. Reuse, reprocessing or resterilization may compromise the structural integrity of the device and/or lead to device failure which, in turn, may result in patient injury, illness or death. Reuse, reprocessing or resterilization may also create a risk of contamination of the device and/or cause patient infection or cross-infection, including, but not limited to, the transmission of infectious disease(s) from one patient to another. Contamination of the device may lead to injury, illness or death of the patient.</li>\n<li>After use, dispose of product and packaging in accordance with hospital, administrative and/or local government policy.</li>\n<li>This device should only be used by physicians who have received appropriate training in interventional neuroradiology or interventional radiology and preclinical training on the use of this device as established by Stryker Neurovascular.</li>\n<li>Patients with hypersensitivity to 316LVM stainless steel may suffer an allergic reaction to this implant.</li>\n<li>MR temperature testing was not conducted in arteriovenous malformations or fistulae models.</li>\n</ul>\n",
      "jcr:lastModified": "Mon Mar 21 2022 19:53:12 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "cq:responsive": {
        "jcr:primaryType": "nt:unstructured",
        "default": {
          "jcr:primaryType": "nt:unstructured",
          "width": "4"
        },
        "tablet": {
          "jcr:primaryType": "nt:unstructured",
          "width": "12"
