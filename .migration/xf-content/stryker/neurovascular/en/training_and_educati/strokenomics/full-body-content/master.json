      "sling:resourceType": "cq/experience-fragments/editor/components/buildingblock",
      "text_copy31994118868332409038400429": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "garrett.shue@stryker.com",
        "text": "<p><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\"><br>\n <br>\n <br>\n Driven by&nbsp;</span><span class=\"futura-bold\"><span style=\"color: #af6d04;\"><span style=\"color: #1c5687;\"><span style=\"color: #000000;\">data</span></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Equipped with the highest level of clinical and economic&nbsp;data, we can strategically navigate barriers—helping to&nbsp;ensure neurovascular procedures are funded and accessible&nbsp;to all eligible patients.</span></span><br>\n</p>\n",
        "jcr:lastModified": "Fri Jun 04 2021 16:57:38 GMT+0000",
