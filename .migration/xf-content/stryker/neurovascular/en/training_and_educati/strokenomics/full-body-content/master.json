    "text_copy_362456251": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "jcr:created": "Thu May 27 2021 19:04:07 GMT+0000",
      "text": "<p><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\">Our strategic areas of focus&nbsp;</span><span class=\"futura-bold\"><span style=\"color: #af6d04;\"><span style=\"color: #85458a;\"><span style=\"color: #000000;\">right at your fingertips</span></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Our efforts to help you gain economic sustainability are focused across five strategic areas. Knowing that funding&nbsp;challenges differ across the globe, our team has created a collection of regionally specific cost analysis tools.&nbsp;Using this analysis, we'll partner with you in developing a strategy for your needs.</span></span></p>\n",
      "jcr:lastModified": "Tue Jun 08 2021 17:07:52 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
