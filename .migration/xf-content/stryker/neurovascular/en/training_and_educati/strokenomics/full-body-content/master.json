    "text_copy31994118868_1654241004": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "text": "<p><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\"><br>\n <br>\n <br>\nTailored </span><span class=\"futura-bold\"><span style=\"color: #af6d04;\"><span style=\"color: #4c7d7a;\"><span style=\"color: #000000;\">for you</span></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">At Stryker, we do more than develop innovative ischemic and hemorrhagic stroke treatment solutions. We demonstrate their economic value- not in a general way, but in a way that matters specifically to you.&nbsp;</span></span></p>\n<p><a href=\"mailto:strokenomics@stryker.com\"><span class=\"standalone-link\"><span class=\"fontsize-1-25em\">Talk with us</span></span></a></p>\n",
      "jcr:lastModified": "Thu Jun 10 2021 16:46:51 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
