      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "jcr:created": "Thu May 27 2021 18:55:11 GMT+0000",
      "text": "<p><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\"><br>\n <br>\n Let’s solve the economic</span><br>\n <span class=\"futura-bold\"><span style=\"color: #af6d04;\"><span style=\"color: #85458a;\"><span style=\"color: #000000;\">piece of the puzzle</span></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">With StrokEnomics, Stryker partners with physicians, hospitals and healthcare systems to create tailored solutions that may improve patient access and make care more efficient. By delivering strategies around health economic analysis and funding solutions, our team helps remove economic barriers to enhance both patient access and quality of care.</span></span><br>\n</p>\n",
      "jcr:lastModified": "Tue Jun 08 2021 17:06:04 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
