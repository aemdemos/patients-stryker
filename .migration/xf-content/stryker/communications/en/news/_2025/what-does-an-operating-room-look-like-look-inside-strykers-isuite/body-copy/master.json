      "text_99138562_copy_1": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
        "text": "<p style=\"text-align: left;\"><b>Surgical lights</b> are designed to provide light for particular needs at the surgical site throughout the procedure.</p>\n",
