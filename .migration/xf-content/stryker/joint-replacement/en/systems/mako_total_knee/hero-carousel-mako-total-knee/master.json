      "jcr:created": "Mon Jan 06 2025 16:01:54 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-3-5-vw\"><span class=\"fontsize-4vw\">Mako Total Knee</span></span></span></h1>\r\n<div> </div>\r\n",
      "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">With over <b>one million procedures completed*</b>, Mako Total Knee has transformed orthopaedics with its revolutionary technology and clinical outcomes. ​ The unique features of Mako SmartRobotics™, and the powerful combination with Triathlon are designed to help surgeons achieve Functional Knee Positioning™ through 3D CT-based implant planning, dynamic joint balancing and AccuStop™ haptic technology. Mako Total Knee allows you to know more about your patient, so you can cut less.<sup>1,2</sup></span></span>",
      "jcr:lastModified": "Fri Feb 21 2025 19:01:26 GMT+0000",
