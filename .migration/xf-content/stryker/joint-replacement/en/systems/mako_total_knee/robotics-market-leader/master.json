    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:lastModifiedBy": "user-16113fe70d@example.invalid",
      "text": "<h5><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Less pain, fewer meds</span></span></h5>\n<p><span class=\"fontsize-1-25em\">Patients experienced less pain,<sup>8</sup> and require less pain relief<sup>9</sup> compared to manual total knee replacement.&nbsp;</span><br>\n</p>\n",
      "jcr:lastModified": "Thu Feb 20 2025 21:40:54 GMT+0000",
