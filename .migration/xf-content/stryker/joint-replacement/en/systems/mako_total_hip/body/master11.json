        "hideComponent": "false",
        "jcr:created": "Tue Jan 30 2024 15:05:17 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">Mako Total Hip may reduce physical and mental demand for a surgeon that may lead to an improved surgical experience, especially while reaming, when compared to manual total hip arthroplasty.<sup>4,5</sup></span></span><br>\n</p>\n",
        "jcr:lastModified": "Mon Sep 22 2025 14:17:59 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "1",
        "textIsRich": "true"
