        "gradientDirection": "left-to-right",
        "line1": "<h3 style=\"text-align: center;\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\"><span class=\"fontsize-2vw\">Improved patient<br>\r\n outcomes</span></span></span></h3>\r\n",
        "jcr:lastModified": "Wed Sep 04 2024 19:56:38 GMT+0000",
        "sling:resourceType": "stryker/components/content/largeheadline",
        "backgroundColor": "rgb(28,86,135)",
