        "jcr:lastModifiedBy": "user-16113fe70d@example.invalid",
        "gradientDirection": "left-to-right",
        "line1": "<h3 style=\"text-align: center;\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\"><span class=\"fontsize-2vw\">Less surgeon mental<br>\r\n and physical fatigue</span></span></span></h3>\r\n",
