        "hideComponent": "false",
        "jcr:created": "Tue Jan 30 2024 15:05:17 GMT+0000",
        "gradientDirection": "left-to-right",
        "text": "<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">Studies have shown that Mako Total Hip patients are significantly less likely to be aware of their hip in daily circumstances compared to manual patients.<sup>6,9</sup></span></span></p>\n",
        "jcr:lastModified": "Mon Sep 22 2025 14:17:42 GMT+0000",
        "sling:resourceType": "stryker/components/content/text",
        "rightPadding": "1",
        "textIsRich": "true"
