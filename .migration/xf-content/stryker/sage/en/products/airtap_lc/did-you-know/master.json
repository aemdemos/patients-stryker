        "gradientDirection": "left-to-right",
        "text": "<p style=\"text-align: left;\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #1c5687;\"><span style=\"color: #ffb500;\">$26.8 billion</span></span></span></span></span></p>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\">in estimated annual costs due to pressure injuries each year<sup>1</sup></span></p>\n",
