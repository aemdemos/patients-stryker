          "ctaLinkType": "deep",
          "ctaOpenInNewTabOverride": "0",
          "jcr:created": "Tue Apr 22 2025 16:25:22 GMT+0000",
          "CTATitle": "SCHEDULE A MEETING ONSITE AT AAHKS",
          "ctaDeepLinkID": "contact",
          "ctaExternalLink": "https://forms.office.com/r/gnQYC2msGP",
          "jcr:lastModified": "Thu Aug 28 2025 18:48:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/curatedcta",
          "CTAButtonColor": "rgba(76,125,122,1)"
        },
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "topPadding": "2",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Mar 26 2025 21:24:32 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">With Stryker, you’re getting more than access to an expansive portfolio. You get access to our dedicated ASC team and a depth of insight gained from years of hands-on experience working with hundreds of ASCs to deliver tailored solutions and proven results.</span></p>\n",
          "jcr:lastModified": "Thu May 15 2025 21:50:46 GMT+0000",
