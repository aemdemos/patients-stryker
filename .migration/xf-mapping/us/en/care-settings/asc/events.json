        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Experience. Expertise. For every ASC.</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"></span></span></span></p>\n<p><span class=\"fontsize-1-25em\">Breaking ground on an ASC? Expanding your existing center? Let’s connect at Becker’s! The Stryker team will be onsite in Chicago, IL on October 29 and October 30 at the Swissotel Chicago, booth #507</span></p>\n<p><span class=\"fontsize-1-25em\">With Stryker, you’re getting more than access to an expansive portfolio. You get access to our dedicated ASC team and a depth of insight gained from years of hands-on experience working with hundreds of ASCs to deliver tailored solutions and proven results.</span></p>\n<p><span class=\"fontsize-1-25em\"><a href=\"#contact\">Schedule dedicated time</a> with our team to discuss where you are in your new build journey and learn how we can help support you.</span></p>\n",
          "jcr:lastModified": "Tue Sep 01 2026 17:48:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
