        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Thu Jun 25 2020 17:35:42 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-25em\">Understanding your challenges. Delivering tailored&nbsp;solutions. <span style=\"color: #ffb500;\">That’s what we do.&nbsp;</span></span></span></span></p>\n",
          "jcr:lastModified": "Thu Jun 25 2020 23:17:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1129280968_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "2",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Apr 18 2025 15:21:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Whether you’re navigating the complexities of a new build, expanding your footprint or adding new specialties, Stryker brings elevated expertise to every phase. With access to our dedicated ASC team and our full portfolio of products, you’ll gain a partner who understands the ASC journey – and guides you through every step.<br>\n</span></p>\n<p><span class=\"fontsize-1-25em\">As your single source of guidance, we’re incredibly specialized, the same way you are. Let’s realize your vision – faster, smarter, together.&nbsp;</span></p>\n",
          "jcr:lastModified": "Fri Apr 18 2025 15:29:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
