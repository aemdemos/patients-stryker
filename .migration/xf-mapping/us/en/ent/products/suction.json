        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Tue Jun 13 2023 15:11:52 GMT+0000",
          "text": "<h3>Cyclone® sinonasal suction and irrigation system</h3>\n<p>The dual-action performance of the Cyclone system is designed to facilitate a positive patient experience by minimizing pooling and drainage. Its unique single handed design includes a re-shapeable distal hypotube that can be modified to suction and irrigate multiple sinus passages in the same patient.<sup>2</sup></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/ent/products/cyclone-sinonasal-suction-and-irrigation-system.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Mon Aug 14 2023 19:04:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
