        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "allisa.chamberlin@stryker.com",
          "jcr:created": "Wed Jul 12 2023 15:52:35 GMT+0000",
          "text": "<h3>XprESS® ENT dilation system</h3>\n<p>The XprESS ENT dilation system delivers control and versatility for balloon dilation. Its seeker-based design and tip malleability provides tactile feel and flexibility to address complex anatomy for a broad range of patients.<sup>7,8</sup></p>\n<p><a href=\"/content/stryker/us/en/ent/products/xpress-ent-dilation-system.html\"><span class=\"standalone-link\">Learn more</span></a></p>\n",
          "jcr:lastModified": "Tue Jun 11 2024 18:10:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed Jul 12 2023 15:54:21 GMT+0000",
          "alt": "Tools_RAN reinforced anesthesia needle_left-1",
          "srcFileRef": "/content/dam/stryker/ent/products/xpress/images/Tools_RAN-reinforced-anesthesia-needle_left-1.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 12 2023 18:01:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "allisa.chamberlin@stryker.com",
          "jcr:created": "Wed Jul 12 2023 15:52:35 GMT+0000",
          "text": "<h3>Reinforced anesthesia needle</h3>\n<p>ENT surgeons select the reinforced anesthesia needle for its innovative design. The unique combination of a 27G tip and larger outer sleeve allows for a positive stop for injection depth precision.<sup>9, 10</sup></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/ent/products/reinforced-anesthesia-needle.html\">Learn more</a></span><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 11 2024 18:11:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
