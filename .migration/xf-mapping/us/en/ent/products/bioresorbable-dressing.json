        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "allisa.chamberlin@stryker.com",
          "jcr:created": "Wed Jun 07 2023 18:39:12 GMT+0000",
          "text": "<h3>Pello™ microdebrider</h3>\n<p>Powered by Stryker's CORE 2 console, the Pello microdebrider has proprietary anti-clogging blades, set to transform your ENT surgical experience. With its balanced ergonomic design and the power and quality of Stryker, Pello offers reliability and is designed for efficient cutting in ENT procedures.<sup>11</sup></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/ent/products/pello-microdebrider.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Tue Jun 11 2024 18:11:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
