        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "allisa.chamberlin@stryker.com",
          "hideComponent": "false",
          "topMargin": "10",
          "jcr:created": "Mon May 22 2023 19:31:20 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">XeroGel nasal packing</span></span><br>\n</p>\n<p>XeroGel nasal packing is a unique blend of Polyethylene glycol (PEG) and chitosan that offers a combination of stenting, adhesion prevention and hemostatic control.<sup>6</sup><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 11 2024 18:10:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
