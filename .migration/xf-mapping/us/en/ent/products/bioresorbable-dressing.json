          "jcr:created": "Wed Jun 07 2023 18:35:18 GMT+0000",
          "alt": "pello",
          "srcFileRef": "/content/dam/stryker/ent/products/bioresorbable-dressings/images/pello.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Jan 18 2024 20:24:48 GMT+0000",
