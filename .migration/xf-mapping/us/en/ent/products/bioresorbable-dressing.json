          "jcr:created": "Wed Jul 12 2023 15:54:21 GMT+0000",
          "alt": "XprESS_LoProfile_2",
          "srcFileRef": "/content/dam/stryker/ent/products/xpress/images/XprESS_LoProfile_2.jpg",
          "borderColor": "rgba(76,125,122,1)",
