        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Tue Jun 27 2023 18:44:54 GMT+0000",
          "text": "<h3>ClariFix® cryotherapy device</h3>\n<p>Stryker's ClariFix device goes straight to the root of chronic rhinitis - the overactive nerves. Using a minimally invasive treatment called cryotherapy, the ClariFix device applies focal, controlled freezing to target tissue under direct visualization.<sup>7</sup><br>\n</p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/ent/products/clarifix-cryotherapy-device.html\">LEARN MORE</a></span></p>\n",
          "jcr:lastModified": "Mon Jul 17 2023 18:06:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
