          "jcr:created": "Tue Jun 27 2023 18:45:59 GMT+0000",
          "alt": "XprESS_LoProfile_2",
          "srcFileRef": "/content/dam/stryker/ent/products/reinforced-anesthesia-needle/XprESS_LoProfile_2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jun 27 2023 18:46:05 GMT+0000",
