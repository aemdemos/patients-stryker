        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Tue Jun 27 2023 18:44:54 GMT+0000",
          "text": "<h3>XprESS® ENT dilation system</h3>\n<p>This system delivers control and versatility for balloon dilation. Its seeker-based design and tip malleability provide the tactile feel and flexibility to address complex anatomy for a broad range of patients.<sup>5-6<br>\n</sup></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/ent/products/xpress-ent-dilation-system.html\">LEARN MORE</a></span></p>\n",
          "jcr:lastModified": "Mon Jul 17 2023 19:16:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
