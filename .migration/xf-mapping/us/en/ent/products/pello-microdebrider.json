        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "text": "<p><span class=\"fontsize-1em\"><span class=\"fontsize-1-25em\">Meet Pello™—Stryker’s innovative microdebrider with proprietary anti-clogging blades,¹ designed for simplicity, reliability,² and efficiency in ENT procedures.³&nbsp;</span></span></p>\n",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hank.ewbank@stryker.com",
          "jcr:lastModifiedBy": "hank.ewbank@stryker.com",
          "preset": "max_width_auto",
          "jcr:created": "Tue Sep 19 2023 19:54:20 GMT+0000",
          "alt": "Surgeon using Pello",
          "srcFileRef": "/content/dam/stryker/ent/products/pello-microdebrider/Pello_Meet Pello 1.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Dec 11 2023 18:41:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hank.ewbank@stryker.com",
          "jcr:lastModifiedBy": "allisa.chamberlin@stryker.com",
          "jcr:created": "Tue Sep 19 2023 19:40:02 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\">Introducing Pello<sup>1</sup> — an ENT microdebrider with proprietary blades designed to reduce clogging and transform your ENT surgical experience. Also designed to be ergonomically balanced&nbsp;and reliable,&nbsp;Pello brings you the power and quality of Stryker to your ENT procedures. Powered by Stryker's CORE 2 Console, Pello is an everyday tool with innovative features.</span><br>\n</p>\n",
          "jcr:lastModified": "Thu Oct 03 2024 18:09:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
