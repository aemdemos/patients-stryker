        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Jun 12 2023 20:47:02 GMT+0000",
          "text": "<h3>XprESS® ENT dilation system</h3>\n<p>The XprESS ENT dilation delivers control and versatility for balloon dilation. Its seeker-based design and tip malleability provide the tactile feel and flexibility to address complex anatomy for a broad range of patients.<sup>2,4</sup></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/ent/products/xpress-ent-dilation-system.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Mon Jul 24 2023 18:19:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
