          "jcr:created": "Mon Jun 12 2023 20:53:35 GMT+0000",
          "alt": "cliq-pump_0-1",
          "srcFileRef": "/content/dam/stryker/ent/products/xpress/images/cliq-pump_0-1.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Jun 12 2023 21:05:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Jun 12 2023 20:47:02 GMT+0000",
          "text": "<h3>Cliq Suction Pump</h3>\n<p>The Cliq suction pump is designed to deliver powerful performance and convenience. It features a twin-cylinder diaphragm vacuum pump housed in an ergonomic case with collapsible handle and easy-to-read vacuum gauge.<sup>5</sup><br>\n</p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/ent/products/suction.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Mon Jul 24 2023 18:20:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
