        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-b81b2f2bb0@example.invalid",
          "jcr:created": "Mon May 22 2023 19:31:20 GMT+0000",
          "text": "<h2>Pointers<br>\n</h2>\n<p>These reusable (up to 10 times) and malleable instruments facilitate access to and precise navigation around complex anatomy.<br>\n</p>\n<p><span class=\"futura-bold\">Features and benefits</span></p>\n<ul>\n<li>Designed for easy access and precision during procedures<br>\n</li>\n<li>Built-in tracking capability</li>\n</ul>\n",
          "jcr:lastModified": "Fri Jan 19 2024 18:50:11 GMT+0000",
