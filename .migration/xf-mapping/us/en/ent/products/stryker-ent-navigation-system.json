              "jcr:createdBy": "user-4051b8581f@example.invalid",
              "jcr:lastModifiedBy": "user-2fc21bab61@example.invalid",
              "preset": "max_width_auto",
              "jcr:created": "Mon Dec 11 2023 19:03:36 GMT+0000",
              "alt": "ENT navigation system _ Precision",
              "srcFileRef": "/content/dam/stryker/ent/products/tgs-navigation/images/ENTnav_FB3.png",
              "borderColor": "rgba(76,125,122,1)",
              "jcr:lastModified": "Mon Aug 04 2025 17:11:33 GMT+0000",
