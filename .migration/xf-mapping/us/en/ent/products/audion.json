      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Wed Apr 19 2023 17:31:43 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Designed to treat&nbsp;Eustachian tube dysfunction</span></span></p>\n<p>The Audion Eustachian Tube dilation system is designed specifically to treat Eustachian tube dysfunction, with many features and benefits including:</p>\n<ul>\n<li>Designed with FlexFeel technology, featuring our atraumatic tip with an enhanced flexible design,&nbsp;to help optimize feel<sup>2</sup></li>\n<li>Slim profile designed for optimal visualization</li>\n<li>Features one-finger advancement and a 45-degree angle to help avoid critical anatomy during transnasal approach<sup>3-4</sup></li>\n<li>Locking mechanism holds pressure for 2 minutes dilation time<br>\n&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Mon Jul 24 2023 15:31:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
