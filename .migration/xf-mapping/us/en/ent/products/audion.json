          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Mon Jun 19 2023 20:25:21 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">XprESS® ENT dilation system</span></span><br>\n<br>\nThe XprESS ENT dilation system delivers&nbsp;control and versatility for balloon dilation. Its seeker-based design and tip malleability provide the tactile feel and flexibility to address complex anatomy for a broad range of patients.<sup>6-7</sup><br>\n<a href=\"/content/stryker/us/en/ent/products/xpress-ent-dilation-system.html\"><br>\n <span class=\"standalone-link\">Learn more</span></a></p>\n",
          "jcr:lastModified": "Tue Jul 18 2023 14:38:22 GMT+0000",
