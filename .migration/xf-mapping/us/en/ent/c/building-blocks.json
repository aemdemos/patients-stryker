      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "0",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "leftPadding": "5",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "jcr:created": "Wed May 14 2025 23:03:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-3vw\">Welcome</span>",
          "jcr:lastModified": "Wed May 14 2025 23:16:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ],
          "leftMargin": "0",
          "bottomMargin": "0"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "leftPadding": "5",
          "jcr:lastModifiedBy": "andrew.reynolds@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed May 14 2025 22:57:18 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Stryker Building Blocks is an educational planning software that allows for the analysis and identification of sinus cells in patient anatomy using International Frontal Sinus Anatomy Classification (IFAC) and planning of the natural drainage pathways through the sinus cavity. The technique uses high-definition CT scans to create a 3-dimensional picture of the cellular structure of this region, which allows surgeons to formulate a step-wise surgical plan and encourages cell-by-cell removal of the obstructing cells. The software was developed with Professor Peter J. Wormald, of Adelaide, Australia.</span></p>\n<p><span class=\"fontsize-1-25em\">Please fill out this form to gain access to a complimentary 1-year license of Stryker Building Blocks software.</span></p>\n<p><span class=\"fontsize-1-25em\">For questions around the Stryker Building Blocks software download, please call +1-800-253-3210, Option 2, Option 3</span></p>\n<p><span class=\"fontsize-1-25em\">For more information about the Stryker ENT Navigation System powered by Scopis software, please <a href=\"mailto:instsvctechsupport@stryker.com\">click here</a> or contact your local rep.</span></p>\n<p><span class=\"fontsize-1-25em\">Stryker Building Blocks software is for educational purposes only. Compatible with operating systems Mac OS 11.0 or later and Windows 10 or later.&nbsp;</span></p>\n",
          "jcr:lastModified": "Tue Nov 18 2025 13:08:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true",
          "bottomMargin": "5"
        }
      },
