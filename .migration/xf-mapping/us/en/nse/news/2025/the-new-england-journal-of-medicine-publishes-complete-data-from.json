          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:lastModifiedBy": "kendra.pilon@stryker.com",
              "hideComponent": "false",
              "gradientDirection": "left-to-right",
              "text": "<p style=\"margin-left: 80px; text-align: left;\"><span style=\"color: #ffffff;\"><span style=\"color: #323232;\"><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #323232;\"><span style=\"color: #ffb500;\"><br>\n The evidence of MIPS.&nbsp;</span></span></span></span><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\"><span style=\"color: #323232;\"><span style=\"color: #ffffff;\"><span class=\"futura-bold\">The support of Stryker.</span></span></span></span></span></span></span></p>\n<p style=\"margin-left: 80px; text-align: left;\"><span style=\"color: #ffffff;\"><span style=\"color: #323232;\"><span style=\"color: #ffffff;\">You need precision technologies for MIPS. Now, the first clinical trial with positive results shows how these instruments - Nico BrianPath and Myriad - work as a system in minimally invasive ICH surgery.<br>\n &nbsp;</span></span></span></p>\n",
              "jcr:lastModified": "Thu Aug 14 2025 12:56:14 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "col2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kendra.pilon@stryker.com",
              "jcr:lastModifiedBy": "kendra.pilon@stryker.com",
              "hideComponent": "false",
              "jcr:created": "Wed Jul 16 2025 18:44:38 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #323232;\"><span style=\"color: #ffb500;\"><br>\n Powerful proof for a new protocol</span></span></span></span></p>\n<p><span style=\"color: #ffffff;\"><span style=\"color: #000000;\"><span style=\"color: #ffffff;\">The ENRICH Trial is the first and only clinical trial that demonstrated positive outcomes in lobar ICH.<sup>4</sup></span></span></span></p>\n",
              "jcr:lastModified": "Thu Aug 14 2025 12:55:51 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
