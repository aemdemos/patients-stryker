          "line1": "<p><span class=\"fontsize-2vw\"><b><span class=\"futura-bold\"><span style=\"color: rgb(50,50,50);\"><span style=\"color: rgb(255,255,255);\"><span class=\"fontsize-1-5-vw\">&nbsp;</span></span></span></span></b></span></p>\r\n<p><span class=\"fontsize-2vw\"><b><span class=\"futura-bold\"><span style=\"color: rgb(50,50,50);\"><span style=\"color: rgb(255,255,255);\"><span class=\"fontsize-1-5-vw\"><span class=\"fontsize-2-5-vw\">ENRICH is World’s First Positive Surgical Trial for ICH</span></span></span></span></span></b></span></p>\r\n",
