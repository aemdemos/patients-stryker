          "jcr:created": "Mon Aug 19 2019 17:51:57 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">&nbsp;</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">&nbsp;</span></span></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<h4><span class=\"fontsize-1-75em\">New attachments</span></h4>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">New Elite 442/440 designs help optimize system length and balance for neuro otology/ENT<br>\n <br>\n </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Increased knurling on new 440/442 attachments allows tripod and other grips while reducing hand fatigue<br>\n <br>\n </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">iBur integrated attachments including 15° distally-bent cutting accessories for enhanced access and direct view of bur on surgical surface&nbsp;<br>\n</span></span></li>\n</ul>\n<p>&nbsp;</p>\n",
