          "jcr:created": "Mon Aug 19 2019 17:51:57 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>&nbsp;</p>\n<p>&nbsp;</p>\n<h4>&nbsp;</h4>\n<h4>&nbsp;</h4>\n<h4><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">πdrive technology</span></span></h4>\n<ul>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Patented, industry-unique design<br>\n<br>\n</span></span></li>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Magnets in “pie” configuration replace nonfunctioning steel core<br>\n</span></span><br>\n</li>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Flat wiring encases core, not open loop wiring<br>\n</span></span><br>\n</li>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Creates volumetric optimization to enhance performance while limiting housing size</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Oct 14 2022 18:04:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
