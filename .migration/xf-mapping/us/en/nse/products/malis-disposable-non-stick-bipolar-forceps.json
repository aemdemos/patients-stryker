              "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td><b>Length</b></td>\n<td colspan=\"3\"><b>Tip size</b></td>\n</tr><tr><td>&nbsp;</td>\n<td>0.5 mm</td>\n<td>1.0 mm</td>\n<td>1.5 mm</td>\n</tr><tr><td>7 in (18 cm)</td>\n<td>✔</td>\n<td>✔</td>\n<td>✔</td>\n</tr><tr><td>8 in (20 cm)</td>\n<td>✔</td>\n<td>✔</td>\n<td>✔</td>\n</tr><tr><td>9 in (23 cm)</td>\n<td>✔</td>\n<td>✔</td>\n<td>✔</td>\n</tr></tbody></table>\n",
              "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
              "jcr:created": "Tue Oct 01 2019 18:55:46 GMT+0000",
