      "jcr:lastModifiedBy": "user-4162137458@example.invalid",
      "jcr:created": "Fri Oct 14 2022 15:08:50 GMT+0000",
      "text": "<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><b><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Golden opportunity for more</span></span></b></span><br>\n</p>\n<p><b data-rte-class=\"rte-temp\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Your&nbsp;industry-leading<sup>1</sup> bone mill now offers you more. By combining existing features you trust and value&nbsp;with new design enhancements, Bone Mill+ aims to provide more capabilities and gold-standard autograft bone yield while reducing your manual effort.</span></span></b><br>\n</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n",
      "jcr:lastModified": "Fri Dec 23 2022 21:32:15 GMT+0000",
