          "sling:resourceType": "stryker/components/content/columncontrol/cols2",
          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text_1855165819": {
              "jcr:primaryType": "nt:unstructured",
              "bottomPadding": "8",
              "jcr:createdBy": "user-4162137458@example.invalid",
              "topPadding": "8",
              "jcr:lastModifiedBy": "user-719c902ffc@example.invalid",
              "hideComponent": "false",
              "jcr:created": "Tue Sep 27 2022 13:50:23 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span class=\"futura-bold\">Features and benefits</span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span style=\"color: #ffffff;\"><b><span class=\"futura-bold\">Enhanced quality</span></b>, quantity and consistency of stripped and milled bone<sup>2</sup></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span style=\"color: #ffffff;\"><b><span class=\"futura-bold\">41 minutes saved</span> </b>compared to manual prepping and milling*<sup>2</sup></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span style=\"color: #ffffff;\"><b><span class=\"futura-bold\">100% rating</span> </b>for quick setup and simple operation<b><sup>2</sup></b></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span style=\"color: #ffffff;\"><b><span class=\"futura-bold\">Improved efficiency</span></b> via automated tissue removal and ability to capture more bone per milling<sup>2</sup></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span style=\"color: #ffffff;\"><b><span class=\"futura-bold\">Multiple refinements</span></b> designed to improve bone yield, safe handling/processing, visibility, smooth performance and grip points/stability<sup>2,3</sup></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span style=\"color: #ffffff;\"><b><span class=\"futura-bold\">Single-pass cutting</span> action</b> protects bone from heat<sup>3</sup></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span style=\"color: #ffffff;\"><b><span class=\"futura-bold\">Ability to customize</span></b> particulate size to suit your preference or procedure<sup>3</sup></span></span></span></span><br>\n</p>\n",
              "jcr:lastModified": "Thu Feb 29 2024 16:22:42 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
