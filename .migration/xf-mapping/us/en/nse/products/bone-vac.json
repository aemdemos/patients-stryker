    "cols3_475620173": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cathy.lapico@stryker.com",
      "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
      "jcr:created": "Wed Aug 05 2020 19:57:35 GMT+0000",
      "jcr:lastModified": "Wed Aug 05 2020 19:57:35 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "text_copy_83412237": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Mon Jul 06 2020 19:00:02 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h4><span style=\"color: #af6d04;\"><span class=\"fontsize-1-75em\">Collectable</span></span></h4>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Compatible with existing drill and standard surgical suction tubing, tip and source</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">13cc capacity filter can be used multiple times during case to capture available bone dust</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 15:14:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "jcr:created": "Mon Jul 06 2020 19:00:02 GMT+0000",
          "text": "<h4><span style=\"color: #af6d04;\"><span class=\"fontsize-1-75em\">Simple</span></span></h4>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Orientation independent; no need to keep upright</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Cleanly ejects all collected material via plunger</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Malleable hydrated bone with putty-like consistency enables efficient shaping and placement</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Tue Jul 21 2020 20:38:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "text_copy_1937696381": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "jcr:created": "Mon Jul 06 2020 19:00:02 GMT+0000",
          "text": "<h4><span style=\"color: #af6d04;\"><span class=\"fontsize-1-75em\">Workflow efficient</span></span></h4>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Quick connect end caps minimize suction interruption when filter is removed</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Disposable; no added cleaning/manpower</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Double sterile barrier packaging with point-of-use assembly instructions enhances setup and usability</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Sterile field drape clip and 4ft flexible tubing provide security and freedom of movement<br>\n </span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jul 21 2020 20:38:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Mon Jul 06 2020 19:00:02 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h4><span style=\"color: #323232;\"><span style=\"color: #af6d04;\"><span class=\"fontsize-1-75em\">Cost conscious</span></span></span></h4>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Can reduce use of&nbsp;non-autologous biologics</span></span><br>\n</li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Equipment compatibility limits capital expenses</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 15:14:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
