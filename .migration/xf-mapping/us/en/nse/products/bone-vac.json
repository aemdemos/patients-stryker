      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Mon Jul 06 2020 19:00:02 GMT+0000",
          "text": "<h4><span class=\"fontsize-1-75em\"><span style=\"color: #ffb500;\">Viable autologous bone dust<a href=\"https://www.strykergooda\"></a></span></span></h4>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Bone dust can contain <span class=\"futura-bold\">viable bone-forming cells</span>, even after drilling<sup>1-6</sup></span></span></p>\n<p>&nbsp;</p>\n<h4><span class=\"fontsize-1-75em\"><span style=\"color: #ffb500;\">Explore the data</span></span></h4>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">With autologous, viable cells and regenerative nature, drilled bone dust can be a valuable adjunct to other bone growth agents. Click below to view just some of the data reflecting its <span class=\"futura-bold\">osteogenic, osteoinductive and osteoconductive</span> potential.<sup>1-6</sup></span></span></p>\n",
          "jcr:lastModified": "Thu Mar 14 2024 19:42:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
