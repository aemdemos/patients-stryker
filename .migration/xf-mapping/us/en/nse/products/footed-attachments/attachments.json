      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "jcr:created": "Mon Oct 07 2019 16:49:35 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Signature Footed</span></span></p>\n<p><span class=\"urw-egyptienne\">Our Signature Footed attachments are compatible with a larger variety of our routers and burs. They bring you more natural balance, grip and maneuverability. As always, our easy-to-use attachments deliver precise performance while streamlining your inventory.</span></p>\n<ul>\n<li><span class=\"urw-egyptienne\">A selection of fixed and rotating attachments to match your preferences and procedures</span></li>\n<li><span class=\"urw-egyptienne\">Refined attachment design for improved balance and maneuverability<br>\n </span></li>\n<li><span class=\"urw-egyptienne\">Fine-edge knurling for better grip and more options for positioning your hand<br>\n </span></li>\n<li><span class=\"urw-egyptienne\">Alignment dots that guide connection of attachments to motor<br>\n </span></li>\n<li><span class=\"urw-egyptienne\">Snap-Connect for easy and consistent assembly and disassembly</span><br>\n</li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Tue Oct 25 2022 14:49:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
