      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Thu Sep 26 2019 20:12:34 GMT+0000",
          "text": "<div><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Choose from more than 50 MIS cutting accessories in a variety of styles and sizes. All options are available for the 13 cm and 16 cm attachments.</span></span></div>\n<div>&nbsp;</div>\n<div><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Each accessory gives you multiple ways to achieve the reach, customization and exposure you need for each patient and procedure. Because each accessory can extend and retract—you get maximum flexibility and functionality from an economical, streamlined set of instruments.</span></span></div>\n<div>&nbsp;</div>\n<ul>\n<li>Unique multinotch (4-10 mm) telescoping ability on cutting accessories<br>\n</li>\n<li>Patented 2Flute cutting technology for smooth and precise for the rapid dissection of bone<br>\n</li>\n<li>Head diameters up to 5 mm—the largest on the market<br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Mon Sep 30 2019 14:00:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1847700893_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Thu Sep 26 2019 20:19:02 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><b>Expandable options</b><br>\nBuilt-in notches in 1 mm increments make it easy to adjust cutting accessory length.</p>\n<ul>\n<li>Large-diameter accessories — four telescoping exposure points<br>\n</li>\n<li>Small-diameter accessories — 10 telescoping exposure points<br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Mon Sep 30 2019 14:02:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(237,238,236,1)",
          "textIsRich": "true"
        }
      }
    },
