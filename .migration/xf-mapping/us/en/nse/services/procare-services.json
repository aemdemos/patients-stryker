      "gradientDirection": "left-to-right",
      "line1": "<h2><span class=\"fontsize-4-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">The </span></span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,181,0);\">ProCare </span></span></span></span><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\">Advantage</span></span></span></span></span></span></h2>\r\n",
      "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-2vw\">Get the most from your investment with specialized care from ProCare Services. We keep you focused on what matters most- patient safety and staff efficiency.</span></span>",
