        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Fri Nov 22 2024 15:30:55 GMT+0000",
          "text": "<h4>Less variability&nbsp;</h4>\n<p>Standardizes intraoperative specimen handling and reduces variability that may occur with manual collection&nbsp;&nbsp;</p>\n",
          "jcr:lastModified": "Fri Nov 22 2024 15:32:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Fri Nov 22 2024 15:30:55 GMT+0000",
          "text": "<h4>Enables efficiences&nbsp;&nbsp;</h4>\n<p>Fully automated system is designed to provide an efficient process for regionalizing samples by intratumor location&nbsp;&nbsp;&nbsp;</p>\n",
          "jcr:lastModified": "Fri Nov 22 2024 15:33:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
