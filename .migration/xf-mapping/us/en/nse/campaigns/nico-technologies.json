          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "hideComponent": "false",
          "topMargin": "12",
          "jcr:created": "Fri Nov 22 2024 15:19:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">BrainPath</span></span></h3>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">BrainPath is part of a systems approach for parafascicular, trans-sulcal access to address:</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Primary and secondary tumors&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Vascular abnormalities and malformations&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Intraventricular tumors and cysts&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Nov 22 2024 16:36:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
