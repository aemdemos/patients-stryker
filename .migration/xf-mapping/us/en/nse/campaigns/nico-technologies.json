          "hideComponent": "false",
          "jcr:created": "Fri Nov 22 2024 15:30:55 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h4>Tissue collection</h4>\n<p>Tissue removed with the Myriad can be collected for post-procedural analysis&nbsp;</p>\n",
          "jcr:lastModified": "Mon Feb 17 2025 18:17:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kendra.pilon@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Nov 22 2024 15:30:55 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h4>Tissue preservation&nbsp;</h4>\n<p>Immediate refrigeration of tissue, while limiting exposure to the atmosphere<br>\n</p>\n",
          "jcr:lastModified": "Fri Jan 31 2025 18:49:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
