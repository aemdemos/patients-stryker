        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kendra.pilon@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Nov 22 2024 15:19:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Nico Myriad Handpiece&nbsp;</span></span></h3>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Nico Myriad handpiece is used for resection and removal of soft tissue and fluids under direct visualization.&nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Automates resection</span></li>\n<li><span class=\"fontsize-1-25em\">Does not generate heat thus achieving tissue removal without injury to adjacent critical structures</span></li>\n<li><span class=\"fontsize-1-25em\">Non-ablative, mechanical cutting technology for precise, user-controlled tissue resection<sup>2</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Enhanced access in narrow corridors due to low profile design<sup>3</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Malleable cannula designed to help optimize access<sup>4</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Minimizes “in-and-out”of the surgical field&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">User-controlled variable aspiration&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Tissue captured in sterile, closed system for use in post-procedure tissue processing</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Feb 19 2025 16:21:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
