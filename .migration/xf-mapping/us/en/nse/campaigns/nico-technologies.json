              "jcr:created": "Fri Nov 22 2024 15:19:23 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h3><span style=\"color: #ffffff;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Nico Spectra System&nbsp;</span></span></span></h3>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\"><span class=\"urw-egyptienne\">Nico Spectra (Nico’s 3rd Generation Myriad System) enables, brain tumor removal and clot evacuation with the ability to toggle between white and blue excitation light, to aid in visualization of suspected grade III or IV gliomas.</span></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\"><span class=\"urw-egyptienne\">The Spectra console enables hand-held directional light coupled with non-ablative, non-thermal resection to complement the surgical workflow.</span></span></span></p>\n",
              "jcr:lastModified": "Mon Feb 17 2025 18:16:41 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
