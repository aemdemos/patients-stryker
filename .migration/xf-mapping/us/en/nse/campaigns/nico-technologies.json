        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "kendra.pilon@stryker.com",
          "hideComponent": "false",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">Securely locks in navigation pointers during placement</span></span></li>\n<li><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">Frosted outer sheath designed to visualize nearby anatomy and minimize light reflection</span></span></li>\n<li><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">Variable obturator lengths to reach shallow or deep subcortical abnormalities</span></span></li>\n<li><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">Two obturator diameters for trans-sulcal access, enabling bi-manual surgical technique</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Feb 17 2025 17:45:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
