    "largeheadline_copy_c_1758200598": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
      "jcr:created": "Tue Aug 13 2019 19:12:46 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"urw-egyptienne\"><span class=\"fontsize-2-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span class=\"fontsize-3vw\"><span class=\"fontsize-3-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Redefining </span></span><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">what's possible</span></span></span></span></span></span></span></span></span></span>",
      "line2": "<span class=\"fontsize-2vw\"><span class=\"urw-egyptienne\">Through new optical tracking options, sophisticated software algorithms and instrumentation, today's Q Guidance System aims to deliver more surgical planning and navigation capabilities.</span></span>",
      "jcr:lastModified": "Thu Apr 13 2023 14:40:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
      "gradientDirectionInverse": "true",
      "textIsRich": [
        "true",
        "true"
      ]
    },
    "text_6528099_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cathy.lapico@stryker.com",
      "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Thu Oct 13 2022 19:16:20 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">Features and benefits<sup>1</sup></span></span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Full-spectrum active/passive hybrid optical tracking</span></span><br>\n</li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Only guidance system with proprietary active technology</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Two PCs; Real-Time PC tracks patient data independent of operating system/apps on Application PC</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Two touch screen monitors for control inside/outside sterile field</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Seamless integration and auto registration with Airo TruCT</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Works with completely redesigned Cranial and Spinal software applications</span></span><ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Spine Guidance Software</span> is the first to receive FDA clearance for use with pediatric patients age 13 or older</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Cranial Guidance Software</span> offers optional modules such as navigated catheter placement via electromagnetic (EM) tracking and Precision Targeting System for brain biopsy</span></span></li>\n</ul>\n</li>\n</ul>\n",
      "jcr:lastModified": "Fri Apr 14 2023 18:13:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "leftMargin": "2",
      "bottomMargin": "3"
    },
