  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p><b>Redefining what’s possible</b></p>\r\n",
    "shortDescTop": "<p>In tandem with our Spine software application, today’s Q Guidance System provides groundbreaking surgical planning and guidance capabilities that are scalable for today and tomorrow.</p>\r\n<p> </p>\r\n<p><b>Features and benefits</b><sup>1</sup></p>\r\n",
    "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Thu Oct 13 2022 19:31:51 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Market-leading, full-spectrum active/passive hybrid optical tracking</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Only guidance system with proprietary active technology</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Two PCs; Real-Time PC tracks patient data independent of operating system/apps on Application PC</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Two GUI touch monitors for control inside/outside sterile field</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Completely redesigned Spine software with expanded capabilities and enhanced automatic and semi-automatic intelligent processing</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Gesture recognition (no-touch instrument validation/calibration and point digitization)</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Seamless integration and auto registration with Airo TruCT</p>\r\n",
        "textIsRich": "true"
      },
      "8": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Broad compatibility with various types of image sets</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
