pan class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">11</span></span></span></span><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">&nbsp;&nbsp;EM Field Generator Mounting Arm<br>\n &nbsp; &nbsp; &nbsp; &nbsp; and Instrument Adapter Box (optional<br>\n &nbsp; &nbsp; &nbsp; &nbsp; components for cranial software)</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: rgb(255, 181, 0);\"><span class=\"futura-bold\">12&nbsp;&nbsp;</span></span><span class=\"urw-egyptienne\">Castors with brakes and cable pushers</span></span></p>\n",
