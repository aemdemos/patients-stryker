          "jcr:created": "Tue Feb 25 2020 19:30:24 GMT+0000",
          "text": "<div style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-2-5em\">You<br>\n </span>&nbsp;</span></div>\n<ul>\n<li>Allows you to easily collect patient reported outcomes (PRO) data for analysis with no added burden to your team</li>\n<li>Gives you insight into your patients' experiences throughout the entire continuum of spinal care</li>\n<li>Enables you to make data-driven decisions</li>\n<li>Empowers you to enhance your patient experience</li>\n</ul>\n",
          "jcr:lastModified": "Wed Oct 28 2020 14:23:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
