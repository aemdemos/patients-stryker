            "jcr:created": "Tue Feb 25 2020 19:59:18 GMT+0000",
            "gradientDirection": "left-to-right",
            "text": "<p style=\"text-align: left;\"><span style=\"color: #ffffff;\"><br>\n <span class=\"futura-bold\"><span class=\"fontsize-2-5em\">&nbsp; BACS Assist<br>\n </span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">&nbsp; &nbsp; &nbsp; Clear surgical planning</span></span></span></p>\n",
            "jcr:lastModified": "Fri Apr 24 2020 16:19:22 GMT+0000",
