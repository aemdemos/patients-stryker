            "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
            "jcr:created": "Tue Feb 25 2020 20:01:04 GMT+0000",
            "gradientDirection": "left-to-right",
            "text": "<p><span style=\"color: #dfe1de;\"><span style=\"color: #ffffff;\">&nbsp;</span></span></p>\n<p><span style=\"color: #dfe1de;\"><span style=\"color: #ffb500;\"><span style=\"color: #ffffff;\"><span style=\"color: #dfe1de;\"><span style=\"color: #b2b4ae;\">We know that payer requirements vary significantly and change frequently. BACS Accelerate streamlines the entire pre-authorization process, providing you with an easy,&nbsp;always-up-to-date checklist of payer-specific and patient-specific requirements.</span></span></span></span><br>\n</span></p>\n<p style=\"margin-left: 40px;\"><span style=\"color: #dfe1de;\">&nbsp;</span></p>\n<p style=\"margin-left: 40px;\"><span style=\"color: #dfe1de;\"><span style=\"color: #000000;\"><span style=\"color: #ffffff;\"><span style=\"color: #dfe1de;\"><span style=\"color: #b2b4ae;\">- Navigate patient-specific and policy-specific requirements with an easy-to-use checklist</span></span></span></span></span></p>\n<p style=\"margin-left: 40px;\"><span style=\"color: #dfe1de;\"><span style=\"color: #ffb500;\"><span style=\"color: #ffffff;\"><span style=\"color: #dfe1de;\"><span style=\"color: #b2b4ae;\">- Designed to help reduce the likelihood of peer-to-peer reviews and last-minute cancellations</span></span></span></span></span></p>\n",
            "jcr:lastModified": "Fri Nov 20 2020 18:50:56 GMT+0000",
            "sling:resourceType": "stryker/components/content/text",
