            "gradientDirection": "left-to-right",
            "text": "<p style=\"text-align: left;\"><span style=\"color: #ffffff;\"><br>\n <span class=\"futura-bold\"><span class=\"fontsize-2-5em\">&nbsp; BACS Accelerate<br>\n </span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">&nbsp; &nbsp; &nbsp; To facilitate smooth and efficient pre-approvals</span></span></span></p>\n",
