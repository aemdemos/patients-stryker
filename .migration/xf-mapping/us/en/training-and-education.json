    "experiencefragment_569211075": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-5b105250fc@example.invalid",
      "jcr:lastModifiedBy": "user-5b105250fc@example.invalid",
      "jcr:created": "Sat Sep 11 2021 05:43:04 GMT+0000",
      "text": "Craniomaxillofacial This site provides craniomaxillofacial surgeons with educational programs that incorporate the latest clinical insights and advancements in procedural innovation. ENT This site provides surgeons, residents, and fellows with training opportunities to further their knowledge of Stryker’s ENT product portfolio and procedures. Interventional Spine This site provides healthcare professionals with an overview of our Medical Education programs and training opportunities focused on advancing knowledge of our extensive product portfolio, procedural techniques and clinical application. Joint Replacement This site provides Joint Replacement surgeons, residents, and fellows with training opportunities to further their knowledge of Stryker’s hip and knee product portfolio. Neurosurgical This site provides residents, fellows and practicing physicians with best in-class educational courses to advance surgical techniques in order to learn the safe and effective use of Neurosurgical devices. Neurovascular Stroke Knowledge Initiatives for Learning and Leadership (SKILL) is a series of innovative, tailored ischemic and hemorrhagic stroke education programs that support our customers’ need to address patient management challenges with the ultimate shared goal of improving lives. SKILL features an e-lab, NeuroElite fellows program, training center initiatives and global centers of excellence. Peripheral Vascular This site provides multidisciplinary healthcare professionals with educational programs and training opportunities focused on advancing knowledge of Stryker’s Peripheral Vascular portfolio, procedural techniques, and clinical application. Spine Sports Medicine This site provides Sports Medicine surgeons, residents, and fellows with training opportunities to further their knowledge of Stryker's Sports Medicine product portfolio and procedures. Surgical Technologies This site provides surgeons with educational programs incorporating the latest and most relevant clinical insights and procedural innovation. Surgical Visualization This site provides multidisciplinary healthcare professionals a peer-to-peer learning experience focused on the advancement of Fluorescence Guided Surgery. Content and surgical experience utilizing Stryker’s advanced visualization technology is shared by global thought-leaders. Trauma & Extremities This site provides Trauma, Upper Extremities and Foot & Ankle surgeons, residents, and fellows with training opportunities to further their knowledge of Stryker’s Trauma & Extremities product portfolio.",
      "jcr:lastModified": "Sat Sep 11 2021 05:44:29 GMT+0000",
      "sling:resourceType": "stryker/components/content/experienceFragment",
      "fragmentPath": "/content/experience-fragments/stryker/training-and-education/en/us/surgeons--residents-and-fellows/master",
      "edsFragmentPath": "/us/en/fragments/stryker/training-and-education/en/us/surgeons-residents-and-fellows/master"
    },
