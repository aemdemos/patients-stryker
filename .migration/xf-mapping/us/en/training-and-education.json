    "experiencefragment": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-5b105250fc@example.invalid",
      "jcr:lastModifiedBy": "user-5b105250fc@example.invalid",
      "jcr:created": "Sat Sep 11 2021 04:03:26 GMT+0000",
      "text": "Clinical education FocusRN is Stryker’s clinical education program, accessible through an online portal. This resource provides clinical education and tools to help you fulfill your education requirements and advance your knowledge to improve patient care. Interventional Spine This site provides Advanced Practice Providers (APPs) with an overview of our Medical Education offerings and resources designed specifically for APPs, including patient identification and imaging education. Joint Replacement - Mako in the OR A collection of educational content designed for OR staff using the Mako System. Watch videos and interact with modules to learn OR layouts, roles and responsibilities, Mako instrumentation, Mako System set-up and more for all three applications. Peripheral Vascular This site provides multidisciplinary healthcare professionals with educational programs and training opportunities focused on advancing knowledge of Stryker’s Peripheral Vascular portfolio, procedural techniques, and clinical application. Surgical Technologies This site provides nurses and operating room staff with meaningful learning experiences that ultimately keep our caregivers safe and improve patient outcomes.",
      "jcr:lastModified": "Fri Oct 15 2021 17:15:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/experienceFragment",
      "fragmentPath": "/content/experience-fragments/stryker/training-and-education/en/us/nurses-and-physician-assistants/master",
      "edsFragmentPath": "/us/en/fragments/stryker/training-and-education/en/us/nurses-and-physician-assistants/master"
    },
