  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Abbott/St. Jude Medical Reprocessed ViewFlex Xtra ICE Catheter</p>\r\n",
    "shortDescTop": "<p>The ViewFlex is a 2D ICE catheter providing direct visualization of the pulmonary veins and other anatomical landmarks. The ViewFlex is inserted into the heart via intravascular access.</p>\r\n",
    "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
    "hideComponent": "false",
    "jcr:lastModified": "Thu Nov 10 2022 14:45:55 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>9F ICE catheter compatible with a 10F or larger introducer Sheath</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Compatible with ViewMate II, ViewMate Z and Philips CX50 ultrasound consoles</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Ergonomic handle</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Four-way tip deflection-anterior/posterior and left/right</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Catheter tip is a 64-element linear phased array transducer housed in silicone</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fully reprocessed, 100% function tested, cleaned and tracked</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Device can be reprocessed one time</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
