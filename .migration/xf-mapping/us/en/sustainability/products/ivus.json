      "jcr:lastModifiedBy": "morgan.harder@stryker.com",
      "imageAlt": "eagle eye ivus catheter",
      "jcr:created": "Wed Jan 29 2025 21:14:08 GMT+0000",
      "headColor": "rgb(255,181,0)",
      "head": "<p><b>Reprocessed Philips Eagle Eye Platinum Rx Digital IVUS Catheters</b></p>\r\n",
      "content": "Expertly reprocessed by Stryker’s Sustainability Solutions (SSS), our Philips Eagle Eye Platinum Rx Digital IVUS Catheters and Philips Visions PV IVUS Catheters help deliver high-quality imaging while supporting a more sustainable approach to intravascular ultrasound (IVUS) procedures.<sup>1</p>\r\n\r\nThese Philips catheters are available in four configurations to meet diverse clinical needs.\r\n\r\n<br><br>\r\nChoose the configuration that best fits your procedural requirements and experience the benefits of a reliable, environmentally conscious option for IVUS.<sup>3\r\n",
      "jcr:lastModified": "Tue Sep 02 2025 04:00:15 GMT+0000",
      "compImageRef": "/content/dam/stryker/sustainability/images/IVUS webpage us.png",
      "sling:resourceType": "stryker/components/content/hero",
