  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Biosense Webster Reprocessed ACUSON AcuNav Ultrasound ICE Catheter</p>\r\n",
    "shortDescTop": "<p>The AcuNav ICE catheter’s transducer transmits ultrasound waves that are reflected by cardiac tissue back to a receiver; high-resolution 2D grayscale and Doppler models. The catheter is intended for intracardiac and intraluminal visualization of cardiac and great vessel anatomy and physiology as well as visualization of other devices in the heart.</p>\r\n",
    "jcr:lastModifiedBy": "morgan.harder@stryker.com",
    "hideComponent": "false",
    "jcr:lastModified": "Wed Aug 28 2024 21:00:00 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "shortDescBottom": "<p>Listed below are the SKUs that SSS reprocesses.</p>\r\n",
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Typically found in EP labs and Cath labs</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Able to connect to General Electric and Siemens consoles</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Available in 8F and 10F sizes</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fully reprocessed 100% function tested, cleaned and tracked</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Device can be reprocessed four time</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
