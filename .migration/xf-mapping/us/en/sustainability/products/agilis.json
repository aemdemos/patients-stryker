  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Abbott/St. Jude Medical Reprocessed Agilis Catheter Introducer Sheath</p>\r\n",
    "shortDescTop": "<p>The Sheath helps grant access to hard-to-reach sites and enhances clinical capability for transseptal puncture, mapping of the heart and therapeutic ablation in the left atrium or ventricle.</p>\r\n",
    "jcr:lastModifiedBy": "morgan.harder@stryker.com",
    "hideComponent": "false",
    "jcr:lastModified": "Wed Jul 26 2023 20:50:22 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
