    "cols2_copy_175606443": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "brittany.brady@stryker.com",
      "jcr:lastModifiedBy": "brittany.brady@stryker.com",
      "jcr:created": "Wed Oct 20 2021 20:21:50 GMT+0000",
      "jcr:lastModified": "Wed Oct 20 2021 20:21:50 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "topPadding": "3",
          "jcr:lastModifiedBy": "morgan.harder@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Every device. Every time.</span><span class=\"fontsize-1-75em\"></span></span></h2>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">All reprocessed devices are 100% function tested, including in-line testing and multi-point inspection.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Before being sent back to you, all reprocessed devices undergo thorough verifications.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Stryker's Sustainability Solutions devices have a 99.96% success rate<sup>1</sup>.</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Dec 01 2023 22:11:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true",
          "leftMargin": "3"
        }
      },
