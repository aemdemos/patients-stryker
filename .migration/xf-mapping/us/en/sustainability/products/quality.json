      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "leftPadding": "3",
          "topPadding": "3",
          "jcr:lastModifiedBy": "morgan.harder@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Patient outcomes</span></span></h2>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">For the last 22 years, SSS has partnered with clinicians to build out a reprocessing program with patient outcomes at the forefront.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">As part of the 510(k) submission, SSS submits extensive cleaning, performance, and sterilization data for their independent review before reprocessed SUDs can be legally marketed.&nbsp;</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">According to a Banner Health study, original manufactured bipolar and ultrasound diathermy devices are reported as defective 4.9 times more frequently than reprocessed devices<sup>2</sup>.&nbsp;</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Dec 01 2023 22:12:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        }
      }
    },
