          "topPadding": "3",
          "jcr:lastModifiedBy": "morgan.harder@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Sustainably designed&nbsp;</span></span></h2>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Redesigned for Sustainability is our commitment to deliver exceptional products that have less impact on the environment.&nbsp;</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Optimized manufacturing, packaing and replacement components all play a role in reprocessing sustainability.&nbsp;</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">SSS has two product linges that are part of Redesigned for Sustainability; MyoSure™ and LigaSure™.&nbsp;</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Dec 01 2023 21:48:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true",
