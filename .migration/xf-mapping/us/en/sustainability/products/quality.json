          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "largeheadline": {
              "jcr:primaryType": "nt:unstructured",
              "bottomPadding": "5",
              "jcr:createdBy": "brittany.brady@stryker.com",
              "topPadding": "5",
              "jcr:lastModifiedBy": "morgan.harder@stryker.com",
              "jcr:created": "Tue Nov 16 2021 18:21:48 GMT+0000",
              "gradientDirection": "left-to-right",
              "line2": "<p><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span class=\"futura-bold\">At Stryker's Sustainability Solutions (SSS),</span><span class=\"urw-egyptienne\"> we&nbsp;</span>reprocess more single-use medical devices than any other provider—always striving for the highest quality and performance&nbsp;standards.&nbsp;We’ve&nbsp;helped over 3,000 customers save approximately $1 billion through reprocessing programs and divert over 26 million pounds of waste from landfills.</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\">&nbsp;</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\">Driven by our shared ambition, we help improve healthcare through innovation—from manufacturing to collections and every step&nbsp;beyond. Every device we reprocess is individually&nbsp;inspected to ensure it meets Stryker's quality and performance standards.</span></span></p>\r\n",
              "jcr:lastModified": "Thu Feb 08 2024 22:49:35 GMT+0000",
              "sling:resourceType": "stryker/components/content/largeheadline",
              "backgroundColor": "rgba(255,255,255,0)",
              "textIsRich": [
                "true",
                "true"
              ]
            }
          }
        }
      }
    },
