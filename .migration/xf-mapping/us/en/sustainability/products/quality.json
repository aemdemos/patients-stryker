      "jcr:created": "Wed Oct 20 2021 20:22:06 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><b><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-4vw\">QUALITY YOU CAN COUNT ON</span></span></span></b></h2>\r\n<h2> </h2>\r\n",
      "jcr:lastModified": "Thu Nov 30 2023 16:57:11 GMT+0000",
