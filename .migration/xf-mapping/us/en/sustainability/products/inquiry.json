      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fixed curve Inquiry catheters come in 4F, 5F and 6F sizes</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Steerable Inquiry catheters come in 4F, 5F, 6F and 7F sizes</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fully reprocessed, 100% function tested, cleaned and tracked</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Device can be reprocessed four times</p>\r\n",
        "textIsRich": "true"
      }
