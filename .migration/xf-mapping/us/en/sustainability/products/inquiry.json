    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Irvine Biomedical Inc. reprocessed Inquiry EP catheter</p>\r\n",
    "shortDescTop": "<p>The Inquiry EP catheter is used to perform standard electrophysiology procedures by applying pacing and recording protocols from inside the heart to determine electrical properties of the atrium and the ventricle.</p>\r\n",
