        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "7",
          "jcr:created": "Mon Jan 26 2026 23:01:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Help address patient injury risk factors</span></span></h2>\n",
          "jcr:lastModified": "Wed Mar 04 2026 18:19:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "2"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "topPadding": "3",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Jan 26 2026 23:05:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">The polyurethane (PUR) material is air filled, not water filled, which makes&nbsp;it lighter weight.<sup>3&nbsp;</sup>The unique dumbbell design provides adaptability to anatomical structures<sup>3</sup> and reduced stool leakage.<sup>4</sup> Diverting stool away from the skin can help keep the skin dry, helping to address a risk factor of incontinence-associated dermatitis (IAD),<sup>5</sup> hospital-acquired pressure injuries (HAPI)<sup>6</sup> and spread of C. difficile infection associated with acute fecal incontinence.<sup>7</sup></span></p>\n",
          "jcr:lastModified": "Mon Feb 23 2026 20:04:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_223799220": {
      "jcr:primaryType": "nt:unstructured",
