          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "7",
          "jcr:created": "Mon Jan 26 2026 23:01:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Impacting nursing workflow&nbsp;</span></span></h2>\n",
          "jcr:lastModified": "Thu Feb 05 2026 15:44:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "2"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "topPadding": "3",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Jan 27 2026 15:24:22 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">The hygh-tec drainage has demonstrated reduced stool leakage<sup>4</sup> compared to other fecal management systems (FMS).<sup>2</sup>* This reduced stool leakage can help support improved patient outcomes and more efficient workflows in the critical care setting.<sup>8</sup></span></p>\n",
          "jcr:lastModified": "Wed Mar 04 2026 18:19:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
