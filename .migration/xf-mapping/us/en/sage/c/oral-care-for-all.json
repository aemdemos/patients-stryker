      "hideSectionTitleComp": "true",
      "jcr:created": "Wed Mar 01 2023 18:04:03 GMT+0000",
      "title": "Guidelines",
      "jcr:lastModified": "Thu Mar 09 2023 19:52:06 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title"
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "1",
      "jcr:createdBy": "errin.pace@stryker.com",
      "jcr:lastModifiedBy": "errin.pace@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Wed Mar 01 2023 19:15:41 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-75em\">NV-HAP prevention guidelines</span></h2>\n",
      "jcr:lastModified": "Tue Mar 21 2023 14:11:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "errin.pace@stryker.com",
      "jcr:lastModifiedBy": "errin.pace@stryker.com",
      "jcr:created": "Thu Mar 09 2023 23:27:00 GMT+0000",
      "jcr:lastModified": "Thu Mar 09 2023 23:27:00 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_2079617127": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "errin.pace@stryker.com",
          "leftPadding": "2",
          "topPadding": "4",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Thu Mar 09 2023 23:47:01 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">ADA evidenced-based protocol<sup>7</sup></span></h3>\n",
          "jcr:lastModified": "Tue Mar 21 2023 14:14:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "2",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "errin.pace@stryker.com",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Mar 01 2023 19:15:41 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\">Brush two - four times a day</span></li>\n<li><span class=\"fontsize-1-5em\">Use a soft-bristled toothbrush<br>\n </span></li>\n<li><span class=\"fontsize-1-5em\">Use plaque-removing toothpaste</span></li>\n<li><span class=\"fontsize-1-5em\">Use sodium bicarbonate</span></li>\n<li><span class=\"fontsize-1-5em\">Use a non petroleum-based moisturizer</span></li>\n</ul>\n<h4>Dependent patients</h4>\n<ul>\n<li><span class=\"fontsize-1-5em\">Use 24-hour suction toothbrush kits for high aspiration-risk patients</span></li>\n<li><span class=\"fontsize-1-5em\">Use a soft-bristled toothbrush</span></li>\n</ul>\n<h4>Edentulate patients (2 times a day)</h4>\n<ul>\n<li><span class=\"fontsize-1-5em\">For patients with dentures, remove and soak dentures</span></li>\n<li><span class=\"fontsize-1-5em\">Brush gums and mouth</span></li>\n<li><span class=\"fontsize-1-5em\">Prevent patients from sleeping with dentures in place</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Mar 21 2023 14:29:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(237,238,236,1)",
          "textIsRich": "true",
          "bottomMargin": "6"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "errin.pace@stryker.com",
          "leftPadding": "2",
          "topPadding": "4",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Thu Mar 09 2023 23:47:01 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">AACN guideline recommendations<sup>8</sup></span></h3>\n",
          "jcr:lastModified": "Tue Mar 21 2023 14:15:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "2",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "12",
          "jcr:createdBy": "errin.pace@stryker.com",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Mar 01 2023 19:15:41 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\">Brush four times a day (after each meal, before bedtime)<br>\n </span></li>\n<li><span class=\"fontsize-1-5em\">Use a soft-bristled toothbrush</span></li>\n<li><span class=\"fontsize-1-5em\">Use an alcohol-free antiseptic oral rinse</span></li>\n<li><span class=\"fontsize-1-5em\">Use non petroleum-based moisturizer</span></li>\n<li><span class=\"fontsize-1-5em\">Use therapeutic toothpaste</span></li>\n</ul>\n<h4>Dependent patients</h4>\n<ul>\n<li><span class=\"fontsize-1-5em\">Brush with a suction toothbrush</span></li>\n</ul>\n<h4>Edentulate patients</h4>\n<ul>\n<li><span class=\"fontsize-1-5em\">If no teeth or dentures, gently brush gums, tongue four times a day</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Mar 10 2023 19:38:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(237,238,236,1)",
          "textIsRich": "true"
        }
      }
    },
