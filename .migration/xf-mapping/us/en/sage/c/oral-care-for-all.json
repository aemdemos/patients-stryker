          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text_573941890": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "errin.pace@stryker.com",
              "topPadding": "16",
              "jcr:lastModifiedBy": "errin.pace@stryker.com",
              "hideComponent": "false",
              "jcr:created": "Wed Mar 01 2023 19:17:51 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h2><span class=\"fontsize-1-75em\"><span style=\"color: #ffffff;\">Sage Self Oral Care can help you </span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">reduce the risk of pneumonia</span></span></span></h2>\n",
              "jcr:lastModified": "Tue Mar 21 2023 14:08:46 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            },
            "text_573941890_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "errin.pace@stryker.com",
              "jcr:lastModifiedBy": "errin.pace@stryker.com",
              "jcr:created": "Wed Mar 01 2023 19:17:51 GMT+0000",
              "text": "<p><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\">The all-in-one, single-use system provides thorough oral care at the bedside and doesn’t require nurse assistance to use.</span></span><br>\n</p>\n",
              "jcr:lastModified": "Tue Mar 21 2023 14:07:30 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        }
      }
    },
    "section_title_1782723020": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "errin.pace@stryker.com",
