      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "michelle.chow@stryker.com",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Mar 01 2022 19:51:55 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Pneumonia is the #1<br>\n</span></span>hospital-acquired infection (HAI)<sup>1</sup></span></h2>\n",
          "jcr:lastModified": "Thu Mar 09 2023 18:44:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_911362462_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "michelle.chow@stryker.com",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Mar 01 2022 19:54:47 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\">It happens far too often. A patient enters the hospital and develops pneumonia. The stats don’t lie - pneumonia is the most common hospital-acquired infection (HAI).<sup>1</sup> The risk is real and not just for ventilated or elderly patients in the ICU. Pneumonia can strike patients in every unit of the hospital. It’s estimated that one in every 100 patients will be affected by non-ventilator hospital-acquired pneumonia (NV-HAP).<sup>2</sup></span></p>\n<p><span class=\"fontsize-1-5em\">In a multistate prevalence study, <b>65% of hospital-acquired pneumonia was non-ventilator associated pneumonia (NV-HAP)</b>.<sup>3</sup></span><br>\n</p>\n",
          "jcr:lastModified": "Tue Mar 28 2023 19:08:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2_3_1_3_82943686": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "errin.pace@stryker.com",
      "jcr:lastModifiedBy": "errin.pace@stryker.com",
      "jcr:created": "Tue Mar 28 2023 18:54:11 GMT+0000",
      "jcr:lastModified": "Tue Mar 28 2023 18:54:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "errin.pace@stryker.com",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "hideComponent": "false",
          "topMargin": "-10",
          "jcr:created": "Tue Mar 28 2023 18:54:19 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h4><span class=\"fontsize-1-5em\">Why it matters</span></h4>\n<p><span class=\"fontsize-1-5em\">Your hospital can take action to prevent NV-HAP while improving the quality of care and patient safety, lowering the risk of sepsis, reducing health care costs, and saving lives.<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Tue Mar 28 2023 18:56:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
