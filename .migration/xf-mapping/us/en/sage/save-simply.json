          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "jcr:created": "Fri Mar 26 2021 19:22:19 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span style=\"color: #1c5687;\"><span style=\"color: #4c7d7a;\">Sage Prevalon Mobile Air Transfer System (MATS)</span></span></span></span></p>\n<p><span style=\"color: #000000;\"><span style=\"color: #000000;\"><span class=\"standalone-link\"><span class=\"fontsize-1-25em\">MATS uses a cushion of air to help laterally transfer your patient with significantly less exertion and without the need for lifting. It simultaneously inflates and cradles your patient to keep them comfortable and properly positioned. The system can remain with your patients and provide transfer assistance throughout their hospital stay.</span></span></span></span></p>\n<p><span class=\"standalone-link\"><a title=\"Learn more about Sage Prevalon Mobile Air Transfer System (MATS).\" href=\"/content/stryker/us/en/sage/products/sage-mats.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Wed Mar 29 2023 16:05:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
