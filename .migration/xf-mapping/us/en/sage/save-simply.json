    "cols2_2_3_1_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kelley.may@stryker.com",
      "jcr:lastModifiedBy": "kelley.may@stryker.com",
      "jcr:created": "Fri Mar 26 2021 19:20:11 GMT+0000",
      "jcr:lastModified": "Fri Mar 26 2021 19:20:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kelley.may@stryker.com",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "jcr:created": "Fri Mar 26 2021 19:20:16 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #1c5687;\"><span style=\"color: #4c7d7a;\">About Save Simply</span></span></span></span></p>\n<p><span class=\"standalone-link\"><span class=\"fontsize-1-25em\">Health systems currently purchasing MATS and engaged in the Save Simply program are able to purchase new and reprocessed MATS for one low price.</span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #1c5687;\"><span class=\"fontsize-2em\"><span style=\"color: #4c7d7a;\">Going beyond reprocessing to reduce our carbon footprint</span></span></span></span></p>\n<p><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">The Save Simply program does more than reprocess Prevalon Mobile Air Transfer Systems (MATS). As part of our environmental commitment, we are proud to work with a waste-to-energy organization that diverts waste from landfills and is converted into electricity.</span></span></p>\n<p><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">The National Forest Foundation (NFF) provides hospitals with an opportunity to help restore our National Forests. Trees are planted based on annual hospital reprocessing collection goals. The NFF plants the trees in areas that have the most need, based on environmental concerns.</span></span></p>\n",
          "jcr:lastModified": "Wed Mar 29 2023 15:50:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
