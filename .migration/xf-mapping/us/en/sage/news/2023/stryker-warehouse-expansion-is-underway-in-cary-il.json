      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Aug 15 2023 17:52:40 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">The expansion will add <span style=\"color: #85458a;\">100,000 sqft</span> and increase storage capacity 40%</span></span></h2>\n<p><span class=\"fontsize-1-5em\">The past few months have seen a lot of new activity on Three Oaks Road, as Stryker expands its warehouse facility to meet the increasing demand for its innovative medical devices and solutions.</span></p>\n<p><span class=\"fontsize-1-5em\">Joe Gray, Associate Manager, Logistics Management at Stryker states, “The goal of this project is to increase our storage capacity as we continue to grow our business and provide support to healthcare providers and patients. Our current projections have the warehouse being completed by the end of November. This will provide us with 40% more on-site storage capacity.”</span></p>\n",
          "jcr:lastModified": "Tue Aug 15 2023 17:53:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "text_620400978": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Tue Aug 15 2023 18:07:38 GMT+0000",
      "text": "<p><span class=\"fontsize-1-5em\">This significant increase in capacity will help streamline operations, allowing Stryker to maintain optimal inventory levels. In addition to storage space, the expansion will further Stryker’s sustainability efforts.&nbsp;&nbsp;</span><br>\n</p>\n<p><span class=\"fontsize-1-5em\">&quot;We’re excited about the opportunity to make an environmental impact in our community,” said Rick Ulreich, Senior Manager, Facilities &amp; EHS Facilities at Stryker. “Our commitment to sustainability for this project includes the installation of LED lighting and the addition of four electric car charging stations. We’re also converting the existing lawn to no-mow prairie grass (750,000 sq ft) and installing over 200 bushes.”&nbsp; &nbsp;</span></p>\n<p><span class=\"fontsize-1-5em\">Stryker remains committed to advancing medical technology and delivering innovative solutions that improve patient care. The expansion of the Cary warehouse facility underscores Stryker's dedication to meeting the needs of healthcare providers and their patients, solidifying its position as a global leader in the medical technology industry.&nbsp;</span></p>\n",
      "jcr:lastModified": "Tue Aug 15 2023 18:08:42 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    }
  },
