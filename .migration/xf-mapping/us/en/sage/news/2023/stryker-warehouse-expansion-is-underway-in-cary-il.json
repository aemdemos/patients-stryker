          "alt": "Stryker's new warehouse facility in Cary, IL",
          "srcFileRef": "/content/dam/stryker/sage/news/2023/SAGE-GSNPS-COMM-739997_REV-0_en_us Website Image.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Aug 15 2023 19:24:41 GMT+0000",
