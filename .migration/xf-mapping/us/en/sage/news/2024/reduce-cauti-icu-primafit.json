      "alt": "Nurse holding a PrimaFit external catheter for urine management",
      "srcFileRef": "/content/dam/stryker/sage/news/2024/um-whitepaper-header-2024.png",
      "borderColor": "rgba(76,125,122,1)",
      "jcr:lastModified": "Mon Dec 09 2024 16:26:38 GMT+0000",
      "sling:resourceType": "stryker/components/content/standaloneimage",
