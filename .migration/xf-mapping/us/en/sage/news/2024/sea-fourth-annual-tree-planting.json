      "jcr:created": "Wed Nov 27 2024 14:28:01 GMT+0000",
      "jcr:lastModified": "Wed Nov 27 2024 14:28:01 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
