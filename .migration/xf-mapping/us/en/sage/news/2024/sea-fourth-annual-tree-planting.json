          "srcFileRef": "/content/dam/stryker/sage/news/2024/2024-sea-tree.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Nov 27 2024 14:27:12 GMT+0000",
