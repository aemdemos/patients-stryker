          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "topMargin": "4",
          "jcr:created": "Wed Nov 27 2024 14:20:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">Digging deep: Planting trees and building a legacy&nbsp;</span></h3>\n<p><span class=\"fontsize-1-25em\">This year, the SEA team of over 25 participants planted 200 red, white, and bur oak trees, along with hazelnut bushes, to restore the former farmland. These species have proven to thrive together and contribute to the ecological balance of the area. While the physical act of planting trees is rewarding, the event is also an educational experience. The MCCD staff provided insight into the history of the site and the significance of these native species in the local ecosystem. With the oak trees becoming increasingly scarce in McHenry County, this project is critical in restoring a natural habitat that will support local wildlife and improve the overall health of the land.</span></p>\n",
          "jcr:lastModified": "Wed Nov 27 2024 14:31:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2_3_1_3": {
      "jcr:primaryType": "nt:unstructured",
