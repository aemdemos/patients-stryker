      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "jcr:created": "Wed Nov 27 2024 14:27:40 GMT+0000",
      "jcr:lastModified": "Wed Nov 27 2024 14:27:40 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
