      "srcFileRef": "/content/dam/stryker/sage/news/2025/infectino-prevention-newsroom-banner.jpg",
      "borderColor": "rgba(76,125,122,1)",
      "jcr:lastModified": "Mon Oct 06 2025 16:16:30 GMT+0000",
