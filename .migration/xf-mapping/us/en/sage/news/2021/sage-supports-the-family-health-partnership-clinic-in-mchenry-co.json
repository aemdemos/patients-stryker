  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "kelley.may@stryker.com",
    "hideComponent": "false",
    "gradientDirection": "left-to-right",
    "text": "<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Raising funds and awareness at the Care4Breast Cancer 5K</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"standalone-link\">The Care4Breast Cancer 5K celebrated its 21st year of raising critical funds for Family Health Partnership Clinic on Sunday, October 17 at Woodstock North High School. The FHPC is a nonprofit organization dedicated to providing quality healthcare to the uninsured men and women of McHenry County. All of the proceeds from the Care4 race benefit FHPC and stay here, in McHenry County, to take care of our neighbors in need.</span></span><br>\n</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Helping our neighbors</span></span></span></p>\n<p><span class=\"standalone-link\"><span class=\"fontsize-1-25em\">Everyone who participated had a great time because it’s not about who has the best finish time, it’s that we’re coming together to help our community. The funds raised from this race help ensure that the uninsured men and women of McHenry County have access to breast cancer screenings, early diagnosis and treatment, education and other women's health services. Early diagnosis is a key to survival and without health insurance, early detection may not happen.</span></span></p>\n",
    "jcr:lastModified": "Fri Oct 22 2021 17:39:17 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
