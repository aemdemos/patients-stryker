  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "user-c8b824f5b1@example.invalid",
    "text": "<p><span class=\"standalone-link\"><span class=\"fontsize-1-25em\">On Thursday, September 16, the Joint Commission released a statement about its new Quick Safety advisory, “Preventing non-ventilator hospital-acquired pneumonia.”</span></span></p>\n<p><span class=\"standalone-link\"><span class=\"fontsize-1-25em\">One in 100 hospitalized patients is diagnosed with non-ventilator hospital-acquired pneumonia (NV-HAP) yearly, yet there is no national tracking system. The new Quick Safety advisory calls for a national conversation on prevention and safety actions.</span></span></p>\n",
    "jcr:lastModified": "Fri Oct 29 2021 18:51:23 GMT+0000",
