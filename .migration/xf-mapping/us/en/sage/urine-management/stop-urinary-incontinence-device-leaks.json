          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Mon Aug 26 2024 14:42:33 GMT+0000",
          "text": "It's time for a change The Sage PrimaFit External Urine Management for the Female Anatomy is a great fit for your patients and your hospital. It’s designed to help improve efficiency and reduce costs as well as address the #1 CAUTI risk factor – the indwelling catheter.2 73% CAUTI rate reduction3 For adolescent and adult patients with female anatomy4 Performs up to 24 hours4 20% estimated average savings with PrimaFit5 17 to 1 CAUTI reduction in a 150-bed facility6",
          "jcr:lastModified": "Mon Aug 26 2024 14:42:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/sage/en/campaigns/urine_management/stop_leaks/time-for-change/master",
          "edsFragmentPath": "/us/en/fragments/stryker/sage/en/campaigns/urine-management/stop-leaks/time-for-change/master"
        }
      }
