          "hideComponent": "false",
          "topMargin": "5",
          "jcr:created": "Mon Aug 26 2024 14:19:54 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Your patients need a better solution</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Catheter-associated urinary tract infections (CAUTIs) pose a threat to patient safety, often leading to complications like sepsis, prolonged hospital stays and increased healthcare costs.<sup>1</sup> Traditional indwelling catheters can cause discomfort, skin injury and infection. Many other external female catheter devices are universally designed, aren’t approved for use on adolescents and most need to be replaced several times a day.</span></p>\n",
          "jcr:lastModified": "Mon Sep 23 2024 16:48:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_2060709371": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "topMargin": "3",
          "jcr:created": "Fri Dec 13 2024 14:41:43 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: left;\"><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">No catheter.</span> <span class=\"futura-bold\"><span style=\"color: #ffb500;\">No CAUTI.</span></span></span></p>\n",
          "jcr:lastModified": "Wed Jun 03 2026 16:32:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
