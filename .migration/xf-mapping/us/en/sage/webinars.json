      "text": "<p><a href=\"/content/stryker/us/en/training-and-education/medical-and-surgical-equipment--/sage/focusrn/upcoming-events.html\"><span class=\"standalone-link\"><span class=\"fontsize-1-25em\">Register for the upcoming FocusRN webinar</span></span></a></p>\n",
      "jcr:lastModified": "Mon Apr 07 2025 21:14:42 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
