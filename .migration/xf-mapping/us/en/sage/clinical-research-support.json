          "hideComponent": "false",
          "jcr:created": "Tue Apr 26 2022 14:51:45 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\">Pressure injury prevention</span></li>\n<li><span class=\"fontsize-1-5em\">Surgical site infection (SSI) prevention</span></li>\n<li><span class=\"fontsize-1-5em\">Comprehensive oral care</span></li>\n<li><span class=\"fontsize-1-5em\">Early patient mobility</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Mar 19 2025 20:38:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-98fdffe29c@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 26 2022 14:51:45 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\">Safe patient handling/injury prevention</span></li>\n<li><span class=\"fontsize-1-5em\">Hospital-acquired infections (HAIs)</span></li>\n<li><span class=\"fontsize-1-5em\">Urine management</span></li>\n<li><span class=\"fontsize-1-5em\">Targeted temperature management</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Mar 31 2025 19:50:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols_721202103": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
