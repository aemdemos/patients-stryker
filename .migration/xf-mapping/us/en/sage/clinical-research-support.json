      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-98fdffe29c@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 26 2022 14:51:45 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>Proposals may be initiated by submitting the Investigator-Initiated Studies Request for Support Form (IISRSF) below. After submission, you may be contacted by a Clinical Affairs team member to collect additional information or questions. Your proposal will then undergo formal review, and Clinical Affairs will notify you of the support decision.</p>\n",
          "jcr:lastModified": "Wed Mar 19 2025 20:38:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "topPadding": "3",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Mar 19 2025 20:32:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">For further information regarding our process, please contact us:</span>&nbsp;<span class=\"urw-egyptienne\"><a href=\"mailto:clinres@stryker.com\">clinres@stryker.com</a></span></span></p>\n",
          "jcr:lastModified": "Mon Mar 31 2025 19:50:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,0)",
