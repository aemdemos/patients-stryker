      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning.html\">Patient&nbsp;positioning</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning/heel-protection.html\">Heel protection</a></p>\n",
          "jcr:lastModified": "Wed Nov 29 2023 15:20:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "jcr:created": "Tue Feb 27 2024 15:51:49 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Patients in surgeries lasting longer than three hours are at an increased risk for pressure injury.<sup>1</sup> The Sage heel protector OR completely elevates the heels from the OR surface while securing the legs during procedures in the supine position.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Knee cushion helps maintain recommended knee flexion throughout surgery</span></li>\n<li><span class=\"fontsize-1-25em\">Calf cradles completely elevate the heels and distribute pressure over the lower leg without creating undue pressure on the Achilles tendon</span></li>\n<li><span class=\"fontsize-1-25em\">Side rail straps and calf cradle connector strap help prevent legs from migrating off the OR table</span></li>\n<li><span class=\"fontsize-1-25em\">Sequential Compression Device (SCD) compatible</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Mar 01 2024 15:48:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
