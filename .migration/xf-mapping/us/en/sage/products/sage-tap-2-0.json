          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning.html\">Patient&nbsp;positioning</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning/turning-and-positioning.html\">Turning and positioning</a></p>\n",
          "jcr:lastModified": "Wed Dec 11 2024 20:25:36 GMT+0000",
