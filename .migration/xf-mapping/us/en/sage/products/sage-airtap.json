        "experiencefragment": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Jul 18 2025 16:00:05 GMT+0000",
          "text": "Did you know? 2.5 million patients develop pressure injuries in acute care facilities each year2 $26.8 billion in estimated annual costs due to pressure injuries each year2 80% of healthcare workers report working with pain or injury3 Registered nurses rank in the top 10 occupations at highest risk for work-related musculoskeletal injuries in the U.S.4 An article for ergonomic guidlines found workers’ compensation claims cost an estimated $40,400 for low back injuries and $51,800 for shoulder injuries5 We’re committed to actively partnering with your facility to reduce the risk of patient handling injuries and improving outcomes. Our Journey to Zero program can help create a culture of safety that benefits your patients, nurses, and your organization. Let’s start the journey to zero – together. Learn more",
          "jcr:lastModified": "Fri Jul 18 2025 16:46:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/sage/en/products/prevalon_airtap/did-you-know/master",
          "edsFragmentPath": "/us/en/fragments/stryker/sage/en/products/prevalon-airtap/did-you-know/master"
        }
      }
    },
