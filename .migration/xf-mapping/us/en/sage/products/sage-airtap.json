      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "4",
          "jcr:created": "Wed Jul 31 2024 17:22:56 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">This system offloads the sacrum, minimizes friction and shear, and manages moisture. Unlike lift slings and plastic slide sheets, the system stays under your patients throughout their hospital stay, so it’s always ready to use. This helps you safely achieve compliance to turning protocols while reducing strain on your hands, wrists, shoulders, and back.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Anchor Wedge System offloads the sacrum, minimizes patient migration down the bed, and reduces the need for boosting</span></li>\n<li><span class=\"fontsize-1-25em\">M² Microclimate Body Pad effectively absorbs and locks in moisture to protect patient’s skin while allowing air to flow through</span></li>\n<li><span class=\"fontsize-1-25em\">Inflatable Glide Sheet with hi-tech fabric promotes a healthy microclimate for the skin and is compatible with low air loss technology</span></li>\n<li><span class=\"fontsize-1-25em\">Tapered Design ensures patient’s head maintains neutral position while inflated</span></li>\n<li><span class=\"fontsize-1-25em\">Point of Care Switch is connected to the Sage Air Pump and integrated into the workflow to improve efficiency</span></li>\n<li><span class=\"fontsize-1-25em\">Easy Roll Handles encourage proper posture for healthcare workers</span></li>\n<li><span class=\"fontsize-1-25em\">Quick Connect Valve provides an easy, secure connection and a quick release</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Jul 28 2025 14:56:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
