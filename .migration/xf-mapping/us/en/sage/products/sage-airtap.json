    },
    "accordion_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Fri Aug 02 2024 15:40:48 GMT+0000",
      "jcr:lastModified": "Mon Jun 02 2025 20:00:58 GMT+0000",
      "sling:resourceType": "stryker/components/content/accordion",
      "accordion_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Aug 02 2024 15:41:39 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The weight capacity of AirTAP is 550 pounds.&nbsp;</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:00:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Aug 02 2024 15:41:47 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Based on clinician feedback, Stryker intentionally designed a non-full-length glide sheet to allow room for boosting with air-assisted technology and reduce bunching.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:00:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordionsGrid": {
        "jcr:primaryType": "nt:unstructured",
        "1": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "1",
          "accTitle": "What is the weight capacity of AirTAP?  "
        },
        "2": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "2",
          "accTitle": "Why is the AirTAP glide sheet 55 inches long? "
        },
        "3": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 3,
          "accTitle": "Can AirTAP be left under a patient in bed?  "
        },
        "4": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 4,
          "accTitle": "How should the wedges be placed? "
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The AirTAP glide sheet is breathable, low air loss and imaging compatible. It is designed to remain underneath the patient while they are in the facility.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jul 28 2025 14:44:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The wedges can be inserted while the glide sheet is fully inflated and should be positioned approximately one hand-width above and below the sacrum.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:01:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
