      "jcr:created": "Tue Nov 16 2021 19:26:23 GMT+0000",
      "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">FAQs</span></span></span></h3>\n",
      "jcr:lastModified": "Thu Mar 14 2024 17:33:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
