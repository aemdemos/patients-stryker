          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Help make lateral transfers safer for caregivers</span></span></h2>\n",
          "jcr:lastModified": "Wed Sep 11 2024 18:10:22 GMT+0000",
