          "jcr:created": "Wed Sep 11 2024 18:03:11 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">$37,000</span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">Average direct cost associated with an occupational back injury of a healthcare worker<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Fri Jul 18 2025 15:50:41 GMT+0000",
