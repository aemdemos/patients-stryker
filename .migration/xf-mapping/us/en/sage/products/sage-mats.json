      "jcr:created": "Tue Nov 16 2021 19:26:23 GMT+0000",
      "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">FAQs</span></span></span></h3>\n",
      "jcr:lastModified": "Thu Mar 14 2024 17:33:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "accordion_copy_copy_": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "jcr:created": "Fri Aug 02 2024 15:40:48 GMT+0000",
      "jcr:lastModified": "Mon Jun 02 2025 20:39:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/accordion",
      "accordion_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:39 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The weight capacity of MATS is up to 1,000 lbs.</span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jul 18 2025 15:49:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:47 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">MATS is made from non-metal materials and is safe for all magnetic resonance imaging. However, the Prevalon Blower Cart and Blower contain metal materials and are not MRI safe.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:38:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Yes. MATS is designed to be breathable, low air loss and imaging compatible and can remain underneath the patient throughout their length of stay.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jul 28 2025 14:48:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The Prevalon air pump is equipped with HEPA filtration and aligns with current industry guidelines. The filter is recommended to be changed every five years.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:39:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys5": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 5,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Mon Jun 02 2025 20:16:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">AirTAP LC is compatible with hook (also referred to as “loop”) style lifts and complies with ISO 10535, the standard testing method for patient lifting devices.</span></p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:17:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
