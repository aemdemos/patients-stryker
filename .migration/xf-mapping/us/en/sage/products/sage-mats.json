          "jcr:created": "Wed Sep 11 2024 18:03:11 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #1c5687;\">1.8 tons</span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">is lifted by the average nurse per shift<sup>3</sup></span></p>\n",
          "jcr:lastModified": "Fri Jul 18 2025 15:50:45 GMT+0000",
