          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Wed Sep 11 2024 18:09:32 GMT+0000",
          "jcr:lastModified": "Wed Sep 11 2024 18:09:32 GMT+0000",
