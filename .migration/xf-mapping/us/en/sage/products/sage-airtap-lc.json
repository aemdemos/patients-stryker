    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Wed Dec 11 2024 20:54:08 GMT+0000",
      "jcr:lastModified": "Wed Dec 11 2024 20:54:08 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Sep 11 2024 16:55:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Designed to help with patient transfer and turning</span></span></h2>\n<p><span class=\"fontsize-1-25em\">We understand the importance of early mobility. To achieve your mobility protocols and comply with guidelines, you need a readily available solution that stays under your patients and fits seamlessly into your workflow. That’s why we combined our innovative air assist technology with lift compatibility to promote safety and mobility.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Intuitive strap system enables multiple lifting positions (supine, reclined and upright)</span></li>\n<li><span class=\"fontsize-1-25em\">30° Body and Anchor Wedge System offloads the sacrum, minimizes patient migration down the bed, and reduces the need for boosting</span></li>\n<li><span class=\"fontsize-1-25em\"><a href=\"/content/stryker/us/en/sage/products/sage-m--microclimate-body-pads.html\" target=\"_blank\">Sage M² Microclimate Body Pad</a> effectively absorbs and locks in moisture to protect patient’s skin while allowing air to flow through</span></li>\n<li><span class=\"fontsize-1-25em\">Inflatable glide sheet with hi-tech fabric promotes a healthy microclimate for the skin and is compatible with low air loss technology</span></li>\n<li><span class=\"fontsize-1-25em\">Integrated head support ensures patient’s head maintains neutral position while inflated</span></li>\n<li><span class=\"fontsize-1-25em\">Point of care power switch is connected to the <a href=\"/content/stryker/us/en/sage/products/sage-air-pump.html\" target=\"_blank\">Sage Prevalon Air Pump</a> and integrated into the workflow to improve efficiency</span></li>\n<li><span class=\"fontsize-1-25em\">Easy roll handles encourage proper posture for healthcare worker</span></li>\n<li><span class=\"fontsize-1-25em\">Quick connect valve provides an easy, secure connection and a quick release</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Sep 24 2024 17:24:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "3"
        }
      },
