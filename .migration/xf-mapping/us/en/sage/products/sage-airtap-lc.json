          "jcr:created": "Fri Aug 02 2024 15:41:47 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Based on clinician feedback, Stryker intentionally designed a non-full-length glide sheet to allow room for boosting with air-assisted technology, reduce bunching and support the head and neck during vertical transfers.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jul 28 2025 14:47:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The AirTAP LC glide sheet is breathable, low air loss and imaging compatible. It is designed to remain underneath the patient while they are in the facility.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jul 28 2025 14:47:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The wedges can be inserted while the glide sheet is fully inflated and should be positioned approximately one hand-width above and below the sacrum.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:01:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordionsGrid": {
        "jcr:primaryType": "nt:unstructured",
        "1": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "1",
          "accTitle": "What is the weight capacity of AirTAP LC?  "
        },
        "2": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "2",
          "accTitle": "Why is the AirTAP LC glide sheet 65 inches long? "
        },
        "3": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "3",
          "accTitle": "Can AirTAP LC be left under a patient in bed?  "
        },
        "4": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "4",
          "accTitle": "How should the wedges be placed? "
        },
        "5": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 5,
          "accTitle": "Is the AirTAP LC Compatible with my lifts? "
        }
      },
      "accordion_parsys5": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 5,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Jun 02 2025 20:16:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">AirTAP LC is compatible with hook (also referred to as “loop”) style lifts and complies with ISO 10535, the standard testing method for patient lifting devices.</span></p>\n",
          "jcr:lastModified": "Mon Jun 02 2025 20:17:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
