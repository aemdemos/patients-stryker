  "disclaimer": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
    "disclaimer-type": "text",
    "disclaimer": "<p>*Sage MP MATS 2.0 is MR safe by rationale. The device is made from all non-metal materials; therefore, MR safety testing was not performed. Compatibility tests did not show artifacts. Based on rationale, Sage MP MATS 2.0 is electronically non-conductive and non-magnetic.</p>\r\n<p>The Prevalon Blower Cart and Blower are not MR safe.</p>\r\n<p><b>References:&nbsp;</b></p>\r\n<p><b>1.</b> Data on file. Sage Products LLC. (11/2019).&nbsp;</p>\r\n<p><b>2.</b> Chitlik A, Safe Positioning for Robotic-Assisted Laparoscopic Prostatectomy, AORN Journal 2011;94(1):37-48.&nbsp;</p>\r\n<p><b>3.</b> Data on file. Sage Products LLC (11/2025).&nbsp;</p>\r\n<p><b>4.</b> Bouyer-Ferullo S. Preventing perioperative peripheral nerve injuries. AORN J. 2013 Jan;97(1):110-124.&nbsp;</p>\r\n<p><b>5.</b> Data on file. Sage Products LLC (04/2021).</p>\r\n<p><b>6.</b> Data on file. Sage Products LLC (01/2022).</p>\r\n",
    "jcr:lastModified": "Wed Jan 21 2026 17:28:43 GMT+0000",
    "sling:resourceType": "stryker/components/structure/disclaimer",
    "textIsRich": "true"
  },
