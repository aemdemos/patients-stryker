    "cols": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Wed Sep 11 2024 17:25:18 GMT+0000",
      "jcr:lastModified": "Wed Sep 11 2024 17:25:18 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Sep 11 2024 17:25:23 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Positioned for stability. Powered by air.&nbsp;</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Tilt procedures in the operating room can present unique challenges for the perioperative team and their patients. The need for lateral pre- and post-surgical transfers can increase the risk of staff injury due to overexertion.<sup>1</sup> For patients, tilt positions can increase the risk of falls or sliding.<sup>2</sup> The Multi-Position MATS 2.0 helps address both transfer and positioning needs in the OR.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Secures patient in the following tilt positions: Lithotomy, Trendelenburg, Reverse Trendelenburg and Lateral tilt</span></li>\n<li><span class=\"fontsize-1-25em\">Breakaway pads are easily removed<sup>3</sup> and reveal the M2 Microclimate Body Pad</span></li>\n<li><span class=\"fontsize-1-25em\">Arm wraps keep arms adducted<sup>3</sup> and help reduce the risk of nerve damage<sup>4,5</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Rail straps keep system secure to the OR table in multiple positions<sup>6</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Drawsheet aids in micro adjustments for patient positioning and aids in microturn for foam removal post procedure</span></li>\n<li><span class=\"fontsize-1-25em\">M² Microclimate Body Pad effectively absorbs and locks in moisture to help protect patient’s skin while allowing air to flow through<sup>3</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Imaging capability is acceptable for use in MRI,* X-Ray, CT Scan and ultrasounds<sup>3</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jan 21 2026 16:28:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1033248771": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "3",
          "jcr:created": "Wed Sep 11 2024 17:40:04 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">System secures patient in the following tilt positions:</span></span></h2>\n",
          "jcr:lastModified": "Wed Sep 11 2024 17:40:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
