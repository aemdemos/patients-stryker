              "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
              "jcr:created": "Fri Jun 28 2019 14:11:17 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">The expiration date can be found on the side of the package.</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Mar 14 2024 17:31:23 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 2,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
              "jcr:created": "Fri Jun 28 2019 14:11:17 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">The active ingredient is 3% dimethicone.&nbsp;&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Mon Apr 01 2024 12:30:58 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys3": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 3,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
              "jcr:created": "Fri Jun 28 2019 14:11:17 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Yes. The intended use for Comfort Shield Barrier Cream Cloths is for infants and older. Neonatal use is at the physician’s discretion.&nbsp;&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Mar 14 2024 17:31:38 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys4": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 4,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
              "jcr:created": "Fri Jun 28 2019 14:11:17 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Yes. Please refer to the packaging for warming instructions.&nbsp;&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Mar 14 2024 17:31:48 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys5": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 5,
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">The expiration date is 18-24 months after the manufacturing date. Please refer to the packaging for the expiration date.&nbsp;&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Mar 14 2024 17:31:56 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys6": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 6,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">No need to add water. The cloths come pre-moistened and ready to use.&nbsp;&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Mar 14 2024 17:32:04 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys7": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 7,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">No. Comfort Shield Barrier Cream Cloths are compatible with antifungal products.<sup>4</sup></span><br>\n</p>\n",
              "jcr:lastModified": "Thu Mar 14 2024 17:32:17 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys8": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 8,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">The standby life of the included battery is four years if installed on a device that is not used. The battery will provide 166 200 joule shocks (with one minute of CPR between shocks) or 103 360 joule shocks (with one minute of CPR between shocks) or 800 minutes of operating time.&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Jun 02 2022 17:42:42 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
