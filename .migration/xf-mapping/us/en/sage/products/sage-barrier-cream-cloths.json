      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "3",
          "jcr:created": "Thu Mar 14 2024 17:20:34 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Preventing incontinence-associated dermatitis</span></span></h2>\n<p><span class=\"fontsize-1-25em\">A two-phase evaluation of 200 patients at high risk for developing IAD and hospital-acquired pressure injury (HAPI) found that not one patient developed an IAD or HAPI after receiving an intervention that standardized incontinence cleanup with a barrier-impregnated cloth following each incontinent episode.<sup>8</sup>&nbsp;</span></p>\n",
          "jcr:lastModified": "Thu Mar 14 2024 17:33:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
