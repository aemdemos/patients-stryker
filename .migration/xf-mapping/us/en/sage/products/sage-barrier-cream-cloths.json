          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Thu Mar 14 2024 17:16:49 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\"><b>100% of hospitals</b> had at least one bacteria-contaminated basin in a study published in the American Journal of Infection Control<sup>5</sup></span></p>\n",
