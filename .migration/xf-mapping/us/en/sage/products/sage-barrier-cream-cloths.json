          "jcr:created": "Thu Mar 14 2024 17:20:17 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-2-5em\"><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span class=\"fontsize-1-25em\"><span style=\"color: #b2b4ae;\"><span style=\"color: #545857;\"><span style=\"color: #ffb500;\">0</span></span></span></span></span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\"><b>IAD or HAPI</b></span></p>\n",
          "jcr:lastModified": "Tue Mar 26 2024 15:13:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
