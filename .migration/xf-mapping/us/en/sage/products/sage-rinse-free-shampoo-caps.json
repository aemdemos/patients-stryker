      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "jcr:created": "Tue Feb 27 2024 15:10:27 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">When your patients feel clean, they’re more likely to be satisfied with their hospital experience. Our all-in-one shampoo cap makes it easy to clean and condition hair for patients with limited mobility. It’s entirely self-contained and eliminates mess, cleanup time, and the need to change wet bed linens, providing the ultimate convenience!</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Fabric-lined cap is pre-moistened with a gentle, rinse-free shampoo and conditioner to leave hair clean and fresh</span></li>\n<li><span class=\"fontsize-1-25em\">Contains USP purified water and is not made with natural rubber latex</span></li>\n<li><span class=\"fontsize-1-25em\">Eliminates the need to move patients to running water or use rinsettes</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Mar 01 2024 14:23:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
