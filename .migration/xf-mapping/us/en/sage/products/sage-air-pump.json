      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "jcr:created": "Tue Feb 27 2024 15:01:22 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The Sage Prevalon Air Pump is designed to help support your facilities’ safe patient handling efforts. It provides an easy and efficient way to quickly inflate all Sage air-assisted patient positioning products. The pump can be transported via the Prevalon Air Pump Cart or Air Pump Bed Adapter, so it’s always easily accessible.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Point of care power switch is integrated into the workflow and allows you to focus on your patient</span></li>\n<li><span class=\"fontsize-1-25em\">Expandable hose extends to 10ft to easily accommodate care settings</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Mar 01 2024 14:20:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
