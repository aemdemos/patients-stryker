      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Dec 06 2023 15:11:15 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The Sage Traptex Plumbing Protection System helps change flushing behavior with innovative devices, education, and monitoring to help prevent non-flushable items from entering the pipes. This results in fewer maintenance calls for clogs, equipment failures, and plumbing disasters.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Professional, on-site sizing and installation</span></li>\n<li><span class=\"fontsize-1-25em\">2-year warranty</span></li>\n<li><span class=\"fontsize-1-25em\">Custom-made Traptex Toilet Guard &amp; Hopper Guard devices</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 06 2023 17:17:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
