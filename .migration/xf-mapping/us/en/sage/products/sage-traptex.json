          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/pre-op-prep.html\">Pre-op prep</a> | <a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-cleansing.html\">Patient cleansing</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-cleansing/plumbing-protection.html\">Plumbing protection</a></p>\n",
          "jcr:lastModified": "Wed Dec 06 2023 17:16:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
