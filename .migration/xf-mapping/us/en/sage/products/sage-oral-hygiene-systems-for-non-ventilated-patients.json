      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/oral-hygiene.html\">Oral hygiene</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/oral-hygiene/non-ventilator-patients.html\">Oral care for non-ventilator patients</a></p>\n",
          "jcr:lastModified": "Tue Feb 27 2024 17:45:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Wed Jul 31 2024 14:04:37 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Hospital-acquired pneumonia is one of the most common hospital-acquired infections in U.S. hospitals. In one study, more than half of patients with pneumonia were non-ventilated patients.<sup>2</sup>&nbsp;Our patient-specialized systems and kits are designed specifically to remove plaque, debris, and oral secretions.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">User-friendly thumb port tools provide easy suction control and quick tool changes</span></li>\n<li><span class=\"fontsize-1-25em\">Simple tools work with standard suction equipment</span></li>\n<li><span class=\"fontsize-1-25em\">Burst pouch dispenses solution in seconds to moisten tools right in the package</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">Learn about the all-in-one, single use&nbsp;<a href=\"/content/stryker/us/en/sage/products/sage-self-oral-care.html\" target=\"_blank\">Sage Self Oral Care</a>.</span></p>\n",
          "jcr:lastModified": "Wed Jul 31 2024 14:05:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "jcr:created": "Wed Jul 12 2023 13:03:02 GMT+0000",
      "jcr:lastModified": "Wed Jul 12 2023 13:03:02 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_2064568269": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Jul 12 2023 13:03:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\"><span class=\"fontsize-1-25em\">Did you know?</span></span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\">Within<b> <span class=\"futura-bold\"><span style=\"color: #4c7d7a;\"><span style=\"color: #000000;\">48 hours</span></span></span></b> of admission, the normal oral flora changes to include respiratory pathogens not normally found in healthy individuals.<sup>3</sup></span></li>\n<li><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\"><span style=\"color: #000000;\">19.3% of NV-HAP</span></span></span></b> patients are readmitted for pneumonia within 30 days.<sup>1</sup></span></li>\n<li><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\"><span style=\"color: #000000;\">$39,900</span></span></span></b> estimated Acute Care cost per case.<sup>4</sup></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\"><span style=\"color: #000000;\">16% average mortality rate</span></span></span> for patients with NV-HAP.<sup>1</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jul 31 2024 14:50:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "4"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Wed Jul 12 2023 13:03:33 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">Clinical outcomes:</span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">Study published in American Journal of Infection Control<sup>1</sup></span></p>\n",
          "jcr:lastModified": "Wed Jul 31 2024 14:08:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
