      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/pre-op-prep.html\" target=\"_blank\">Pre-op prep</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/pre-op-prep/nose-mouth-and-skin-prep.html\" target=\"_blank\">Nose, mouth and skin prep</a></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 16:25:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 15 2024 16:25:35 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">We can help you address bacteria in the nares, in the oral cavity, and on the skin, which are risk factors for Surgical Site Infections (SSIs). Our clinically proven systems can help standardize your pre-op approach for maximum efficiency and enhanced compliance. Our early prepping systems reduce risk factors for surgical infections consistently and effectively by addressing three reservoirs of bacteria: the nose, the mouth, and the skin.</span></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 16:25:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "section_title_286073": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "hideSectionTitleComp": "true",
      "deepLinkingId": "overview",
      "jcr:created": "Wed Dec 06 2023 16:00:39 GMT+0000",
      "title": "Overview",
      "jcr:lastModified": "Wed Dec 13 2023 19:26:51 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title"
    },
    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Tue Oct 15 2024 16:24:07 GMT+0000",
      "jcr:lastModified": "Tue Oct 15 2024 16:24:07 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 15 2024 16:25:52 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Nasal prepping</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\">3M skin and nasal antiseptic reduces bacterial counts in the nares in one hour, including S. aureus by 99.5%, and maintains the reduction for at least 12 hours</span></li>\n<li><span class=\"fontsize-1-25em\">Convenient, single-dose bottle and two-minute application fits easily into your preoperative process</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Oct 15 2024 16:29:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 15 2024 16:25:52 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Oral cleansing</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Two convenient options:</span></p>\n<p style=\"margin-left: 40px;\"><span class=\"fontsize-1-25em\"><b>1)</b> 0.12% Chlorhexidine Gluconate</span></p>\n<p style=\"margin-left: 40px;\"><span class=\"fontsize-1-25em\"><b>2)</b> Corinz Oral Antiseptic and Moisturizer</span></p>\n<p><span class=\"fontsize-1-25em\">Ultra-soft toothbrush contains nylon bristles to gently remove plaque, debris, and oral secretions</span></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 16:30:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 15 2024 16:25:52 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Skin prepping</span></span></h3>\n<p><span class=\"fontsize-1-25em\">(<a href=\"/content/stryker/us/en/sage/products/sage-nose-to-toes.html\" target=\"_blank\">2% Chlorhexidine Gluconate* Cloths</a>)</span></p>\n<p><span class=\"fontsize-1-25em\">The solution remains on the skin to provide antimicrobial activity for up to 6 hours and is effective against a broad spectrum of microorganisms including MRSA, VRE, and Acinetobacter</span></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 16:32:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
