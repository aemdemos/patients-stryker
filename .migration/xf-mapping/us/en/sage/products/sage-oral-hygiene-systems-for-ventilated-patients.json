          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/oral-hygiene.html\">Oral hygiene</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/oral-hygiene/ventilator-patients.html\" target=\"_blank\">Oral care for ventilator patients</a></p>\n",
          "jcr:lastModified": "Wed Jul 31 2024 17:58:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Jul 31 2024 17:58:36 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Our comprehensive 24-hour oral care systems are designed to remove plaque, debris and oral secretions while helping you comply with your oral care protocol.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Easy to use, sequential packaging available in various configurations to meet hospital protocol</span></li>\n<li><span class=\"fontsize-1-25em\">Burst pouch dispenses solution in seconds to moisten tools right in the package</span></li>\n<li><span class=\"fontsize-1-25em\">Includes all-in-one solution, Corinz Antiseptic Cleansing and Moisturizing Oral Rinse, which can help streamline workflow and promote compliance to protocol</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jul 31 2024 17:59:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
