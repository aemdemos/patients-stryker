          "jcr:created": "Mon Apr 08 2024 13:59:25 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Advancing mobilitiy with convenience and confidence</span></span></h2>\n<p><span class=\"fontsize-1-25em\">We understand the importance of early mobility. To achieve your mobility protocols and comply with nursing patient positioning guidelines, you need a readily available solution that stays under your patient and fits seamlessly into your workflow. That’s why we added lift compatibility to our innovative turn and position system to promote safety and mobility.&nbsp;</span></p>\n",
          "jcr:lastModified": "Wed Apr 10 2024 18:01:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "4"
        },
