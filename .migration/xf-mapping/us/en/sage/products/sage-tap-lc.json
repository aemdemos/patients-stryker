          "gradientDirection": "left-to-right",
          "text": "<p><span style=\"color: #ffffff;\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">1. Boost</span></span></span></p>\n<p><span style=\"color: #ffffff;\"><span class=\"fontsize-1-25em\">Help address patient migration</span></span></p>\n",
          "jcr:lastModified": "Mon May 13 2024 12:33:02 GMT+0000",
