    "cols2_1_3_2_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "jcr:created": "Fri Apr 05 2024 16:00:04 GMT+0000",
      "jcr:lastModified": "Fri Apr 05 2024 16:00:04 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Wed Dec 06 2023 15:11:15 GMT+0000",
          "text": "<h2><span style=\"color: #1c5687;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\">Reduce risk factors for skin injury and caregiver injury</span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">Our TAP system is designed to assist and maintain proper patient positioning to offload the sacrum. It also effectively manages moisture and body heat to protect patients’ skin. In addition, it helps reduce the risk of nurse injury by providing a more ergonomically friendly method of repositioning patients.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">30° Body and Anchor Wedge System allow staff to easily position patients for consistent protection and pressure redistribution </span></li>\n<li><span class=\"fontsize-1-25em\"><a href=\"/content/stryker/us/en/sage/products/sage-m--microclimate-body-pads.html\"><u>M² Microclimate Body Pad</u></a> effectively absorbs and locks in moisture to protect patient’s skin while allowing air to flow through </span></li>\n<li><span class=\"fontsize-1-25em\">Anti-shear strap anchors the system to the bed to reduce shearing </span></li>\n<li><span class=\"fontsize-1-25em\">Low-friction glide sheet works with the 30° body wedge system to reduce friction and shear </span></li>\n<li><span class=\"fontsize-1-25em\">Dermasuede material on the glide sheet grips the microclimate body pad to keep it in place </span></li>\n<li><span class=\"fontsize-1-25em\">Positioning handles assist with quick, gentle micro-turns to position the patient at the appropriate angle</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Apr 17 2024 18:09:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
