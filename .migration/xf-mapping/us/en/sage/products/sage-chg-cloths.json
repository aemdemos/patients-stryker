          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Help protect your patients with CHG cloths</span></span></h2>\n",
          "jcr:lastModified": "Thu Aug 08 2024 20:45:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "3"
        },
        "experiencefragment_1": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Aug 21 2024 14:28:00 GMT+0000",
          "text": "Formulation BZK-free and alcohol-free Benzalkonium Chloride (BZK) and alcohol are well-known skin irritants.2,3 Efficacy Concentrated More concentrated dose per square inch than other CHG cloths4 Impactful Clinically validated and meets strict FDA requirements5 Persistent Rinse-free formula provides antimicrobial activity up to 6 hours after application Fast Fast-acting and effective against a broad spectrum of microorganisms, including Candida auris6,7 Outcomes 25+ published outcomes Proven effective, specifically targeting the reduction of the risk factors that can cause SSIs",
          "jcr:lastModified": "Wed Aug 21 2024 14:28:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/sage/en/products/sage_2_chlorhexidine/features/features-2",
