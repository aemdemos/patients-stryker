        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "3",
          "jcr:created": "Tue Jul 30 2024 17:49:45 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Surgery prep cloths: </span></span><span class=\"fontsize-1-5em\">The clinically proven solution to help address the risk factors of SSIs</span></h2>\n<p><span class=\"fontsize-1-25em\">Surgical site infection is a primary threat to your surgical patients. SSIs are, in most cases, preventable when the patient and hospital staff members adhere to proper prevention practices.<sup>1</sup> Our cloths are clinically proven to address bacteria on the skin and can standardize your pre-op approach for maximum efficiency and enhanced compliance.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">CHG effectively addresses harmful bacteria on the skin</span></li>\n<li><span class=\"fontsize-1-25em\">Unique formulation contains ingredients that hydrate and protect skin; pH balanced</span></li>\n<li><span class=\"fontsize-1-25em\">Delivers a concentrated amount of CHG per square inch of cloth</span></li>\n<li><span class=\"fontsize-1-25em\">Proven effective and backed by peer-reviewed, published outcomes</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Nov 06 2024 18:43:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
