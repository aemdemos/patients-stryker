      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "jcr:created": "Fri Jul 26 2024 17:50:16 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Help protect your patients' heels in the ICU</span></span></h2>\n<p><span class=\"fontsize-1-25em\">The heel is the second most common site for pressure injury development.<sup>1</sup> The Heel Protector III is specifically designed to help reduce the risk of heel pressure injury in the ICU.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Offloads the heel</span></li>\n<li><span class=\"fontsize-1-25em\">Reduces plantar flexion contracture risk</span></li>\n<li><span class=\"fontsize-1-25em\">Helps prevent lateral rotation, reducing risk of peroneal nerve damage</span></li>\n<li><span class=\"fontsize-1-25em\">Sequential Compression Device (SCD) compatible</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Aug 12 2024 18:13:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Fri Jul 26 2024 17:52:20 GMT+0000",
      "jcr:lastModified": "Fri Jul 26 2024 17:52:20 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "5",
          "jcr:created": "Fri Jul 26 2024 17:52:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">2.5 million</span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">patients affected by pressure injuries per year.<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Fri Jul 26 2024 18:07:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "5",
          "jcr:created": "Fri Jul 26 2024 17:52:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">9.3%</span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">prevalence of pressure injuries over 10-year survey.<sup>3</sup></span></p>\n",
          "jcr:lastModified": "Wed Jul 31 2024 13:00:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "5",
          "jcr:created": "Fri Jul 26 2024 17:52:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\"><span class=\"fontsize-1-25em\">$20.9k-$151.7k</span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">cost to treat pressure injuries depending on the stage of injury.<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Wed Jul 31 2024 13:02:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
