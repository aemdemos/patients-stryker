      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning.html\">Patient&nbsp;positioning</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning/lateral-transfer.html\">Lateral transfer</a></p>\n",
          "jcr:lastModified": "Tue Feb 27 2024 14:58:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Feb 27 2024 14:51:33 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">We understand specialty procedures can have unique challenges. You shouldn’t have to worry when you transfer surgical patients from surface to surface in the OR. That’s why we designed HalfMATS to fit seamlessly into your workflow and address your transfer needs during specialty procedures so you can achieve the best possible outcomes.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Addresses your transfer needs during OR specialty procedures (e.g., lithotomy and orthopedic)</span></li>\n<li><span class=\"fontsize-1-25em\">Patient placement positioning (Breakline) ensures proper placement of the patient to promote workflow efficiency</span></li>\n<li><span class=\"fontsize-1-25em\">Integrated Head Support inflates to provide comfort and support for the head and neck<sup>1</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Quick Connect Valve provides an easy, secure connection and a quick release</span></li>\n<li><span class=\"fontsize-1-25em\">Hose Protection Sleeve helps protect hose from environmental contamination</span></li>\n<li><span class=\"fontsize-1-25em\">Microclimate Management Pad effectively absorbs and locks in moisture to protect patient’s skin while allowing air to flow through<sup>1</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Imaging capability is acceptable for use in MRI*, X-Ray, CT Scan, and ultrasounds<sup>2</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Feb 27 2024 14:52:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
