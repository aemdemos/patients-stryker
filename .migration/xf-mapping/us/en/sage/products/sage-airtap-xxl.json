      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning.html\">Patient&nbsp;positioning</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning/turning-and-positioning.html\">Turning and positioning</a></p>\n",
          "jcr:lastModified": "Wed Dec 06 2023 15:11:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "jcr:created": "Thu Feb 29 2024 15:39:05 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Boosting and repositioning patients in bed is a high-frequency task. This system helps reduce the risk of injury to nurses and other caregivers by providing an ergonomically friendly method of turning and repositioning larger patients.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Body wedge tail with easy glide fabric enables at least two healthcare workers to turn larger patients</span></li>\n<li><span class=\"fontsize-1-25em\">Larger low-friction glide sheet and M2 microclimate body pad accommodate bariatric patients</span></li>\n<li><span class=\"fontsize-1-25em\">M² microclimate body pad effectively absorbs and locks in moisture to protect patient’s skin while allowing air to flow through</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Mar 01 2024 15:59:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
