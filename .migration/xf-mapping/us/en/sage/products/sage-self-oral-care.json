      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/oral-hygiene.html\">Oral hygiene</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/oral-hygiene/non-ventilator-patients.html\">Oral care for non-ventilator patients</a></p>\n",
          "jcr:lastModified": "Tue Feb 27 2024 17:45:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Jul 31 2024 17:47:05 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">When patients enter a hospital, they shouldn’t have to worry about getting sicker. Brushing their teeth and gums is one of the best ways to help address risk factors for pneumonia, which can impact all patients, regardless of acuity.<sup>2</sup>&nbsp;Our all-in-one, single use oral care system is designed to help address the risk factors associated with hospital-acquired pneumonia (HAP) for your non-ventilated patients.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Removable suction cap allows for easy connection to hospital suction</span></li>\n<li><span class=\"fontsize-1-25em\">Ergonomic handle allows patients to easily grip and maneuver brush</span></li>\n<li><span class=\"fontsize-1-25em\">Spill-resistant spittoon</span></li>\n<li><span class=\"fontsize-1-25em\">Ultra-soft brush removes plaque and debris while being gentle on gums</span></li>\n<li><span class=\"fontsize-1-25em\">Sodium bicarbonate treated swab absorbs Corinz solution to help clean the teeth and oral cavity</span></li>\n<li><span class=\"fontsize-1-25em\">Corinz, an all-in-one antiseptic solution and mouth moisturizer, helps reduce bacteria</span></li>\n<li><span class=\"fontsize-1-25em\">Reorder #6304 (4-pack)</span></li>\n<li><span class=\"fontsize-1-25em\">Reorder #6302 (2-pack)</span></li>\n<li><span class=\"fontsize-1-25em\">Reorder #6301 (1-pack)</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jul 31 2024 17:47:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
