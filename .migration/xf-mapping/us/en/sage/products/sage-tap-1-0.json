      "jcr:created": "Wed Dec 06 2023 15:10:22 GMT+0000",
      "jcr:lastModified": "Wed Dec 06 2023 15:10:22 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning.html\">Patient&nbsp;positioning</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/patient-positioning/turning-and-positioning.html\">Turning and positioning</a></p>\n",
          "jcr:lastModified": "Wed Dec 06 2023 15:11:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "jcr:created": "Wed Dec 06 2023 15:11:15 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">This system is designed to assist and maintain proper patient positioning to offload the sacrum. It also effectively manages moisture and body heat to protect patients’ skin. In addition, it helps reduce the risk of injury to nurses by providing a more ergonomically friendly method of repositioning patients.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">30° Body Wedges allow staff to easily position patients for consistent protection and pressure redistribution</span></li>\n<li><span class=\"fontsize-1-25em\">M² Microclimate Body Pad effectively absorbs and locks in moisture to protect patient’s skin while allowing air to flow through</span></li>\n<li><span class=\"fontsize-1-25em\">Anti-Shear Strap anchors the system to the bed to reduce shearing</span></li>\n<li><span class=\"fontsize-1-25em\">Low-Friction Glide Sheet works with the 30° Body Wedge System to reduce friction and shear</span></li>\n<li><span class=\"fontsize-1-25em\">Dermasuede material on the glide sheet grips the microclimate body pad to keep it in place</span></li>\n<li><span class=\"fontsize-1-25em\">Positioning Handles assist with quick, gentle micro-turns to position the patient at the appropriate angle</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Dec 11 2023 20:55:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
