          "jcr:created": "Fri Jul 26 2024 18:40:33 GMT+0000",
          "text": "<h3><span class=\"futura-bold\">Sage oral solutions and moisturizers can help address the risk factors for infection</span></h3>\n<p><span class=\"fontsize-1-25em\">Our portfolio of oral solutions and mouth moisturizers can help you clean your patients’ mouths.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Corinz antiseptic cleansing and moisturizing oral rinse</span></li>\n<li><span class=\"fontsize-1-25em\">Perox-A-Mint solution</span></li>\n<li><span class=\"fontsize-1-25em\">Mouth moisturizer</span></li>\n<li><span class=\"fontsize-1-25em\">Sodium bicarbonate mouthpaste</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Aug 27 2024 20:08:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
