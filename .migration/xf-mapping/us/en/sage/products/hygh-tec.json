        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "7",
          "jcr:created": "Mon Apr 13 2026 18:57:01 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h4><span class=\"fontsize-1-5em\">The difference is the design</span></h4>\n<p><span class=\"fontsize-1-25em\">The polyurethane (PUR) material is lightweight because it’s filled with air, not water.<sup>1</sup> The unique dumbbell design provides adaptability to anatomical structures<sup>1</sup> and reduced stool leakage.<sup>3</sup><br>\n </span>&nbsp;</p>\n",
          "jcr:lastModified": "Thu May 07 2026 16:35:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
