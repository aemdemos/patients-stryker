      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Mon Jan 26 2026 23:01:28 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Reshaping how fecal incontinence is managed&nbsp;</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Current indwelling fecal management systems (FMS) can leak up to 70%.<sup>2</sup> To address this issue, hygh-tec drainage was engineered with air technology to synchronize with the sphincter muscles, allowing it to reduce stool leakage.<sup>1,3,4</sup>*</span></p>\n<p><span class=\"fontsize-1-25em\">The results of a 2025 study published in Australian Critical Care demonstrated:<sup>3</sup></span></p>\n",
      "jcr:lastModified": "Thu May 07 2026 16:19:19 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "4"
    },
