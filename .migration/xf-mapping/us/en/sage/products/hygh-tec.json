      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "7",
          "jcr:created": "Mon Apr 13 2026 18:45:15 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Dignity matters &nbsp;</span></span></h2>\n<p><span class=\"fontsize-1-25em\">The value of preserving patients’ dignity in their most vulnerable time can’t be quantified. By providing that respect, both for staff and patients, this fecal diversion system can have a real impact.</span></p>\n<p><span class=\"fontsize-1-25em\"><b>Up to 40% of ICU patients experience fecal incontinence</b>,<sup>5</sup> a challenge that can increase the risk of skin injury, infection and distress for patients.</span></p>\n",
          "jcr:lastModified": "Thu May 07 2026 16:36:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
