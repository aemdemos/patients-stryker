      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "7",
          "jcr:created": "Mon Apr 13 2026 18:57:01 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Care with confidence</span></span></h2>\n<p><span class=\"fontsize-1-25em\">hygh-tec drainage has demonstrated reduced stool leakage<sup>3</sup> compared to first-generation FMS.<sup>2</sup>* This reduced stool leakage can help support improved patient outcomes and more efficient workflows in the critical care setting.<sup>6</sup></span></p>\n<p><span class=\"fontsize-1-25em\">Diverting semi-liquid and liquid stool away from the skin can help keep the skin dry, helping to address a risk factor of incontinence-associated dermatitis (IAD),<sup>6</sup> hospital-acquired pressure injuries (HAPI)<sup>8</sup> and spread of C. difficile infection associated with acute fecal incontinence.<sup>9</sup></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Thu May 07 2026 16:36:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
