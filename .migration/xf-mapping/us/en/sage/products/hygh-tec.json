          "accTitle": "What syringe should I use to collect stool samples from the device?"
        },
        "5": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 5,
          "accTitle": "How often should we irrigate the system?"
        },
        "6": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 6,
          "accTitle": "Is the device MRI compatible?"
        }
      },
      "accordion_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Apr 13 2026 19:00:53 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The drainage head is inflated with 85mL of air and can be filled with the air syringe included in the kit. The syringe has an indicator line at 85mL. Additionally, you can use the pre-anal balloon segment after inflation to double-check the inflation level.<br>\n </span>&nbsp;</p>\n",
          "jcr:lastModified": "Mon Apr 13 2026 19:01:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Apr 13 2026 19:00:53 GMT+0000",
          "text": "<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\">A Luer lock syringe (not included in the kit) can be used for irrigation of the device.</span></p>\n",
          "jcr:lastModified": "Mon Apr 13 2026 19:01:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Apr 13 2026 19:00:53 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">No. Lubricant is not included in the kit but per the IFU a lubricant/lubricant gel should be used when preparing the patient and the system.</span></p>\n",
          "jcr:lastModified": "Mon Apr 13 2026 19:02:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Apr 13 2026 19:00:53 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">A Luer slip syringe (not included in the kit) can be used to collect stool samples from the device.</span></p>\n",
          "jcr:lastModified": "Mon Apr 13 2026 19:02:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys5": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 5,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Apr 13 2026 19:00:53 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The system should be irrigated once per shift or as needed. Always refer to the Instructions for Use (IFU) and institutional policy for full instructions.</span></p>\n",
          "jcr:lastModified": "Fri May 08 2026 15:30:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys6": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 6,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Apr 13 2026 19:00:53 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The device is MR conditional, meaning the device can be safely used in an MRI setting only if specific conditions are met. Refer to IFU for specific conditions.</span></p>\n",
          "jcr:lastModified": "Thu May 07 2026 16:37:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
