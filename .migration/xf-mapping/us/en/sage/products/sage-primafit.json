      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1051646430_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Thu May 25 2023 22:02:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span style=\"color: #85458a;\"><span class=\"futura-bold\"><span style=\"color: #000000;\"><span style=\"color: #85458a;\"><span style=\"color: #1c5687;\"><span style=\"color: #85458a;\"><span class=\"fontsize-1-5em\">Did you know?</span></span></span></span></span></span></span></h2>\n<ul>\n<li><span class=\"fontsize-1-25em\">More than 30 million Foley catheters are inserted annually in the United States.<sup>4</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Each day the indwelling urinary catheter remains, a patient has a 3 - 7% increased risk of acquiring a CAUTI.<sup>5</sup></span></li>\n</ul>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Learn more about CAUTI and how to help prevent it.</span>&nbsp;</span></p>\n<p><a href=\"/content/stryker/us/en/sage/urine-management.html\"><span class=\"standalone-link\">LEARN MORE</span></a></p>\n",
          "jcr:lastModified": "Fri Aug 02 2024 15:43:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
      }
    },
    "accordion": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
