      "accordion_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:39 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Set vacuum to low, continuous suction at a minimum of 60 mmHg. Always use the minimum amount of suction necessary.</span></p>\n",
          "jcr:lastModified": "Fri Aug 02 2024 15:42:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:47 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Replace PrimaFit every 12 to 24 hours, or sooner if soiled with stool or bodily fluids other than urine. Dispose of the device per hospital protocol and local regulations.</span></p>\n",
          "jcr:lastModified": "Fri Aug 02 2024 15:42:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">If used on retracted male anatomy, use clinical judgement and hospital protocol.&nbsp;</span></p>\n",
          "jcr:lastModified": "Fri Aug 02 2024 15:42:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Align tapered end with perineum and place device between the labia and against the urethral opening. Ensure the fabric is covering the urethral meatus. Curve the device toward the patient’s lower abdomen. While holding the device in place, remove the adhesive liner and adhere the adhesive pad over the suprapubic region.</span></p>\n",
          "jcr:lastModified": "Thu Aug 22 2024 19:13:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys5": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 5,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Aug 02 2024 15:41:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">PrimaFit has a silicone-based adhesive that is skin friendly<sup>6</sup> and allows the device to stay in place for the duration of use.</span></p>\n",
          "jcr:lastModified": "Thu Aug 22 2024 19:13:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
