          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span style=\"color: #1c5687;\"><span class=\"futura-bold\"><span style=\"color: #85458a;\"><span style=\"color: #000000;\">17 to 1 CAUTI reduction</span></span></span></span>&nbsp;in a 150-bed facility</span><sup><span class=\"fontsize-1-5em\">3</span></sup></p>\n",
