          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Jul 30 2024 14:41:34 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">A warm washcloth is used to clean each area of your patient's body separately.</span></p>\n",
          "jcr:lastModified": "Mon Aug 05 2024 12:39:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Jul 30 2024 14:41:27 GMT+0000",
          "alt": "Washcloth icon",
          "srcFileRef": "/content/dam/stryker/sage/products/bath/images/cleansers-icon.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Aug 28 2024 20:37:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
