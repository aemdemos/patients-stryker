      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Jul 30 2024 14:31:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Standardize patient hygiene</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Our patient cleansing washcloths can help reduce the risk of cross-contamination from basins – a proven CAUTI risk factor – and waterborne hospital-acquired infections. The soft washcloths can help your facility comply with CDC infection control guidelines,<sup>1</sup>&nbsp;while providing comfortable, skin-friendly benefits to your patients.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Rinse-free cleansing and moisturizing with aloe and vitamin E</span></li>\n<li><span class=\"fontsize-1-25em\">Dermatologist-tested formula; proven hypoallergenic, gentle, and non-irritating; pH-balanced</span></li>\n<li><span class=\"fontsize-1-25em\">Insulated, resealable packaging</span></li>\n<li><span class=\"fontsize-1-25em\">Washcloths can be warmed when placed in our commercial-grade warmer</span></li>\n<li><span class=\"fontsize-1-25em\">Eliminates the mess and need to change wet bed linens</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Aug 12 2024 13:39:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "3"
        },
        "sectionseparator": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Jul 30 2024 14:42:30 GMT+0000",
          "jcr:lastModified": "Tue Jul 30 2024 14:42:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "text_877577826": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Jul 30 2024 14:41:55 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Our hygienic full-body washcloths leave your patient's skin feeling clean and refreshed</span></span></h2>\n",
          "jcr:lastModified": "Mon Aug 05 2024 12:38:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
