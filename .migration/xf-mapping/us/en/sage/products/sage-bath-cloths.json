          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Jul 30 2024 14:41:34 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Each washcloth contains mild cleansers, purified water, and skin moisturizers with aloe and vitamin E.</span></p>\n",
          "jcr:lastModified": "Tue Jul 30 2024 14:43:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
