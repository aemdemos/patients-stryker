          "preset": "max_width_1440",
          "jcr:created": "Tue Jul 30 2024 14:41:27 GMT+0000",
          "alt": "Hypoallergenic washcloths icon",
          "srcFileRef": "/content/dam/stryker/sage/products/bath/images/hypoallergenic-icon.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Aug 28 2024 20:37:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Jul 30 2024 14:41:34 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Thick, hypoallergenic, ultra-soft washcloths are gentler on your patient's skin than laundered cloths.</span></p>\n",
          "jcr:lastModified": "Mon Aug 05 2024 12:39:14 GMT+0000",
