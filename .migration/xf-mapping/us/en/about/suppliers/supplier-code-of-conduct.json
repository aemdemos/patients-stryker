          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Jul 07 2025 21:35:26 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Our Supplier Code of Conduct aligns with our values and reflects our shared commitment to protect the workers, environment, and communities in our value chain. We set clear expectations for our suppliers through the Supplier Code, covering critical areas, including business integrity, labor and human rights, environment, workplace health and safety and management systems.</span></p>\n",
          "jcr:lastModified": "Thu Jul 31 2025 17:56:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "2",
          "textIsRich": "true"
        },
