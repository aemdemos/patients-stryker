      "gradientDirection": "left-to-right",
      "line1": "<h1><span style=\"color: rgb(175,109,4);\"><span class=\"futura-bold\"><span class=\"fontsize-3-5-vw\"><span style=\"color: #000000;\">Supplier Code of Conduct</span></span></span></span></h1>\r\n",
      "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-2-5-vw\">We do <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">what's right</span></span></span></span>",
      "jcr:lastModified": "Mon Jul 21 2025 14:49:15 GMT+0000",
