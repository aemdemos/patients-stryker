              "gradientDirection": "left-to-right",
              "line1": "<p><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-2vw\"><span style=\"color: #000000;\">Sparking&nbsp;curiosity at Stryker’s second-annual DE&amp;I summit</span></span></span></span></p>\r\n<p>&nbsp;</p>\r\n",
              "jcr:lastModified": "Mon Sep 26 2022 19:06:45 GMT+0000",
              "sling:resourceType": "stryker/components/content/largeheadline",
              "backgroundColor": "rgba(255,255,255,0)",
