              "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-4vw\">A safe space <br>\r\nat Stryker</span></span></h1>\r\n",
              "line2": "<span class=\"fontsize-1-5-vw\">Creating support and allyship for the LGBTQIA+ community</span>",
              "jcr:lastModified": "Mon Jun 13 2022 20:36:34 GMT+0000",
              "sling:resourceType": "stryker/components/content/largeheadline",
