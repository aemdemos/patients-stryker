        "item1089953560363234_234768509": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"urw-egyptienne\"></span> ",
          "line2": "<p><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">“</span></span><span style=\"font-size: 21.0px; background-color: transparent; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\">I would say at about month two, I started doing more impactful aerobic activity.&nbsp;</span>Overall I’m incredibly happy with my surgeon, with the procedure itself and my experience with Zip.</span></span><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">”</span></span><br>\r\n</p>\r\n<p>______________<br>\r\n<br>\r\n<span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Jesse</span><br>\r\n</span></span></span><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\">Zip skin closure patient</span></span></span></span></p>\r\n",
