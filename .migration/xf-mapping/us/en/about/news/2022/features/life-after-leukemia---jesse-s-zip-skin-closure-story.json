        "largeheadline_copy53": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-1-5-vw\">After recovering from leukemia, Jesse was ready to get back to his active lifestyle. However, his doctor let him know that his hip wasn’t ready for physical activity and that he would need hip resurfacing surgery. Watch Jesse as he shares how Zip provided him with more comfort, less scars and a quicker recovery so he could get back to his aerobic activities.</span>",
          "jcr:lastModified": "Tue Mar 22 2022 16:03:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
