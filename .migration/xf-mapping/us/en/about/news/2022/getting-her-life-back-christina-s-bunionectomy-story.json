        "largeheadline_copy53": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2vw\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\">Getting her life back</span><span class=\"urw-egyptienne\"><br>\r\n</span>Christina’s bunionectomy story</span></span>",
          "line2": "<br>\r\n<span style=\"color: rgb(0,0,0);\">About 30% of women experience a painful bump on the outside of their big toe, known as a bunion.<sup>1</sup>&nbsp;Due to their location, bunions can often reduce the flexibility of the toe and cause continuous pain. Watch Christina as she shares how PROstep provided her with less pain<sup>2</sup>, smaller scars<sup>2,3</sup>&nbsp;and a quicker recovery<sup>3,4</sup>&nbsp;so she could get back to her nursing career and bodybuilding.</span>",
          "jcr:lastModified": "Mon Apr 11 2022 20:13:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
