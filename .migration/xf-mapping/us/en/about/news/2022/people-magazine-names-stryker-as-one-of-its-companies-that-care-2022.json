  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
    "text": "<p>Stryker has been named one of PEOPLE Companies that Care for the third time.</p>\n<p>The Companies that Care list highlights the top U.S. companies that have succeeded in business while also demonstrating outstanding respect, care and concern for their employees, their communities and the environment.</p>\n<p>People magazine teamed up with Great Place to Work® to produce the list by evaluating thousands of organizations using employee survey responses and data provided by those companies.</p>\n<p>This recognition is a direct result of the contributions our employees make to our customers and our communities. Thank you for what you do every day! <a href=\"https://www.greatplacetowork.com/best-workplaces/companies-that-care/2022\">See the list</a> and <a href=\"https://people.com/human-interest/people-100-companies-that-care-2022/\">learn more</a> about this recognition.</p>\n",
    "jcr:lastModified": "Wed Aug 31 2022 14:19:58 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
