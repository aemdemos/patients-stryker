        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Tue Oct 03 2023 18:54:10 GMT+0000",
          "text": "<p><span class=\"futura-bold\">About Stryker&nbsp;</span><br>\nStryker is one of the world’s leading medical technology companies and, together with its customers, is driven to make healthcare better. The company offers innovative products and services in Medical and Surgical, Neurotechnology, Orthopaedics and Spine that help improve patient and healthcare outcomes. Alongside its customers around the world, Stryker impacts more than 130 million patients annually. More information is available at <a href=\"http://www.stryker.com\">www.stryker.com</a>.&nbsp;</p>\n<p><span class=\"futura-bold\">Media contact&nbsp;</span><br>\nMeghan Menz<br>\nSenior Director, Communications<br>\n<a href=\"mailto:meghan.menz@stryker.com\">meghan.menz@stryker.com</a></p>\n",
          "jcr:lastModified": "Tue Oct 03 2023 18:55:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
