        "largeheadline_copy53": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2vw\"><span class=\"futura-bold\"><a><span style=\"color: rgb(0,0,0);\">Improving her happiness and confidence</span><br />\r\n </a></span>Carolyn's bunionectomy story</span>",
          "line2": "<br>\r\nAs high as 30% of women experience a painful bump on the outside of their big toe, known as a bunion.<sup>1</sup> Due to their location, bunions can often reduce the flexibility of the toe and cause continuous pain. Watch Carolyn as she shares how PROstep provided her with less pain<sup>2</sup>, smaller scars<sup>2,3</sup> and a quicker recovery<sup>3,4</sup>.",
          "jcr:lastModified": "Fri Jan 27 2023 21:45:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
