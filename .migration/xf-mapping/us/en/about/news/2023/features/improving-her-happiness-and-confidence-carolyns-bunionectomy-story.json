        "item1089953560363234": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"urw-egyptienne\"></span> ",
          "line2": "<p><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">“</span></span><span style=\"font-size: 21.0px; background-color: transparent; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"urw-egyptienne\">For years, I lived with bunions. The pain was one thing, but they were so unsightly that I was embarrassed to show my feet in public—I didn’t even have the confidence to walk into a shoe store! But now, thanks to PROstep MIS, there’s no more pain and whole lot more shoe shopping.</span></span></span><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">”</span></span><br>\r\n</p>\r\n<p>______________<br>\r\n<br>\r\n<span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Carolyn D</span><br>\r\n</span></span></span><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\">PROstep bunionectomy patient</span></span></span></span></p>\r\n",
          "jcr:lastModified": "Fri Jan 27 2023 22:05:09 GMT+0000",
