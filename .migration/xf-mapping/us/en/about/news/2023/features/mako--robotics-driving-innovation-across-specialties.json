          "jcr:created": "Fri Jan 27 2023 19:18:03 GMT+0000",
          "alt": "Tom Chergey, Vice President & General Manager, Mako",
          "srcFileRef": "/content/dam/stryker/about/news/2023/features/mako--robotics-driving-innovation-across-specialties/Joint-Replacement-Chergey,-Thomas_Resized_Edited_V2.png",
