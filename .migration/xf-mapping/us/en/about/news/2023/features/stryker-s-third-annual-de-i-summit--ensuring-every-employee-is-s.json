    "text_698669724": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "topPadding": "3",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Thu Aug 24 2023 17:52:37 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p>And our Chair and CEO Kevin Lobo candidly answered the burning questions that are top of mind for many of our employees.<br>\n<br>\n“Kevin has been unwavering in his commitment to DE&amp;I and its impact on innovation and growth,” said Annie Heath, Vice President of Diversity, Equity and Inclusion at Stryker.<br>\n&nbsp;</p>\n",
      "jcr:lastModified": "Thu Aug 24 2023 18:23:52 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
