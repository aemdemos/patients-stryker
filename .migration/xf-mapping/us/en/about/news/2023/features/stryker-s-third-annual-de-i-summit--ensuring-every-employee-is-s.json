      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Thu Aug 24 2023 17:50:08 GMT+0000",
          "text": "<p>Stryker continues to make positive strides to foster a culture where every employee feels seen, heard and valued.</p>\n",
          "jcr:lastModified": "Thu Aug 24 2023 17:57:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_728378226_": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "1",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "leftPadding": "3",
          "topPadding": "2",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Thu Aug 24 2023 17:50:08 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">With our third-annual Diversity, Equity and Inclusion (DE&amp;I) Summit, we emphasized to employees that</span> <span style=\"color: #ffb500;\"><span class=\"futura-bold\">each of us has the power to advance DE&amp;I and build a more inclusive culture here at Stryker.</span></span></span></p>\n",
          "jcr:lastModified": "Thu Aug 24 2023 17:58:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "showDimensionalBox": "true",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Thu Aug 24 2023 17:50:08 GMT+0000",
          "text": "<p><br>\nThousands of employees attended. In a series of intimate conversations, attendees heard their colleagues share stories about how their unique life experiences have brought them to where they are today – and what they did with the opportunities once they got there. We heard what allyship truly means from co-workers who found support when they needed it most, allowing them to bring their authentic selves to work. We heard how women engineers at Stryker, several of whom have been patients themselves, are a driving force behind our advancements in women’s healthcare.<br>\n&nbsp;</p>\n",
          "jcr:lastModified": "Thu Aug 24 2023 17:58:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
