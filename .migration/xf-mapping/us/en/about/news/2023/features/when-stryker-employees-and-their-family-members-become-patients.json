      "jcr:created": "Tue Sep 05 2023 20:17:44 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Carolyn’s hip replacement</span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Stryker employee Carolyn Fahey knew what it was like to be a patient – well before she became one herself.&nbsp;“As a former orthopaedic surgery nurse, I was the customer,”&nbsp;Carolyn said.&nbsp;“I have done the job.”&nbsp;But when her hip began causing her pain, she thought nothing of it – before it was too late and she required a full hip replacement.</span></span></p>\n",
      "jcr:lastModified": "Thu Sep 21 2023 15:53:41 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
