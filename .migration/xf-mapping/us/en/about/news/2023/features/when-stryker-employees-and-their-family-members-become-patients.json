        "largeheadline_copy53": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "garrett.fitzsimmons@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">Together with her daughter, Stryker employee Jordan Hartmann, Emily began exploring options for a <a href=\"https://www.stryker.com/us/en/portfolios/orthopaedics/craniomaxillofacial.html\">jaw replacement</a>. Ultimately, her surgeon not only restored her function but helped her feel beautiful again.</span></span>",
          "jcr:lastModified": "Tue Sep 05 2023 20:29:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
