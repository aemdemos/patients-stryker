        "item1089953560363234": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "garrett.fitzsimmons@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"urw-egyptienne\"></span> ",
          "line2": "<p><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">“</span></span><span style=\"font-size: 21.0px; background-color: transparent; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\">To have [the procedure] be successful and to be functional [with] no pain was just an answer to prayer.</span></span></span><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">”</span></span><br>\r\n</p>\r\n<p>______________<br>\r\n<br>\r\n<span style=\"font-size: 21.0px;\"><b><span class=\"futura-bold\"><span style=\"color: rgb(0,0,0);\">Emily</span></span></b></span></p>\r\n",
          "jcr:lastModified": "Fri Sep 15 2023 19:07:07 GMT+0000",
