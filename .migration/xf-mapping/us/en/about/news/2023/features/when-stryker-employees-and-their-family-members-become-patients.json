        "largeheadline_copy53": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "garrett.fitzsimmons@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">Even though most sudden cardiac arrests occur at home, owning a home <a href=\"https://www.stryker.com/us/en/emergency-care/community-public-safety.html\">AED</a> is extremely uncommon. Luckily for Esley, with the help of an AED they keep in their kitchen pantry, each of his family members played a role in saving his life when a sudden cardiac arrest struck.</span></span>",
          "jcr:lastModified": "Tue Sep 05 2023 20:20:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
