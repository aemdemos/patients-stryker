          "line1": "<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">After Jesse’s surgery, our <a href=\"https://www.stryker.com/us/en/orthopaedic-instruments/products/zip-skin-closure.html\">Zip skin closure</a> provided him with more comfort, fewer scars and a quicker recovery so he could get back to his aerobic activities.</span></span>",
          "jcr:lastModified": "Tue Sep 05 2023 21:02:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
