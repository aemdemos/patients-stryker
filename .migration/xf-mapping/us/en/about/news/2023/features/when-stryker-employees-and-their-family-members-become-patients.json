        "item1089953560363234": {
          "jcr:primaryType": "nt:unstructured",
          "topPadding": "5",
          "jcr:lastModifiedBy": "garrett.fitzsimmons@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"urw-egyptienne\"></span> ",
          "line2": "<p><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">“</span></span><span style=\"font-size: 21.0px; background-color: transparent; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\">If it wasn’t for that AED, I don’t know if I would mentally be here.</span></span></span><span class=\"futura-bold\" style=\"font-size: 21.0px; background-color: transparent;\"><span style=\"color: rgb(255,181,0);\">”</span></span><br>\r\n</p>\r\n<p>______________<br>\r\n<br>\r\n<span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Esley</span></span></span></span><br>\r\n</p>\r\n",
          "jcr:lastModified": "Fri Sep 15 2023 19:06:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
