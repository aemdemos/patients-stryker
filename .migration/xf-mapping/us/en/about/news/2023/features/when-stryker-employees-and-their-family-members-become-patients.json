      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Jesse’s Zip skin closure</span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">After recovering from leukemia, Stryker employee Jesse Decker was ready to get back to his active lifestyle. However, his doctor let him know that his hip wasn’t ready for physical activity and that he would need hip resurfacing surgery.</span></span><br>\n</p>\n",
      "jcr:lastModified": "Thu Sep 21 2023 15:53:21 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
