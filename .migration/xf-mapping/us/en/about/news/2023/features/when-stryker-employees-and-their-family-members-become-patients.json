      "jcr:created": "Tue Sep 05 2023 20:17:44 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Emily’s jaw replacement</span></span></h2>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">In 2007, Emily Hartmann began experiencing muscle spasms in her jaw. She endured years of pain, avoiding talking and relying on liquid diets. She was eventually diagnosed with a rare disorder called Parry-Romberg syndrome, which causes the slow deterioration of the skin and soft tissue in half the face<sup>1</sup>.</span></span><br>\n</p>\n",
      "jcr:lastModified": "Thu Sep 21 2023 15:53:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
