    "cols2_copy_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "jcr:created": "Thu Feb 09 2023 19:47:17 GMT+0000",
      "jcr:lastModified": "Thu Feb 09 2023 19:47:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "preset": "max_width_auto",
          "jcr:created": "Fri Jan 27 2023 19:18:03 GMT+0000",
          "alt": "Patrick Fisher, headshot",
          "srcFileRef": "/content/dam/stryker/about/news/2023/features/delivering-a-more-efficient-experience-for-surgeons-and-patients-in-ambulatory-surgery-centers/images/PF-headshot.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Oct 06 2023 15:25:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false",
          "cq:responsive": {
