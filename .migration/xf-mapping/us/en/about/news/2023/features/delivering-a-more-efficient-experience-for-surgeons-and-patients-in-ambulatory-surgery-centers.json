              "gradientDirection": "left-to-right",
              "line1": "<div style=\"text-align: left;\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-2vw\">Delivering a more efficient experience for surgeons and patients in ambulatory surgery centers</span></span></span></span></div>\r\n",
              "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\"><br>\r\n Stryker’s Vice President and General Manager of Foot &amp; Ankle gets detailed about our Pulse Intelligent Delivery Platform</span></span>",
              "jcr:lastModified": "Mon Oct 09 2023 15:11:30 GMT+0000",
              "sling:resourceType": "stryker/components/content/largeheadline",
