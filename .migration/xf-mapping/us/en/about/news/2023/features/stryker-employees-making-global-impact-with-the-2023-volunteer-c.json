          "alt": "Group photo",
          "srcFileRef": "/content/dam/stryker/about/news/2023/features/stryker-employees-making-global-impact-with-the-2023-volunteer-challenge/Jennifer Rodriguez 3.jpeg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Aug 08 2023 15:07:02 GMT+0000",
