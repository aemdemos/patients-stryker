      "jcr:created": "Mon Sep 26 2022 13:40:17 GMT+0000",
      "text": "<p><b>About Stryker<br>\n </b>Stryker is one of the world’s leading medical technology companies and, together with its customers, is driven to make healthcare better. The company offers innovative products and services in Medical and Surgical, Neurotechnology, Orthopaedics and Spine that help improve patient and healthcare outcomes. Alongside its customers around the world, Stryker impacts more than 130 million patients annually.&nbsp;</p>\n<p>More information is available at <a href=\"/content/stryker/us/en/orthopaedic-instruments/products/ortho-q-guidance-system.html\">www.stryker.com</a>.&nbsp;<br>\n&nbsp;</p>\n",
      "jcr:lastModified": "Tue Jul 11 2023 18:02:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
