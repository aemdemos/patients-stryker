          "alt": "Brandon Jominy, headshot",
          "srcFileRef": "/content/dam/stryker/about/news/2023/kers-journey-to-zero-harm-continues-with-neptune-s/Jominy_Final.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Aug 16 2023 19:03:58 GMT+0000",
