        "experiencefragment": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7065227e84@example.invalid",
          "jcr:lastModifiedBy": "user-a6c55eaa2a@example.invalid",
          "jcr:created": "Fri Feb 10 2023 18:56:47 GMT+0000",
          "text": "More about Stryker’s Journey to Zero harm Alongside The Joint Commission, a nonprofit committed to quality improvement and patient safety in healthcare, Stryker has committed to several zero goals in the operating room: blind spots, surgical smoke, retained surgical sponges, drug diversion, splashes and spills, and slips, trips and falls – known collectively as the “Journey to Zero*” harm across the continuum of care. Did you know? Operating rooms generate up to 70% of the total waste produced in hospitals.2 Up to 60% of cases experience splash and spill during collection, removal or disposal of infectious fluid waste.3 Open waste management systems require nearly 3.5 times as much staff time for setup and maintenance during procedures and post-procedure waste disposal.4 Neptune was pioneered by an OR nurse. In 2001 we launched the first-generation Neptune fluid and smoke waste management system as the only constantly closed waste management system on the market.",
          "jcr:lastModified": "Tue Aug 15 2023 18:18:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/corporate/en/about/news/_2023/features/strykers_journey_to_/infographic/master",
          "edsFragmentPath": "/us/en/fragments/stryker/corporate/en/about/news/2023/features/strykers-journey-to/infographic/master"
        }
      }
    },
    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
