    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "jcr:created": "Wed Apr 26 2023 14:08:32 GMT+0000",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">About Stryker</span></span><br>\nStryker is one of the world’s leading medical technology companies and, together with its customers, is driven to make healthcare better. The company offers innovative products and services in Medical and Surgical, Neurotechnology, Orthopaedics and Spine that help improve patient and healthcare outcomes. Alongside its customers around the world, Stryker impacts more than 130 million patients annually. More information is available at <a href=\"http://www.stryker.com\">www.stryker.com</a>.<br>\n<br>\n<span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Media contact</span></span><br>\nLindsay Harris<br>\nGlobal Director, Digital, Marcom and Events<br>\n<a href=\"mailto:lindsay.harris@stryker.com\">lindsay.harris@stryker.com</a><br>\n&nbsp;</p>\n",
      "jcr:lastModified": "Fri Apr 28 2023 16:03:37 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    }
