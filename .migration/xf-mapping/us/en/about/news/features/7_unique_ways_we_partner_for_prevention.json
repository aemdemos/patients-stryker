          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:08:30 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Medics experience frequent spinal loading due to repetitive motions such as lifting, lowering, carrying, and bending. An estimated 34% of EMS work-related injuries are sprain or strain<g class=\"gr_ gr_4 gr-alert gr_gramm gr_inline_cards gr_disable_anim_appear Style replaceWithoutSep\" id=\"4\" data-gr-id=\"4\">, and</g> 35% of these injuries are located in the lower trunk.<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Mon Aug 19 2019 16:41:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
