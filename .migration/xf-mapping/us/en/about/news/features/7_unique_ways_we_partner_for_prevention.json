          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:08:52 GMT+0000",
          "srcFileRef": "/content/dam/stryker/about/news/features/7-unique-ways-we-partner-for-prevention/Challenge5.jpg",
          "jcr:lastModified": "Thu Aug 01 2019 17:06:19 GMT+0000",
