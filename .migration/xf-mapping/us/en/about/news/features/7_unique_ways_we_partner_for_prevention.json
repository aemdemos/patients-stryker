          "jcr:created": "Tue Jul 30 2019 19:15:01 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Using a smart technology like the <a href=\"/content/stryker/us/en/surgical/products/surgicount-safety-sponge-system.html\">SurgiCount Safety Sponge System</a> verifies <g class=\"gr_ gr_3 gr-alert gr_gramm gr_inline_cards gr_disable_anim_appear Grammar only-ins replaceWithoutSep\" id=\"3\" data-gr-id=\"3\">removal</g> of each individually barcoded sponge to ensure all sponges are accounted for with evidence-based outcome.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Aug 19 2019 16:52:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
