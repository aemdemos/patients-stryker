        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:08:30 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">With 2.5 million patients treated for hospital-acquired pressure injuries annually in the U.S.<sup>4</sup>, the cost of treatment is on the rise. Pressure injury care in the U.S. approaches $11 billion annually.<sup>5</sup></span><br>\n</p>\n",
          "jcr:lastModified": "Thu Aug 01 2019 19:24:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "largeheadline_copy_c": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:03:52 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(255,255,255);\">Prevention</span></span></span></span>",
          "jcr:lastModified": "Tue Jul 30 2019 19:06:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(182,114,25,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Wed Jul 31 2019 18:27:24 GMT+0000",
          "srcFileRef": "/content/dam/stryker/about/news/features/7-unique-ways-we-partner-for-prevention/Prevention5.jpg",
          "jcr:lastModified": "Thu Aug 01 2019 17:07:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:15:01 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Hospitals can help prevent and treat all pressure injuries (stages 1-4, unstageable and deep tissue injury) with the <a href=\"/content/stryker/us/en/acute-care/products/isolibrium.html\">Isolibrium Support Surface</a> and <a href=\"/content/stryker/us/en/acute-care/products/isotour.html\">IsoTourGel support surface</a>. Unique technology addresses pressure redistribution, shear <g class=\"gr_ gr_5 gr-alert gr_gramm gr_inline_cards gr_disable_anim_appear Punctuation only-ins replaceWithoutSep\" id=\"5\" data-gr-id=\"5\">and</g> moisture. Additionally, the Isolibrium combines this with a clinically relevant pulmonary solution.<sup>6</sup></span><br>\n</p>\n",
          "jcr:lastModified": "Mon Aug 19 2019 16:53:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
