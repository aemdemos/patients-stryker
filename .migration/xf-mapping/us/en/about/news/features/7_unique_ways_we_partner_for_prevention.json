          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:15:01 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">For a proactive approach to fall prevention, our <a href=\"/content/stryker/us/en/acute-care/products/s3.html\">S3 MedSurg Bed</a>, and <a href=\"/content/stryker/us/en/acute-care/products/intouch.html\">InTouch Critical Care bed</a>, combined with the <a href=\"/content/stryker/us/en/acute-care/products/ibed-wireless.html\">iBed Wireless <g class=\"gr_ gr_4 gr-alert gr_spell gr_inline_cards gr_disable_anim_appear ContextualSpelling ins-del multiReplace\" id=\"4\" data-gr-id=\"4\">Smartbed</g> Technology</a> offer enhanced risk monitoring abilities and the tools that help caregivers to respond in a timely manner.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Aug 19 2019 16:55:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
