        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:08:30 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">It's estimated that 500,000 workers are exposed to laser and electrosurgical smoke each year,<sup>7&nbsp;</sup>putting them at risk for chronic bronchitis, carcinoma, leukemia, cardiovascular <g class=\"gr_ gr_3 gr-alert gr_spell gr_inline_cards gr_disable_anim_appear ContextualSpelling ins-del\" id=\"3\" data-gr-id=\"3\">disfunction</g> and more.</span><br>\n</p>\n",
          "jcr:lastModified": "Thu Aug 15 2019 14:48:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "largeheadline_copy_c": {
