        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:15:01 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">We developed a solution that protects staff and their patients from surgical smoke while improving workflow at the same time.<sup>8&nbsp;</sup><a href=\"/content/stryker/us/en/surgical/products/neptune-e-sep-smoke-evacuation-pencil.html\">Neptune SafeAir</a> supports surgical smoke evacuation in the O.R.</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Aug 19 2019 16:53:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
