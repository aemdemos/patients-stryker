        "text_306536357": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:15:01 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">We design products to help you save lives and your back during transport. Our industry-leading powered ambulance cot, the <a href=\"/content/stryker/us/en/emergency-care/products/power-pro-xt.html\">Power Pro-XT</a> assists you in lifting and lowering the cot. While <a href=\"/content/stryker/us/en/emergency-care/products/power-load.html\">Power-LOAD</a>, our powered cot fastener system, helps boost safety by supporting the cot throughout loading and unloading. The reduction in spinal load helps prevent cumulative trauma injuries.</span></p>\n",
          "jcr:lastModified": "Mon Aug 19 2019 16:51:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
