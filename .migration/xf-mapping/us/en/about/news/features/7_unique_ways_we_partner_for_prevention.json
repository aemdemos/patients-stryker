          "sling:resourceType": "stryker/components/content/standaloneimage",
          "linkInternal": "/content/stryker/us/en/portfolios/medical-surgical-equipment/cleaners-and-disinfectants"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:05:16 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">To combat infection, we offer a slate of cleaners and disinfectants like <a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/cleaners-and-disinfectants.html\">Blu62</a> that are formulated to optimize equipment and instrument lifespan, while supporting the need to meet evidence-based cleaning and disinfecting standards.</span></p>\n",
          "jcr:lastModified": "Tue May 12 2026 15:00:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
