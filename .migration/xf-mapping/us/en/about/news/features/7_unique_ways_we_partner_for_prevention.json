        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:08:30 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">While being treated in a hospital, roughly 850,000 patients experience a fall.<sup>9&nbsp;</sup>On average, there is a fall injury every 13 seconds.<sup>10</sup> We know fall prevention is a top priority for our customers.</span><br>\n</p>\n",
          "jcr:lastModified": "Thu Aug 01 2019 19:24:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
