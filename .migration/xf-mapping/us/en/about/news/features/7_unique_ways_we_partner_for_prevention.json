          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Tue Jul 30 2019 19:07:23 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">So we created a secure alternative for drug waste: the <a href=\"/content/stryker/us/en/surgical/products/cactus-controlled-substance-waste-management-system.html\">Cactus Smart Sink System</a>. The Cactus Smart Sink System automatically secures and renders controlled substance waste unusable and non-retrievable while providing a secured bridge from traditional drug disposal to proper and responsible disposal.</span></p>\n",
          "jcr:lastModified": "Mon Aug 19 2019 16:50:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
