          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "gradientDirection": "left-to-right",
          "line2": "<span class=\"fontsize-1-5-vw\">Studies show that the rate of survival from sudden cardiac arrest decreases by 10% every minute without intervention.<sup>1</sup> Thankfully, Bennett’s coaches and emergency responders acted quickly to restart his heart when he collapsed at baseball practice. Watch how, miraculously, first responders restarted Bennett’s heart: three times.</span>",
          "jcr:lastModified": "Wed Sep 15 2021 19:02:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
