        "largeheadline_copy53": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-1-5-vw\">Studies show the rate of survival from sudden cardiac arrest decreases by 10% for every minute without intervention.<sup>1</sup>&nbsp;Miraculously, after 80 minutes of continuous CPR with the LUCAS chest compression system and critical care from emergency caregivers, Matt regained his pulse and started breathing.</span>",
          "jcr:lastModified": "Wed Jul 28 2021 19:50:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
