  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "danielle.smith@stryker.com",
    "text": "<p>80 years ago, Dr. Homer Stryker started working with healthcare professionals to make healthcare better. Today it’s an honor to continue his legacy by partnering with doctors to develop solutions for their patients.</p>\n<p>The following stories highlight doctors whose knowledge and commitment to their community have impacted the patient in the story, and countless others. Thank you for providing us with inspiration when we need it the most.</p>\n<p>Meet Professor Ton Tran, Professor Oheneba Boachie-Adjei, Dr. Vernon Burke and Dr. Anne Peled.<br>\n</p>\n",
    "jcr:lastModified": "Mon Mar 29 2021 20:12:45 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
