      "gradientDirection": "left-to-right",
      "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2vw\">Stryker aims to improve healthcare with IoT solutions</span></span>",
      "jcr:lastModified": "Thu Jul 11 2019 17:07:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,181,0,1)",
