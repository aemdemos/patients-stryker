    "text_774605157": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "jcr:created": "Thu Jul 11 2019 15:41:51 GMT+0000",
      "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">“To be a good partner for our customers, we must continually evolve the ways in which we deliver value.”&nbsp;</span></span><br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1em\">-&nbsp; Matt Powell, Senior Director, Connected Care</span></span></p>\n",
      "jcr:lastModified": "Fri Jul 26 2019 17:12:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
