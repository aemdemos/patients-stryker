      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Thu Aug 22 2019 19:54:55 GMT+0000",
      "jcr:lastModified": "Thu Aug 22 2019 19:54:55 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
