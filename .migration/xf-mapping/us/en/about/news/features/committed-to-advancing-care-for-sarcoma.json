          "jcr:created": "Fri Jun 19 2020 18:57:45 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2vw\"><span style=\"color: #ffffff;\">“Stryker wants to be at the forefront of the battle.”</span></span><br>\r\n<span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(255,255,255);\"><br>\r\n <span style=\"color: #ffb500;\">- Lee Roy Selmon Jr.</span></span></span></span>",
          "jcr:lastModified": "Fri Jun 19 2020 19:30:06 GMT+0000",
