          "jcr:created": "Fri Jun 19 2020 19:14:01 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\">July is Sarcoma Awareness Month.&nbsp;</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\">We stand alongside the healthcare community, patients and their loved ones to recognize and bring attention to &quot;the forgotten cancer&quot;<sup>1</sup>. Sarcoma is rare, but the passion that fuels our employees is not. We're committed to advancing care and inspiring hope.</span></p>\r\n",
          "jcr:lastModified": "Mon Jun 29 2020 21:30:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
