          "leftPadding": "17",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Thu Jan 14 2021 19:17:24 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Do you know a nurse who goes above and beyond?<span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><br>\n </span>Nominate a&nbsp;heroic healer&nbsp;today<br>\n &nbsp;</span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Throughout the year we will select the stories of several standout nurses to feature&nbsp;in our Caregiver Stories series.<br>\n <br>\n We know all caregivers are amazing. Please be sure to include what truly sets your nominee apart from all the other incredible caregivers out there.&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Mon May 10 2021 15:26:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "5"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
