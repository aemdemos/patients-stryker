          "jcr:created": "Mon Dec 02 2019 19:24:41 GMT+0000",
          "useProduction": "true",
          "message": "Thank you for your nomination. If your nominee is selected, you will be notified by Feb 28. \r\n\r\nTogether with our customers, we are driven to make healthcare better.",
