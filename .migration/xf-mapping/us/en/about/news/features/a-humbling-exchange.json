      "jcr:lastModified": "Mon Mar 09 2020 19:04:50 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "garrett.shue@stryker.com",
          "jcr:created": "Wed Feb 26 2020 20:13:02 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">A humbling exchange</span><br>\n </span></span></span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">__________________________________________________________________</span></span></span></p>\n<p><span class=\"fontsize-2em\">Professor Ton Tran grew up in Vietnam. As a teenager, his family risked their lives fleeing the country during political unrest, escaping as refugees and settling in Australia. Against all odds, Professor Tran proceeded to learn English, attend school and become one of Australia’s top trauma surgeons. But this story goes far beyond the operating room.&nbsp;&nbsp;</span><br>\n</p>\n",
          "jcr:lastModified": "Mon Mar 09 2020 19:05:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
