          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2vw\"><span class=\"urw-egyptienne\">&quot;Our feedback loop was continuous — that was important — we didn't want to take for granted that we had enough input.&quot;</span></span>",
          "line2": "<br>\r\n<span class=\"futura-bold\">Kyle Walberg</span><br>\r\nProgram Manager, Stryker<br>\r\n<br>\r\n<br>\r\n<br>\r\n",
          "jcr:lastModified": "Wed Sep 18 2019 16:00:31 GMT+0000",
