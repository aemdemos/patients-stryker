      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Sep 18 2019 13:55:10 GMT+0000",
          "srcFileRef": "/content/dam/stryker/about/news/sonopet-iq/images/Dr. Zada edit.png",
          "jcr:lastModified": "Wed Sep 18 2019 18:07:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Sep 18 2019 15:51:32 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">“I was asked to [offer] customer feedback at multiple … scientific and neurosurgical meetings going back over the last five years. What I am seeing as the final product is a really fantastic blend overall of some of the best features that I would have hoped for.”</span></span></p>\n<p><span class=\"futura-bold\">Gabriel Zada, M.D. </span><br>\n<span class=\"urw-egyptienne\">Associate Professor of Neurological Surgery <br>\n Keck School of Medicine, University of Southern California <br>\n Stryker consultant</span></p>\n",
          "jcr:lastModified": "Wed Sep 18 2019 18:08:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Sep 18 2019 13:45:45 GMT+0000",
          "srcFileRef": "/content/dam/stryker/about/news/sonopet-iq/images/Dr Figuero edit.png",
          "jcr:lastModified": "Wed Sep 18 2019 18:07:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Sep 18 2019 15:49:26 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">“It’s exciting to see something coming online that is such a unique blend of the engineering know-how and modifications that have been made in anticipation of surgeon’s needs. [While] also incorporating the direct surgeon input and that of the operating room staff.”</span></span></p>\n<p><span class=\"futura-bold\">Bryan Figueroa, M.D. </span><br>\n<span class=\"urw-egyptienne\">Surgical Director, Comprehensive Stroke Program Metro Health, <br>\n University of Michigan Health <br>\n Director of Cranial and Cerebrovascular Neurosurgery <br>\n Saint Mary’s Health Center <br>\n Stryker consultant</span></p>\n",
          "jcr:lastModified": "Wed Sep 18 2019 18:08:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Sep 18 2019 15:37:18 GMT+0000",
          "srcFileRef": "/content/dam/stryker/about/news/sonopet-iq/images/Dr Prevedello edit.png",
          "jcr:lastModified": "Wed Sep 18 2019 18:07:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Sep 18 2019 15:46:33 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">“The collaboration with Stryker developing Sonopet has been great. I like that Stryker listened to us, [which] is very important when I express a need in the operating room. And at all levels I noticed that there is this commitment to really push and listen to the surgeon. Over the years I have been giving ideas and feedback…and the fact that Stryker listened to us, it does feel [like] its designed for us.”</span></span></p>\n<p><span class=\"futura-bold\">Daniel Prevedello, M.D. </span><br>\n<span class=\"urw-egyptienne\">Professor, Dept. of Neurological Surgery,<br>\n Director, Minimally Invasive Cranial Surgery Program,<br>\n The Ohio State University Wexner Medical Center<br>\n Stryker consultant</span></p>\n",
          "jcr:lastModified": "Wed Sep 18 2019 18:08:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    }
  },
