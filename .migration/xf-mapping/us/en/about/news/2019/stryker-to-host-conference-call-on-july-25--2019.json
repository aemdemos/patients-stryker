  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "nadia.conard@stryker.com",
    "text": "<p>Stryker (NYSE:SYK) announced that it will host a conference call on Thursday, July 25, 2019 at 4:30 p.m., Eastern Time, to discuss the Company's operating results for the quarter ended June 30, 2019 and provide an operational update. Final operating results for the quarter ended June 30, 2019 will be released at 4:05 p.m. that day.</p>\n<p><a href=\"https://investors.stryker.com/press-releases/news-details/2019/Stryker-to-host-conference-call-on-July-25-2019/default.aspx\">See full press release here</a>.&nbsp;</p>\n",
    "jcr:lastModified": "Mon Jun 24 2019 19:00:31 GMT+0000",
