  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
    "text": "<p>Stryker has received the “Don Clifton Strengths-Based Culture Award” from Gallup. The award recognizes workplaces that put the strengths of their leaders and employees at the center of how they work every day.</p>\n<p>A panel of judges selected six companies that successfully integrate the Clifton StrengthsFinder methodology into its performance management framework as well as support employees in discovering and operating in their strengths. Stryker is among the first to receive this new award.</p>\n<p>Find more information about this award and other ways Gallup recognizes top companies by <a href=\"https://www.gallup.com/workplace/311486/strengths-based-culture-award-2020.aspx\">visiting their website.</a></p>\n",
    "jcr:lastModified": "Fri Jun 05 2020 15:21:12 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
