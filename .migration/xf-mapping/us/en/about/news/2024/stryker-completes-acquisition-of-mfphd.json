          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "text_1606269074": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "jcr:created": "Fri Apr 26 2024 18:52:01 GMT+0000",
          "text": "<p><span class=\"futura-bold\">About Stryker<br>\n </span>Stryker is a global leader in medical technologies and, together with its customers, is driven to make healthcare better. The company offers innovative products and services in MedSurg, Neurotechnology, Orthopaedics and Spine that help improve patient and healthcare outcomes. Alongside its customers around the world, Stryker impacts more than 150 million patients annually. More information is available at <a href=\"https://www.stryker.com/us/en/index.html\">stryker.com</a>.</p>\n<p>Stryker Corporation or its affiliates own, use or have applied for the following trademarks or service marks:&nbsp; Stryker; Fortress.&nbsp; All other trademarks are trademarks of their respective owners or holders.</p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Tue May 28 2024 17:32:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
