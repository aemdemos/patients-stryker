        },
        "text_298518024": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Thu Sep 19 2024 19:01:54 GMT+0000",
          "text": "<p><span class=\"futura-bold\">About Stryker<br>\n </span>Stryker is a global leader in medical technologies and, together with its customers, is driven to make healthcare better. The company offers innovative products and services in MedSurg, Neurotechnology, Orthopaedics and Spine that help improve patient and healthcare outcomes. Alongside its customers around the world, Stryker impacts more than 150 million patients annually. More information is available at<span class=\"fontsize-8em\">&nbsp;</span><a href=\"https://www.stryker.com/us/en/index.html\">www.stryker.com</a>.</p>\n<p><span class=\"futura-bold\">Media contact<br>\n </span>Beth Sizemore<br>\nSr. Director, Strategic Communications<br>\n<a href=\"mailto:beth.sizemore@stryker.com\">beth.sizemore@stryker.com</a><br>\n</p>\n",
          "jcr:lastModified": "Mon Sep 30 2024 20:44:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
