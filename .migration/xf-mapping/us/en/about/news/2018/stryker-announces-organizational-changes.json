  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "shannon.cox@stryker.com",
    "text": "<p>Stryker Corporation&nbsp;(NYSE:SYK) announced today that&nbsp;David K. Floyd, Group President, Orthopaedics has notified the Company of his intent to retire on&nbsp;June 30, 2019. Until this date, Mr. Floyd will serve as Group President and Advisor to the CEO and will assist with transitioning his responsibilities to our newly appointed leaders while also contributing to strategic growth projects.</p>\n<p>See full press release <a href=\"https://investors.stryker.com/press-releases/news-details/2018/Stryker-announces-organizational-changes/default.aspx\">here</a>.&nbsp;</p>\n",
    "jcr:lastModified": "Mon Mar 11 2019 18:42:48 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  }
