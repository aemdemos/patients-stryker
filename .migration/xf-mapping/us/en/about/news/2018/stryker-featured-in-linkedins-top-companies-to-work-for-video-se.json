  "text": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "nadia.conard@stryker.com",
    "text": "<p>Stryker was featured in LinkedIn’s “Top Companies to Work For” video series after being ranked No. 30 on the 2018 list! LinkedIn bases this list on the billions of actions taken by its 500+ million members in three categories: interest in a company's jobs, interest in a company's brand and employees, and employee retention.</p>\n<p>Watch the <a href=\"https://www.youtube.com/watch?v=yUudMeI_OE8&amp;feature=youtu.be\">full video</a> to hear why people love working for Stryker.&nbsp;</p>\n",
    "jcr:lastModified": "Thu Sep 13 2018 15:08:03 GMT-0400",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  }
