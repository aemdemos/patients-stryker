          "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Thu Dec 09 2021 18:22:43 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\"><br>\n </span></span><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">“</span>I would like to say thank you to anyone who was involved.</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">&nbsp;I don’t think they realize how much they change people’s lives.</span></span><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">”</span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">&nbsp;</span></span><br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">_____________</span><br>\n <br>\n </span></span></span><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">Ellys</span></span><br>\n </span></span><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Maxillofacial patient&nbsp;</span></span></p>\n",
