          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">At 12 years old&nbsp;Ellys&nbsp;noticed that her jaw looked different on her right side compared to her left. Impacting her confidence and social life,&nbsp;Ellys worked with her orthodontist and a surgeon to see if surgery could address the asymmetry.&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Tue Dec 14 2021 18:06:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
