          "jcr:created": "Mon Nov 22 2021 21:34:19 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>Leaders from Stryker’s Women’s Network employee resource group celebrate at the Nov. 10, 2021 event.</p>\n",
          "jcr:lastModified": "Tue Nov 23 2021 14:32:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
