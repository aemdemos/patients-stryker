          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Fri Aug 07 2026 16:06:18 GMT+0000",
          "text": "<p>Glassdoor has recognized Stryker Chair and CEO Kevin Lobo as one of their 50 Best CEOs of 2026, an award given out by the workplace data site that highlights exceptional leaders based entirely on employee feedback.</p>\n<p>The awards are determined using ratings and reviews that U.S. employees have shared on Glassdoor.com during a 12-month eligibility period. Glassdoor then analyzes the quantity, quality and consistency of those reviews to identify the leaders who have earned the highest levels of employee approval and trust.</p>\n<p>Kevin has received top CEO recognition from Glassdoor multiple times since he became our CEO in 2012.</p>\n",
          "jcr:lastModified": "Fri Aug 07 2026 16:06:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
