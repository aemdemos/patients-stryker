          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2vw\">Advancing women <span style=\"color: #ffb500;\">together</span></span></span>",
          "line2": "<span class=\"fontsize-2vw\">SWN improves Stryker's results by fostering an open and inclusive culture, with a focus on attracting, developing and retaining talented women, and driving engagement for all employees.</span>",
          "jcr:lastModified": "Tue Jan 30 2018 09:51:39 GMT-0500",
