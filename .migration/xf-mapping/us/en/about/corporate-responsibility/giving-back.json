          "rightMargin": "5",
          "topMargin": "10",
          "jcr:created": "Tue Jun 21 2022 19:03:13 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\">Contributed in 2024</span></span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2-5em\">$11.3M</span></span></span><br>\n<span class=\"futura-bold\"><span style=\"color: #ffffff;\">contributed*</span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2-5em\">5,700</span></span></span><br>\n<span class=\"futura-bold\"><span style=\"color: #ffffff;\">nonprofits supported</span></span></p>\n<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">11,200</span></span></span><br>\n<span class=\"futura-bold\"><span style=\"color: #ffffff;\">employee donors and volunteers</span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2-5em\">36,000<br>\n </span></span><span style=\"color: #ffffff;\">volunteer hours</span></span></p>\n",
          "jcr:lastModified": "Tue Feb 18 2025 00:44:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "10",
          "backgroundColor": "rgba(133,69,138,1)",
