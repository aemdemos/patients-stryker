          "gradientDirection": "left-to-right",
          "line1": "<h3><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: #ffb500;\">How requests are reviewed</span></span></span></h3>\r\n",
          "jcr:lastModified": "Tue Oct 13 2026 19:55:18 GMT+0000",
