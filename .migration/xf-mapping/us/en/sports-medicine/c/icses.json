          "hideComponent": "false",
          "jcr:created": "Wed Jan 24 2024 19:35:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\">Join Stryker's Sports Medicine and Upper Extremities at ICSES 2026 in Vancouver B.C. Explore our latest advancements in shoulder care from repair to reconstruction, designed to support your surgical goals.&nbsp;</span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\">Dates: September 23-25, 2026</span></li>\n<li><span class=\"fontsize-1-5em\">Location: Vancouver Convention Centre</span></li>\n<li><span class=\"fontsize-1-5em\">Stryker Booth Number: #405</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Aug 18 2026 19:36:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
