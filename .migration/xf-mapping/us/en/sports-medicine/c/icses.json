        "text_copy_copy_27929": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">Beyond the algorithm: navigating complex shoulder instability and rotator cuff cases</span></span></span></p>\n",
          "jcr:lastModified": "Wed Aug 05 2026 18:19:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Thursday, September 24 | 1:30 - 2:30 p.m.</span></span></p>\n<p><span class=\"fontsize-1-25em\">Through a series of case-based presentations and expert-led discussion, faculty will present complex instability and rotator cuff repair cases, highlighting critical decision points, surgical technique considerations, and lessons learned from difficult primary and revision procedures. Through interactive discussion and debate, attendees will explore evolving treatment algorithms, emerging technologies, and review evidence-based approaches intended to support clinical decision-making in high-demand patients.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Faculty: </span>Dr. Rob Hartzler*, Dr. George Athwal*, Dr. Jonathan Levy*, Dr. Jonathan Barlow*, Dr. Richard Lloyd*</span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Location:&nbsp;</span>Vancouver Convention Centre West Building, Level 1 – 116-117</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Aug 12 2026 17:06:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Mon Jun 02 2025 15:43:39 GMT+0000",
          "alt": "Shoulder anatomy illustration",
          "srcFileRef": "/content/dam/stryker/sports-medicine/campaigns/aossm/aossm-shoulder-tile-1200x680.png",
          "borderColor": "rgb(0,0,0)",
          "jcr:lastModified": "Fri May 29 2026 15:14:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">Mako Shoulder: a new standard in arthroplasty&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</span></span></span></p>\n",
          "jcr:lastModified": "Wed Aug 12 2026 17:08:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Wednesday, September 23 | 1:30 p.m. - 2:30 p.m.</span></span></p>\n<p><span class=\"fontsize-1-25em\">Join us at ICSES and experience the future of shoulder arthroplasty with Mako Shoulder. Dr. Michael Amini and Dr. Ruth Delaney will present on their firsthand experience with Mako, sharing clinical insights from cases and key learnings.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Faculty:&nbsp;</span>Dr. Michael Amini, Dr. Ruth Delaney</span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Location: </span>Vancouver Convention Centre West Building, Level 1 – 116-117</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Aug 12 2026 17:07:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
