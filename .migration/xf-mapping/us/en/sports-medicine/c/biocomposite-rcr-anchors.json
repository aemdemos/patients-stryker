    "cols": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "brittany.brady@stryker.com",
      "jcr:lastModifiedBy": "brittany.brady@stryker.com",
      "jcr:created": "Mon Mar 30 2026 16:17:01 GMT+0000",
      "jcr:lastModified": "Mon Mar 30 2026 16:17:01 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "topPadding": "5",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Jan 24 2024 19:35:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">AlphaVent and AlphaVent Knotless</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Advances a trusted foundation, enhanced with dual-thread technology for cortical and cancellous engagement.<sup>1</sup> AlphaVent Knotless incorporates a coupled self-punching anchor system*, with 39% greater ultimate tensile strength** compared to the leading competitor.<sup>1</sup></span></p>\n",
          "jcr:lastModified": "Mon Apr 27 2026 20:38:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "brittany.brady@stryker.com",
      "jcr:lastModifiedBy": "brittany.brady@stryker.com",
      "jcr:created": "Fri Apr 24 2026 17:07:57 GMT+0000",
      "jcr:lastModified": "Fri Apr 24 2026 17:07:57 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_png",
          "jcr:created": "Tue Jun 04 2024 16:22:53 GMT+0000",
          "alt": "AlphaVent Knotless coupled, self-punching anchor system",
          "srcFileRef": "/content/dam/stryker/sports-medicine/campaigns/biocomposite/images/avk-biocomposite-600x600.png",
          "borderColor": "rgb(187,188,188)",
          "jcr:lastModified": "Mon Apr 27 2026 20:46:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Coupled, self-punching anchor system</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Alleviates need for pilot hole creation*</span></li>\n<li><span class=\"fontsize-1-25em\">Coupled eyelet and anchor facilitate streamlined tensioning&nbsp;</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">(AlphaVent Knotless only)</span></p>\n<p>*Pilot hole creation required for hard bone indications. Instrumentation is available for preparation of pilot holes if needed</p>\n",
          "jcr:lastModified": "Mon Apr 27 2026 20:18:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_png",
          "jcr:created": "Tue Jun 04 2024 16:22:53 GMT+0000",
          "alt": "AlphaVent dual-thread technology",
          "srcFileRef": "/content/dam/stryker/sports-medicine/campaigns/biocomposite/images/avk-bioc-bone-anchor.png",
          "borderColor": "rgb(187,188,188)",
          "jcr:lastModified": "Mon Apr 27 2026 20:40:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Dual-thread technology</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Designed to support anchor performance through cortical thread engagement<sup>2</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Provides tactile feedback during cortical thread engagement<sup>2</sup></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Tue Apr 28 2026 20:58:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_png",
          "jcr:created": "Tue Jun 04 2024 16:22:53 GMT+0000",
          "alt": "AlphaVent osteoconductive material design",
          "srcFileRef": "/content/dam/stryker/sports-medicine/campaigns/biocomposite/images/av-avk-biocomposite-osteo-material-600x600.png",
          "borderColor": "rgb(187,188,188)",
          "jcr:lastModified": "Mon Apr 27 2026 20:40:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Osteoconductive material design</span></span></p>\n<p><span class=\"fontsize-1-25em\">Biocomposite 85% Poly(L-Lactide) (PLLA) and 15% Beta-tricalcium phosphate (β-TCP)</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Leverages the osteoconductive properties of β-TCP, paired with the strength of PLLA<sup>2,3,4</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Designed to promote bone healing and bony ingrowth at the implant site<sup>3,5,6,7</sup></span></li>\n<li><span class=\"fontsize-1-25em\"><span data-teams=\"true\">Biocompatibility supported by over a decade of clinical use<sup>7,8</sup></span></span></li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Sun May 03 2026 09:28:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
