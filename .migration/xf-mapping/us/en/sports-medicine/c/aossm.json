        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Mon Jun 02 2025 15:43:39 GMT+0000",
          "alt": "Shoulder anatomy illustration",
          "srcFileRef": "/content/dam/stryker/sports-medicine/campaigns/aossm/aossm-shoulder-tile-1200x680.png",
          "borderColor": "rgb(0,0,0)",
          "jcr:lastModified": "Fri May 29 2026 15:14:53 GMT+0000",
