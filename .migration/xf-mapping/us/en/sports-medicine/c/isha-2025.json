          "preset": "max_width_png",
          "jcr:created": "Wed Aug 20 2025 22:36:03 GMT+0000",
          "alt": "Card with text: Innovations and latest trends in the world of hip preservation",
          "srcFileRef": "/content/dam/stryker/sports-medicine/campaigns/isha-2025/images/hip-innovations-trends-banner.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Aug 25 2025 16:37:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Jun 02 2025 15:43:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Thursday, October 2 | 12:45–13:35</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Location:</span>&nbsp;Room 411/412</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Faculty*:</span>&nbsp;Dr. Michael Salata, Dr. Andrew Wolff, Dr. Shane Nho and Dr. Mario Hevesi</span></p>\n<p>Join our esteemed panel as they discuss the latest technologies, innovations and techniques within hip preservation. They will cover all facets of the process including preoperative work up, intra-operative decision making and technical pearls for the dysplastic patient, extra-articular pathology, FAI and more!</p>\n",
          "jcr:lastModified": "Tue Aug 19 2025 17:28:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "preset": "max_width_png",
          "jcr:created": "Wed Aug 20 2025 22:36:03 GMT+0000",
          "alt": "Card with text: Hip preservation: An international discussion",
          "srcFileRef": "/content/dam/stryker/sports-medicine/campaigns/isha-2025/images/hip-preservation-banner.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Aug 25 2025 16:37:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "jcr:created": "Mon Jun 02 2025 15:43:58 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Friday, October 3 | 12:45–13:55</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Location:&nbsp;</span>Room 411/412</span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Faculty*:</span></span>&nbsp;<span class=\"fontsize-1-25em\">Dr. Andrea Spiker, Dr. Alan Zhang, Dr. Diana Silas, Dr. Thomas Wuerz, Dr. Michael Ellman, Dr. Femi Ayeni, Dr. Nicolas Bonin, Dr. Tony Andrade and Dr. Matthew Brick</span></p>\n<p>Join our global panel to gain insight and listen to discussions and debates about the various trends, challenges and approaches seen from region to region and how patients are being treated around the world. The faculty will discuss various topics within hip preservation during this insightful session.</p>\n",
          "jcr:lastModified": "Mon Aug 25 2025 16:49:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
