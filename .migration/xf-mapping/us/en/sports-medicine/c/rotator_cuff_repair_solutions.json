      "jcr:lastModified": "Wed Jun 04 2025 21:29:12 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline_copy_c": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Wed May 21 2025 21:29:00 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-3-5-vw\">You expect the best in rotator cuff solutions.&nbsp;</span><span style=\"color: rgb(255,181,0); font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; font-size: 49.0px; background-color: transparent;\"><span class=\"futura-bold\">And so do we.</span></span></h1>\r\n",
          "jcr:lastModified": "Fri May 30 2025 18:22:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Mon Jun 30 2025 17:50:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Our rotator cuff repair portfolio offers versatile solutions for a range of pathologies. From the&nbsp;hydroxyapatite and bioglass-coated <b>Iconix HA<sup>+&nbsp;</sup></b>to the minimally-invasive <b>InSpace&nbsp;</b>subacromial balloon spacer and knotless options like <b>Iconix Knotless</b> and <b>AlphaVent Knotless</b>, we deliver technologies designed to address the complexities of partial, full-thickness and massive irreparable rotator cuff repairs (RCTs).</span></p>\n",
          "jcr:lastModified": "Tue Dec 02 2025 17:24:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "largeheadline_copy_1": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "topPadding": "1",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Wed May 21 2025 21:46:54 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">Challenges in Rotator Cuff Repair </span></span></h1>\r\n",
          "jcr:lastModified": "Mon Jun 30 2025 17:54:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "text_copy_1303716808": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "1",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed May 21 2025 21:46:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">The success of rotator cuff repairs varies widely in the literature, with reported failure rates ranging from 34% for small tears to 73% for massive tears.<sup>1</sup> These outcomes are influenced by various factors, including biological patient factors such as poor tissue quality, and mechanical factors such as complex or massive tears and fixation challenges. Our goal at Stryker is to provide you with the right solution for the right patient in their continuum of care. Explore our RCR portfolio below to learn more.</span></p>\n",
          "jcr:lastModified": "Wed Jul 02 2025 13:41:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "curatedcta_copy": {
