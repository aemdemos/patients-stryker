      "backgroundColor": "rgb(255,181,0)",
      "fbleedparsys": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "user-1cc9f530da@example.invalid",
          "topPadding": "2",
          "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
          "jcr:created": "Wed Jan 24 2024 21:14:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h2><span class=\"futura-bold\"><span class=\"fontsize-2vw\">Creating the potential for accelerated bony integration</span></span></h2>\r\n",
          "line2": "<span class=\"fontsize-1-5-vw\">An ovine animal study, comparing Iconix HA<sup>+</sup> to an uncoated all-suture implant, was designed to evaluate the implants with respect to bone ongrowth at 4, 8 and 12 weeks.</span>",
          "jcr:lastModified": "Mon Sep 16 2024 17:05:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
    },
    "text_1555485565": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "2",
      "jcr:createdBy": "user-1cc9f530da@example.invalid",
      "topPadding": "2",
      "jcr:lastModifiedBy": "user-1cc9f530da@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Thu Jan 25 2024 16:24:26 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p>In a blinded histomorphometry analysis at 8 weeks, the uncoated implant showed no integration (n=4), while Iconix HA<sup>+</sup> showed bone integration in all samples (n=4).<sup>13</sup></p>\n",
      "jcr:lastModified": "Thu Feb 08 2024 15:17:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "backgroundColor": "rgba(255,255,255,1)",
      "textIsRich": "true"
    },
