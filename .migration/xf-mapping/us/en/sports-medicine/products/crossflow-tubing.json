              "gradientDirection": "left-to-right",
              "text": "<h3><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Day-use tubing</span></span></h3>\n<p><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\">The day-use inflow cassette tubing is used for a single day's cases (no more than 10 cases, 8 hours of active use or 24 hours from the point of first use)</span></span></p>\n",
              "jcr:lastModified": "Thu Oct 19 2023 16:50:53 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "rightPadding": "5",
              "textIsRich": "true"
