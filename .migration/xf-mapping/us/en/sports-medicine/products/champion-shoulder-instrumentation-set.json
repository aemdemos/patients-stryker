    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Simplistic color coded design to reduce the risk of human error in arthroscopic shoulder cases.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Versatile instruments allow for multiple techniques in bone and tissue preparation as well as suture passage, including loading suture transversely. Razor sharp tips on suture needles allow for ease in tissue penetration.</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Costs are lowered with reusable suture passage instruments (StabiliHook &amp; Cuff Hook) and a reusable suture slider handle designed for single-use needles.</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
