          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-5vw\">HipCheck</span></span>",
          "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">An intra-operative resection planning and execution tool that allows you to measure and resect cam lesions to your desired alpha angle.</span></span>",
          "jcr:lastModified": "Tue Mar 30 2021 22:27:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-1cc9f530da@example.invalid",
          "jcr:created": "Thu Feb 28 2019 18:12:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\">Visualization</span><br>\nIntroduce a visualization tool to the sterile field to localize and address cam pathology on a patient-specific basis.</p>\n<p><span class=\"futura-bold\">Reproducible approach to femoroplasty<br>\n </span>View side-by-side comparison of pre-resection and post-resection fluoroscopy to validate the resection plan was executed.</p>\n",
          "jcr:lastModified": "Tue Mar 30 2021 22:26:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
