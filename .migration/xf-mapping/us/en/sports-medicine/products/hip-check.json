    "cols2_185659253": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-5891a4f69d@example.invalid",
      "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
      "jcr:created": "Thu Feb 28 2019 18:11:19 GMT+0000",
      "jcr:lastModified": "Thu Feb 28 2019 18:11:19 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
          "jcr:created": "Thu Feb 28 2019 18:11:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-5vw\">HipMap</span></span>",
          "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">A pre-operative planning tool that delivers a patient-specific, interactive 3D representation of the hip designed to assist with clinical decision making.</span></span>",
          "jcr:lastModified": "Thu Feb 28 2019 18:13:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-1cc9f530da@example.invalid",
          "jcr:created": "Thu Feb 28 2019 18:12:39 GMT+0000",
          "text": "<p>HipMap is rooted in literature and utilizes complex analytics to provide you with an advanced approach to pre-operative clinical decision making.</p>\n<p><span class=\"futura-bold\">Plan the surgery</span><br>\nHipMap leverages advanced imaging to create a patient-specific, interactive 3D representation of the hip. The full report is delivered in a consumable format complete with cam and pincer analysis, version/torsion measurements, indications for potential instability, 3D heat maps, measurement scales and other visual tools.</p>\n<p><span class=\"futura-bold\">Educate patients</span><br>\nHipMap will help patients understand the pathology affecting their hip joint and will contribute to a more robust discussion on the surgical approach.</p>\n",
          "jcr:lastModified": "Tue Mar 30 2021 22:25:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
