      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Streamline pre-operative planning and intra-operative clinical decision making</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Introduce a visualization tool to your workflow that provides a reproducible approach to femoroplasty</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Bring HipMap into the OR with HipCheck in order to translate planning to execution</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Both tools enable you to communicate differently with your patients</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
