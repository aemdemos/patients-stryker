    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>     </p>\r\n",
    "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
    "jcr:lastModified": "Thu Dec 06 2018 23:53:36 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Curved instrumentation allows for access to the inferior aspect of the glenoid with low profile knot stacks using XBraidTT</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>The small footprint of a 1.4mm PEEK anchor allows for minimal bone removal</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Stryker’s 1.4 platform offers intraoperative flexibility between the 1.4mm Iconix all suture anchors and the 1.4mm NanoTack TT anchor by utilizing the same drill and same curved guides across the platform</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Two-stage fixation yields comparable strength to larger anchors&nbsp;</p>\r\n",
        "textIsRich": "true"
      }
    }
  }
