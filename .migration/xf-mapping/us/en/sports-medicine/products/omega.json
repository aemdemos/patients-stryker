          "gradientDirection": "left-to-right",
          "line1": "<h2><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-4vw\">Accuracy matters</span></span></h2>\r\n",
          "line2": "<span class=\"fontsize-2vw\"><span style=\"color: rgb(255,255,255);\">Omega’s decoupled eyelet design allows for more patient-specific control in your repairs.</span></span>",
          "jcr:lastModified": "Thu Jul 27 2023 03:24:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
