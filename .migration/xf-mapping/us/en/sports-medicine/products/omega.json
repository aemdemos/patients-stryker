        "true",
        "true"
      ]
    },
    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "carissa.frausto@stryker.com",
      "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
      "jcr:created": "Wed Jun 28 2023 17:44:11 GMT+0000",
      "jcr:lastModified": "Wed Jun 28 2023 17:44:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:25:08 GMT+0000",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/omega/images/SYK.SM.StrykerCom.Products.Omega_R5-AssetsProprietaryDecoupledEyelet1.jpg",
          "jcr:lastModified": "Wed Jul 24 2019 19:12:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:25:34 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Proprietary decoupled eyelet</span></span></p>\n<p>The proprietary eyelet is decoupled from the screw and offers distinct advantages. The eyelet design allows it to reposition during suture tensioning and customize its final position based on bone quality.&nbsp;</p>\n",
          "jcr:lastModified": "Wed Jul 24 2019 18:49:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:25:14 GMT+0000",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/omega/images/SYK.SM.StrykerCom.Products.Omega_R5-AssetsUnobstructedCompleteCannulation.jpg",
          "jcr:lastModified": "Mon Jul 22 2019 23:25:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:25:34 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Unobstructed complete cannulation</span></span></p>\n<p>The decoupled eyelet and screw construct and the eyelet’s ability to reposition during suture tensioning allows for unobstructed complete cannulation. The eyelet’s position, unlike some competitive anchors, will not obstruct or plug the distal end of the screw.&nbsp;<br>\n</p>\n",
          "jcr:lastModified": "Mon Jul 22 2019 23:28:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "preset": "max_width_auto",
          "jcr:created": "Mon Jul 22 2019 23:27:03 GMT+0000",
          "alt": "Omega-guiding-suture-path",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/omega/images/SYK.SM.StrykerCom.Products.Omega_new-AssetsGuidingSuturePath.jpg",
          "jcr:lastModified": "Wed Jun 28 2023 17:49:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:25:34 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Guiding suture path</span></span></p>\n<p>The self-punching eyelet delivers the sutures subcortically during pilot hole creation. The resulting suture path may make it easier to identify the aperature of the hole and to deliver and seat the screw efficiently.<br>\n</p>\n",
          "jcr:lastModified": "Wed Jul 24 2019 18:50:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols3_1283780230": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "carissa.frausto@stryker.com",
      "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
      "jcr:created": "Wed Jun 28 2023 17:45:12 GMT+0000",
      "jcr:lastModified": "Wed Jun 28 2023 17:45:12 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:27:07 GMT+0000",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/omega/images/SYK.SM.StrykerCom.Products.Omega_R5-AssetsSelfPunchingEyelet.jpg",
          "jcr:lastModified": "Mon Jul 22 2019 23:27:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:25:34 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Self-punching eyelet</span></span></p>\n<p>The all-PEEK eyelet is preloaded on a self-punching awl which is designed to eliminate the need to drill. Drills, taps and awls are available.&nbsp;<br>\n</p>\n",
          "jcr:lastModified": "Mon Jul 22 2019 23:29:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:27:39 GMT+0000",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/omega/images/SYK.SM.StrykerCom.Products.Omega_R5-AssetsEaseofSizingUp.jpg",
          "jcr:lastModified": "Mon Jul 22 2019 23:27:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Jul 22 2019 23:25:34 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Ease of sizing up</span></span></p>\n<p>The decoupled eyelet and screw construct allows for the surgeon to size up to a larger size screw with ease and fewer steps. The eyelet and sutures stay subcortically while the screw is exchanged without the need to remove the eyelet or rethread the sutures.<br>\n</p>\n",
          "jcr:lastModified": "Mon Jul 22 2019 23:29:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
