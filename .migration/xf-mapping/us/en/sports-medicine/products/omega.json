    "largeheadline": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
      "jcr:created": "Wed Jul 24 2019 18:46:59 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"fontsize-3-5-vw\"><span class=\"urw-egyptienne\">Explore the unique </span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">de-coupled design</span></span></span>",
      "line2": "<span class=\"fontsize-1-5-vw\">The decoupled eyelet design creates a guiding suture path, offering unobstructed cannulation and the ease to size up to a larger screw without removal of the eyelet and sutures.</span>",
      "jcr:lastModified": "Thu Jul 27 2023 03:19:48 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
