        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Primary dog-bone shaped suction path establishes uniform flow around all parts of the suction path<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Hard, heat-treated 17-7 stainless steel for increased stiffness&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Tapered shaft provides a thicker shaft wall while maintaining a small tip diameter</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Optimized active-to-return distance for more intense plasma generation<sup>2</sup>.</p>\r\n",
        "textIsRich": "true"
