  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>&nbsp;&nbsp;</p>\r\n",
    "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
    "jcr:lastModified": "Fri Oct 13 2017 16:32:15 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>A disposable suture passer that incrementally advances the needle for targeted delivery.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Specifically designed cannulas attach to the handle to allow you to gain access to all zones of the meniscus: right/left posterior, right/left middle, right/left anterior.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>High-strength 2-0 UHMWPE suture is designed to meet strength demand.</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Efficient design with single-handed needle advancement requiring less operating assistance.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Visual markings help distinguish the distance traveled before engaging the meniscus.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
