  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Explore the benefits of the VersiPass suture passer</p>\r\n",
    "shortDescTop": "<p>Stryker’s VersiPass is engineered for versatile suture passing across a wide range of soft tissues. Its low-profile design helps to reduce clamping pressure, increase surgeon control and provide improved suture passing.<sup>1</sup></p>\r\n",
