          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Thu Feb 26 2026 18:44:11 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">A)</span></span>&nbsp;&nbsp;<span class=\"urw-egyptienne\">5.0mm DriLok cannula</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">B)</span></span>&nbsp;&nbsp;<span class=\"urw-egyptienne\">1.2mm Xraid TT Violet Co-Braid</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">C)</span></span>&nbsp;&nbsp;<span class=\"urw-egyptienne\">#2 Force Fier White/Blue</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">D)</span></span>&nbsp;&nbsp;<span class=\"urw-egyptienne\">1.4mm XBraid TT White/Blue</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">E)</span></span>&nbsp;&nbsp;<span class=\"urw-egyptienne\">#2 Force Fiber White/Green</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">F)</span></span>&nbsp;&nbsp;<span class=\"urw-egyptienne\">#2 XBraid S, White/Blue</span></span></p>\n",
          "jcr:lastModified": "Thu Feb 26 2026 19:02:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
