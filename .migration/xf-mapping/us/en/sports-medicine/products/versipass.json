          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Thu Feb 26 2026 18:46:41 GMT+0000",
          "text": "<p>The low-profile design allows for access into the joint with the ability to reach more places along the meniscus.</p>\n",
          "jcr:lastModified": "Thu Feb 26 2026 18:47:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Thu Feb 26 2026 18:46:35 GMT+0000",
          "alt": "Feature 2",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/versipass/images/Feature 2 4.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Feb 26 2026 19:45:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Thu Feb 26 2026 18:46:44 GMT+0000",
          "text": "<p>VersiPass suture passer has a bite depth of 12mm and has a laser line across the top and sides of the jaw to indicate where the needle will exit.</p>\n",
          "jcr:lastModified": "Thu Feb 26 2026 18:47:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Thu Feb 26 2026 18:46:38 GMT+0000",
          "alt": "Feature 3",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/versipass/images/Feature 3 4.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Feb 26 2026 19:45:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Thu Feb 26 2026 18:46:47 GMT+0000",
          "text": "<p>The single lever firing mechanism and longer needle length are designed to reduce the chances of a distal misfire.</p>\n",
          "jcr:lastModified": "Thu Feb 26 2026 18:48:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
