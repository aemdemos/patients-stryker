    "cols2_2_3_1_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-98fdffe29c@example.invalid",
      "jcr:lastModifiedBy": "user-98fdffe29c@example.invalid",
      "jcr:created": "Tue Aug 25 2026 16:29:58 GMT+0000",
      "jcr:lastModified": "Tue Aug 25 2026 16:29:58 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-1cc9f530da@example.invalid",
          "jcr:lastModifiedBy": "user-98fdffe29c@example.invalid",
          "jcr:created": "Tue Jun 04 2024 16:22:57 GMT+0000",
          "text": "<div><span class=\"fontsize-1-25em\">Control the OR like never before.</span></div>\n<div>&nbsp;</div>\n<ul>\n<li><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">Provides surgeons with access to relevant clinical data (such as HipMap reports, HipCheck, and CT scans<sup>2</sup>) all within the sterile field to support clinical decision making.<sup>1</sup></span></span></li>\n</ul>\n<ul>\n<li><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">Allows surgeons to customize the orientation and placement of their virtual arthroscopy video screen, HipCheck software feed, HipMap report, and CT scan without physical restrictions.<sup>1</sup></span></span></li>\n</ul>\n<ul>\n<li><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">The surgeon specific, customized OR / cockpit reduces reliance on traditional monitors and supports improved ergonomic alignment.<sup>1</sup></span></span></li>\n</ul>\n<p>*Physical restrictions are defined as other equipment within the OR, room dimensions, the patient, and other people in the OR<sup>1</sup><br>\n</p>\n",
          "jcr:lastModified": "Tue Sep 01 2026 20:15:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
