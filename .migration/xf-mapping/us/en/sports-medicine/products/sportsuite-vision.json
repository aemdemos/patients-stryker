          "jcr:created": "Wed Jan 24 2024 19:35:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Break the physical limits of the OR</span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">A mixed reality operating environment on Apple Vision Pro.</span></span></p>\n<p><span class=\"fontsize-1-25em\">SportSuite Vision allows arthroscopy surgeons to maintain visibility of their natural OR environment, using video see-through technology, while being able to access, display, and position digital tools such as the arthroscope feed, HipCheck, HipMap, and CT scans.<sup>1,2</sup></span></p>\n",
          "jcr:lastModified": "Tue Aug 25 2026 20:03:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
