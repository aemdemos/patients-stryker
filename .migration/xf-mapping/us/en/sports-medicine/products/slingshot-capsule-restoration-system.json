    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Variable suture stitch placement allows for capsular plication.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Customized suture length delivery allows for quick and easy suture retrieval.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Tip options allow you to pass and retrieve varying lengths of suture into multiple locations in the joint through one portal in one pass, potentially optimizing OR time.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
