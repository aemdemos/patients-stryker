          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><b><span class=\"futura-bold\">C.</span> 16mm length </b>allows for multiple points of fixation without screw convergence in double-row repairs.</span></p>\n",
          "jcr:lastModified": "Tue Mar 01 2022 22:26:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
