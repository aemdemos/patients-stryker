              "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
              "hideComponent": "false",
              "jcr:created": "Mon Mar 21 2022 15:49:10 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"fontsize-1-25em\">AlphaVent suture anchor platform offers three anchor sizes and 44 implants. This array of options allows you to utilize the anchor for a multitude of sports medicine procedures.</span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">PEEK (poly-ether-ether-ketone) and biocomposite (85% PLLA, 15% B-TCP) material options<br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">4.75mm, 5.5mm and 6.5mm sizes</span><br>\n</li>\n<li><span class=\"fontsize-1-25em\">Sliding and non-sliding options</span></li>\n<li><span class=\"fontsize-1-25em\">Needled and non-needled options</span></li>\n<li><span class=\"fontsize-1-25em\">Single, double and triple-loaded configurations with suture and tape</span></li>\n<li><span class=\"fontsize-1-25em\">Instrumentation for all bone qualities​​​​</span></li>\n</ul>\n",
              "jcr:lastModified": "Fri Sep 22 2023 20:39:41 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
