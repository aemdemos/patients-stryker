            "gradientDirection": "left-to-right",
            "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-5vw\">AlphaVent</span></span></h1>\r\n",
            "line2": "<h2>Hard-body screw-in anchor platform​</h2>\r\n<h3><span class=\"futura-bold\">​<span class=\"fontsize-2vw\">Confidence in every repair.</span></span></h3>\r\n<div><span class=\"fontsize-1-5-vw\">AlphaVent provides a comprehensive, <span class=\"futura-bold\">versatile</span> and <span class=\"futura-bold\">strong</span> suture anchor offered in PEEK and biocomposite materials for a variety of sports medicine repairs.</span></div>\r\n",
            "jcr:lastModified": "Wed Jul 26 2023 20:31:18 GMT+0000",
            "sling:resourceType": "stryker/components/content/largeheadline",
            "backgroundColor": "rgba(255,255,255,0)",
