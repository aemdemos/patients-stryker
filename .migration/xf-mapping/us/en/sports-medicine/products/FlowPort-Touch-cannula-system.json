      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Tue Sep 23 2025 16:34:22 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-2-5-vw\"><span style=\"color: rgb(255,181,0);\">FlowPort Touch </span></span></span><span class=\"fontsize-2-5-vw\">Cannula system</span></h1>\r\n",
          "line2": "<span class=\"fontsize-1-5-vw\">FlowPort Touch is a polymer-tipped, atraumatic cannula-obturator for hip arthroscopy. FlowPort Touch introduces a new, streamlined workflow that minimizes the number of steps required for joint access. It is designed to mitigate iatrogenic damage caused by numerous spinal needle insertions.</span>",
          "jcr:lastModified": "Wed Oct 22 2025 16:17:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
    },
