              "hideComponent": "false",
              "topMargin": "8",
              "jcr:created": "Fri Sep 12 2025 19:26:30 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h2>Designed to mitigate risk</h2>\n<p><span class=\"fontsize-1-25em\">of iatrogenic damage from repeated needle insertions and deflections<sup>​1</sup></span></p>\n",
              "jcr:lastModified": "Wed Oct 22 2025 15:56:09 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "bottomMargin": "8"
