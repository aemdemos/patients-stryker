              "jcr:created": "Fri Sep 12 2025 19:26:30 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h1>Radiopaque polymer</h1>\n<p><span class=\"fontsize-1-25em\">allows you to enter the joint freely<sup>1</sup></span></p>\n",
              "jcr:lastModified": "Tue Sep 23 2025 17:00:09 GMT+0000",
