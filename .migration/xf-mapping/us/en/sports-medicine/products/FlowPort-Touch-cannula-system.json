              "hideComponent": "false",
              "topMargin": "8",
              "jcr:created": "Fri Sep 12 2025 19:26:30 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h1>All-in-one design</h1>\n<p><span class=\"fontsize-1-25em\">includes cannula, obturator and needle<sup>1</sup></span></p>\n",
              "jcr:lastModified": "Tue Oct 28 2025 17:45:08 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "bottomMargin": "8"
