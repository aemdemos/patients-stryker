        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Wed Feb 15 2023 20:48:43 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">A multitude of configurations</span></span></p>\n<p><span class=\"fontsize-1-25em\">Iconix is available in 14 different suture and anchor tape configurations. Options include 1.4mm and 2.3mm sizes, double and triple loaded, with and without needles, self-punching and non-self-punching, #5 suture, #2 suture, 1.2mm and 2.0mm anchor tapes.</span></p>\n",
          "jcr:lastModified": "Thu Jun 08 2023 21:56:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
