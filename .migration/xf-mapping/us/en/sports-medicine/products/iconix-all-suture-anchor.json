      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "preset": "max_width_png",
          "jcr:created": "Wed Feb 15 2023 20:48:39 GMT+0000",
          "alt": "iconix multitude of configurations",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/iconixallsutureanchorsystem/images/iconix-family-all.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Feb 15 2023 23:00:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
