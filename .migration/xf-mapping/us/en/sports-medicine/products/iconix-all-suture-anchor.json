    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "carissa.frausto@stryker.com",
      "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
      "jcr:created": "Tue Nov 10 2020 04:53:05 GMT+0000",
      "jcr:lastModified": "Tue Nov 10 2020 04:53:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Wed Feb 15 2023 22:04:50 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Self-Punching option</span></span></p>\n<p>Stryker’s Iconix Speed all-suture anchor is designed to eliminate the need to drill and supports precise anchor placement during rotator cuff repair.</p>\n<p><span class=\"fontsize-8em\">*Iconix Speed is only indicated for rotator cuff repair.</span></p>\n",
          "jcr:lastModified": "Thu Jun 08 2023 21:57:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "preset": "max_width_png",
          "jcr:created": "Wed Feb 15 2023 22:05:46 GMT+0000",
          "alt": "Iconix close up tip",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/iconixallsutureanchorsystem/images/ICONIX_Speed_1.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Feb 15 2023 22:09:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Sat Jan 26 2019 01:48:39 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Multiple suture configurations for a variety of techniques.</span></span></p>\n<p><b><span class=\"futura-bold\">Triple loaded&nbsp;</span></b><span class=\"urw-egyptienne\">1.2mm XBraid TT</span></p>\n<p><b><span class=\"futura-bold\">Double loaded&nbsp;</span></b><span class=\"urw-egyptienne\">2.0mm XBraid TT</span></p>\n<p><b><span class=\"futura-bold\">Double loaded&nbsp;</span></b><span class=\"urw-egyptienne\">#2 Force Fiber</span></p>\n<p><b><span class=\"futura-bold\">Combo&nbsp;</span></b><span class=\"urw-egyptienne\">1.2mm and 2.0mm&nbsp;XBraid TT</span></p>\n",
          "jcr:lastModified": "Wed Feb 15 2023 22:20:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
