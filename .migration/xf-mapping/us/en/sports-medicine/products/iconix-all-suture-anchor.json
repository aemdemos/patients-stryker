          "jcr:created": "Wed Feb 15 2023 20:48:39 GMT+0000",
          "alt": "iconix guides",
          "srcFileRef": "/content/dam/stryker/sports-medicine/products/iconixallsutureanchorsystem/images/iconix-guides.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Feb 15 2023 23:00:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "annie.werner@stryker.com",
          "jcr:created": "Wed Feb 15 2023 20:49:21 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Instrumentation</span></span></p>\n<p><span class=\"fontsize-1-25em\">The Iconix all-suture anchor platform offers a variety of drill guide options (2.3mm and 1.4mm) including straight short, straight, 12-degree, 12-degree slant, 25-degree, 25-degree slant and disposable kit options.</span></p>\n",
          "jcr:lastModified": "Mon Apr 24 2023 15:10:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
