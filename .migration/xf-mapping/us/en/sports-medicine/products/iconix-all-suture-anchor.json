          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Wed Feb 15 2023 20:49:27 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Minimal bone removal</span></span></p>\n<p><span class=\"fontsize-1-25em\">With 1.4mm and 2.3mm sizes, the Iconix platform requires minimal bone removal for anchor fixation.&nbsp;</span></p>\n",
          "jcr:lastModified": "Thu Jun 08 2023 21:56:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col4": {
