        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "hideComponent": "false",
          "topMargin": "-3",
          "jcr:created": "Fri Jun 05 2026 21:43:25 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">The Champion and Champion+ Sliders are shuttle suture passers, offered in a variety of curved needles for efficient suture passing and color-coded for easy identification.&nbsp;</span></p>\n<p><span class=\"fontsize-1-25em\">Diamond tip technology holds the nitinol wire in place, allowing the surgeon to grasp easily in the joint space<sup>1</sup> while the anatomical design of the needle facilitates easy access to the desired location<sup>2</sup>.</span></p>\n",
          "jcr:lastModified": "Wed Jul 22 2026 15:55:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
