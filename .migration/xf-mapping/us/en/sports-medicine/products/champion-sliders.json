          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\">Champion and Champion+ Sliders</span></span></h1>\r\n",
          "jcr:lastModified": "Wed Jun 24 2026 23:33:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
