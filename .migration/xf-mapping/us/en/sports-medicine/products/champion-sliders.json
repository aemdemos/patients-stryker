          "hideComponent": "false",
          "rightMargin": "0",
          "topMargin": "5",
          "jcr:created": "Wed Jun 24 2026 21:48:20 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">A)</span></span></span><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"> </span>Champion+ Sliders are available in <span class=\"futura-bold\">7 needle options</span>:</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Crescent</span></li>\n<li><span class=\"fontsize-1-25em\">90° Straight and Tight Curve</span></li>\n<li><span class=\"fontsize-1-25em\">45° Left and Right</span></li>\n<li><span class=\"fontsize-1-25em\">25° Left and Right</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">Champion+ Sliders offer a fully disposable system, designed for single use.</span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">B)</span></span></span><span class=\"fontsize-1-25em\"> <span class=\"futura-bold\">AC Slider needle</span><br>\n Reusable needle for AC joint procedures</span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">C)</span></span></span> <span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Stand-alone disposable handle</span></span><br>\n<span class=\"fontsize-1-25em\">Available to be used with resusable Champion Slider needle tips</span></p>\n",
          "jcr:lastModified": "Tue Jun 30 2026 23:50:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "showDimensionalBox": "true",
          "textIsRich": "true",
          "leftMargin": "0",
          "bottomMargin": "3"
        }
      }
    },
