          "jcr:created": "Thu Feb 26 2026 21:43:38 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Champion Sliders are available in <span class=\"futura-bold\">10 needle options</span>:</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Crescent Medium XL and Large XL for hip arthroscopy</span></li>\n<li><span class=\"fontsize-1-25em\">Crescent Medium and Large</span></li>\n<li><span class=\"fontsize-1-25em\">45° Left and Right</span></li>\n<li><span class=\"fontsize-1-25em\">30° and 60° Straight</span></li>\n<li><span class=\"fontsize-1-25em\">25° Left and Right</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">Champion Slider needles can be reused up to 5 times, making it a cost savings option.</span></p>\n",
          "jcr:lastModified": "Wed Jul 22 2026 16:15:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "showDimensionalBox": "true",
