    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Hip specific length and robust shaft designed to accommodate most patient sizes and offer confidence addressing the hip capsule.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Extremely sharp blade allows for ease of cutting through tough capsule tissue and ergonomic handle allows for control and comfort in precision cutting.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Single body construction designed to minimize the potential for blade breakage and single-use sharpness allows for reproducible performance.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
