    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>The NanoPass small puncture footprint, approximately half the size of a typical suture passer*, offers minimal labrum disruption.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Mattress, intra-labral or simple stitch may be accommodated as well as various labral pathologies with the multiple tip shapes.</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Delivers and retrieves sutures via a single portal and is designed to allow for close approximation to the acetabular rim.</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
