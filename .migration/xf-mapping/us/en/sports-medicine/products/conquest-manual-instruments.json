    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>The Conquest set includes sharp, highly durable components with extremely tight tolerances, combined to create the ultimate tissue resection tool.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Heat-treated stainless steel offers excellent strength, while wire EDM technology provides sharp edges on all cutting surfaces.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Stryker’s exclusive contoured meniscal crescent design provides surgeons easy access in difficult-to-reach posterior areas of the meniscus, while ninety degree rotary punch enables surgeons to access anterior to medial third of the meniscus.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
