          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">G.</span>&nbsp;AO quick connect</b></span></p>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:30:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-8em\">Important: Make certain to avoid inserting the guide rod too far into wire driver and gripping the nitinol suture loop.</span></p>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:31:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
