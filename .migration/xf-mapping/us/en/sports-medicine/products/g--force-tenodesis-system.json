    "cols3_487725794_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "carissa.frausto@stryker.com",
      "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
      "jcr:created": "Thu Mar 10 2022 19:34:48 GMT+0000",
      "jcr:lastModified": "Thu Mar 10 2022 19:34:48 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">A.</span>&nbsp;Cannulated reamers</b></span></p>\n<ul>\n<li><span class=\"fontsize-1em\">4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5 and 8mm</span></li>\n<li><span class=\"fontsize-1em\">Drills over the suture loop guide rod</span></li>\n<li><span class=\"fontsize-1em\">Color-coded with tissue protector and drivers</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:31:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">B.</span>&nbsp;Driver shafts</b></span></p>\n<ul>\n<li><span class=\"fontsize-1em\">Protruding tip allows easy bone hole location</span></li>\n<li><span class=\"fontsize-1em\">Tapering allows snug screw driving with easy driver removal</span></li>\n<li><span class=\"fontsize-1em\">Color-coded with tissue protector and reamers</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:31:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">C.</span>&nbsp;Ratcheting handle</b></span></p>\n<ul>\n<li><span class=\"fontsize-1em\">Provides fast, easy, smooth screw insertion</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:31:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Fri Feb 24 2023 14:24:52 GMT+0000",
      "jcr:lastModified": "Fri Feb 24 2023 14:24:52 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">D.</span>&nbsp;Tendon sizer</b></span></p>\n<ul>\n<li><span class=\"fontsize-1em\">Allows for quick, accurate, consistent tendon measurements</span></li>\n<li><span class=\"fontsize-1em\">Color-coded with reamers, drivers and tissue protectors</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:31:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">E.</span>&nbsp;Suture loop guide rod</b></span></p>\n<ul>\n<li><span class=\"fontsize-1em\">Provides guidance for bone hole drilling</span></li>\n<li><span class=\"fontsize-1em\">Includes a braided nitinol loop for suture passing</span></li>\n<li><span class=\"fontsize-1em\">Ideal for intraoperative tendon tensioning</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:32:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Tue Mar 01 2022 21:33:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">F.</span>&nbsp;Tissue protector handle</b></span></p>\n",
          "jcr:lastModified": "Fri Feb 24 2023 14:30:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
