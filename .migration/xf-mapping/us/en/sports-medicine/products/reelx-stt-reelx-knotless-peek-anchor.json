    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Proximal PEEK eyelet design helps avoid bone abrasion from sutures.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Allows for patient-specific tissue tensioning with the simplistic locking mechanism giving greater control over repairs.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Optional instrumentation for insertion provides interoperative efficiency, and the expanding anchor body is designed to provide enhanced fixation.</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
