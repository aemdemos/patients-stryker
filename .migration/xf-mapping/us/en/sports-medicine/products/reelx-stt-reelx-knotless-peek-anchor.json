        "text_copy_1007088104": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Thu Apr 21 2022 20:54:53 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #85458a;\">A</span></span><span class=\"urw-egyptienne\"> – ​Proximal PEEK eyelet design helps avoid bone abrasion from sutures</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #85458a;\">B</span></span><span class=\"urw-egyptienne\">&nbsp;– Sharp self-punching metal tip designed to allow anchor insertion with or without instrumentation, providing interoperative efficiency</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #85458a;\">​C</span></span><span class=\"urw-egyptienne\">&nbsp;–&nbsp;Pull tabs and tether suture</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\">​D</span></span><span class=\"urw-egyptienne\"> – Tensioning dial expands PEEK body of anchor under the cortical surface<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Tue Jun 27 2023 16:09:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
