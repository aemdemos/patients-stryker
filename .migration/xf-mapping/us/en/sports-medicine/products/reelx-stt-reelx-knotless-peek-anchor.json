          "hideComponent": "false",
          "jcr:created": "Tue Jun 27 2023 16:00:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Discover greater control and enhanced fixation<sup>1</sup> with patient <span style=\"color: #ffb500;\">Specific-Tissue Tensioning</span></span></span></h3>\n",
          "jcr:lastModified": "Tue Jun 27 2023 16:23:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carissa.frausto@stryker.com",
          "jcr:lastModifiedBy": "carissa.frausto@stryker.com",
          "jcr:created": "Tue Jun 27 2023 16:21:05 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-1-25em\">An incremental tensioning system allows for patient specific-tissue tensioning giving greater control over repairs.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">The expanding anchor body is designed to provide enhanced fixation.<sup>1</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jun 27 2023 16:21:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
