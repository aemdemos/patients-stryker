          "jcr:created": "Tue Jun 27 2023 16:00:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">See the ReelX STT design</span></span></h3>\n",
          "jcr:lastModified": "Tue Jun 27 2023 16:20:01 GMT+0000",
