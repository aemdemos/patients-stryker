          "hideComponent": "false",
          "jcr:created": "Wed Jan 24 2024 21:35:04 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2-5em\">ProZip</span>&nbsp;<br>\n </span></span><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"></span></span></span><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\">Knotless All-Suture Implant</span></span></span></span></h1>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\">ProZip is a knotless all-suture implant indicated for soft tissue approximation. It is designed to eliminate knot stacks through a simple and reproducible technique. It can be used in arthroscopic and open procedures.</span></p>\n",
          "jcr:lastModified": "Wed Apr 15 2026 21:37:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        }
      }
    },
