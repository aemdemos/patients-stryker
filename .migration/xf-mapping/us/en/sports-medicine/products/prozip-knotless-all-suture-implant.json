      "jcr:created": "Thu Apr 09 2026 21:47:28 GMT+0000",
      "jcr:lastModified": "Thu Apr 09 2026 21:47:28 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "leftPadding": "5",
          "topPadding": "5",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Thu Apr 09 2026 21:42:47 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\">Eliminates knot stacks.<sup>1</sup></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\">Improved cyclic extension and ultimate tensile strength compared to tested surgeon tied knots with #2 suture &amp; Arthrex’s LoopLoc.<sup>1, 2</sup></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\">Designed to mitigate the variability in ultimate fixation strength and cyclic displacement that can exist from surgeon to surgeon, and knot to knot<sup>1, 2</sup>.</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\">Compatible with the Stryker Injector II &amp; SlingShot<sup>1</sup></span></li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Wed Apr 15 2026 21:45:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        }
      },
