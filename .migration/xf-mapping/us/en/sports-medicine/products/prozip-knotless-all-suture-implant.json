    "cols2_1973616823_cop_747565994": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "jcr:created": "Fri Apr 10 2026 19:36:35 GMT+0000",
      "jcr:lastModified": "Fri Apr 10 2026 19:36:35 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "7",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Apr 10 2026 19:36:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\">When compared to the average tested surgeon tied knots with #2 suture<sup>2</sup>, ProZip provides: <sup>1, 2</sup></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><b>49% (+192N)</b> higher ultimate tensile strength</span></li>\n<li><span class=\"fontsize-1-5em\"><b>19%</b> lower cyclic extension</span></li>\n<li><span class=\"fontsize-1-5em\"><b>4.91mm</b> lower suture construct height&nbsp;</span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Fri Apr 10 2026 22:43:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Apr 10 2026 19:36:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\">When compared to tested Arthrex LoopLoc devices<sup>1</sup>, ProZip: <sup>1</sup></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><b>78% (+274N) </b>higher Ultimate Tensile Strength</span></li>\n<li><span class=\"fontsize-1-5em\"><b>24% </b>lower cyclic displacement</span></li>\n<li><span class=\"fontsize-1-5em\">Requires <b>5 less steps</b> to achieve final knotless fixation&nbsp;</span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Thu May 07 2026 13:41:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        }
      },
