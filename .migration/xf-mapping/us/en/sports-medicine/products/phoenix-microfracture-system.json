    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Designed to reduce the chance of induced fracture by allowing for a larger number of small diameter holes.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Guide configuration, specific to hip, offers targeted access to the chondral defect and is designed to facilitate repeatable, precise bone hole placement.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Designed to extract bone during drilling which may result in greater quantity and quality of repair cartilage and intraoperative efficiency.<sup>1</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
