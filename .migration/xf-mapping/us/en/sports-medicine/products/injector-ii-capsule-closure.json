    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Tailhook suture management system and bite depth of 3.5mm (per side) designed to allow for highly reproducible stitching and stitch depth for controlled tissue apposition even in tough capsule.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Enables complete capsule retraction for optimal viewing and resection of the cam pathology.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Capsule closure capability is designed to achieve normal capsule anatomy.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
