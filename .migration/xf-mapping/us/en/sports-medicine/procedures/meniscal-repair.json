  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>Meniscal preservation is critical for maintaining long-term joint health and function<sup>3,4,5</sup>. From inside-out to all-inside to root repairs and transplants, Stryker’s Meniscal Repair portfolio is built to support a variety of approaches to meniscal preservation.</p>\r\n<p>&nbsp;</p>\r\n<p>No matter the technique, you can count on our comprehensive portfolio to meet your surgical needs.</p>\r\n",
    "jcr:lastModifiedBy": "hannah.white@stryker.com",
    "hideComponent": "false",
    "jcr:lastModified": "Mon Mar 02 2026 18:11:10 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
