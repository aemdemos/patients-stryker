          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Thu Dec 18 2025 21:26:33 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span style=\"color: #323232;\">Clinical communications</span></span></h3>\n<h3>Unifying the human network of care.</h3>\n<p><span class=\"fontsize-1-25em\">With voice activated hands-free communication devices like the Sync Badge, teams stay connected as they work across the hospital. Teams can receive critical information from nurse call systems, EHRs, patient monitors, medical devices, scheduling systems and connected beds and stretchers to help support timely and coordinated response.</span></p>\n",
          "jcr:lastModified": "Tue Feb 10 2026 19:09:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
