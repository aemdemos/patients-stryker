          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Thu Dec 18 2025 21:26:33 GMT+0000",
          "text": "<h3><span data-rte-class=\"rte-temp\"><span class=\"futura-bold\">Connected infrastructure</span></span></h3>\n<h3>Connecting the physical world of care.</h3>\n<p><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">The foundation of the SmartHospital Platform, connected infrastructure keeps patients at the center of everything we do. Across transport, treatment and recovery, our interoperable ecosystem helps enhance care delivery and support clinical and operational workflows from the moment an event occurs through the patient’s arrival in the ED and into inpatient care.</span></span></p>\n",
          "jcr:lastModified": "Tue Feb 10 2026 19:05:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
