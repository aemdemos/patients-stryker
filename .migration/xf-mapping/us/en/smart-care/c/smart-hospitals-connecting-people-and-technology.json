        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Thu Dec 18 2025 21:26:33 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Your digital journey only matters if it leads closer to the patient</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Healthcare is at a turning point. Systems are fragmented. Communication is inefficient. Clinicians face burnout. Care delivery continues to grow more complex, creating a need for a solution that helps unify the hospital into a single smart, adaptive system.</span></p>\n<p><span class=\"fontsize-1-25em\">The <a title=\"Learn more about the SmartHospital Platform\" href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/smart-hospital.html\">SmartHospital Platform</a> acts like an operating system for healthcare. By unifying the technology around care teams, each member can give every moment and every patient their best.</span></p>\n",
          "jcr:lastModified": "Fri Feb 06 2026 17:46:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "curatedcta": {
