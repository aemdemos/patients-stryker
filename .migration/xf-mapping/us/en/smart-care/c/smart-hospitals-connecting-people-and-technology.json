          "jcr:created": "Thu Dec 18 2025 21:26:33 GMT+0000",
          "text": "<h3><span class=\"futura-bold\">Virtual care</span></h3>\n<h3>Extending clinical reach beyond the bedside.</h3>\n<p><span class=\"fontsize-1-25em\">Virtual nursing and virtual monitoring workflows align with your facility’s protocols and processes while supporting bedside staff with tasks such as patient monitoring, rounding, admissions and discharge. These virtual care models can be integrated into daily operations to support patient management, patient safety and ongoing process improvement.</span></p>\n",
          "jcr:lastModified": "Tue Feb 10 2026 19:09:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
