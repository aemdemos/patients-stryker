          "jcr:created": "Tue Jan 14 2025 22:25:51 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Ambient intelligence</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Ambient intelligence transforms care environments into intelligent spaces. Our AI-driven, always-aware ambient sensors continuously monitor activity and conditions within patient rooms, providing clinicians with near-real-time insights. These capabilities can empower informed clinical decision-making throughout the patient journey.</span></p>\n",
          "jcr:lastModified": "Wed Oct 29 2025 12:43:54 GMT+0000",
