          "jcr:created": "Tue Jan 14 2025 22:26:06 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Transform your healthcare environment by redefining how care is delivered</span></span></h2>\n<p><span class=\"fontsize-1-25em\">As part of our SmartHospital Platform, care.ai’s scalable, integrated suite of virtual care and ambient intelligence solutions supports the unique clinical and operational needs of your health system. By automating tasks and connecting clinicians with relevant insights, we help redefine care delivery—scaling seamlessly across your facility and wherever future innovation leads.</span></p>\n",
          "jcr:lastModified": "Wed Nov 26 2025 18:47:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
