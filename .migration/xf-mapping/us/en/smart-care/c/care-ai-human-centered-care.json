          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Virtual care</span></span></h2>\n<p><span class=\"fontsize-1-25em\">The care.ai suite of AI-enabled virtual care solutions, including Virtual Nursing and Virtual Monitoring workflows, is designed to align with your facility’s protocols and processes. From a single virtual command center, virtual nurses or sitters can manage a variety of tasks to support bedside teams in delivering hands‑on care.</span></p>\n",
          "jcr:lastModified": "Wed Oct 29 2025 12:43:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
