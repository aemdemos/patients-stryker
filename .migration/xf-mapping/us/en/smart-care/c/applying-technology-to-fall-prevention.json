        "text_908007915_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "eleni.maistrellis@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "rightMargin": "3",
          "jcr:created": "Thu Sep 10 2020 13:09:36 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span style=\"color: #ffb500;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Applying technology to <span style=\"white-space: nowrap;\">fall prevention</span></span></span></span></h1>\n<p><span class=\"fontsize-1-25em\">This course will focus on evidence-based practices in the utilization of technology for prevention of patient falls and injury management. Participants will be introduced to patient bed technologies and wireless features and learn how the key components of a patient’s bed enable clinical success in reducing patient falls and injury from falls.</span></p>\n<div><p data-slate-node=\"element\" style=\"caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0);\"><b style=\"font-size: 1.25em;\">Course objectives:<b data-rte-class=\"rte-temp\"><b data-rte-class=\"rte-temp\"><b data-rte-class=\"rte-temp\"><b data-rte-class=\"rte-temp\"><span class=\"Apple-converted-space\"></span></b></b></b></b></b></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Define and describe falls in the inpatient setting</span></li>\n<li><span class=\"fontsize-1-25em\">Discuss technology strategies to help minimize falls and fall-related injuries</span></li>\n<li><span class=\"fontsize-1-25em\">Describe implementation barriers in utilizing technology for preventing falls and injury</span></li>\n<li><span class=\"fontsize-1-25em\">Discuss integration of technology into fall and injury prevention practices</span></li>\n</ul>\n</div>\n",
          "jcr:lastModified": "Fri Mar 14 2025 17:28:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "2",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
      }
    },
