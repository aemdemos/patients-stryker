          "jcr:created": "Tue Oct 28 2025 16:25:18 GMT+0000",
          "alt": "A Virtual Nurse calling into a patient's room while an on-site nurse performs bedside care duties",
          "srcFileRef": "/content/dam/stryker/acute-care/products/care-ai/images/virtual-nursing/Offload_Admin_680x400.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Jan 09 2026 17:14:01 GMT+0000",
