          "preset": "max_width_1440",
          "jcr:created": "Tue Oct 28 2025 16:25:18 GMT+0000",
          "alt": "A care.ai sensor attached to the wall",
          "srcFileRef": "/content/dam/stryker/acute-care/products/care-ai/images/Ambient_sensors-care-ai.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jan 07 2026 16:33:16 GMT+0000",
