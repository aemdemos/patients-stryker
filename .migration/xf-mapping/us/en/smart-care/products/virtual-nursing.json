          "srcFileRef": "/content/dam/stryker/acute-care/products/care-ai/images/virtual-nursing/11946350_REV-0_en_us _Consultative_Partnership_680x400_DRAFT-v1.jpg",
          "borderColor": "rgba(76,125,122,1)",
