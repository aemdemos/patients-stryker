    "accordion": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "jcr:created": "Tue Oct 28 2025 16:22:23 GMT+0000",
      "jcr:lastModified": "Tue Oct 28 2025 16:22:55 GMT+0000",
      "sling:resourceType": "stryker/components/content/accordion",
      "accordionsGrid": {
        "jcr:primaryType": "nt:unstructured",
        "1": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 1,
          "accTitle": "What is Virtual Nursing?"
        },
        "2": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 2,
          "accTitle": "How does Virtual Nursing work?"
        },
        "3": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 3,
          "accTitle": "How can Virtual Nursing help a hospital attract and retain nurses?"
        },
        "4": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": 4,
          "accTitle": "Can Virtual Nursing, Virtual Monitoring and Ambient Monitoring happen concurrently in one patient room?"
        }
      },
      "accordion_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">In Virtual Nursing, virtual nurses interact with patients directly via a screen in the patient’s room.&nbsp;Virtual nurses perform top-of-license practices and also support workflows such as admission, rounding, discharge and nurse documentation in accordance with your facility’s protocols and standards.</span></p>\n",
          "jcr:lastModified": "Wed Dec 03 2025 17:07:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Virtual nurses work from a virtual command center supporting a curated task list, which can allow bedside clinical team more time to focus on hands-on patient care.</span></p>\n",
          "jcr:lastModified": "Wed Dec 03 2025 17:07:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Virtual Nursing can help a hospital attract and retain nurses by allowing flexibility in the type of work nurses perform (virtual or hands-on or a combination). Some hospitals have team members who work only as virtual care providers, leveraging an experienced workforce that has retired, or experienced senior nurses who want to move away from bedside acute care but still practice and mentor. Virtual Nursing is a great avenue for experienced nurses to provide mentorship to new practice nurses throughout a facility or health system.</span></p>\n",
          "jcr:lastModified": "Tue Nov 18 2025 16:21:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Yes. Because some patients may need multiple layers of care, Virtual Nursing sessions can be run simultaneously with Virtual Monitoring and/or Ambient Monitoring using a single ambient monitoring sensor.</span></p>\n",
          "jcr:lastModified": "Wed Dec 03 2025 17:08:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
