      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 28 2025 16:25:22 GMT+0000",
          "text": "<h4>Transform healthcare facilities into smart spaces</h4>\n<p><span class=\"fontsize-1-25em\">Always-aware ambient sensors are advanced, AI-driven devices embedded within care environments that act as the eyes, ears and intelligence of care.ai solutions.</span></p>\n<h4>Protect patient privacy</h4>\n<p><span class=\"fontsize-1-25em\">Using computer vision and AI-driven algorithms, sensors continuously monitor activity to autonomously detect presence, motion and behavior without intruding on patient privacy. Ambient sensors capture real-time data, infer patterns and identify deviations. They can notify appropriate care providers if a situation needs attention.</span></p>\n<h4>Help drive standardization and optimize workflows</h4>\n<p><span class=\"fontsize-1-25em\">Sensors can monitor for facility protocol compliance to help drive standardization and optimize clinical and operational workflows.<br>\n </span></p>\n",
          "jcr:lastModified": "Tue Jan 06 2026 15:51:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:responsive": {
