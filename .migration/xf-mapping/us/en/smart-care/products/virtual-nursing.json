          "jcr:created": "Fri Oct 06 2023 13:39:08 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Offload administrative tasks and scale staff with a virtual model</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Virtual nurses interact with patients directly via a screen in the patient’s room and can access pertinent information from the EHR and other integrated systems during virtual care sessions.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Oct 28 2025 16:43:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
