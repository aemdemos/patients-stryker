    "text_copy_copy_copy_": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue Oct 28 2025 16:27:42 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Virtual command center</span></span></h2>\n<p><span class=\"fontsize-1-25em\">The virtual command center is the intelligence hub for care.ai solutions, bringing together virtual care and ambient intelligence into one seamless experience. For virtual care workflows, care providers work from the command center supporting a curated task list or monitoring multiple patients at once.</span></p>\n",
      "jcr:lastModified": "Wed Jan 07 2026 16:28:31 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "2"
    },
    "cols2_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "jcr:created": "Tue Oct 28 2025 16:25:07 GMT+0000",
      "jcr:lastModified": "Tue Oct 28 2025 16:25:07 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Tue Oct 28 2025 16:25:18 GMT+0000",
          "alt": "A nurse talking to a patient through the care.ai intelligence hub",
          "srcFileRef": "/content/dam/stryker/acute-care/products/care-ai/images/virtual-nursing/11946350_REV-0_en_us _Virtual_Command_680x400_DRAFT-v1.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jan 07 2026 16:33:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 28 2025 16:25:22 GMT+0000",
          "text": "<h4>Automate workflows, streamline compliance monitoring</h4>\n<p><span class=\"fontsize-1-25em\">In Ambient Monitoring scenarios, the command center draws on near-real-time data from always-aware ambient sensors. It automates workflows, streamlines facility protocol compliance monitoring and delivers actionable insights that support proactive interventions.</span></p>\n<h4>Get a single source of truth for situational awareness</h4>\n<p><span class=\"fontsize-1-25em\">The command center unifies capabilities, systems and more, delivering predictive intelligence and enterprise-wide visibility to enable smarter, more human-centered care. The command center can integrate with a wide variety of systems like the EHR, nurse call, documentation tools, interpretation services and IoT devices.</span></p>\n<h4>Support flexibility in managing care delivery</h4>\n<p><span class=\"fontsize-1-25em\">The command center’s workflow orchestration tools support flexibility in managing aspects of care delivery like receiving and completing tasks or notifying team members.<br>\n </span>&nbsp;</p>\n",
          "jcr:lastModified": "Fri Jan 09 2026 19:06:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:responsive": {
            "jcr:primaryType": "nt:unstructured",
            "default": {
              "jcr:primaryType": "nt:unstructured",
              "offset": "0",
              "width": "6"
            }
          }
        }
      }
    },
    "text_copy_1243853165": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue Oct 28 2025 16:27:42 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Consultative partnership</span></span></h2>\n<p><span class=\"fontsize-1-25em\">We believe transformation in healthcare requires more than just technology – it requires trusted partnership and deep clinical experience. Our platform is built hand-in-hand with frontline clinicians. We continuously incorporate their insights to address real-world challenges like workforce shortages, administrative burdens and patient safety risks.</span></p>\n",
      "jcr:lastModified": "Wed Jan 07 2026 16:28:36 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "2"
    },
    "cols2_copy_142069860": {
      "jcr:primaryType": "nt:unstructured",
