          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Sat Jun 03 2023 14:14:21 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span>Nurses</span></span> can document to the EHR while receiving filtered, prioritized notifications.</span></span></p>\n",
          "jcr:lastModified": "Wed Jun 21 2023 18:00:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Sat Jun 03 2023 14:14:21 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span>Physicians</span></span>&nbsp;can easily locate and communicate with the nurse and team members supporting their patients, saving time with each connection.</span></span></p>\n",
          "jcr:lastModified": "Mon Jun 05 2023 14:30:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Sat Jun 03 2023 14:14:21 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Get a <span class=\"futura-bold\"><span>unified view</span></span> of all communications, workflow tasks, and digital checklists specific to each patient.</span></span></p>\n",
          "jcr:lastModified": "Mon Jun 05 2023 19:25:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
