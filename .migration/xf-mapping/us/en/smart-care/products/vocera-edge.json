          "jcr:created": "Fri Jun 02 2023 20:28:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span>Clinical communication</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Call or message team members by name, role, group or extension – or from within an&nbsp;electronic health records (EHR) notification</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">See who is calling and why; caller ID presents context including caller, patient and notifications&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Send and receive broadcasts and messages with context about recipients, tagged patients and/or safety concerns&nbsp;</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Wed Jun 21 2023 18:55:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
