          "jcr:created": "Fri Jun 02 2023 20:28:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span>Point of care nurse workflows</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Help save time with the most common EHR documentation workflows and urgent, event-based communication unified in a single smartphone app</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Securely access patient data from the EHR at the point of care and write back directly to the patient record through closed-loop, bi-directional communication</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jun 21 2023 18:55:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
