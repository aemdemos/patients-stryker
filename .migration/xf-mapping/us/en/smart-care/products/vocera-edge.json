          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Sat Jun 03 2023 14:14:21 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span>Team members can communicate and collaborate seamlessly&nbsp;through</span></span>&nbsp;single sign-on, deep linking with Epic’s mobile apps and integration with Epic’s Treatment Team.</span></span></p>\n",
          "jcr:lastModified": "Mon Jun 05 2023 14:30:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_300685201": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Jun 02 2023 20:28:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Epic Rover and Epic Haiku&nbsp;</span></span><br>\n</h3>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Clinical documentation&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Order entry&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Secure chat/text&nbsp;</span></span></li>\n</ul>\n<h3><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Vocera Edge</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Voice and video&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Event notifications&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Physician-centric features&nbsp;</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Jun 22 2023 12:35:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
