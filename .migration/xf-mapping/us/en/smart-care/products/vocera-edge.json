          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Sat Jun 03 2023 14:27:12 GMT+0000",
          "text": "<h2 style=\"text-align: center;\"><span class=\"fontsize-1-5em\">Get more value from your EHR and bring the whole care team together, centered around the patient.</span></h2>\n",
          "jcr:lastModified": "Sat Jun 03 2023 14:28:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
