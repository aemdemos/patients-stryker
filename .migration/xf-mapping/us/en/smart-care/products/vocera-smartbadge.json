        "table": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td style=\"text-align: center;\">2.4&quot; touchscreen with haptic touch call button</td>\n</tr><tr><td style=\"text-align: center;\">89g</td>\n</tr><tr><td style=\"text-align: center;\">100mm x 52mm x 17mm</td>\n</tr><tr><td style=\"text-align: center;\">Swappable battery with 4hrs active life, <i>40 hrs standby</i></td>\n</tr><tr><td style=\"text-align: center;\">Dedicated panic button</td>\n</tr><tr><td style=\"text-align: center;\">Ruggedized&nbsp;for healthcare with IP54 Ingress Protection</td>\n</tr><tr><td style=\"text-align: center;\">Bluetooth-enabled</td>\n</tr><tr><td style=\"text-align: center;\">Dedicated handset receiver</td>\n</tr><tr><td style=\"text-align: center;\">USB-C charging port</td>\n</tr></tbody></table>\n",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Wed May 31 2023 21:11:12 GMT+0000",
          "jcr:lastModified": "Wed Jun 21 2023 15:50:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/table",
          "mobileDesign": "true",
          "textIsRich": "true"
        },
