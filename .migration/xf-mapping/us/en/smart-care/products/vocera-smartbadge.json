          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "jcr:created": "Wed May 24 2023 20:35:35 GMT+0000",
          "text": "<p><span style=\"font-size: 16.25px;\"><b><span style=\"color: #1c5687;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">Clear communication</span></span></span></span></b></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Enjoy smooth, natural bidirectional conversation</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Send and receive secure messages as easily as on a smartphone</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Make and answer calls hands-free</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Communicate safely, even under restrictive PPE</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jul 05 2023 14:43:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
