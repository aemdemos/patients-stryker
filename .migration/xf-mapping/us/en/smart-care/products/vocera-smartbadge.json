        "text_449527439_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed May 24 2023 20:21:52 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">Get even more from the Smartbadge with workflow intelligence</span></span></span></h2>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Help reduce alarm fatigue and make it easier for clinicians to stay focused on patient care by coupling Vocera hands-free communication devices with the Vocera Engage intelligent workflow engine. Engage enables integration with more than 150 clinical and operational systems. It allows routing, escalation and prioritization of communications and notifications that include patient, event and care team context.</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">With Engage you can:</span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">Receive prioritized messages and alarm notifications based on rules set by your organization</span></span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">Listen and respond to alarm notifications hands-free or by using the Call and DND buttons</span></span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">Add yourself to a group</span></span></span></li>\n</ul>\n<p><a href=\"/content/stryker/us/en/acute-care/products/vocera-engage.html\"><span class=\"standalone-link\">Learn more about Vocera Engage</span></a></p>\n",
          "jcr:lastModified": "Mon Jun 12 2023 13:40:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true",
          "bottomMargin": "2"
        }
      }
    },
