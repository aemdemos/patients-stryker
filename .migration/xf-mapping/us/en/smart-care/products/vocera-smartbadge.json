          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed May 31 2023 20:13:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span style=\"color: #1c5687;\"><span class=\"futura-bold\"><span style=\"color: #000000;\"><span class=\"fontsize-1-5em\">Streamline hospital communications</span></span></span></span></h2>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Care teams face mounting challenges daily and need a solution that streamlines communication, minimizes interruption fatigue and safeguards staff - without comprimising patient care.&nbsp;</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The Smartbadge can help by:&nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">making it easy for people to find each other and communicate quickly</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">enabling people to<b> </b>communicate safely and effectively during hands-on patient care workflows</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">assisting workers to&nbsp;reach help quickly in an emergency</span></span></li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Wed Jul 05 2023 14:40:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
