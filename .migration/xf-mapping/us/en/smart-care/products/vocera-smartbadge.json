          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"urw-egyptienne\"><span style=\"color: #1c5687;\"><span style=\"color: #000000;\"><span class=\"fontsize-1-5em\">Device features</span></span></span></span></p>\n",
          "jcr:lastModified": "Wed May 31 2023 21:26:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,181,0,1)",
