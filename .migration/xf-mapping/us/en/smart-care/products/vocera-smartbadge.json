        "table_315476427": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td style=\"text-align: center;\">Place and receive calls</td>\n</tr><tr><td style=\"text-align: center;\">&quot;OK Vocera&quot; to awaken device</td>\n</tr><tr><td style=\"text-align: center;\">Send / receive secure messages (No character limit)</td>\n</tr><tr><td style=\"text-align: center;\">Receive intuitive notifications with additional context*</td>\n</tr><tr><td style=\"text-align: center;\">Search users and groups on screen, and view presence/availability</td>\n</tr></tbody></table>\n",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
