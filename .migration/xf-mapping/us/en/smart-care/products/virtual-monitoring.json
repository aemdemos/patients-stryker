          "alt": "An AI sensor presenting a feed for a virtual monitor to watch patients",
          "srcFileRef": "/content/dam/stryker/acute-care/products/care-ai/images/ambient-monitoring/Workflows_680x400.jpg",
          "borderColor": "rgba(76,125,122,1)",
