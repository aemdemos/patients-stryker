      "tabs_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "tabPosId": 1,
        "sling:resourceType": "wcm/foundation/components/parsys",
        "experiencefragment_c": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Nov 19 2025 22:24:06 GMT+0000",
          "text": "Always-aware ambient sensors Transform healthcare facilities into smart spaces Always-aware ambient sensors are advanced, AI-driven devices embedded within care environments that act as the eyes, ears and intelligence of care.ai solutions. Protect patient privacy Using computer vision and AI-driven algorithms, sensors continuously monitor activity to autonomously detect presence, motion and behavior without intruding on patient privacy. Ambient sensors capture real-time data, infer patterns and identify deviations. They can notify appropriate care providers if a situation needs attention. Help drive standardization and optimize workflows Sensors can monitor for facility protocol compliance to help drive standardization and optimize clinical and operational workflows.",
          "jcr:lastModified": "Tue Jan 06 2026 15:50:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/smart_care/en/products/us/ambient_monitoring/tabs-content/master",
          "edsFragmentPath": "/us/en/fragments/stryker/smart-care/en/products/us/ambient-monitoring/tabs-content/master"
        }
      },
      "tabs_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "tabPosId": 2,
        "sling:resourceType": "wcm/foundation/components/parsys",
        "experiencefragment_c": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Nov 19 2025 22:24:06 GMT+0000",
          "text": "Consultative partnership We believe transformation in healthcare requires more than just technology – it requires trusted partnership and deep clinical experience. Our platform is built hand-in-hand with frontline clinicians. We continuously incorporate their insights to address real-world challenges like workforce shortages, administrative burdens and patient safety risks. Align with your protocols and processes We don’t just deliver tools; we want to be your partner, aligning with your leadership and care teams to co-design solutions that align with your protocols and processes. Integrate seamlessly Our implementation teams work to integrate your care.ai solutions seamlessly with your existing systems. Help ensure solution adoption Our clinical specialists collaborate with your clinical leaders to help ensure solution adoption, support your team training and education efforts and work with you to quantify outcomes.",
          "jcr:lastModified": "Tue Jan 06 2026 15:50:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/smart_care/en/products/us/ambient_monitoring/tabs-content/master1",
          "edsFragmentPath": "/us/en/fragments/stryker/smart-care/en/products/us/ambient-monitoring/tabs-content/master1"
        }
      },
      "tabs_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "tabPosId": 3,
        "sling:resourceType": "wcm/foundation/components/parsys",
        "experiencefragment_c": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Nov 19 2025 22:24:06 GMT+0000",
          "text": "Virtual command center The virtual command center is the intelligence hub for care.ai solutions, bringing together virtual care and ambient intelligence into one seamless experience. For virtual care workflows, care providers work from the command center supporting a curated task list or monitoring multiple patients at once. Automate workflows, streamline compliance monitoring In Ambient Monitoring scenarios, the command center draws on near-real-time data from always-aware ambient sensors. It automates workflows, streamlines protocol compliance monitoring and delivers actionable insights that support proactive interventions. Get a single source of truth for situational awareness The command center unifies capabilities, systems and more, delivering predictive intelligence and enterprise-wide visibility to enable smarter, more human-centered care. The command center can integrate with a wide variety of systems like the EHR, nurse call, documentation tools, interpretation services and IoT devices. Support flexibility in managing care delivery The command center’s workflow orchestration tools support flexibility in managing aspects of care delivery like receiving and completing tasks or notifying team members.",
          "jcr:lastModified": "Tue Jan 06 2026 15:50:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/smart_care/en/products/us/ambient_monitoring/tabs-content/master2",
          "edsFragmentPath": "/us/en/fragments/stryker/smart-care/en/products/us/ambient-monitoring/tabs-content/master2"
        }
      }
    },
    "text_copy_1183232467": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "hideComponent": "false",
      "topMargin": "5",
      "jcr:created": "Mon Oct 02 2023 17:44:03 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">FAQs</span></span></span></h2>\n",
      "jcr:lastModified": "Tue Jul 08 2025 20:54:08 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "3-"
    },
    "accordion_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kent.schwartz@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Tue Oct 28 2025 16:22:23 GMT+0000",
      "jcr:lastModified": "Tue Oct 28 2025 17:10:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/accordion",
      "accordion_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">With Virtual Monitoring workflows, a virtual sitter works from the virtual command center, monitoring multiple patients per your organizational policy. A virtual sitter can engage with a patient through in-room audio and notify the bedside team members on the unit floor if a situation needs attention.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Oct 28 2025 17:10:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">In Virtual Monitoring, a sitter works from the virtual command center monitoring multiple patients at one time. A virtual sitter can engage with a patient through an in-room speaker and/or bring in additional care team members as needed. In comparison, Ambient Monitoring uses AI-driven, always-aware ambient sensors to continuously interpret activity, conditions and behaviors in the healthcare environment. Ambient intelligence can be incorporated into Virtual Monitoring activities to scale virtual sitter resources even further.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Oct 28 2025 17:11:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Yes. Because some patients may need multiple layers of care, Virtual Nursing sessions can be run simultaneously with Virtual Monitoring and/or Ambient Monitoring using a single ambient monitoring sensor.</span><br>\n</p>\n",
          "jcr:lastModified": "Wed Dec 03 2025 16:58:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 28 2025 16:22:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Yes. A virtual clinician can initiate a “virtual knock” to enter a patient’s room – for example, to round on a patient or to provide a medication administration double-check – without disrupting Virtual Monitoring and/or Ambient Monitoring.</span></p>\n",
          "jcr:lastModified": "Tue Oct 28 2025 16:24:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordionsGrid": {
        "jcr:primaryType": "nt:unstructured",
        "1": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "1",
          "accTitle": "What is a virtual sitter?"
        },
        "2": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "2",
          "accTitle": "What is the difference between Virtual Monitoring and Ambient Monitoring?"
        },
        "3": {
          "jcr:primaryType": "nt:unstructured",
          "accPosId": "3",
          "accTitle": "Can Virtual Monitoring, Ambient Monitoring and Virtual Nursing happen concurrently in one patient room?"
        }
      }
    },
