        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "text": "<h4>Help avoid adverse events</h4>\n<p><span class=\"fontsize-1-25em\">Support injury prevention protocols with use cases such as patient movement and fall prevention monitoring.</span></p>\n<h4>Support standardization of care</h4>\n<p><span class=\"fontsize-1-25em\">Enhance process control with use cases like bed compliance monitoring and patient turning adherence.</span></p>\n<h4>Drive throughput and quality</h4>\n<p><span class=\"fontsize-1-25em\">Help support operational efficiency and improve patient flow with environmental monitoring use cases such as bed occupancy tracking.</span></p>\n<h4>Create a responsive environment</h4>\n<p><span class=\"fontsize-1-25em\">Employ ambient, voice-driven workflows for use cases like clinical assessments, rounding adherence and staff duress.<br>\n </span>&nbsp;</p>\n",
          "jcr:lastModified": "Wed Nov 19 2025 22:55:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
