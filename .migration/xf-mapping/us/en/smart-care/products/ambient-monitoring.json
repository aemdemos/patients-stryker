          "alt": "An Ambient Monitoring frame keying in on a potential adverse event",
          "srcFileRef": "/content/dam/stryker/portfolios/medical-surgical/smartcare/ambient-intelligence/ambient-intelligence-specialty-thumbnail-v2.jpg",
          "borderColor": "rgba(76,125,122,1)",
