          "jcr:created": "Fri Oct 06 2023 13:39:08 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Workflows designed according to your needs</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Ambient Monitoring uses AI-driven, always-aware ambient sensors to continuously interpret activity, conditions and behaviors in the healthcare environment. Through seamless, automated awareness, it proactively monitors patients and environments, surfaces real-time insights and helps automate and streamline workflow.</span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jan 09 2026 19:08:15 GMT+0000",
