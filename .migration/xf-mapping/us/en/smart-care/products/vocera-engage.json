        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "topPadding": "2",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed May 31 2023 21:10:10 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">Turning actionable notifications into smart workflows</span></span></span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Receive only the communications and notifications you need and make sure important information reaches the right recipient by setting rules for filtering, routing, escalation and prioritization based on your facility’s protocols.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">With Engage, rules may include the following, and more:<br>\n • Number of caregivers in an escalation path<br>\n • Care team roles for each escalation<br>\n • A recipient’s presence and availability<br>\n • Time between escalations</span></span></p>\n",
          "jcr:lastModified": "Wed Jul 05 2023 13:55:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
