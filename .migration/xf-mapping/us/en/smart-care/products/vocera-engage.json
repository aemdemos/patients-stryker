          "jcr:created": "Wed May 31 2023 21:10:10 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Putting patients at the center of care – communication software and devices</span></span></h2>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Vocera Engage connects the entire clinical ecosystem of nurses, physicians and ancillary staff, whether their workflows demand hands-free, voice-driven communication or a smartphone.&nbsp;</span></span><br>\n</p>\n",
          "jcr:lastModified": "Wed Jul 05 2023 13:56:23 GMT+0000",
