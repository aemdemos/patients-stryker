      "line1": "<p><span style=\"color: rgb(255,255,255);\"><span style=\"color: #ffffff;\"><span class=\"fontsize-1-5-vw\"><span style=\"font-size: 35.0px;\"><b><i><span style=\"color: rgb(255,181,0);\">&quot;</span></i></b></span></span><span class=\"fontsize-2-5-vw\"><span style=\"font-size: 35.0px;\"><b><i>&nbsp;</i></b></span><span class=\"urw-egyptienne\">Interoperability between our many clinical systems and the Vocera app helps&nbsp;improve the healthcare experience for both patients and nurses by helping&nbsp;create a quieter environment with fewer nuisance alarms.</span></span><span style=\"color: rgb(255,181,0);\"><i><span class=\"fontsize-2-5-vw\">&quot;</span></i></span></span></span></p>\r\n<p>&nbsp;</p>\r\n",
