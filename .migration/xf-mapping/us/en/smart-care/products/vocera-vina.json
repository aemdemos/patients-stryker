          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jun 02 2023 16:04:55 GMT+0000",
          "alt": "Screenshot of a communication between healthcare colleagues using Vocera Vina",
          "srcFileRef": "/content/dam/stryker/acute-care/products/vocera-vina/images/vocera-vina_zebra_screen_patient-info.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 05 2023 13:51:54 GMT+0000",
