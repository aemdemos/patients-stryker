          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed May 24 2023 20:35:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><b><span style=\"color: #1c5687;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span style=\"color: #ffffff;\">Flexibility</span></span></span></span></b></p>\n",
          "jcr:lastModified": "Thu Jun 01 2023 19:44:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(76,125,122,1)",
          "textIsRich": "true",
          "bottomMargin": "2"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed May 24 2023 20:35:38 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Available on Apple, Android, web console</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Enterprise-wide user management through Active Directory authentication</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Shared and Bring Your Own Device (BYOD) models supported</span></span></li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Sun Jun 04 2023 14:15:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "0.01",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "topPadding": "2.5",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed May 24 2023 20:35:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><b><span style=\"color: #1c5687;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span style=\"color: #ffffff;\">Benefits</span></span></span></span></b></p>\n",
          "jcr:lastModified": "Thu Jun 01 2023 19:45:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(133,69,138,1)",
          "textIsRich": "true",
          "bottomMargin": "2"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed May 24 2023 20:35:41 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Receive messages inside and outside the facility for greater flexibility and convenience</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Securely share confidential information</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Contact care teams regardless of location to speed responses</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">One-click response to messages to speed communications</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Quickly access patient and care team information for better informed clinical decisions</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Ensure all participants in conversation are discussing the same patient to avoid confusion</span></span></li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Fri Jun 09 2023 17:48:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
