      "text": "<h2><span class=\"futura-bold\"><span style=\"color: #1c5687;\"><span style=\"color: #ffb500;\"><span style=\"color: #1c5687;\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">What you get with Vocera Collaboration Suite</span></span></span></span></span></span></h2>\n",
