          "hideComponent": "false",
          "topMargin": "6",
          "jcr:created": "Thu Jun 01 2023 18:52:37 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span style=\"color: #1c5687;\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">Situational awareness helps inform<br>\nclinical decision making</span></span></span></span></h2>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Collaborate with the care team</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Reference patient details in text conversations</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Access to care team in near-real time</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Avoid response delays by reaching available care team members</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Patient information, tagged with identities, is correlated and texts are routed simultaneously to the right care team members on their primary communication device</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Wed Jun 21 2023 18:58:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
