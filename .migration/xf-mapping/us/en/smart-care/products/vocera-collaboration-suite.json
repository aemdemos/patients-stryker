          "bottomPadding": "0.01",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "topPadding": "2.5",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed May 24 2023 20:35:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><b><span style=\"color: #1c5687;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span style=\"color: #ffffff;\">Features</span></span></span></span></b></p>\n",
          "jcr:lastModified": "Thu Jun 01 2023 19:44:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(28,86,135,1)",
          "textIsRich": "true",
          "bottomMargin": "2"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Wed May 24 2023 20:35:35 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Situational awareness and actionable patient data</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Prioritized alarm** notifications based on Engage intelligent workflow engine</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Auditable communication trail</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Message forwarding to covering team members</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Missed calls highlighted in call log</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jun 21 2023 17:33:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "0.01",
          "jcr:createdBy": "kent.schwartz@stryker.com",
