    "cols2_1_3_2_3_1908198687": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Tue Sep 16 2025 18:34:10 GMT+0000",
      "jcr:lastModified": "Tue Sep 16 2025 18:34:10 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "text": "<h2>Reclaiming time for care: The future of human-centered workflows in healthcare</h2>\n<p><span class=\"fontsize-1-25em\">Today’s healthcare environment is inundated with devices and systems, often leading to alarm fatigue and increased administrative burdens for nurses. This webinar will delve into the challenges faced by nurses, such as excessive documentation and lack of connected devices, and propose a vision for a future where technology empowers nurses to deliver exceptional patient care.</span></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/smart-care/c/reclaiming-time-for-care-human-centered-workflows-in-healthcare.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Tue Jan 27 2026 14:49:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
