        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "text": "<h2>Applying technology to fall prevention</h2>\n<p><span class=\"fontsize-1-25em\">This course will focus on evidence-based practices in the utilization of technology for prevention of patient falls and injury management. Participants will be introduced to patient bed technologies and wireless features and learn how the key components of a patient’s bed enable clinical success in reducing patient falls and injury from falls.</span></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/smart-care/c/applying-technology-to-fall-prevention.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Tue Jan 27 2026 14:50:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_copy_c_1242269202": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Tue Feb 06 2024 23:11:28 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 23:11:28 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Feb 06 2024 23:11:33 GMT+0000",
          "alt": "male and female nurses standing in hospital hallway",
          "srcFileRef": "/content/dam/stryker/acute-care/campaigns/lightening-the-load/nurses-lightening-load_thumbnail_1200x680.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Jun 27 2024 22:15:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "text": "<h2>Lightening the Load: Unpacking Cognitive Overload</h2>\n<p><span class=\"fontsize-1-25em\">Today, roughly 80% of medical-device user errors occur due to cognitive overload. In addition, persistent cognitive overload contributes to fatigue, burnout, and practice dissatisfaction among nurses and other clinical team members. Hospital systems and clinical leaders are challenged with creating environments and systems to help lift some of the burden placed on healthcare professionals. In this course, we'll discuss system wide solutions to address these challenges, and in particular, how technology can play a pivotal role in lightening the load, and the positive impacts these changes have on nursing wellbeing, and patient care.</span></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/smart-care/c/lightening-the-load-unpacking-cognitive-overload.html\" title=\"Learn more about the course\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Tue Jan 27 2026 14:50:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
