          "alt": "Nurse looking at phone, patient in ProCuity bed in background",
          "srcFileRef": "/content/dam/stryker/acute-care/products/fall-prevention/iBed-cable-free-nurse-call-connection_1200c680.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Mar 19 2025 13:37:29 GMT+0000",
