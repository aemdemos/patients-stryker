            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-4162137458@example.invalid",
              "topPadding": "20",
              "jcr:lastModifiedBy": "user-4162137458@example.invalid",
              "hideComponent": "false",
              "jcr:created": "Thu Feb 16 2023 21:43:30 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h1>&nbsp;</h1>\n<h1><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffffff;\"><span class=\"fontsize-1-25em\">Ortho Q<br>\n Guidance system</span></span></span></span></h1>\n<p><span class=\"fontsize-2em\">&nbsp;</span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffffff;\"><span style=\"color: #000000;\"><span class=\"fontsize-1-75em\">Advanced surgical planning and&nbsp;guidance platform for hip and knee procedures</span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Today’s Ortho Q Guidance system with its refined design, enhanced camera, improved articulating arm and abundant user preferences provides active optical tracking designed to deliver a simpler, less invasive approach to hip and knee replacement.</span></span></p>\n",
              "jcr:lastModified": "Mon Apr 03 2023 13:13:41 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        }
      }
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-4162137458@example.invalid",
      "jcr:lastModifiedBy": "user-4162137458@example.invalid",
      "jcr:created": "Thu Feb 16 2023 21:48:22 GMT+0000",
      "jcr:lastModified": "Thu Feb 16 2023 21:48:22 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-4162137458@example.invalid",
          "jcr:lastModifiedBy": "user-4162137458@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Mon Feb 20 2023 15:44:45 GMT+0000",
          "alt": "Ortho-Q-Homescreen",
          "srcFileRef": "/content/dam/stryker/orthopaedic-instruments/products/ortho-q/images/Ortho-Q-Homescreen.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Feb 20 2023 15:44:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
