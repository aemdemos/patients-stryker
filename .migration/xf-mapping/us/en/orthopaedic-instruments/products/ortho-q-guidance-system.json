        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-4162137458@example.invalid",
          "topPadding": "20",
          "jcr:lastModifiedBy": "user-4162137458@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Thu Feb 16 2023 21:48:42 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\"><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-5em\">Your streamlined TKA/THA&nbsp;guidance solution</span></span></span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Ortho Q Guidance system’s enhanced, custom components and proprietary technology – along with Stryker’s trusted performance, reliability and ease of use – combine to create a versatile, enabled platform that can grow with you.</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Features and benefits</span></span></p>\n<ul>\n<li>Economical entry to a scalable, future-ready platform</li>\n<li>Open, agnostic implant platform</li>\n<li>Active optical tracking technology</li>\n<li>Enhanced FP8000 camera, including new articulating arm</li>\n<li>Dual PCs (application and real-time)</li>\n<li>Dual GUI touch monitors for control</li>\n<li>Rapid registration and calibration/validation of instruments</li>\n<li>Upgraded cart design; more capability with same small footprint</li>\n<li>Mobile for use across ORs</li>\n<li>Helps maximize potential of our hip/knee software features such as automatic and semi-automatic processing algorithms<sup>1</sup></li>\n</ul>\n",
          "jcr:lastModified": "Mon Apr 03 2023 13:13:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
