          "jcr:created": "Fri Feb 17 2023 15:28:02 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><b>IO-panel</b></p>\n<ol>\n<li>RJ45 ports (robotics)</li>\n<li>RJ45 port (misc)</li>\n<li>RJ45 port (network)</li>\n<li>HD DVI-D (video in)</li>\n<li>Analog NTSC/PAL (video in)</li>\n<li>HDMI (video out)7. USB port</li>\n</ol>\n",
          "jcr:lastModified": "Fri Feb 17 2023 15:31:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
