      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
          "jcr:created": "Fri Jul 01 2022 20:57:47 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Precision engineering provides predictable cut paths, so you can have confidence in every cut.</span></span></p>\n<ul>\n<li>• Centering plugs help ensure the attachment is accurately in the cup’s center</li>\n<li>Dual curvature blades follow the exact contour of the cup</li>\n<li>The blade’s sawing motion results in a smooth cut plane</li>\n<li>Produces 83% less stress on the acetabular interface, reducing the potential for fracture or damage*</li>\n<li>Results in 60% less bone loss after remaining*</li>\n<li>Requires a narrower operative space than manual tools, fitting under the femoral head and surrounding tissue*</li>\n</ul>\n",
          "jcr:lastModified": "Fri Jul 01 2022 20:58:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
