          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">NP</span></span><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\">seal&nbsp;</span></span></span></span><span class=\"fontsize-8em\"><span class=\"fontsize-1-75em\"><span class=\"fontsize-2em\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\"><br>\n </span></span></span></span></span></span><span style=\"color: #000000;\">Negative pressure wound therapy&nbsp;</span></h1>\n<p><span style=\"color: #000000;\">NPseal delivers the proven benefits of NPWT in a lightweight, ultraportable system—no cords, no batteries, no canisters. It’s a refreshingly simple way to provide advanced wound care with the confidence that your patients are healing comfortably at home.&nbsp;</span></p>\n",
          "jcr:lastModified": "Thu Sep 17 2026 23:42:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
