        "experiencefragment": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Wed Feb 11 2026 22:38:29 GMT+0000",
          "text": "Simple design Apply, seal, pinch NPseal simplifies negative pressure wound therapy with a three-step application process—apply, seal and pinch. Once applied, patients can manage their own therapy confidently thanks to the integrated pinch pump that establishes and maintains negative pressure with a few pinches. NPseal may be worn for up to seven days,2 though a change may be needed sooner depending on wound conditions.",
          "jcr:lastModified": "Wed Feb 11 2026 22:42:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/experienceFragment",
          "fragmentPath": "/content/experience-fragments/stryker/orthopaedic-instruments/en/products/npseal/simple-design/master",
