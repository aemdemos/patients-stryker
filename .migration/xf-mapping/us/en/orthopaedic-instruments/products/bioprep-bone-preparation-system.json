  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>BioPrep Bone Preparation Kit</p>\r\n\r\n",
    "shortDescTop": "<p>The BioPrep Bone Preparation Kit contains brushes and sponges which allow the medullary canal and acetabulum to be cleaned prior to placement of bone cement and/or prosthesis. It also contains sculps which may be used to remove excess cement around the prosthesis.<br>\r\n\r\n</p>\r\n\r\n",
    "jcr:lastModifiedBy": "user-5a4ae9843d@example.invalid",
    "jcr:lastModified": "Mon Aug 07 2017 15:02:47 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Femoral canal brush - thoroughly cleans&nbsp;intramedullary canal of&nbsp;loose cancellous bone&nbsp;and other debris.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Cement restrictor and inserter - three ring design provides&nbsp;superior cement fixation and&nbsp;<span style=\"font-size: 0.8125rem;\">pressurization.</span></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Femoral sponge - suction feature effectively&nbsp;absorbs blood and fluid from&nbsp;<span style=\"font-size: 0.8125rem;\">the medullary canal.</span></p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Cement application -&nbsp;Stryker's dual speed gun&nbsp;provides fill and pressurize&nbsp;mode to assure optimal&nbsp;<span style=\"font-size: 0.8125rem;\">cement-to-bone interface.</span></p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Cement sculps - remove surrounding soft&nbsp;cement with no risk of&nbsp;<span style=\"font-size: 0.8125rem;\">scratching the prosthesis.</span></p>\r\n",
        "textIsRich": "true"
      }
    }
  },
  "image": {
    "jcr:primaryType": "nt:unstructured"
  }
}
