          "hideComponent": "false",
          "jcr:created": "Fri Jul 01 2022 15:19:04 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Precision Falcon</span></span><br>\n<span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Precision standard blade</span></span></p>\n<p><span class=\"fontsize-1-25em\">Length: 90mm, 105 mm<br>\n Width: 20mm, 25 mm<br>\n Thickness: 1.27mm, 1.37mm</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><b>Reduced movement throughout blade&nbsp;</b></span></li>\n<li><span class=\"fontsize-1-25em\"><b>Outward facing cutting teeth with cutting arch <br>\n of -5° to +5°</b></span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">Non-oscillating blade shaft and variable speed control allow the surgeon to very precisely trim and shape bone in preparation for implants.</span></p>\n<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"standalone-link\"><span style=\"color: #4c7d7a;\"><span style=\"color: #ffffff;\"><span style=\"color: #545857;\"><a href=\"/content/dam/stryker/orthopaedic-instruments/resources/System%209%20Precision%20Brochure1.pdf\">DOWNLOAD THE PDF</a></span></span></span></span></span></p>\n",
          "jcr:lastModified": "Wed Sep 24 2025 14:26:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": "true"
        }
      }
    },
