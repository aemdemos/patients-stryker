          "jcr:created": "Wed Feb 12 2025 20:49:08 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">2. Your head size</span></span></p>\n<p><span class=\"fontsize-1-5em\">Three points of securement for an adjustable helmet fit</span></p>\n",
          "jcr:lastModified": "Thu Feb 27 2025 16:42:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
