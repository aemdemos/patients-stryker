          "sling:resourceType": "stryker/components/content/standaloneimage",
          "srcFileRef-0": "/content/dam/stryker/orthopaedic-instruments/products/speedspray62/images/Full-size.jpg",
          "enableBorder": "false"
        },
        "text_221274034": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
          "jcr:created": "Mon Apr 11 2022 18:06:05 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">A. One button, continuous spraying</span></span><br>\n<span class=\"fontsize-1-25em\">Push START to activate foam and STOP to deactivate</span></p>\n<p><br>\n<span class=\"fontsize-1-5em\"><span class=\"futura-bold\">B. Customizeable foam output</span></span><br>\n<span class=\"fontsize-1-25em\">Use the up and down buttons to set the detergent dosing volume necessary to produce the foam quality desired over trays and in instruments with channels</span></p>\n<p><br>\n<span class=\"fontsize-1-5em\"><span class=\"futura-bold\">C. Ergonomic delivery of detergent for less hand fatigue</span></span><br>\n<span class=\"fontsize-1-25em\">Wand trigger allows for more control when dispensing pretreatment foam</span></p>\n<p><br>\n<span class=\"fontsize-1-5em\"><span class=\"futura-bold\">D. Wall mount option</span></span><br>\n<span class=\"fontsize-1-25em\">Easily mount on a flat wall surface within six feet of the foam application point and within reach of a power outlet</span></p>\n",
          "jcr:lastModified": "Mon Apr 11 2022 18:09:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
