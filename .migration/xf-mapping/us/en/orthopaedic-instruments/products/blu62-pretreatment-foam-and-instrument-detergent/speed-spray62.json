      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
          "jcr:created": "Mon Apr 11 2022 18:10:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Jump start</span><br>\n <span class=\"urw-egyptienne\">your cleaning with Blu</span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">62</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Surfactants begin cleaning and prevent drying at the point of care</span></li>\n<li><span class=\"fontsize-1-25em\">Enables visual verification of coverage by foam and color</span></li>\n<li><span class=\"fontsize-1-25em\">Makes cleaning more efficient</span></li>\n<li><span class=\"fontsize-1-25em\">Helps fulfill recommended pretreatment practices of AAMI and AORN</span></li>\n<li><span class=\"fontsize-1-25em\">Meets AAMI TIR 12:2010 and AAMI TIR 30:2011 standard</span><br>\n</li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Mon Apr 11 2022 18:14:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
