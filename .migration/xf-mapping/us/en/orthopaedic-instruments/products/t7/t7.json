      "textparsys": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline_448954341": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Nov 30 2020 18:44:06 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-1-5-vw\"><span style=\"color: #ffffff;\">Tailored to you</span><br>\r\n </span><span class=\"futura-bold\"><span class=\"fontsize-4vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: #ffb500;\">T7 helmet</span></span></span></span>",
          "line2": "<span style=\"color: #ffffff;\">The T7 helmet is engineered to fit you–and fit you well. Technology and ergonomics work together to create a comfortable fit without sacrificing your personal protection.</span>",
          "jcr:lastModified": "Tue Dec 01 2020 15:51:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(84,88,87,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Nov 30 2020 18:49:54 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: #000000;\">1. Hear with ease</span></span></span></span>",
          "line2": "<br>\r\n<span style=\"color: rgb(255,255,255);\"><span style=\"color: #000000;\">40% quieter than our previous generation, T7 will leave you asking if it’s actually on.</span></span><br>\r\n<br>\r\n",
          "jcr:lastModified": "Mon Nov 30 2020 19:47:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "largeheadline_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Nov 30 2020 18:49:54 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: #000000;\">2. Work in comfort</span></span></span></span>",
          "line2": "<p><br>\r\n<span style=\"color: rgb(255,255,255);\"><span style=\"color: #000000;\">EVA foam conforms to your head with a lighter frame and a cooler fit.</span></span></p>\r\n<p><span style=\"color: rgb(255,255,255);\"><span style=\"color: #000000;\">Better balance and ergonomics keep T7 comfortable and secure.</span></span><br>\r\n</p>\r\n",
          "jcr:lastModified": "Mon Nov 30 2020 19:48:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "largeheadline_copy_2129623076": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Nov 30 2020 18:49:54 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2vw\"><b><span style=\"color: rgb(255,181,0);\"><span style=\"color: #000000;\">3. Adjust to your fit</span></span></b></span></span>",
          "line2": "<p><br>\r\n<span style=\"color: rgb(255,255,255);\"><span style=\"color: #000000;\">The dual adjustment knob lets you precisely control height and width.</span></span></p>\r\n<p><span style=\"color: rgb(255,255,255);\"><span style=\"color: #000000;\">Improved center of gravity is intended to take the strain off of your neck.</span></span><br>\r\n</p>\r\n",
          "jcr:lastModified": "Mon Nov 30 2020 19:48:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "largeheadline_copy_1092365959": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Nov 30 2020 18:49:54 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2vw\"><b><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">4. Stay in the zone</span></span></b></span></span>",
          "line2": "<p><br />\r\n<span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\">Pause button lets you control the fan to streamline the donning and doffing workflow and save battery life.</span></span></p>\r\n<p><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\">Extended battery life means fewer interruptions in the OR.</span></span></p>\r\n<p><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">+</span></span> 15 hours with LED off<br />\r\n <span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">+</span></span> 6 hours with LED on</span></span></p>\r\n",
          "jcr:lastModified": "Mon Nov 30 2020 19:49:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
