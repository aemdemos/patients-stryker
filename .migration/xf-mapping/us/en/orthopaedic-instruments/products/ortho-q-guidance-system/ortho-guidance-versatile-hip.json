              "hideComponent": "false",
              "cq:lastRolledout": "Mon May 06 2024 18:07:39 GMT+0000",
              "jcr:created": "Mon Feb 20 2023 16:05:54 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h1>&nbsp;</h1>\n<h1><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">Ortho Guidance<br>\n versatile hip software</span></span></span></span></h1>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffffff;\">Versatile hip surgical planning and&nbsp;guidance software powered by Ortho Q Guidance system</span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\">Versatile hip software is highly customizable to each surgeon and patient case to help you achieve consistent results in cup/stem positioning and leg length/femoral offset determinations – all while optimizing OR workflow and time.</span></span></span></p>\n",
              "jcr:lastModified": "Mon May 06 2024 18:07:39 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
            }
