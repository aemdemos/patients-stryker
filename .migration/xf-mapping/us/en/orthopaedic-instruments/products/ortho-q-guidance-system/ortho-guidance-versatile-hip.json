        "cq:lastRolledoutBy": "kristian.bocage@stryker.com",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:mixinTypes": [
            "cq:LiveRelationship"
          ],
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "topPadding": "15",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "hideComponent": "false",
          "cq:lastRolledout": "Mon May 06 2024 18:07:39 GMT+0000",
          "jcr:created": "Mon Feb 20 2023 16:11:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Through precise OR guidance, visualization and data analytics, versatile hip software aims to enhance clinical outcomes for THA utilizing the proprietary active optical tracking technology that’s helped make us the&nbsp;industry technology leader in orthopaedic navigation.</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Features and benefits</span></span></p>\n<ul>\n<li>Open, agnostic implant platform</li>\n<li>Multiple user options and customization</li>\n<li>Consistently reproducible cup/stem positioning and leg length/femoral offset determinations</li>\n<li>Intra-operative and post-implantation assessment of joint stability and ROM</li>\n<li>Pin-less comparison of pre-op leg length to intra-op trial and final implants</li>\n<li>Automatic and semi-automatic processing</li>\n<li>Sophisticated anatomical algorithms</li>\n<li>Intuitive ease of use<br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 18:07:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
        }
      },
