          "hideComponent": "false",
          "cq:lastRolledout": "Mon May 06 2024 18:07:40 GMT+0000",
          "jcr:created": "Mon Feb 20 2023 18:11:10 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-5em\">Enhancing your surgical experience</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Our software is designed to create a simple, intuitive system that helps mitigate complex surgical variables.</span></span></p>\n<ul>\n<li>Anatomical, functional and patient/table reference planes and registration options</li>\n<li>Automatic and semi-automatic processing provides a multitude of vital anatomical metrics</li>\n<li>Pin-less leg length determination</li>\n<li>Inclination/anteversion feedback for all implant systems</li>\n<li>PDF case report for saved patient files</li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 18:07:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
        },
        "text_320172394": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:mixinTypes": [
            "cq:LiveRelationship"
          ],
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "leftPadding": "4",
          "topPadding": "4",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "hideComponent": "false",
          "cq:lastRolledout": "Mon May 06 2024 18:07:40 GMT+0000",
          "topMargin": "4",
          "jcr:created": "Mon Feb 20 2023 21:29:45 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span style=\"color: #545857;\"><b>Lateral patient/OR table referencing helps:</b></span></p>\n<ul>\n<li><span style=\"color: #545857;\">Compensate for patient-specific pelvic tilt</span></li>\n<li><span style=\"color: #545857;\">Functionally align cup with true coronal plane of patient in standing position</span></li>\n<li><span style=\"color: #545857;\">Eliminate need to digitize the downside ASIS</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 18:07:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
