              "jcr:created": "Mon Feb 20 2023 16:25:16 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-5em\">Align, ream and reduce<br>\nwith confidence</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Numerous features and data analytics help inform accurate decisions for added confidence.</span></span></p>\n<ul>\n<li>Live feedback on depth to fovea and hip center change</li>\n<li>Tracks alignment with inclination/anteversion and insertion depth</li>\n<li>Stem optimization auto-calculates best combinations of leg length, medialization/lateralization and leg offset</li>\n<li>Comparison of trial-to-final reduction</li>\n<li>Joint stability</li>\n<li>Range of motion</li>\n</ul>\n",
              "jcr:lastModified": "Mon May 06 2024 18:07:40 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
