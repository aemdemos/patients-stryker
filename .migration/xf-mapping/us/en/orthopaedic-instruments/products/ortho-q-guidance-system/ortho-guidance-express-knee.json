          "hideComponent": "false",
          "cq:lastRolledout": "Mon May 06 2024 18:06:31 GMT+0000",
          "jcr:created": "Fri Feb 17 2023 19:08:36 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\">Less invasive:<br>\n </span></span></span><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span class=\"fontsize-2-5em\">Helps minimize risk</span></span></span></p>\n<ul>\n<li>MIS jig for distal femur/proximal tibia alignment/resection and femoral rotation</li>\n<li>Limits anchoring devices; patient trackers attach to fixation plate</li>\n<li>No additional skin incisions; navigation tracker pins placed on articular surface</li>\n<li>Eliminates need for intramedullary guide</li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 18:06:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
