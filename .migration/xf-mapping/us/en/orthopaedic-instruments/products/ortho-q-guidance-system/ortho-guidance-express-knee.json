      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "jcr:mixinTypes": [
          "cq:LiveRelationship"
        ],
        "cq:lastRolledout": "Mon May 06 2024 18:06:30 GMT+0000",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "cq:lastRolledoutBy": "kristian.bocage@stryker.com",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:mixinTypes": [
            "cq:LiveRelationship"
          ],
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "topPadding": "20",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "hideComponent": "false",
          "cq:lastRolledout": "Mon May 06 2024 18:06:30 GMT+0000",
          "jcr:created": "Fri Feb 17 2023 19:04:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Inherent in our express knee software and proprietary active optical tracking technology are numerous features designed to help optimize your performance, workflow and time in the OR while helping simplify the complex clinical tasks and decisions you face.</span></span></p>\n",
          "jcr:lastModified": "Mon May 06 2024 18:06:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
        },
        "text_968921375": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:mixinTypes": [
            "cq:LiveRelationship"
          ],
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "cq:lastRolledout": "Mon May 06 2024 18:06:30 GMT+0000",
          "jcr:created": "Fri Feb 17 2023 19:04:03 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Features and benefits</span></span></p>\n",
          "jcr:lastModified": "Mon May 06 2024 18:06:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:mixinTypes": [
            "cq:LiveRelationship"
          ],
          "jcr:createdBy": "cathy.lapico@stryker.com",
          "topPadding": "-10",
          "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
          "hideComponent": "false",
          "cq:lastRolledout": "Mon May 06 2024 18:06:31 GMT+0000",
          "jcr:created": "Fri Feb 17 2023 18:45:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li>Open, agnostic implant platform</li>\n<li>Rapid registration</li>\n<li>Automatic and semi-automatic processing<br>\n</li>\n<li>Sophisticated anatomical algorithms</li>\n<li>Ability to run active trackers/pointers</li>\n<li>MIS jig for less invasive approach</li>\n<li>Abundant surgeon preferences and workflow options</li>\n<li>Post-operative analysis</li>\n<li>Intuitive ease of use</li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 18:06:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
        }
      }
    },
