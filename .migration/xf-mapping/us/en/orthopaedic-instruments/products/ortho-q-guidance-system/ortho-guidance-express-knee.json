          "cq:lastRolledoutBy": "kristian.bocage@stryker.com",
          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "jcr:mixinTypes": [
              "cq:LiveRelationship"
            ],
            "cq:lastRolledout": "Mon May 06 2024 18:06:31 GMT+0000",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "cq:lastRolledoutBy": "kristian.bocage@stryker.com",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:mixinTypes": [
                "cq:LiveRelationship"
              ],
              "bottomPadding": "-",
              "jcr:createdBy": "cathy.lapico@stryker.com",
              "topPadding": "10",
              "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
              "hideComponent": "false",
              "cq:lastRolledout": "Mon May 06 2024 18:06:31 GMT+0000",
              "jcr:created": "Fri Feb 17 2023 19:17:44 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-5em\">Smart, streamlined workflow</span></span></span></p>\n<ul>\n<li>Only fully autonomous system in the industry</li>\n<li>Automatic and semi-automatic processing provides a multitude of vital anatomical metrics</li>\n<li>Smart instruments with industry-leading accuracy</li>\n<li>Cut-check verification of distal femoral/proximal tibia resections without requiring an anatomy survey</li>\n<li>No need for tracker pins in femur or tibia shafts</li>\n<li>Low latency PC displays virtual model onscreen in real time</li>\n</ul>\n",
