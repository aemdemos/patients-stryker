              "bottomPadding": "10",
              "jcr:createdBy": "cathy.lapico@stryker.com",
              "topPadding": "10",
              "jcr:lastModifiedBy": "cathy.lapico@stryker.com",
              "hideComponent": "false",
              "cq:lastRolledout": "Mon May 06 2024 18:06:30 GMT+0000",
              "jcr:created": "Fri Feb 17 2023 18:31:49 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h1>&nbsp;</h1>\n<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-2em\">Ortho Guidance express knee software</span></span></span></span></h1>\n<p>&nbsp;</p>\n<p><span style=\"color: #ffffff;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Express knee surgical planning and guidance software powered by Ortho Q Guidance system</span></span></span></p>\n<p><span style=\"color: #ffffff;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">The precision and capabilities of our express knee software enables a simpler, less invasive approach to total knee replacement and has helped make us the&nbsp;industry technology leader in orthopaedic navigation.<sup>1</sup></span></span></span></p>\n",
              "jcr:lastModified": "Mon May 06 2024 18:06:30 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "cq:lastRolledoutBy": "kristian.bocage@stryker.com"
            }
          }
