              "jcr:createdBy": "user-4162137458@example.invalid",
              "topPadding": "10",
              "jcr:lastModifiedBy": "user-4162137458@example.invalid",
              "hideComponent": "false",
              "cq:lastRolledout": "Mon May 06 2024 18:07:28 GMT+0000",
              "jcr:created": "Fri Feb 17 2023 20:15:59 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h1>&nbsp;</h1>\n<h1><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">Ortho Guidance precision knee software</span></span></span></span></h1>\n<p>&nbsp;</p>\n<p><span style=\"color: #ffffff;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Precision knee surgical planning and&nbsp;guidance software powered by Ortho Q Guidance system</span></span></span></p>\n<p><span style=\"color: #ffffff;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Precision knee software’s guidance, visualization and data analytics support confident decisions surrounding alignment/orientation of instruments, trials and implants, and balancing soft tissue – all while enabling less invasive TKA techniques.</span></span></span></p>\n",
              "jcr:lastModified": "Mon May 06 2024 18:07:28 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "cq:lastRolledoutBy": "user-c26bb7a766@example.invalid"
            }
          }
        }
      }
    },
