        "cq:lastRolledoutBy": "user-c26bb7a766@example.invalid",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:mixinTypes": [
            "cq:LiveRelationship"
          ],
          "jcr:createdBy": "user-4162137458@example.invalid",
          "jcr:lastModifiedBy": "user-4162137458@example.invalid",
          "hideComponent": "false",
          "cq:lastRolledout": "Mon May 06 2024 18:07:28 GMT+0000",
          "jcr:created": "Fri Feb 17 2023 20:19:31 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Precision knee software is rooted in the proprietary active optical tracking technology that’s helped make us the&nbsp;industry technology leader in orthopaedic navigation<sup>1</sup>, providing numerous features designed to help optimize OR workflow and time, TKA procedural outcomes and your surgical experience.</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Features and benefits</span></span></p>\n<ul>\n<li>Open, agnostic implant platform</li>\n<li>Rapid registration</li>\n<li>Automatic and semi-automatic processing</li>\n<li>Sophisticated anatomical algorithms</li>\n<li>Ability to run active trackers/pointers</li>\n<li>MIS jig for less invasive approach</li>\n<li>Pre-, peri- and post-implantation assessment of joint kinematics</li>\n<li>Intuitive ease of use</li>\n</ul>\n",
          "jcr:lastModified": "Mon May 06 2024 18:07:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:lastRolledoutBy": "user-c26bb7a766@example.invalid"
        }
      },
