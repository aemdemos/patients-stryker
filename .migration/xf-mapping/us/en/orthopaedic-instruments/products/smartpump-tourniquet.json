  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>SmartPump Tourniquet System</p>\r\n",
    "shortDescTop": "<p>We know that best practices for surgical tourniquets require precise balance between providing a bloodless field and protecting patient wellbeing, including delicate tissues. That’s why Stryker designed the high performance SmartPump Tourniquet System to be reliable and intuitive, complete with multiple built-in safety checks.</p>\r\n",
    "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
    "jcr:lastModified": "Wed Nov 28 2018 13:25:37 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>EvenAIRe Technology Stiffeners in the corresponding Color Cuff Tourniquet helps achieve occlusion at the lowest effective pressure setting, potentially reducing complications associated with higher pressure levels<sup>1-4</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Limb occlusion pressure (LOP) is determined by you, not based on time-delayed pre-op readings</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Three-second self calibration upon start up automatically detects any issues with the pump, cuff or inflow/outflow line</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Provides comprehensive documentation of periop data</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Three step IVRA lock protection (for IVRA/Bier block, elbow or similar scenarios). When one line is deflated, the second bladder will not deflate unless acted on by you</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
  "disclaimer": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
    "disclaimer-type": "text",
    "disclaimer": "<p>1. Stryker Instruments, Kalamazoo, MI. “Compression Performance of the Stryker Color Cuff Tourniquet: A Comparative Study.”&nbsp;(Feb. 2014).</p>\r\n<p>2. Clarke M.T., et al. “Tourniquet-induced wound hypoxia after total knee replacement.” Journal Bone Joint Surg Br. 83:1 (2001): 40-4.</p>\r\n<p>3. Noordin S., et al. “Surgical Tourniquets in Orthopedics.” Journal Bone Joint Surg Am. 91:12 (2009): 2958-67</p>\r\n<p>4. Olivecrona, Charlotta, et al. “Lower Tourniquet Cuff Pressure Reduces Postoperative Wound Complications after Total&nbsp;<span style=\"font-size: 0.8125rem;\">Knee Arthroplasty: A randomized controlled study of 164 patients.” Journal Bone Joint Surg Am. 94:22 (2012): 16-21.</span></p>\r\n",
    "jcr:lastModified": "Mon Jul 31 2017 11:57:56 GMT-0400",
