      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Dilara.Atkins@stryker.com",
          "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
          "jcr:created": "Tue Oct 30 2018 14:50:58 GMT+0000",
          "srcFileRef": "/content/dam/stryker/surgical/products/smartpumptourniquet/images/Productfeatures_TourniquetCuffOcclusion3.jpg",
          "jcr:lastModified": "Wed Oct 31 2018 18:25:57 GMT+0000",
