      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>The intuitive design of the device allows surgeons to focus on the procedure at hand</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Ergonomic design that improves ease of use enabling a more intuitive assembly process</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Distinct connection points enable a confident connection</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Specialized handpieces consist of four saws, a micro drill, universal driver, and wire driver</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>I.D. Touch capabilities on the CORE 2 console with the sagittal saw and micro drill handpieces</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
