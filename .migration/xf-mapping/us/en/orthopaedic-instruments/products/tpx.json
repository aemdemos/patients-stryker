  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Solution for a variety of small bone procedures</p>\r\n",
    "shortDescTop": "<p>Combined with a variety of different cutting accessories, TPX enables the cutting and shaping of bone for small bone procedures.</p>\r\n",
    "jcr:lastModifiedBy": "user-bffe03609f@example.invalid",
