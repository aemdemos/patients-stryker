    "cols2_1682070053_cop": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "jcr:created": "Tue Apr 18 2023 22:54:56 GMT+0000",
      "jcr:lastModified": "Tue Apr 18 2023 22:54:56 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-5a4ae9843d@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 18 2023 22:56:17 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">The EZout system powers the cutting, <br>\n <span class=\"futura-bold\"><span style=\"color: #323232;\"><span style=\"color: #ffb500;\">so you can handle everything else.</span></span></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Predictable engineering provides predictable cut paths, so you can have confidence in every cut.</span><br>\n <span class=\"fontsize-1-75em\">&nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Centering plugs help ensure the attachment is accurately in the cup’s center</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Dual curvature blades follow the exact contour of the cup</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The blade’s sawing motion results in a smooth cut plane</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Produces <span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">83% less stress</span></span>&nbsp;in the bone, reducing the potential for fracture of damage*</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Results in <span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">60% less bone loss</span></span> after remaining*</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Requires a narrower operative space than manual tools, fitting under the femoral head and surrounding tissue*</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Consistently removes the cup in <span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">3-5 minutes</span></span>* &nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Requires<span class=\"futura-bold\"> <span style=\"color: #4c7d7a;\">78% less physical exertion</span> </span>to remove a cup<br>\n &nbsp;</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Aug 11 2023 14:19:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
