              "hideComponent": "false",
              "jcr:created": "Tue Apr 18 2023 21:04:28 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p style=\"text-align: left;\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #edeeec;\">Predictable, consistent results.</span></span></span></span></p>\n<p style=\"text-align: left;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Cut with controlled power <br>\n Get predictable results<br>\n Have confidence in consistency</span></span><br>\n</p>\n",
