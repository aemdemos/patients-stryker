      "backgroundColor": "rgba(84,88,87,1)",
      "fbleedparsys": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "topPadding": "3",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 18 2023 21:59:49 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span style=\"color: #edeeec;\"><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">“It seems that our traditional broad blades compress the bone and therefore widen the space, whereas EZout doesn’t seem to do that. It removes a very narrow channel and that seems to mean that you’re then going to implant smaller sockets than your others ones would’ve had to have done.”<br>\n&nbsp;</span></span></span></p>\n<p><span style=\"color: #edeeec;\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Mr. Simon Lewthwaite, Consultant Orthopaedic Surgeon</span></span></span></p>\n",
          "jcr:lastModified": "Sat Jul 08 2023 21:22:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
