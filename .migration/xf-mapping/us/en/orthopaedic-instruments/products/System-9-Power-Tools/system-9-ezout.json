    "text_copy_334796670__1527654883": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "4",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "topPadding": "2",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue Apr 18 2023 21:04:28 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: left;\"><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\">Revolutionary technology&nbsp;<br>\n </span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">that minimizes bone tissue loss.</span></span></span></p>\n<p style=\"text-align: left;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Controlled and precise cutting leads to improved results compared to manual cup revision tools.&nbsp;</span></span><br>\n</p>\n",
      "jcr:lastModified": "Thu Jul 27 2023 20:03:25 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
