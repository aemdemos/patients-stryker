      "jcr:created": "Tue Apr 18 2023 23:32:27 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: left;\"><span class=\"futura-bold\"><span class=\"fontsize-2-5em\">A family of power tools built for the whole hospital</span></span></p>\n<p style=\"text-align: left;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Intentionally engineered to empower you with <br>\n a power tool solution that caters to your exact needs</span></span></p>\n",
