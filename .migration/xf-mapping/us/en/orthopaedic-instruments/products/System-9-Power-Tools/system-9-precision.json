    "text_copy_334796670_": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "2",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "topPadding": "4",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Tue Apr 18 2023 21:04:28 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: left;\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Evolving the way you cut.</span></span><br>\n</span></p>\n<p style=\"text-align: left;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Empowering you with precision and control when you need it most.&nbsp;</span></span><br>\n</p>\n",
      "jcr:lastModified": "Thu Jul 27 2023 20:04:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Apr 18 2023 21:11:18 GMT+0000",
      "jcr:lastModified": "Tue Apr 18 2023 21:11:18 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
          "jcr:created": "Tue Apr 18 2023 21:11:27 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> </span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">The stationary cartridge design allows freehand stabilization of the cartridge body and eliminates wear on the cut guide. Precision cartridges can be used for ankle, shoulder, hip and knee arthroplasty, offering versatility and ensuring all your orthopaedic procedure needs are met.&nbsp;</span></span><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\"><br>\n &nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Length: 90mm, 105mm</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Width: 20mm, 25mm</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Thickness: 1.27mm, 1.37mm</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Reduced movement throughout blade</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Outward facing cutting teeth with cutting arch of -5° to +5°</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Sep 05 2023 12:48:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
