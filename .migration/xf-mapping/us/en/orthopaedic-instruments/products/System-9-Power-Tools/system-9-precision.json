    "cols2_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Apr 18 2023 21:11:18 GMT+0000",
      "jcr:lastModified": "Tue Apr 18 2023 21:11:18 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 18 2023 21:11:27 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Feel the difference</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The thinner cartridge design helps eliminate sticking or binding in cut guide slots. Because of the optimal tooth engagement throughout the cut arc, surgeons also reported an improved tactile feel when transitioning to cortical bone.</span></span></p>\n",
          "jcr:lastModified": "Sat Jul 08 2023 22:02:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 18 2023 21:11:27 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Optimized for efficiency</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Precision’s Falcon saw tooth geometry is 19% faster and comparable to Stryker’s sagittal saw<sup>2</sup> speed. It offers enhanced relief features for chip clearance and a reduced blade surface area to decrease cutting temperature</span></span></p>\n",
          "jcr:lastModified": "Sat Jul 08 2023 21:50:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
