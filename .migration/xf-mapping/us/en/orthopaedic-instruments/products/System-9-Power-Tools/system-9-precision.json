          "jcr:createdBy": "cedu.ocson@stryker.com",
          "topPadding": "3",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 18 2023 21:59:49 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span style=\"color: #edeeec;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">“We learned of course that using a saw with oscillating tip creates way less soft tissue trauma than a conventional oscillating saw.”</span></span></span></p>\n<p><span style=\"color: #edeeec;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Prof. Dr. Philipp Lobenhoffer, Hannover, Germany</span></span></span></p>\n",
          "jcr:lastModified": "Tue May 16 2023 23:07:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
