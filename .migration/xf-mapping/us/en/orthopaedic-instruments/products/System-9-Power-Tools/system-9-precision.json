    "text_copy_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
      "jcr:created": "Tue Apr 18 2023 21:04:28 GMT+0000",
      "text": "<p style=\"text-align: left;\"><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\">Total confidence,</span><br>\n<span class=\"futura-bold\"><span style=\"color: #ffb500;\">total control.</span></span></span><br>\n<span class=\"fontsize-1-75em\"><br>\n <span class=\"urw-egyptienne\">Our oscillating tip saw reduces noise and vibration, <br>\n enhancing handpiece control for a more precise surgical experience.</span></span></p>\n",
      "jcr:lastModified": "Tue Sep 05 2023 12:49:22 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
