              "jcr:created": "Tue May 16 2023 18:08:36 GMT+0000",
              "gradientDirection": "left-to-right",
              "line1": "<p><span class=\"futura-bold\"><span class=\"fontsize-4-5-vw\">Precision </span></span></p>\r\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-3vw\">Oscillating Tip Saw</span></span></p>\r\n",
              "jcr:lastModified": "Thu Jul 27 2023 15:36:16 GMT+0000",
