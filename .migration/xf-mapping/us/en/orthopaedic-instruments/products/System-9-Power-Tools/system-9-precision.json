    "cols2_1883477064_cop": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Apr 18 2023 21:35:34 GMT+0000",
      "jcr:lastModified": "Tue Apr 18 2023 21:35:34 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 18 2023 21:43:29 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #4c7d7a;\">Stationary cartridge design</span></span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Allows for free-hand stabilization of the cartridge body</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Eliminates wear on the cut guide and 84% reduction in metal as shows in cadaveric TKA model<sup>1</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Sep 05 2023 12:49:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
          "jcr:created": "Tue Apr 18 2023 21:43:33 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #4c7d7a;\">Oscillating tip design</span></span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Reduces noise and vibration for a more precise surgical experience<br>\n </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Surgeons report a 23% reduction in excursion arc versus a sagittal blade<sup>2</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Sep 05 2023 12:50:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
