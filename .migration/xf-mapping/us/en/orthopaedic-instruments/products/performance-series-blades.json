          "preset": "max_width_1440",
          "jcr:created": "Fri Jul 01 2022 22:41:52 GMT+0000",
          "alt": "concave",
          "srcFileRef": "/content/dam/stryker/orthopaedic-instruments/products/performance-series-blades/images/concave.png",
          "borderColor": "rgba(187,188,188,1)",
          "jcr:lastModified": "Wed Aug 19 2026 21:38:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Fri Jul 01 2022 22:42:07 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span style=\"color: #ffb500;\">Concave</span></span></span><br>\n<span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Most stable</span></span></p>\n<p>Concave shape creates a cutting face that keeps blade centered at all times and allows the smoothest cut possible. Fewer teeth engaged means blade does not grab or kick.</p>\n",
          "jcr:lastModified": "Fri Jul 01 2022 22:58:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
