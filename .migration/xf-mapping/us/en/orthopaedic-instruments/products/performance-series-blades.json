    "cols_183233753_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Fri Oct 11 2019 15:18:25 GMT+0000",
      "jcr:lastModified": "Fri Oct 11 2019 15:18:25 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Fri Jul 01 2022 22:37:08 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\">Premium design. Proven results.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Stryker’s Performance Series blades are highly engineered for reliable cutting operation</span></span></p>\n",
          "jcr:lastModified": "Fri Jul 01 2022 22:37:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Fri Jul 01 2022 22:37:43 GMT+0000",
      "jcr:lastModified": "Fri Jul 01 2022 22:37:43 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "leftPadding": "5",
          "topPadding": "5",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Jul 01 2022 22:37:49 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Beveled edges</span></span></p>\n<ul>\n<li>Beveled edges are intended to reduce the likelihood of soft tissue damage as compared to non-beveled blades.</li>\n<li>They also aid in the reduction of wear debris within the cutting block.</li>\n<li>This is particularly evident with single use cutting blocks.</li>\n</ul>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Stability</span></span></p>\n<ul>\n<li>Concave tooth design stabilizes the blade by engaging fewer teeth at on time.</li>\n<li>This improves overall control of the saw.</li>\n</ul>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Patented tooth design</span></span></p>\n<ul>\n<li>Inner teeth feed bone chips into the chip clearance area, mimnimizing the amount of debris at the cut site allowing for a more efficient cut.</li>\n</ul>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Accuracy</span></span></p>\n<ul>\n<li>Constant blade thickness improves overall cut accuracy by having optimal fit in the cutting block.</li>\n<li>Thicker and stiffer than other toothset blades, it’s less likely to dive or skyve.&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Fri Jul 01 2022 22:40:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
