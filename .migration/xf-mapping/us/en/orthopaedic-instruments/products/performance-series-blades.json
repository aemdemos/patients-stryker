          "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jul 01 2022 22:41:44 GMT+0000",
          "alt": "convex",
          "srcFileRef": "/content/dam/stryker/orthopaedic-instruments/products/performance-series-blades/images/convex.png",
          "borderColor": "rgba(187,188,188,1)",
          "jcr:lastModified": "Wed Aug 19 2026 21:37:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "true"
