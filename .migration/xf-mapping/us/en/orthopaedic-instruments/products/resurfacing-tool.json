  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>One cutting edge with four benefits</p>\r\n",
    "shortDescTop": "<p>Stryker’s resurfacing tool provides a reduced level of chatter, increased cut accuracy, and increased cut speed<sup>1</sup> when compared to a 4.0mm fluted egg bur.<sup>1,2</sup><br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-5a4ae9843d@example.invalid",
    "jcr:lastModified": "Tue Feb 27 2018 15:46:01 GMT-0500",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Creates a more accurate cut path when compared to the current 4.0mm fluted egg bur<sup>2&nbsp;</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Offers a significant reduction in chatter when compared to the 4.0mm fluted egg bur<sup>2</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>When compared to fluted burs of similar geometries, the material removal&nbsp;of the Resurfacing Tools is improved over the current 4.0mm fluted egg bur<sup>1,2</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Designed to not clog<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
