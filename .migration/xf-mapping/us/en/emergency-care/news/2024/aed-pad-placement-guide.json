          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Mon Sep 23 2024 18:01:03 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">New AEDs can cost anywhere from $1,200 to $3,000 depending on features.</span></p>\n",
          "jcr:lastModified": "Mon Sep 23 2024 18:01:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Mon Sep 23 2024 18:01:03 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Yes, but dry the chest area before applying the pads. Water can conduct electricity, creating a risk of shock to the rescuer or bystanders.</span></p>\n",
          "jcr:lastModified": "Mon Sep 23 2024 18:01:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
