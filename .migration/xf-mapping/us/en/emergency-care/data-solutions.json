          "jcr:created": "Wed Oct 20 2021 20:21:56 GMT+0000",
          "alt": "The LIFENET System data and asset management system shown on a computer screen",
          "srcFileRef": "/content/dam/stryker/ems/products/lifenet/us/lifenet-manage-equipment.jpg",
          "borderColor": "rgba(76,125,122,1)",
