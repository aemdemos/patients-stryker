      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">The LIFENET System<br>\n </span></span><span class=\"fontsize-1-5em\">Data and asset management system</span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Smoother communication. Faster care. Stronger teams.</span></span></p>\n<p><span class=\"fontsize-1-5em\">The LIFENET System is a comprehensive cloud-based platform that provides information and tools EMS and hospital teams need to work together seamlessly. Access and share critical patient data for STEMI patients, stroke patients and other time-sensitive emergencies. Quickly and easily obtain consultations from remote clinicians and activate care teams across your organization. Rapidly distribute post-event review insights and manage your LIFEPAK device fleet-wide with innovative tools that help save time and empower improvement.</span></p>\n",
          "jcr:lastModified": "Wed Aug 24 2022 21:10:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        },
        "curatedcta_copy": {
          "jcr:primaryType": "nt:unstructured",
