      "jcr:created": "Mon Jul 20 2020 20:04:36 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><span class=\"fontsize-4-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Your </span></span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,181,0);\">trusted</span></span></span></span><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\"> medical device service partner</span></span></span></span></span></span></h2>\r\n",
