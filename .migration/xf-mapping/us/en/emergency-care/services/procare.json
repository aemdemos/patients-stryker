    "largeheadline_copy_c_1177704226": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "eleni.maistrellis@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Mon Jul 20 2020 20:04:36 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><span class=\"fontsize-4-5-vw\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Our </span></span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,181,0);\">proactive </span></span></span></span><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\">approach</span></span></span></span></span></span></h2>\r\n",
      "line2": "<span class=\"fontsize-1-5-vw\">With ProCare Service, we offer you operational and financial peace of mind through three comprehensive offerings: ProCare Preventive Maintenance, ProCare Protect and ProCare Prevent. Choose the emergency medical equipment service package that best meets your needs.</span>",
      "jcr:lastModified": "Mon Aug 04 2025 20:42:42 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,0)",
      "textIsRich": [
        "true",
        "true"
      ]
    },
