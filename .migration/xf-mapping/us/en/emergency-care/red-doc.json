          "accordion_parsys5": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 5,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">ClearVoice technology detects background noise and adjusts audio and voice prompts to ensure they can be heard clearly in noisy environments.&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Wed May 25 2022 17:57:53 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys6": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 6,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "katie.boertman@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">The LIFEPAK CR2 comes with a lithium battery and QUIK-STEP electrode pads that can be used on both adult and pediatric patients.&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Fri Jun 10 2022 17:24:39 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys7": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 7,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">The standby life of the included battery is four years if installed on a device that is not used. The battery will provide 166 200 joule shocks (with one minute of CPR between shocks) or 103 360 joule shocks (with one minute of CPR between shocks) or 800 minutes of operating time.&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Jun 02 2022 17:42:42 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
