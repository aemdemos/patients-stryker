        "/content/dam/stryker/ems/resources/end-of-life/3342606_c_heartsine_eol_faq_2020.pdf"
      ],
      "description": "For more information on this product discontinuation and how we are complying with the latest FDA final order, please review the following.",
      "jcr:lastModifiedBy": "user-98fdffe29c@example.invalid",
      "jcr:created": "Tue Jul 21 2020 22:14:52 GMT+0000",
      "title": "Additional resources",
      "jcr:lastModified": "Wed Jul 27 2022 19:20:48 GMT+0000",
      "sling:resourceType": "stryker/components/content/resourcesanddownload"
    },
    "text_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-98fdffe29c@example.invalid",
      "jcr:lastModifiedBy": "user-98fdffe29c@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Thank you for your business and continued partnership. We are committed to providing high-quality, clinically relevant products so that you can be confident in the care you are providing to your communities.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Please contact your local Stryker sales representative or authorized distributor to discuss trade-up and flexible financing options to support you during this transition. For more information, review the additional resources above.</span></span><br>\n</p>\n",
      "jcr:lastModified": "Wed Jul 27 2022 19:22:12 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "3",
      "textIsRich": "true"
    }
  }
