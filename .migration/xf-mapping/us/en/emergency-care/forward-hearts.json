              "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
              "jcr:created": "Fri Oct 01 2021 17:37:38 GMT+0000",
              "gradientDirection": "left-to-right",
              "line1": "<h2><b><span class=\"futura-bold\"><span style=\"color: rgb(0,0,0);\"><span class=\"fontsize-3-5-vw\">Pay it forward</span></span></span></b></h2>\r\n",
              "line2": "<span style=\"color: rgb(0,0,0);\"><span class=\"fontsize-1-5-vw\">Forward Hearts lets survivors of a sudden cardiac arrest event pay it forward and potentially save another life by donating an automated external defibrillator (AED) to the charitable organization of the survivor's choice.</span></span>",
              "jcr:lastModified": "Mon Aug 01 2022 15:48:49 GMT+0000",
              "sling:resourceType": "stryker/components/content/largeheadline",
              "rightPadding": "10",
              "backgroundColor": "rgba(255,255,255,0)",
              "textIsRich": [
                "true",
                "true"
              ]
            }
          }
        }
      }
    },
    "largeheadline_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-98fdffe29c@example.invalid",
      "leftPadding": "20",
      "topPadding": "5",
      "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
      "jcr:created": "Wed Oct 20 2021 20:01:20 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2 style=\"text-align: center;\"><b><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-4vw\">Forward&nbsp;<span style=\"color: rgb(0,0,0);\">Hearts</span></span></span></span></b></h2>\r\n",
      "jcr:lastModified": "Mon Aug 29 2022 20:19:01 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "rightPadding": "20",
      "backgroundColor": "rgba(255,255,255,0)",
      "textIsRich": [
        "true",
        "true"
      ]
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "5",
      "jcr:createdBy": "user-98fdffe29c@example.invalid",
      "leftPadding": "20",
      "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Wed Jul 27 2022 21:13:23 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">How it works</span></span></p>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">When a HeartSine samaritan PAD, LIFEPAK CR2, LIFEPAK CR Plus or LIFEPAK EXPRESS AED is used to help save a life, the survivor chooses an organization to receive the donated AED. The survivor can choose to make their donation to the organization anonymously or be part of a public announcement.</span></span></p>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">If you have a Forward Hearts story, or know of someone who survived a sudden cardiac arrest with the help of one of the qualifying AEDs, please share your story with us.&nbsp;</span></span></p>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Stryker is committed to saving lives and making public access AEDs more readily available in the workplace and community. The donation of a defibrillator through the Forward Hearts program extends this lifesaving technology to even more people, offering many a better chance of survival in the case of sudden cardiac arrest.</span></span><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">&nbsp;</span></span></p>\n",
      "jcr:lastModified": "Mon Aug 29 2022 20:18:13 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "20",
      "textIsRich": "true"
    },
