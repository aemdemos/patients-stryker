          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Mon Feb 26 2024 20:49:02 GMT+0000",
          "text": "<h1><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\"><span class=\"futura-bold\">Empower heroes, save lives&nbsp;<br>\n</span></span></span></h1>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Your partner in fire and rescue excellence</span></span></p>\n<p><span class=\"fontsize-1-25em\">Every day, your courage meets chaos in extraordinary ways. You rely on durable, powerful, connected devices* to help save lives and coordinate teams so you can deliver high-quality care when it matters most. That’s where we come in. Stop by our booth to see the next generation of powered equipment in action.</span></p>\n",
          "jcr:lastModified": "Fri Mar 13 2026 19:11:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
