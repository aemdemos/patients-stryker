      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Feb 26 2024 20:49:02 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">Experience our powered products <span style=\"white-space: nowrap;\">first-hand&nbsp;</span></span></span></span></h3>\n<p><span class=\"fontsize-1-25em\">Visit us at FDIC for hands-on demos of our powered products, including Power-PRO 2, Xpedition, LIFEPAK 35, LUCAS and more. See how our connected ecosystem is designed to support your crews in high-pressure moments and talk with our experts about how we can support your response on scene and beyond.</span></p>\n",
          "jcr:lastModified": "Fri Feb 13 2026 16:21:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
