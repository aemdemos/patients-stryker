          "jcr:created": "Mon Feb 26 2024 20:50:30 GMT+0000",
          "alt": "customer and sales rep demoing Lucas CRP unit at trade show",
          "srcFileRef": "/content/dam/stryker/ems/campaigns/fdic-trade-show/lucas-booth-demo.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri May 10 2024 17:55:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
