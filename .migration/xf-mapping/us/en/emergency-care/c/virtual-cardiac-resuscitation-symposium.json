          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Tue Aug 20 2024 12:53:01 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Emergency Care </span>|<span class=\"futura-bold\">&nbsp;<span style=\"color: #ffb500;\">Symposium</span></span></span><br>\n</p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 19:36:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "hideComponent": "false",
          "topMargin": "3",
          "jcr:created": "Mon Aug 19 2024 21:36:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">Virtual Cardiac Resuscitation Symposium</span></span></span></h1>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">November 14, 2024<span style=\"font-weight: normal;\">, 11 a.m.-3 p.m. ET/ 8 a.m.-12 p.m. PT</span></span></span></p>\n",
          "jcr:lastModified": "Thu Oct 17 2024 21:54:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_188497224": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Mon Aug 19 2024 21:36:23 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Description:</span></span><br>\n</p>\n<p><span class=\"fontsize-1-25em\">Attend this half-day virtual symposium to discover actionable techniques to help improve resuscitation survival rates in your systems and community.</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Agenda topics include:</span></span></p>\n<p><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">• Event medicine<br>\n • Capnography<br>\n • Airway management<br>\n • Synchronized Cardioversion<br>\n • High-quality CPR<br>\n • Types of shock</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Who should attend?</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">EMS (i.e. chiefs, paramedics, EMTs)</span></li>\n<li><span class=\"fontsize-1-25em\">Hospital providers (i.e. nurses, physicians, RTs, educators)</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Cost:</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">$25 until November 7th</span></li>\n<li><span class=\"fontsize-1-25em\">$40 after November 7th</span></li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Fri Oct 18 2024 15:10:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1920514816": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Thu Aug 22 2024 19:08:52 GMT+0000",
          "text": "<p>This CE activity is approved for 4.0 CEH by ResponderCast, an organization accredited by the Commission on Accreditation for Pre-Hospital Continuing Education (CAPCE). This educational activity is approved for 4.0 contact hours by ResponderCast, an accreditedprovider for continuing education. Provider approved by California Board of Nursing. Provider #14477 and the Florida Board of NursingProvider #50-17032 This program has been approved for 4.0 contact hours Continuing Respiratory Care Education (CRCE) credit by theAmerican Association of Respiratory Care.<br>\n</p>\n",
          "jcr:lastModified": "Wed Oct 16 2024 19:59:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
