      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_188497224": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Aug 19 2024 21:36:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Description:</span></span><br>\n</p>\n<p><span class=\"fontsize-1-25em\">This lecture will focus on a toxidrome-based method of triage to rapidly identify the most lethal and rapidly acting toxins that can be used in a chemical attack. We will discuss how the information gained during this process will have direct implications for management of casualties first identified in the prehospital environment. We will also review commonly discussed mass casualty incident (MCI) triage tools and how they can be incorporated during these complex events.</span></p>\n",
          "jcr:lastModified": "Thu Nov 28 2024 12:53:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_563209906": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Aug 19 2024 21:36:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Objectives:</span></span></p>\n<ol>\n<li><span class=\"fontsize-1-25em\">Recall commonly discussed triage models.</span></li>\n<li><span class=\"fontsize-1-25em\">Describe how to integrate poisoning from chemical warfare agents (CWAs) into triage models.</span></li>\n<li><span class=\"fontsize-1-25em\">Demonstrate understanding of how to use MARCHE2 as a framework for management of casualties from CWAs.</span></li>\n</ol>\n",
          "jcr:lastModified": "Thu Nov 28 2024 12:53:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1920514816": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Thu Aug 22 2024 19:08:52 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>Important: Due to changes in the compliance policy, a $10 fee will be charged for receiving a CE. Attendees can view the webinar for free.&nbsp;</p>\n<p>This CE activity is approved for 1.0 CEH by ResponderCast, an organization accredited by the Commission on Accreditation for Prehospital Continuing Education (CAPCE). This educational activity is approved for 1.0 contact hours by Saxe Healthcare Communications, an accredited provider for continuing education. Provider approved by California Board of Nursing. Provider #14477 and the Florida Board of Nursing Provider #50-17032. This program has been approved for 1.0 contact hours Continuing Respiratory Care Education (CRCE) credit by the American Association of Respiratory Care.&nbsp;</p>\n",
          "jcr:lastModified": "Thu Nov 28 2024 12:53:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        }
      }
    },
