          "jcr:created": "Mon Aug 19 2024 21:36:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">The art of triage: Preparing for chemical warfare agents</span></span></span></h1>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">December 12, 2024&nbsp;1–2 p.m. ET/10–11 a.m. PT&nbsp;</span></span></p>\n<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">Presented by:</span></b></span></p>\n<p><span class=\"fontsize-1-25em\">Asa Margolis, DO, MPH, MS, FACEP, FAEMS&nbsp;<br>\n Associate Professor, Division of Special Operations, Department of Emergency Medicine&nbsp;<br>\n Executive Director, James J. Scheulen Center for Transport and Resuscitative Medicine&nbsp;&nbsp;<br>\n Program Director, Johns Hopkins University School of Medicine Emergency Medical Services Fellowship&nbsp;<br>\n Deputy Medical Director, United States Secret Service&nbsp;</span></p>\n",
          "jcr:lastModified": "Thu Nov 28 2024 12:51:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
