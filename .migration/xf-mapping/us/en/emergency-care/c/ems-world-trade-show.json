          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Thu Jan 18 2024 17:29:28 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">The power to save. The heart to serve.</span></span></span></span></h2>\n<h3><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Powered gear that empowers you in the field</span></span></h3>\n<p><span class=\"fontsize-1-25em\">As a first responder, you're there for people on their hardest days. You face challenges head-on, persevere through tough conditions and always put those you serve first. You deserve durable, powered devices to help save lives and coordinate teams. And that’s exactly what we deliver.</span></p>\n",
          "jcr:lastModified": "Tue Jul 21 2026 15:46:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
