            "accPosId": 1,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Height: 8 inches<br>\n Width: 7.25 inches<br>\n Depth: 1.9 inches&nbsp;&nbsp;</span></p>\n",
              "jcr:lastModified": "Tue May 31 2022 21:54:10 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 2,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Fri Jun 28 2019 14:11:17 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">They weigh 2.14 pounds each with the Pad-Pak inserted.&nbsp;</span><br>\n</p>\n",
              "jcr:lastModified": "Tue May 31 2022 21:54:28 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys3": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 3,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Fri Jun 28 2019 14:11:17 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">The waveform is the Self-Compensating Output Pulse Envelope (SCOPE) optimized biphasic escalating waveform compensates energy, slope and duration for patient impedance.</span><br>\n</p>\n",
              "jcr:lastModified": "Tue May 31 2022 21:54:52 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys4": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 4,
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Fri Jun 28 2019 14:11:17 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">For the Pad-Pak (for adult use):<br>\n Shock 1: 150J<br>\n Shock 2: 150J<br>\n Shock 3: 200J</span></p>\n<p><span class=\"fontsize-1-25em\">For the Pediatric-Pak (for use on children 1-8 years old):<br>\n Shock 1: 50J<br>\n Shock 2: 50J<br>\n Shock 3: 50J&nbsp;</span></p>\n",
              "jcr:lastModified": "Mon Aug 29 2022 17:47:21 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "accordion_parsys5": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 5,
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "kristian.bocage@stryker.com",
              "jcr:lastModifiedBy": "brittany.brady@stryker.com",
              "jcr:created": "Thu Jul 11 2019 15:25:15 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Charge time (typical):<br>\n 150J in &lt; 8 seconds<br>\n 200J in &lt; 12 seconds&nbsp;&nbsp;</span></p>\n",
              "jcr:lastModified": "Tue May 31 2022 21:55:53 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
