      "jcr:created": "Wed Oct 20 2021 20:22:06 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2 style=\"text-align: left;\"><b><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-1-5-vw\">PRODUCT HIGHLIGHTS</span></span></span></b></h2>\r\n<h2 style=\"text-align: left;\"><b><span class=\"futura-bold\"><span class=\"fontsize-3vw\">HeartSine samaritan PAD 350P/360P</span></span></b></h2>\r\n",
      "line2": "<div style=\"text-align: left;\"><span class=\"fontsize-1-5-vw\">The semi-automatic HeartSine samaritan PAD 350P AED and fully automatic HeartSine samaritan PAD 360P AED, available with or without Wi-Fi connectivity, offer industry-leading value and environmental protection in the smallest and lightest package available.</span></div>\r\n",
      "jcr:lastModified": "Wed Jun 08 2022 16:02:21 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
