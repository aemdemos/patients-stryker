          "hideComponent": "false",
          "topMargin": "1",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/emergency-patient-transport.html\">Emergency patient transport</a> | <a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/public-access.html\" target=\"_blank\">Public access</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/public-access/evacuation-chairs.html\">Evacuation chairs</a></p>\n",
          "jcr:lastModified": "Tue Dec 19 2023 14:59:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "20"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Dec 19 2023 14:50:08 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Evacuation Chair at a glance</span></span></span><span class=\"fontsize-1-25em\"></span></h2>\n<p><span class=\"fontsize-1-25em\"><b>Model number: 6254</b></span></p>\n<p><span class=\"fontsize-1-25em\">Our tracked technology makes this chair ideal for the efficient evacuation of disabled or injured patients in multilevel facilities.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Patented Stair-TREAD™ tracks allow easy evacuation down stairs by a single operator</span></li>\n<li><span class=\"fontsize-1-25em\">Extendable handle allows operator to have a forward-facing, upright posture</span></li>\n<li><span class=\"fontsize-1-25em\">Foot end lift handles also extend, allowing two caregivers to lift an evacuee over obstacles or up stairs</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Dec 19 2023 14:55:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
