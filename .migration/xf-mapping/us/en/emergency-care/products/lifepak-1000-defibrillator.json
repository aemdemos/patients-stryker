    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7a617b9e44@example.invalid",
      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "hideComponent": "false",
      "topMargin": "3",
      "jcr:created": "Wed Apr 24 2024 14:36:48 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h4><span style=\"color: #ffb500;\">Product Highlights</span></h4>\n<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">LIFEPAK 1000 AED</span></span></h2>\n<p><span class=\"fontsize-1-25em\">In a squad car, onboard a fire engine or out in the field, you're always ready to respond to sudden cardiac arrest emergencies. The LIFEPAK 1000 provides powerful defibrillation, long battery life and robust durability that can stand up to severe environments.&nbsp;</span></p>\n",
      "jcr:lastModified": "Wed Apr 24 2024 14:42:00 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "2"
    },
