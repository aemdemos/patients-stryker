      "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Wed Apr 24 2024 14:39:39 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2 style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">The right tool can make all the difference</span></span></span></h2>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">If you're first on the scene of a cardiac emergency, the LIFEPAK 1000 AED can help improve lifesaving outcomes and speed the transition of patients to the next critical level of care.</span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">The LIFEPAK 1000 combines the simplicity of an AED with clear guidance, including onscreen and audio prompts with the flexibility of manual mode operation when indicated. Flexible setup options allow on-screen graphics for the basic rescuer or ECG display and access to manual mode for the more advanced rescuer. This powerful AED combines basic guidance with advanced operational control, enabling responders to deliver fast, appropriate treatment.&nbsp;</span></p>\n",
      "jcr:lastModified": "Wed Apr 24 2024 14:40:59 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "20",
      "textIsRich": "true"
    },
