          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Powerful and easy to use</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\">Loud voice prompts and on-screen graphics provide clear guidance on applying electrodes and initiating a shock for added user confidence.</span></li>\n<li><span class=\"fontsize-1-25em\">Escalating energy to 360J biphasic for difficult to defibrillate patients.</span></li>\n<li><span class=\"fontsize-1-25em\">Provides battery power for up to 220 shocks – escalating to 360 joules – delivering 17 hours of monitoring time.&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Apr 24 2024 14:36:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        }
      }
    },
