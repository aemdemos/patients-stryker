          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Rugged, vehicle-friendly construction</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\">Endures rigorous drop-tests and includes protective case and bumpers to help maximize durability in the harshest environments.</span></li>\n<li><span class=\"fontsize-1-25em\">Designed to ride along in any vehicle without damage from continuous vibrations and other movement.&nbsp;&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Apr 24 2024 14:36:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true",
