              "hideComponent": "false",
              "gradientDirection": "left-to-right",
              "text": "<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">LIFEPAK 1000 defibrillator</span></span></span></h1>\n<h2><span class=\"fontsize-1-25em\">Simple. Flexible. Powerful.</span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Rugged yet easy to use, the LIFEPAK 1000 defibrillator can make the lifesaving difference for victims of sudden cardiac arrest.&nbsp;</span></span></p>\n",
              "jcr:lastModified": "Wed Apr 24 2024 14:30:42 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
