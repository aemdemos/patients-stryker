          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Clinically advanced, with robust features</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\">Exclusive cprMAX technology helps minimize CPR interruptions by allowing responders to perform pre-shock CPR while the AED charges.</span></li>\n<li><span class=\"fontsize-1-25em\">Industry-leading features including a CPR countdown timer, ECG capability, a shock counter and programmable settings – all on a large, easy-to-read LCD screen.&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Apr 24 2024 14:35:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
