          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Consolidated patient data</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\">Improve patient hand-off across care teams with consolidated data in a single, web-based platform</span></li>\n<li><span class=\"fontsize-1-25em\">Speed up care with faster patient navigation for a variety of non-emergent events and critical emergencies<sup>1-3</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Apr 23 2024 14:05:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true",
