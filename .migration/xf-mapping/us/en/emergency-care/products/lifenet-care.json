              "hideComponent": "false",
              "gradientDirection": "left-to-right",
              "text": "<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-75em\"><span class=\"fontsize-8em\">LIFENET Care</span></span></span></span></h1>\n<h2>Stryker's next-generation patient data communication platform</h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Get a more unified view of your patient's journey by customizing protocols on a modern, clean interface. LIFENET Care makes it easy to consolidate patient data, organize your workflow and connect care teams to make your job easier.</span></span></p>\n",
              "jcr:lastModified": "Thu Apr 25 2024 19:54:31 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "bottomMargin": "7",
