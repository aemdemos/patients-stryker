          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Save time and effort</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Reduces the effort and expense of managing your AED program, while helping to increase your program’s readiness and effectiveness.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Remote monitoring of all readiness information for Stryker AEDs</span></li>\n<li><span class=\"fontsize-1-25em\">Map view with visual readiness status to expedite maintenance checks for all Stryker AEDs</span></li>\n<li><span class=\"fontsize-1-25em\">Readiness alerts including a change in battery status</span></li>\n<li><span class=\"fontsize-1-25em\">Dashboard with the status of all sites, AEDs and CPR/AED certifications*</span></li>\n<li><span class=\"fontsize-1-25em\">Battery and electrode expiration notices</span></li>\n<li><span class=\"fontsize-1-25em\">Additional safety equipment tracking including fire extinguishers and medical kits*</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Mar 11 2024 17:44:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true",
