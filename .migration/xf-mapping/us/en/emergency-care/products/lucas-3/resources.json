              "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
              "jcr:created": "Tue Jan 21 2025 21:41:55 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Manual CPR has hidden costs, Emergency Care<br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-Hidden-Cost-of-Manual-CPR-EMS_US-Canada.pdf\" target=\"_blank\">US</a></span></p>\n<p><span class=\"fontsize-1-25em\">Manual CPR has hidden costs, Hospital<br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-Hidden-Cost-of-Manual-CPR-Hospital_US-Canada.pdf\" target=\"_blank\">US</a></span></p>\n<p><span class=\"fontsize-1-25em\">Eliminate the mattress effect<br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-v3.1-Mattress-Effect_US-Canada.pdf\" target=\"_blank\">US</a>&nbsp;/&nbsp;<a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-v3.1-Mattress-Effect_Europe-MEA.pdf\" target=\"_blank\">Europe/MEA</a></span></p>\n",
              "jcr:lastModified": "Mon Mar 17 2025 14:22:17 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        }
