              "text": "<p><span class=\"fontsize-1-25em\">LUCAS System Values<br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-System-Values_US-Canada.pdf\" target=\"_blank\">US</a>&nbsp;/&nbsp;<a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-System-Values_Europe-MEA.pdf\" target=\"_blank\">Europe/MEA</a></span></p>\n<p><span class=\"fontsize-1-25em\">LUCAS by the numbers, Emergency Care<br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-by-the-numbers_EMS_US-Canada.pdf\" target=\"_blank\">US</a>&nbsp;/&nbsp;<a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-by-the-numbers_EMS_Europe-MEA.pdf\" target=\"_blank\">Europe/MEA</a></span></p>\n<p><span class=\"fontsize-1-25em\">LUCAS by the numbers, Hospital <br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-by-the-numbers_Hospital_US-Canada.pdf\" target=\"_blank\">US</a>&nbsp;/&nbsp;<a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-by-the-numbers_Hospital_Europe-MEA.pdf\" target=\"_blank\">Europe/MEA</a></span></p>\n<p><span class=\"fontsize-1-25em\">LUCAS in helicopter<br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-v3.1-in-a-Helicopter_US-Canada.pdf\" target=\"_blank\">US</a>&nbsp;/&nbsp;<a href=\"/content/dam/stryker/ems/products/lucas-3/resources/one-sheet-topics/LUCAS-3-v3.1-in-a-Helicopter_Europe-MEA.pdf\" target=\"_blank\">Europe/MEA</a></span></p>\n",
              "jcr:lastModified": "Mon Mar 17 2025 14:21:52 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
