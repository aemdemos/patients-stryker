              "jcr:createdBy": "chris.kleckner@stryker.com",
              "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
              "jcr:created": "Tue Jan 21 2025 21:41:55 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">LUCAS 3, v3.1 Your partner in life support<br>\n <a></a><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Brochure_US-Canada.pdf\">US</a> / <a></a><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Pre-hospital-Brochure_Europe-MEA.pdf\">Europe/MEA</a> (Pre-hosp) / <a></a><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Hospital-Brochure_Europe-MEA.pdf\">Europe/MEA</a> (In-hosp)</span></p>\n<p><span class=\"fontsize-1-25em\">Meet LUCAS 3, v3.1 Data sheet<br>\n </span><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\"><a></a><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Spec-Sheet_US-Canada.pdf\">US</a> / <a></a><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Spec-Sheet_Europe-MEA.pdf\">Europe/MEA</a></span></span></p>\n<p><span class=\"fontsize-1-25em\">LUCAS 3 Accessories catalog<br>\n </span><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\"><a></a><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS_3_Accessories-catalog-US_Canada.pdf\">US</a></span></span></p>\n<p><span class=\"fontsize-1-25em\">LUCAS 2-3 Accessories catalog<br>\n </span><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\"><a></a><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS_2-3_Accessories-catalog-Europe_MEA_Canada.pdf\">Europe/MEA</a></span></span></p>\n",
              "jcr:lastModified": "Sun Mar 16 2025 17:28:15 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "col2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "chris.kleckner@stryker.com",
              "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
              "jcr:created": "Tue Jan 21 2025 21:41:55 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">LUCAS Connectivity Guide<br>\n <span data-rte-class=\"rte-temp\"><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Connectivity-Guide_US-Canada-Europe-MEA.pdf\">US</a></span></span></p>\n<p><span class=\"fontsize-1-25em\">Checklist LUCAS 3, v3.1 - Defining setup options<br>\n <span data-rte-class=\"rte-temp\"><a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Setup-Options-Checklist_US-Canada.pdf\">US</a> / <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Setup-Options-Checklist_Europe-MEA.pdf\">Europe/MEA</a></span></span></p>\n<p><span class=\"fontsize-1-25em\">LUCAS Implementation Guide<br>\n <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Implementation-Guide_US-Canada.pdf\" target=\"_blank\">US</a> / <a href=\"/content/dam/stryker/ems/products/lucas-3/resources/brochures/LUCAS-3-v3.1-Implementation-Guide_Europe-MEA.pdf\" target=\"_blank\">Europe/MEA</a></span></p>\n",
              "jcr:lastModified": "Mon Mar 17 2025 13:50:30 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
