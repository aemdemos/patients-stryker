      "hideComponent": "false",
      "jcr:created": "Wed Apr 24 2024 14:17:40 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2 style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Take action with your data.</span></span></span></h2>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">It's crucial to quickly manage patient and device data in the field and throughout the hospital for the best possible care. Receive advance notice of incoming patients, communicate to activate care teams in seconds and track and manage device readiness to make your job easier.</span></p>\n",
      "jcr:lastModified": "Wed Apr 24 2024 14:19:02 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "20",
      "textIsRich": "true"
    },
