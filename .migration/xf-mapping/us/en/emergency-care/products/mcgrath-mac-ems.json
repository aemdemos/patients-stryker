          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Simple. Smart. Versatile.&nbsp;</span></span></h3>\n<ul>\n<li><span class=\"fontsize-1-25em\">Minute-by-minute battery indication and auto-off optimize battery life</span></li>\n<li><span class=\"fontsize-1-25em\">One handle has multiple blade options</span></li>\n<li><span class=\"fontsize-1-25em\">Use for pediatric and adult patients for both routine and extreme airways<sup>6,7</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Mar 11 2024 17:18:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
