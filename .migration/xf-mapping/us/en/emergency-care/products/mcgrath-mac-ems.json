          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Mar 11 2024 17:21:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">Built tough for EMS and designed to reinforce paramedics’ direct laryngoscopy skills, the McGRATH MAC video laryngoscope offers EMS providers an easy-to-implement, cost-effective solution to improve visualization and airway management.</span></p>\n",
          "jcr:lastModified": "Thu Mar 14 2024 21:13:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "20",
          "textIsRich": "true"
        }
      }
    },
