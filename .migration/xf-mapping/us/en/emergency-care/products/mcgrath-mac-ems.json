          "gradientDirection": "left-to-right",
          "text": "<h2 style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Simple and durable</span></span></span></h2>\n",
          "jcr:lastModified": "Mon Mar 11 2024 17:26:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "20",
