      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "sectionseparator": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Mar 11 2024 17:22:05 GMT+0000",
          "jcr:lastModified": "Mon Mar 11 2024 17:22:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Mar 11 2024 17:19:25 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">KEY BENEFITS</span></span></span></h3>\n<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Helping protect you and your patients during intubation</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Video laryngoscopy supports first-attempt success of airway intubation. Research shows video laryngoscopy can help prevent clinician exposure to droplet-borne pathogens and further improve your safety.<sup>3&nbsp;</sup>Recent guidelines highlight the risks of contracting COVID-19 among those caring for infected patients.<sup>3</sup>&nbsp;The guidelines recommend airway management clinicians take precautions to further protect against droplet-borne pathogens.<sup>3</sup>&nbsp;The McGRATH™ MAC video laryngoscope is proven to improve first time success rate,<sup>1,2&nbsp;</sup>reduce time,<sup>5&nbsp;</sup>and lessen hemodynamic response to intubation6&nbsp;when compared to the traditional direct visualization technique.<sup>1,2,5</sup></span></p>\n",
          "jcr:lastModified": "Mon Mar 11 2024 17:21:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_copy_175606443": {
