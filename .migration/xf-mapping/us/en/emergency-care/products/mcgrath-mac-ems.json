          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Proven technology</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The next-generation McGRATH MAC video laryngoscope is an enhanced, more robust device designed for routine use in fast-paced hospital and EMS environments. The latest design offers:</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Enhanced optics</span></li>\n<li><span class=\"fontsize-1-25em\">Increased durability</span></li>\n<li><span class=\"fontsize-1-25em\">Intelligent battery management</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Mar 11 2024 17:19:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true",
          "leftMargin": "3"
        }
      },
