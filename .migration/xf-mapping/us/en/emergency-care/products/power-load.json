  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Power-LOAD at a glance</p>\r\n",
    "shortDescTop": "<p>Our powered cot fastener system helps boost safety by supporting the cot throughout loading and unloading. The reduction in spinal load helps prevent cumulative trauma injuries.<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-82a520efa4@example.invalid",
    "modelNumber": "6390",
    "jcr:lastModified": "Wed Jun 07 2017 15:16:58 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "Communicates wirelessly with Power-PRO cots"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "Eliminates the need to steer the cot into and out of the ambulance"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "Helps minimize patient drops by supporting the cot until the wheels are on the ground"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "Meets dynamic crash test standards for maximized occupant safety"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "Features an easy-to-use manual back-up system"
      }
    }
  },
