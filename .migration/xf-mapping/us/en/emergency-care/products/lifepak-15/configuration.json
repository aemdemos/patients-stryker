          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The red circles will not be displayed when the Site Number and Device ID field values have already been changed or accepted as shown below.</span></span></p>\n",
          "jcr:lastModified": "Wed Jul 27 2022 18:11:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
