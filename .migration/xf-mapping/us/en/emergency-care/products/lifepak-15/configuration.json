          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Technical Support</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">If you have any questions when installing or running the configuration setup tool, please contact Stryker's technical support team at 1-800-442-1142, option 5, option 1 and then option 2.</span></span></p>\n",
          "jcr:lastModified": "Tue Mar 07 2023 19:38:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        },
