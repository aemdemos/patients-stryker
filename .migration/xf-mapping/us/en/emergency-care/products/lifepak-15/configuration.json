      "jcr:lastModified": "Wed Jul 27 2022 17:55:46 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The LIFEPAK defibrillator software solutions - configuration setup tool is a Windows based application designed to assist users in managing the setup options in their LIFEPAK 15 monitor/defibrillators.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The available setup options are described in detail in the LIFEPAK 15 monitor/defibrillator setup options that accompany your device. We recommend you review the setup options prior to using the configuration setup tool to help you become familiar with the available settings in your LIFEPAK 15 monitor/defibrillator.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The configuration setup tool allows you to create a new setup options file on your PC using default settings, save a file from your LIFEPAK device to your PC, modify a file on your PC, or apply setup options to your device.</span></span></p>\n",
          "jcr:lastModified": "Tue Mar 07 2023 19:31:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        },
        "sectionseparator": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Wed Jul 27 2022 17:56:01 GMT+0000",
          "jcr:lastModified": "Wed Jul 27 2022 17:56:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Capabilities and features:</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">A setup wizard to guide you&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Windows based organization for easy navigation&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">A tiered view of all available setup options with defaults highlighted in bold&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Password access to prevent unauthorized changes&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Electronic and printed report options&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Additional language and device support files downloaded as needed&nbsp;</span></span></li>\n</ul>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">System requirements:</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Supported operating systems:</span></span><ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Windows 10 Pro (32 or 64-bit)&nbsp; &nbsp; &nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Windows 11 Pro (64-bit)</span></span></li>\n</ul>\n</li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Minimum hardware requirements:</span></span><ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Processor: 1 GHz or faster processor</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">RAM: 1 GB or more</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Hard Disk: 50 MB of available space required</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Display: 800 x 600 or higher resolution</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Keyboard and mouse (or compatible pointing device)</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Available RS-232 serial DB9 port of USB 2.0 port</span></span></li>\n</ul>\n</li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Communications cables:</span></span><ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">LIFEPAK monitor/defibrillator to DB9 serial port cable&nbsp;(CAT#11230-000020)</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">LIFEPAK monitor/defibrillator to USB cable&nbsp;(CAT#11996-000288)</span></span></li>\n</ul>\n</li>\n</ul>\n",
          "jcr:lastModified": "Tue Mar 07 2023 19:35:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        },
        "sectionseparator_1727781431": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Wed Jul 27 2022 17:59:25 GMT+0000",
          "jcr:lastModified": "Wed Jul 27 2022 17:59:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Download and installation:</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\"><a href=\"/content/dam/stryker/ems/products/lifepak-15/us/ConfigurationSetupToolInstaller.zip\" target=\"_blank\">The&nbsp;configuration setup tool</a>&nbsp;is available free of charge through the Stryker website. Administrative privileges on your PC are required to install the application. An end-user license agreement must also be accepted before installation will proceed.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><u><span class=\"futura-bold\">Before you start:</span></u></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Always consult your medical director's protocol when adjusting the settings on your LIFEPAK 15 monitor/defibrillator. It is also recommended that you have the following documents readily available when you use the configuration setup tool:</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">LIFEPAK 15 monitor/defibrillator setup options&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">LIFEPAK 15 monitor/defibrillator operating instructions&nbsp;</span></span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Think about what you would like to do each time you use the tool. To start, you will be asked to choose from the following options:</span></span></p>\n<ol>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Create a file from your LIFEPAK 15 monitor/defibrillator&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Create a file using factory default settings&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Modify the setup options within an existing file&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Apply the setup options to one or more LIFEPAK devices</span></span></li>\n</ol>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Once you start, just follow the steps in the wizard.Navigation</span></span></p>\n",
          "jcr:lastModified": "Thu Mar 09 2023 16:55:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        },
        "sectionseparator_228849802": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Wed Jul 27 2022 18:10:13 GMT+0000",
          "jcr:lastModified": "Wed Jul 27 2022 18:10:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Navigation</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">To view all the available setup options in the left-hand pane, click on the &quot;Plus Sign&quot; and &quot;Minus Sign&quot; symbols to expand and contract the list (see figure below).</span></span></p>\n",
          "jcr:lastModified": "Tue Mar 07 2023 19:37:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
        },
