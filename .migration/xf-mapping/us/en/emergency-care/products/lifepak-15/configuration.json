          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Notes</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Stryker has verified that the configuration setup tool operates correctly on the listed operating systems and knows of no issues that would prevent its use on newer versions or other editions of Windows operating systems.</span></span></p>\n",
          "jcr:lastModified": "Tue Mar 07 2023 19:39:08 GMT+0000",
