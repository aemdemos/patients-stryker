          "hideComponent": "false",
          "jcr:created": "Tue Nov 16 2021 20:06:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\"><b>NOTE: </b>Always confirm that your scheduled setup options match your local medical director's protocols.</span></span></p>\n",
          "jcr:lastModified": "Mon Aug 29 2022 20:43:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "textIsRich": "true"
