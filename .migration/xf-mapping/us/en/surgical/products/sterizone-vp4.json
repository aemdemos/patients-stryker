          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 14:58:05 GMT+0000",
          "srcFileRef": "/content/dam/stryker/surgical/products/sterizone-vp4/images/robot.png",
          "jcr:lastModified": "Fri Oct 11 2019 14:58:27 GMT+0000",
