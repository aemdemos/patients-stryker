        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 14:58:14 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Three robotic surgery sets in the </span><span class=\"futura-bold\">same</span><span class=\"urw-egyptienne\"> load</span></span></p>\n",
          "jcr:lastModified": "Fri Oct 11 2019 19:44:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 14:58:05 GMT+0000",
          "srcFileRef": "/content/dam/stryker/surgical/products/sterizone-vp4/images/load.png",
          "jcr:lastModified": "Fri Oct 11 2019 15:02:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 14:58:14 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Orthopaedic power tools </span><span class=\"futura-bold\">and</span><span class=\"urw-egyptienne\"> batteries sterilized in the same load</span></span></p>\n",
          "jcr:lastModified": "Fri Oct 11 2019 19:43:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-bffe03609f@example.invalid",
          "jcr:created": "Fri Oct 11 2019 14:58:05 GMT+0000",
          "srcFileRef": "/content/dam/stryker/surgical/products/sterizone-vp4/images/bacteria.png",
          "jcr:lastModified": "Wed Oct 30 2019 17:53:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-bffe03609f@example.invalid",
          "jcr:created": "Fri Oct 11 2019 14:58:14 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Flexible endoscopes that fall within certain dimensions that have come into contact with multi-drug resistant bacteria can now be </span><span class=\"futura-bold\">terminally sterilized</span></span></p>\n",
          "jcr:lastModified": "Wed Oct 30 2019 17:42:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
