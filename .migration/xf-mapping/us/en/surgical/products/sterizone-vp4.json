      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 15:04:51 GMT+0000",
          "srcFileRef": "/content/dam/stryker/surgical/products/sterizone-vp4/images/button.png",
          "jcr:lastModified": "Fri Oct 11 2019 15:05:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-bffe03609f@example.invalid",
          "jcr:created": "Fri Oct 11 2019 15:04:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Load the device, press the button, and let the machine do the work.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">With no load calculations, and a mix-and-match load capability up to 75 lb.,*&nbsp;helps to minimize chances for operator error so you&nbsp; can be confident that terminally sterilized instruments go to the OR every time.</span></span></p>\n",
          "jcr:lastModified": "Mon Dec 02 2019 15:42:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 15:04:51 GMT+0000",
          "srcFileRef": "/content/dam/stryker/surgical/products/sterizone-vp4/images/money.png",
          "jcr:lastModified": "Fri Oct 11 2019 15:05:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 15:04:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The mix-and-match load capability enables you to process the same amount of instruments in fewer loads, which saves you money.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Our Dynamic Sterilant Delivery System uses only as much sterilant as you need for each load. One cycle reduces the need for multiple biological indicators required in multi-cycle sterilizers.&nbsp;Our load capacity of up to 75 lbs. of mixed instrumentation can increase throughput. And by helping your staff increase their efficiency, you save on overhead costs.</span></span></p>\n",
          "jcr:lastModified": "Fri Nov 15 2019 18:56:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 15:04:51 GMT+0000",
          "srcFileRef": "/content/dam/stryker/surgical/products/sterizone-vp4/images/time.png",
          "jcr:lastModified": "Fri Oct 11 2019 15:05:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Oct 11 2019 15:04:59 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">The Sterizone VP4 Sterilizer delivers with minimal sorting time, staff touchpoints, and training time.&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Fri Nov 15 2019 18:57:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
