      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "col2": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "wcm/foundation/components/parsys",
          "text": {
            "jcr:primaryType": "nt:unstructured",
            "jcr:createdBy": "alison.moutinho@stryker.com",
            "jcr:lastModifiedBy": "alison.moutinho@stryker.com",
            "jcr:created": "Wed Jan 11 2023 17:12:16 GMT+0000",
            "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Our patient education brochures, posters, banners and more are intended to help build understanding and confidence during patient clinic visits and provide a pathway to additional information after the appointment. These materials can help educate patients on ankle arthritis and the features and benefits of total ankle replacement. <b>To order, contact your sales representative today.</b></span></span><br>\n</p>\n",
            "jcr:lastModified": "Wed May 03 2023 16:13:53 GMT+0000",
            "sling:resourceType": "stryker/components/content/text",
            "textIsRich": "true"
          }
        }
      }
    },
