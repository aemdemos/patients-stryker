    "largeheadline_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "alison.moutinho@stryker.com",
      "jcr:lastModifiedBy": "alison.moutinho@stryker.com",
      "jcr:created": "Wed Dec 07 2022 16:13:41 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2-5-vw\">Welcome to the Total Ankle Replacement Patient Marketing Toolkit</span></span>",
      "jcr:lastModified": "Wed May 03 2023 16:07:10 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
      "textIsRich": [
        "true",
        "true"
      ]
    },
    "text_copy_1777794849": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "alison.moutinho@stryker.com",
      "jcr:lastModifiedBy": "alison.moutinho@stryker.com",
      "jcr:created": "Wed Dec 07 2022 16:17:12 GMT+0000",
      "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">As a healthcare provider, you understand your patients need accurate and comprehensive information about their health care. Our patient education and marketing toolkit was created with this express purpose in mind. We offer a wide variety of options to help your practice reach patients through various platforms including print collateral, website content, digital marketing, social media and public relation efforts.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Start exploring the ways you can give patients the opportunity to learn more about total ankle replacement.</span></span></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n",
      "jcr:lastModified": "Wed May 03 2023 19:28:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
