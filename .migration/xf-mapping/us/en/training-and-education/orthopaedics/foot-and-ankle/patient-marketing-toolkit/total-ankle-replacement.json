      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "alison.moutinho@stryker.com",
          "jcr:lastModifiedBy": "alison.moutinho@stryker.com",
          "jcr:created": "Wed Jan 11 2023 19:28:00 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">National patient campaigns are intended to raise awareness of ankle arthritis and to educate patients for these conditions including total ankle replacement. Our patient education, digital marketing, social media and public relations efforts drive patients to each product’s respective patient website where they can learn more about the procedures and locate a provider in their area to schedule a consultation. The goal of this program is to empower patients to seek treatment by connecting them with physicians who perform total ankle replacement procedures. <b>Talk to your sales representative today to be added to our surgeon locator.</b></span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri May 12 2023 15:24:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
