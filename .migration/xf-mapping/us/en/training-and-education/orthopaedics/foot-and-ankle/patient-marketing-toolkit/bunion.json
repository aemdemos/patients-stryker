          "text": {
            "jcr:primaryType": "nt:unstructured",
            "jcr:createdBy": "user-869b706c5f@example.invalid",
            "jcr:lastModifiedBy": "user-869b706c5f@example.invalid",
            "jcr:created": "Wed Jan 11 2023 17:12:16 GMT+0000",
            "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Our patient education brochures, posters, banners and more are intended to help build understanding and confidence during patient clinic visits and provide a pathway to additional information after the appointment. These materials can help educate patients on bunion pathology, the features and benefits of PROstep minimally invasive surgery and Lapifuse bunion correction procedures. <b>To order, contact your sales representative today</b></span></span><br>\n</p>\n",
            "jcr:lastModified": "Wed Jan 18 2023 20:39:40 GMT+0000",
            "sling:resourceType": "stryker/components/content/text",
            "textIsRich": "true"
          }
        }
      }
    },
