      "jcr:created": "Wed Dec 07 2022 16:13:41 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2-5-vw\">Welcome to the PROstep MIS and Lapifuse Patient Marketing Toolkit</span></span>",
      "jcr:lastModified": "Wed Dec 07 2022 16:14:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
