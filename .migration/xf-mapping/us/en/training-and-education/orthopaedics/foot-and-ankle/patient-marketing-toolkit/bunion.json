      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-869b706c5f@example.invalid",
          "jcr:lastModifiedBy": "user-869b706c5f@example.invalid",
          "jcr:created": "Wed Jan 11 2023 19:28:00 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">National patient campaigns are intended to raise awareness of bunions and to educate patients about surgical solutions for these conditions including PROstep minimally invasive surgery and Lapifuse bunion correction procedure. Our patient education, digital marketing, social media and public relations efforts drive patients to each product’s respective patient website where they can learn more about the procedures and locate a provider in their area to schedule a consultation. The goal of this program is to empower patients to seek treatment by connecting them with our physician customers. <b>Talk to your sales representative today to be added to our surgeon locator.</b></span></span><br>\n</p>\n",
          "jcr:lastModified": "Wed Jan 18 2023 20:35:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
