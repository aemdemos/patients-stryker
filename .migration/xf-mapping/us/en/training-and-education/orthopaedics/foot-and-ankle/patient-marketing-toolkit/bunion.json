    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-869b706c5f@example.invalid",
      "jcr:lastModifiedBy": "user-869b706c5f@example.invalid",
      "jcr:created": "Wed Dec 07 2022 16:17:12 GMT+0000",
      "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">As a healthcare provider, you understand your patients need accurate and comprehensive information about their health care. Our patient education and marketing toolkit was created with this express purpose in mind. We offer a wide variety of options to help your practice reach patients through various platforms including print collateral, website content, digital marketing, social media and public relation efforts.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Start exploring the ways you can give patients the opportunity to learn more about PROstep minimally invasive surgery and Lapifuse bunion correction procedures.</span></span></p>\n",
      "jcr:lastModified": "Wed Jan 18 2023 20:39:54 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
