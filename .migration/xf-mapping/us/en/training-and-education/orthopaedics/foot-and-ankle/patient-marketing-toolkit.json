      "gradientDirection": "left-to-right",
      "line1": "<span class=\"fontsize-3-5-vw\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Making healthcare better through education.</span></span></span>",
      "jcr:lastModified": "Wed Jul 03 2024 16:03:13 GMT+0000",
