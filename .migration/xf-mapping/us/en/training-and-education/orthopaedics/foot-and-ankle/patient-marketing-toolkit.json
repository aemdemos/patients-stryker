    "cols": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-869b706c5f@example.invalid",
      "jcr:lastModifiedBy": "user-869b706c5f@example.invalid",
      "jcr:created": "Wed Dec 07 2022 15:47:30 GMT+0000",
      "jcr:lastModified": "Wed Dec 07 2022 15:47:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1297665558": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-869b706c5f@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 07 2022 15:47:47 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">As a healthcare provider, you understand your patients need accurate and comprehensive information about their health care and the products you use for their treatment. Our patient education and patient marketing toolkit was created with this express purpose in mind. We offer a wide variety of options to help your practice reach patient through various platforms including print collateral, website content, digital marketing, social media and public relation efforts.&nbsp;</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Start exploring the ways you can give patients the opportunity to learn more about Stryker products and techniques, and contact you for expert advice, counsel and consultation.</span></span></p>\n",
          "jcr:lastModified": "Wed Jul 03 2024 15:02:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "fullwidthimage": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-869b706c5f@example.invalid",
