      "layoutOptions": "50_top",
      "backgroundImageRef": "/content/dam/stryker/foot-and-ankle/images/patient-marketing-toolkit/1_Bunion Patient Site Banner_3000x1000.png",
      "jcr:created": "Wed Jan 11 2023 16:27:54 GMT+0000",
      "alt": "Woman on computer",
      "jcr:lastModified": "Wed Jan 11 2023 16:33:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/fullWidthImage",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "col1": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "wcm/foundation/components/parsys",
          "text": {
            "jcr:primaryType": "nt:unstructured",
            "jcr:createdBy": "user-869b706c5f@example.invalid",
            "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
            "jcr:created": "Wed Jan 11 2023 16:35:23 GMT+0000",
            "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\">Surgeon locator</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">so patients can find you when they need you.</span><span class=\"fontsize-1-5em\"><span class=\"fontsize-1-75em\"></span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">In order to meet the needs for our patient visitor, we strive to provide high-quality patient education regarding our products, along with a list of surgeons who have experience using our products, should they have questions about their condition, our products or techniques. Online search initatives play a significant role here at Stryker. We firmly believe in the power of the internet to help educate patients on our products and techniques and invite you to be a part of our efforts.&nbsp;</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><b>Surgeons: talk to your sales representative today to be added to our surgeon locator.</b></span></span></p>\n",
            "jcr:lastModified": "Wed Jul 03 2024 16:02:44 GMT+0000",
            "sling:resourceType": "stryker/components/content/text",
            "textIsRich": "true"
          },
