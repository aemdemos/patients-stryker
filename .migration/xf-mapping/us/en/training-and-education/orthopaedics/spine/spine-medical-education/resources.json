      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Apr 13 2020 18:58:51 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">The lab is our mobile operating room, with eight integrated lab stations that allow visitors to experience&nbsp;our line of products and partner technologies.</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\">It is set up for a wide variety of surgical specialties, procedures and situations and is continually touring the country, stopping at facilities and institutions.</span></span></span></p>\r\n",
          "jcr:lastModified": "Thu Apr 16 2020 13:13:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Tue Apr 14 2020 17:29:51 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">The mobile lab is used for a variety of events:</span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Customer experience events showcasing&nbsp;our products</span></span><br>\n</li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Product training events and courses<br>\n </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">O.R. professionals workshops<br>\n </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Customer feedback for next generation products</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Thu Apr 16 2020 13:14:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
