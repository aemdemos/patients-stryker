          "jcr:created": "Mon Apr 13 2020 18:58:51 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">Located within our headquarters in Leesburg, Virginia is a 1,484 sq-ft bioskills lab designed for hands-on cadaveric and sawbones simulated training, accommodating up to six whole body stations with fluoroscopy.</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\">The lab provides an environment for interactive product training for surgeons, physicians, and HCPs, from surgical procedure training to research and development.</span></span></span></p>\r\n",
          "jcr:lastModified": "Thu Apr 16 2020 13:12:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Apr 13 2020 14:59:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span style=\"color: #000000;\"><span style=\"color: #ffffff;\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\">Offering six stations, each with a camera, monitor, and lights for enhanced visibility</span></span></span><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><br>\n <br>\n </span></span></span></span></li>\n<li><span style=\"color: #000000;\"><span style=\"color: #ffffff;\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\">Equipped with a Ziehm RFD 3D C-Arm and two GE 9900 Elite C-Arms</span></span></span><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><br>\n <br>\n </span></span></span></span></li>\n<li><span style=\"color: #000000;\"><span style=\"color: #ffffff;\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\">SpineMap 3D and SpineMap Go navigation software available for hands-on use</span></span></span></span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Tue Apr 14 2020 17:21:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": "true"
        }
      }
