          "jcr:created": "Mon Apr 13 2020 18:58:51 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">The S2S program is an educational forum that provides academic product trainings and encourages surgeon-to-surgeon collaboration.</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\">The goal of this program is to provide physicians an opportunity to learn surgical techniques from esteemed and experienced spine surgeons who utilize our products.</span></span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">These discussions will include product tips and pearls to help you enhance patient care.</span></span></p>\r\n",
          "jcr:lastModified": "Tue Apr 14 2020 17:16:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
