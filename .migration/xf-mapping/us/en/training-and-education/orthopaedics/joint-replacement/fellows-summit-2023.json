    "text_copy_1139286102_533494690": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Thu Oct 06 2022 22:38:52 GMT+0000",
      "text": "<p><span class=\"urw-egyptienne\"><span style=\"color: #85458a;\"><span class=\"fontsize-2em\">VSO GO</span></span></span></p>\n<p>Experience a live procedure in a Virtual Surgical Observation (VSO GO) without ever leaving your office. A VSO GO transports you into a faculty’s OR to watch a procedure with multiple views and dialogue directly with the faculty in real time! VSO GOs are a premier peer-to-peer educational tool, and we hope you’ll make them a part of your education journey.</p>\n<p><span class=\"futura-bold\">VSO GO types</span></p>\n<p>Introduction to Mako | See Mako in action and learn how it has impacted the faculty and their patients.</p>\n<p>Post-certification | Schedule a VSO GO after certification and before your first case for additional training, tips and tricks.</p>\n<p>Advanced training | Explore what Mako SmartRobotics™ can do for your patients.</p>\n<p>&nbsp;</p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span style=\"color: #85458a;\">VSO GO procedures</span></span></span></p>\n<p>Mako Partial Knee, Mako Total Knee, Mako Total Hip, DA with Insignia<sup>®</sup></p>\n<p>Choose your VSO faculty and schedule a VSO GO with your Stryker sales representative today!</p>\n",
      "jcr:lastModified": "Tue Apr 11 2023 15:28:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
