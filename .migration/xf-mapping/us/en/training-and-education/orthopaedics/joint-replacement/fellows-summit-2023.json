    "text_copy_1139286102": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Thu Oct 06 2022 22:38:52 GMT+0000",
      "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #4c7d7a;\"><span style=\"color: #85458a;\">JR</span></span></span><span style=\"color: #b2b4ae;\">45&nbsp;</span></span><span class=\"urw-egyptienne\">Year of Learning</span></span></p>\n<p><span class=\"futura-bold\">Are you registered for JR45, Year of Learning?</span></p>\n<p>Register today for Stryker’s interactive and on-demand monthly education series focused on the latest techniques and technologies in hip and knee arthroplasty. Join the education journey to explore nine months of unlocked e-learning content plus monthly 45-minute case-based webinars.</p>\n",
      "jcr:lastModified": "Tue Apr 11 2023 15:28:02 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
