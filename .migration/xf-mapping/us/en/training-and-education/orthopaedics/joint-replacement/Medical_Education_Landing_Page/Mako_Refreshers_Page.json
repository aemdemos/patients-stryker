          "jcr:created": "Fri Jan 10 2020 19:33:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\">Join us for one - or more - Mako SmartRobotics™&nbsp;</span></span></span><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\">refresher courses</span><span style=\"color: rgb(255,181,0); background-color: transparent; font-weight: normal;\">!</span></span></span></h1>\r\n",
          "line2": "<h3><span class=\"fontsize-1-5-vw\"><span class=\"fontsize-2vw\"><span style=\"color: rgb(237,238,236);\">Each virtual course is dedicated to just one application, so you and a very small group of your peers can dialogue directly with the faculty and delve into your specific training questions. Let’s explore planning, OR set up, intraoperative workflow and more. You can even pull up your past or upcoming cases and review them with the faculty!</span></span></span></h3>\r\n",
          "jcr:lastModified": "Tue Aug 17 2021 16:52:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(133,69,138,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
