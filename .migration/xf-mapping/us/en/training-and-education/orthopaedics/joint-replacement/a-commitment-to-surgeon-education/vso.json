      "jcr:created": "Fri Jan 23 2026 19:56:34 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<div><span class=\"fontsize-1-25em\"><b>Experience</b> <b>a live procedure</b> in a Virtual Surgical Observation (VSO) without leaving your office. A VSO transports you into an OR to watch a Mako procedure in real time and ask questions directly to the operating surgeon.&nbsp;</span><span class=\"fontsize-1-5em\"><br>\n </span><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">&nbsp;</span></b></span></div>\n<div style=\"margin-left: 40px;\"><br>\n<span class=\"fontsize-1-25em\"><b>Introduction to Mako:&nbsp;</b>See Mako in action and learn how it can impact your practice and patient outcomes.&nbsp;</span></div>\n<div style=\"margin-left: 40px;\"><b data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\"><br>\n <b>Pre-certification:&nbsp;</b></span></b><span class=\"fontsize-1-25em\">Prepare for your certification with a live Mako procedure and discussions with faculty.&nbsp;</span><b data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\"><br>\n <br>\n <b>Post-certification:&nbsp;</b></span></b><span class=\"fontsize-1-25em\">Schedule a VSO after certification and before your first Mako case for additional training, tips and tricks.&nbsp;</span><b data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\"><br>\n <br>\n <b>Advanced training:&nbsp;</b></span></b><span class=\"fontsize-1-25em\">Explore more of what Mako SmartRobotics™ can do for you and your patients.</span></div>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\"><br>\nStretch your skills, sharpen your thinking and step into what’s next.</span></b></span></p>\n<p><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\">Reserve your spot below.</span></b> A calendar invite and access details will follow.</span></p>\n",
      "jcr:lastModified": "Mon Apr 27 2026 18:49:52 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "5",
      "showDimensionalBox": "true",
      "textIsRich": "true"
    },
