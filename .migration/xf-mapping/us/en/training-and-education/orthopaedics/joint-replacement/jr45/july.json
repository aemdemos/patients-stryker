          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Evaluate when to use a cemented stem based on bony anatomy</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate when to use a collared and collarless stem</span></li>\n<li><span class=\"fontsize-1-25em\">Understand acetabular component selection</span></li>\n<li><span class=\"fontsize-1-25em\">Explore and understand implant selection for complex primary total hip arthroplasty</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Jul 06 2023 20:37:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Product focus</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Insignia Hip System</span></li>\n<li><span class=\"fontsize-1-25em\">Accolade II Hip System<br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">Exeter Hip System</span></li>\n<li><span class=\"fontsize-1-25em\">Restoration Modular</span></li>\n<li><span class=\"fontsize-1-25em\">Trident II Tritanium Acetabular System</span></li>\n<li><span class=\"fontsize-1-25em\">Modular Dual Mobility</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Jul 06 2023 20:38:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
