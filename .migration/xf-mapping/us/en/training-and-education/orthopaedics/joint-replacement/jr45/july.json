          "jcr:created": "Mon Jul 25 2022 18:37:31 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Patient care choices <br />\r\n</span></span><b>Total hip edition</b></span></h1>\r\n",
          "line2": "<span class=\"fontsize-1-5-vw\">Faculty pearls | Transitioning to practice</span>",
          "jcr:lastModified": "Fri Jul 07 2023 15:20:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
