          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Evaluate the painful total knee&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Identify implant needs through surgical planning&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Define the steps of revision knee surgery&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Discover tips and tricks for implant removal&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Define indications for stems and cones&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate post operative considerations&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Discuss minimizing complications&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Sep 06 2022 16:10:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Product focus</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Triathlon Revision Knee System</span></li>\n<li><span class=\"fontsize-1-25em\">Triathlon Tritanium Cone Augments&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Sep 06 2022 16:12:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
