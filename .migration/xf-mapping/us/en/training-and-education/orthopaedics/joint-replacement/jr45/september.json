          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Simplifying</span></span> revision knee</span></h1>\r\n",
          "jcr:lastModified": "Tue Jan 17 2023 15:55:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
