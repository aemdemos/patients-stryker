          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span style=\"background-color: transparent; font-weight: normal; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Treatment of&nbsp;<span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">periprosthetic fractures</span></span></span></span></span></h1>\r\n",
          "jcr:lastModified": "Fri Apr 11 2025 14:42:28 GMT+0000",
