          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span style=\"background-color: transparent; font-weight: normal; color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Adding to patient-based options with partial&nbsp;<span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">knee procedures</span></span></span></span></span></h1>\r\n",
          "jcr:lastModified": "Mon Feb 10 2025 18:30:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
