          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">What would you do? <br />\r\n</span></span><b>Complex revision knee</b></span></h1>\r\n",
