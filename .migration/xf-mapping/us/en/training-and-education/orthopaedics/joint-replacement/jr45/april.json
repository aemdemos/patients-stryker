          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Explore what you would do with an infection</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate what you would do with bone loss</span></li>\n<li><span class=\"fontsize-1-25em\">Determine what you would do with loosening</span></li>\n<li><span class=\"fontsize-1-25em\">Explore what you would do to address periprosthetic fractures</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Mar 29 2023 13:38:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
