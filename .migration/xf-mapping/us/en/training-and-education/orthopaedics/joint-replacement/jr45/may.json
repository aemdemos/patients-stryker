          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Explore complex revision total hip procedures&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Identify prosthetic implant selection&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate and address revision for infection cases&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate and address revision for fracture cases&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Explore pelvic reconstruction in revision hip surgery&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Apr 21 2023 13:37:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
