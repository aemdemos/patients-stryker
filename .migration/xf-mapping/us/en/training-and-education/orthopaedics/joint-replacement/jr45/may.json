          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">What would you do? <br />\r\n </span></span><b>Complex revision total hip</b></span></h1>\r\n",
          "jcr:lastModified": "Tue May 09 2023 18:05:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
