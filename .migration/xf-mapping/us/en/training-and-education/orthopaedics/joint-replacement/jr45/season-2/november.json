          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Product focus</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Mako Total Hip</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Oct 30 2023 17:46:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
