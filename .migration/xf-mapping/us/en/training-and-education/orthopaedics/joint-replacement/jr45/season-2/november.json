          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Mon Jul 25 2022 18:37:31 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Incorporating individualized planning into total hip arthroplasty</span></span></span></h1>\r\n",
          "jcr:lastModified": "Mon Oct 30 2023 17:44:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Understand the principles of CT-based planning through cup and stem positioning</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate patient landmarks to determine points used for hip length, offset, COR and Functional Hip Positioning</span></li>\n<li><span class=\"fontsize-1-25em\">Discuss the importance of the hip to spine relationship and the effects of a stiff or hyper-mobile spine in 3D, CT-based planning</span></li>\n<li><span class=\"fontsize-1-25em\">Demonstrate Functional Hip Positioning, pelvic tilt planning and impingement modeling with 3D, CT-based planning&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Nov 01 2023 17:31:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
