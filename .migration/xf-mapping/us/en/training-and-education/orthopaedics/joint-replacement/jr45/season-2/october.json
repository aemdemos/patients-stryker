          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Who, why and how? Exploring partial knee procedures</span></span></span></h1>\r\n",
          "jcr:lastModified": "Thu Oct 12 2023 18:09:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
