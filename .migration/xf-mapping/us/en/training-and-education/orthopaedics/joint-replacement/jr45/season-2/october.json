          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Explore 3D CT-based planning, surgical steps and workflow</span></li>\n<li><span class=\"fontsize-1-25em\">Identify and understand indications for partial knee procedures</span></li>\n<li><span class=\"fontsize-1-25em\">Explore medial, bicomp and patellofemoral partial knee replacements</span></li>\n<li><span class=\"fontsize-1-25em\">Understand clinical data on robotic partial knee procedures</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Oct 16 2023 15:42:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
