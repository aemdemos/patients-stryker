          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Product focus</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Direct Anterior Approach DART<sup>TM</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Insignia Hip System</span></li>\n<li><span class=\"fontsize-1-25em\">Accolade II Hip System</span></li>\n<li><span class=\"fontsize-1-25em\">Exeter Hip System</span></li>\n<li><span class=\"fontsize-1-25em\">Restoration Modular</span></li>\n<li><span class=\"fontsize-1-25em\">Trident II Tritanium Acetabular System</span></li>\n<li><span class=\"fontsize-1-25em\">Modular Dual Mobility</span><br>\n</li>\n</ul>\n",
