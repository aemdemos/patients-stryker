          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Determine when to do a uni or total knee arthroplasty</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate cementless and cemented total knee arthroplasty&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Evaluate and understand differences in CR and PS&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Determine the use of stems or cones for complex primaries&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue May 30 2023 14:40:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
