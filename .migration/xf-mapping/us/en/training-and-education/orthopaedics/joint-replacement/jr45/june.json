          "line1": "<h1><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Patient care choices,&nbsp;<br>\r\n</span></span><b>total knee edition</b></span></h1>\r\n",
