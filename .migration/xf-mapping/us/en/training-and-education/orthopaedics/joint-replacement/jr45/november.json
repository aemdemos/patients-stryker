          "jcr:created": "Mon Jul 25 2022 18:37:31 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-5vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Simplifying&nbsp;</span></span><b>revision hip</b></span></h1>\r\n",
          "jcr:lastModified": "Fri Jan 20 2023 20:08:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
