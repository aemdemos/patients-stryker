      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Program objectives</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Goals of revision hip surgery&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Identify and evaluate periprosthetic fractures&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Discuss implant removal, ETO and EZout</span></li>\n<li><span class=\"fontsize-1-25em\">Femoral reconstruction</span></li>\n<li><span class=\"fontsize-1-25em\">Augments and defect management</span></li>\n<li><span class=\"fontsize-1-25em\">Indications for dual mobility constructs</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Nov 03 2022 15:09:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Mon Jul 25 2022 18:46:47 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Product focus</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Modular Dual Mobility</span></li>\n<li><span class=\"fontsize-1-25em\">Restoration Acetabular Wedge Augment System</span></li>\n<li><span class=\"fontsize-1-25em\">Restoration Anatomic Shell</span></li>\n<li><span class=\"fontsize-1-25em\">Restoration Modular Hip System.</span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Thu Nov 03 2022 15:14:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
