      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "frank.mastrangelo@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Mon Oct 02 2017 12:31:22 GMT-0400",
          "text": "<h5><b>We'll keep up. </b>As you progress so will our offerings.</h5>\n<ul>\n<li>Your need for tiered levels of training and education is met byour extensive course offering ranging from basic resident traning to advanced surgical techniques.</li>\n</ul>\n<div>&nbsp;</div>\n<ul>\n<li>By partnering with industry societies, we offer educational grants to give you the opportunity to attend other courses that you may need.&nbsp;</li>\n</ul>\n<div>&nbsp;</div>\n<ul>\n<li>We're bringing training to you. Our cutting-edge mobile operation room experience (the TEACH mobile lab) is a first-class lab on wheels.</li>\n</ul>\n",
          "jcr:lastModified": "Tue Feb 13 2018 14:50:59 GMT-0500",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
