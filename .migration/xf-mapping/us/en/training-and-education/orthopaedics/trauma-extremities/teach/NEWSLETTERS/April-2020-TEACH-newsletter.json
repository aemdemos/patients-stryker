              "line1": "<b><span class=\"fontsize-3-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">May 2020 TEACH newsletter</span></span></span></b>",
              "line2": "<p><span class=\"futura-bold\"><span class=\"fontsize-1vw\"><span class=\"fontsize-1-5-vw\">A message from Dr. Lowe</span></span></span></p>\r\n<p><span class=\"fontsize-1vw\"><sup><span class=\"urw-egyptienne\">Banner University Health System | Tuscon, AZ</span></sup></span></p>\r\n",
