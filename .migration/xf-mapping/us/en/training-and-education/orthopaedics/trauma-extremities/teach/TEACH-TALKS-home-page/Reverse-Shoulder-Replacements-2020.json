      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Wed Sep 11 2019 19:43:16 GMT+0000",
          "text": "<p><b>Description:&nbsp;<br>\n</b>Reverse shoulder arthroplasty has become a popular treatment option for many patients experiencing shoulder pain. Join us as Dr. Bahk presents the history, evolution, and biomechanical considerations of reverse shoulder arthroplasty options on the market today.</p>\n<p><b>Learning objective:</b></p>\n<ul>\n<li>Take a look at the biomechanics and anatomy of the glenohumeral joint</li>\n<li>Review the evolution of the reverse shoulder replacements and where the research has brought us to today&nbsp;</li>\n<li>The key components of a lateralized design and the benefits potentially to the patient</li>\n<li>Find out why reverse shoulder replacements have become so popular and how modernized implant designs have impacted the shoulder market</li>\n</ul>\n<p><b>Course instructor:</b>&nbsp;Michael Bahk, MD</p>\n",
          "jcr:lastModified": "Wed May 27 2020 19:50:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
