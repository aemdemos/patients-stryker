          "jcr:created": "Mon Mar 18 2019 20:54:23 GMT+0000",
          "title": "ADAPT for Gamma3",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/landing-pages/ADAPT-feature.png",
          "jcr:lastModified": "Mon Mar 18 2019 21:02:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Mon Mar 18 2019 20:54:54 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b>ADAPT’s software</b> is designed to provide 3-dimensional guidance for implant placement based on x-ray images and offers precision where it matters most, an adaptive workflow and is designed for consistent results with Distal Targeting support. This software can eliminate the need for certain hardware instrumentation while enabling surgeons to guide implant alignment, lag screw length determination, lag screw positioning and distal targeting. Explore the resources below to learn more about ADAPT for Gamma3.</span></p>\n",
          "jcr:lastModified": "Mon Mar 18 2019 21:06:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
