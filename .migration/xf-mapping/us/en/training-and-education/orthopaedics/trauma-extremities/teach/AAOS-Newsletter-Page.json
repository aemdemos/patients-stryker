      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Tue Mar 19 2019 15:19:52 GMT+0000",
          "title": "Plating",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/landing-pages/Plating-feature.png",
          "jcr:lastModified": "Tue Mar 19 2019 15:20:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Mon Mar 18 2019 21:07:46 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">Over the past decade we have continued to expand our comprehensive plating portfolio by releasing over 35 new products. This year Stryker maintains its position as the market leader in titanium plating by providing innovative solutions to treat periprosthetic fractures. The <b>new AxSOS 3 Variable Angle Extension Arm</b> provides the ability to avoid a prosthetic implant with variable angle locking. The AxSOS 3 cable plug provides stable positioning of cerclage cable on a plate. These periprosthetic plate attachments, when used independently or together, allow for multiplanar fixation around an intramedullary implant.</span></p>\n<p><span class=\"fontsize-1-25em\"><a href=\"https://www.stryker.com/us/en/trauma-and-extremities/systems/plating.html\"><b>Visit our website</b></a> to learn more about how Stryker continues to provide unmatched instrumentation, data driven plate design, and innovative solutions to solve complex cases.</span></p>\n",
          "jcr:lastModified": "Fri Mar 29 2019 19:02:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
