    "cols2_1_3_2_3_1693256875": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "vince.wolff@stryker.com",
      "jcr:lastModifiedBy": "vince.wolff@stryker.com",
      "jcr:created": "Mon Mar 18 2019 21:07:01 GMT+0000",
      "jcr:lastModified": "Mon Mar 18 2019 21:07:01 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Mon Mar 18 2019 21:07:46 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b>T2 Alpha</b> is the result of Stryker’s latest technological advancements in both implant and instrumentation design delivering a comprehensive intramedullary nailing system designed for intuitive use and a streamlined procedure. T2 Alpha delivers a comprehensive implant portfolio to meet the diverse anatomical needs of patients with nails designed for preferred entry (greater trochanteric or piriformis fossa), length-dependent radius of curvature, and added locking configurations both proximally and distally.</span></p>\n<p><span class=\"fontsize-1-25em\">T2 Alpha introduces a new screw option called the Advanced Locking Screw designed for added axial and angular stability. The Advanced Locking Screw is designed to limit relative motion between the nail and screw while maintaining bi-cortical purchase<sup>1,2</sup>. With the ability to thread and lock into any round 5mm hole of T2 Alpha nails, Advanced Locking Screws allow surgeons to choose when additional stability is needed. In addition, T2 Alpha allows for guided distal screw locking with dedicated distal targeting devices for both femur and tibia.&nbsp; Distal targeting devices are designed to provide surgeons with a reproducible and consistent procedure for distal screw locking while may reduce X-ray exposure and improve OR efficiency<sup>3</sup>.&nbsp;</span></p>\n",
          "jcr:lastModified": "Fri Mar 29 2019 17:58:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
