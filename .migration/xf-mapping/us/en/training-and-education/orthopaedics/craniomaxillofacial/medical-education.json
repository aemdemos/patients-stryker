            "standaloneimage": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-c26bb7a766@example.invalid",
              "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
              "preset": "max_width_1440",
              "jcr:created": "Thu Jun 05 2025 19:43:37 GMT+0000",
              "alt": "MedEd-CMF-local-platforms",
              "srcFileRef": "/content/dam/stryker/education-and-training/craniomaxillofacial-medical-education/cmf-meded/images/MedEd-CMF-local-platforms.jpg",
              "borderColor": "rgba(76,125,122,1)",
              "jcr:lastModified": "Thu Jun 05 2025 19:43:45 GMT+0000",
              "sling:resourceType": "stryker/components/content/standaloneimage",
              "enableBorder": "false"
            },
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-c26bb7a766@example.invalid",
              "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
              "jcr:created": "Thu Jun 05 2025 19:43:05 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Our national platforms deliver consistent, high-quality educational experiences led by expert surgeon faculty. These programs are designed to enhance surgical skills and promote the safe and effective use of Stryker products.</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Jun 05 2025 19:44:52 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "col2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-c26bb7a766@example.invalid",
              "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
              "jcr:created": "Thu Jun 05 2025 19:43:49 GMT+0000",
              "text": "<ul>\n<li><span class=\"fontsize-1-25em\"><b>Surgical Training Lab (STL):</b>\u000bA one-day, hands-on cadaveric and didactic course focused on surgical techniques and best practices. Topics vary by location and are tailored to relevant clinical needs.<br>\n<br>\n</span></li>\n<li><span class=\"fontsize-1-25em\"><b>Speaker Series:</b> A one- to three-hour, non-cadaveric lecture program centered on surgical pearls and product usage. These sessions offer flexible, focused learning led by experienced surgeon educators.</span></li>\n</ul>\n",
              "jcr:lastModified": "Wed Jun 11 2025 18:29:54 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        }
      }
