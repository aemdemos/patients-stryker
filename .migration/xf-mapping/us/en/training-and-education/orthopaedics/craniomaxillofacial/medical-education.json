          "sling:resourceType": "stryker/components/content/columncontrol/cols2",
          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "standaloneimage": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-c26bb7a766@example.invalid",
              "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
              "preset": "max_width_1440",
              "jcr:created": "Thu Jun 05 2025 19:40:51 GMT+0000",
              "alt": "MedEd-CMF-national-platforms",
              "srcFileRef": "/content/dam/stryker/education-and-training/craniomaxillofacial-medical-education/cmf-meded/images/MedEd-CMF-national-platforms.jpg",
              "borderColor": "rgba(76,125,122,1)",
              "jcr:lastModified": "Thu Jun 05 2025 19:41:06 GMT+0000",
              "sling:resourceType": "stryker/components/content/standaloneimage",
              "enableBorder": "false"
            },
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-c26bb7a766@example.invalid",
              "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
              "jcr:created": "Thu Jun 05 2025 19:43:05 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Our local educational platforms provide specialized training opportunities for surgeons at various stages of their professional development. Programs include cadaveric and non-cadaveric courses, each led by interdisciplinary faculty and expert surgeon educators.</span><br>\n</p>\n",
              "jcr:lastModified": "Thu Jun 05 2025 19:43:22 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
          "col2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-c26bb7a766@example.invalid",
              "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
              "jcr:created": "Thu Jun 05 2025 19:40:54 GMT+0000",
              "text": "<ul>\n<li><span class=\"fontsize-1-25em\"><b>Advances in Craniomaxillofacial Surgery (ACS):</b> A two-day cadaveric program focused on advanced CMF surgical techniques and approaches.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\"><b>Surgical Approaches and Techniques (SAT):</b> A one-day cadaveric course covering foundational CMF trauma techniques.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\"><b>Fibula Teeth:</b> A non-cadaveric course dedicated to digital planning and guided surgery for immediate dental implants in jaw reconstruction.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\"><b>TMJ Training:</b> A hands-on cadaveric session exploring total joint replacement surgery with the TMJ Concepts system.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\"><b>Surgeon2Surgeon:</b> Peer-led training through live surgery observations or virtual meetings, fostering knowledge exchange.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\"><b>Innovative Solutions (IS):</b> A cadaveric course leveraging advanced technology and patient-specific implants in reconstructive and orthognathic surgery.</span></li>\n</ul>\n",
              "jcr:lastModified": "Wed Jun 11 2025 18:29:49 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        }
      },
      "tabs_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "tabPosId": 2,
        "sling:resourceType": "wcm/foundation/components/parsys",
        "cols2": {
