      "text": "<p style=\"text-align: center;\"><span style=\"color: #ffffff;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">When you partner with a Stryker program, you can expect outstanding<span style=\"color: #000000;\">&nbsp;educational opportunities</span></span></span></span></p>\n",
