          "text": "<p style=\"margin-left: 40px;\"><span class=\"fontsize-1-25em\">&nbsp;</span></p>\n<h1><span class=\"fontsize-1-25em\">SKILL <span class=\"futura-bold\">Training centers</span></span></h1>\n",
