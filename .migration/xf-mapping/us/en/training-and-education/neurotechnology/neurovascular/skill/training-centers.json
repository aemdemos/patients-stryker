          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue May 09 2023 20:07:15 GMT+0000",
          "alt": "SKILL Training Centers -technical knowledge",
          "srcFileRef": "/content/dam/stryker/education-and-training/skill/images/SKILL Training Center -technical knowledge.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu May 18 2023 18:40:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "darek.jansen1@stryker.com",
          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "hideComponent": "false",
          "topMargin": "15",
          "jcr:created": "Tue May 09 2023 20:07:07 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2>Evolving your <span class=\"futura-bold\">technical knowledge</span></h2>\n<p><span class=\"fontsize-1-25em\">Complementing this technology, Stryker’s training centers also allow healthcare professionals to develop the technical aspects of neuroendovascular procedures and treatments through the use of flow models. Performed under real-time simulated fluoroscopy, participants can reinforce their skills in various treatments.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Diagnostic angiography</span></li>\n<li><span class=\"fontsize-1-25em\">Aneurysm embolization with coils</span></li>\n<li><span class=\"fontsize-1-25em\">Balloon and stent-assisted coiling</span></li>\n<li><span class=\"fontsize-1-25em\">Mechanical thrombectomy</span></li>\n<li><span class=\"fontsize-1-25em\">Angioplasty</span></li>\n<li><span class=\"fontsize-1-25em\">Stenting</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu May 18 2023 20:26:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "text_393769139": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "brianna.warsen@stryker.com",
      "topPadding": "2",
      "jcr:lastModifiedBy": "brianna.warsen@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Wed May 24 2023 16:04:48 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: left;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\">SKILL Training Centers provide a truly innovative and holistic approach to both <span style=\"color: #000000;\">ischemic</span> and <span style=\"color: #000000;\">hemorrhagic stroke education</span></span></span></span></p>\n",
      "jcr:lastModified": "Tue Jul 11 2023 02:55:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "backgroundColor": "rgba(255,181,0,1)",
      "textIsRich": "true"
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "topPadding": "1",
      "jcr:lastModifiedBy": "brianna.warsen@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Thu May 18 2023 18:43:08 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\">With the shared and ultimate goal of improving patient lives, <span class=\"futura-bold\">Stryker is committed to partnering with fellows and healthcare professionals</span> to advance patient care with the right medical education at the right time in their career.</span></p>\n",
      "jcr:lastModified": "Wed May 24 2023 16:06:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "2"
