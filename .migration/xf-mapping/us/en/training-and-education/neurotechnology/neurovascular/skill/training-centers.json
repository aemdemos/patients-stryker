    "text_1257478377_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "jcr:created": "Thu May 18 2023 18:00:10 GMT+0000",
      "text": "<h2>Advancing your <span class=\"futura-bold\">procedural skills</span></h2>\n<p><span class=\"fontsize-1-25em\">Stryker’s globally connected training centers deliver hands-on learning opportunities, involving simulation, flow models, emerging virtual technologies, C-arm and other leading-edge lab equipment, through computer-assisted medical simulation technology for the experiential training of neurointerventional procedures.</span></p>\n<p><span class=\"fontsize-1-25em\">With a realistic, reproducible and safe environment, these simulations allow users and participants to assess and enhance their procedural skills. Additionally, this technology enables healthcare professionals to create a personalized curriculum, and customize programs with progressive levels of training.</span></p>\n",
      "jcr:lastModified": "Thu May 18 2023 18:38:38 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2_copy_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "jcr:created": "Tue May 09 2023 20:06:57 GMT+0000",
      "jcr:lastModified": "Tue May 09 2023 20:10:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
