          "hideComponent": "false",
          "topMargin": "0",
          "jcr:created": "Thu May 07 2020 17:55:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"margin-left: 40px;\"><span class=\"fontsize-1-25em\">&nbsp;</span></p>\n<h1><span class=\"fontsize-1-25em\">SKILL <span class=\"futura-bold\">Assist MAX</span></span></h1>\n",
          "jcr:lastModified": "Tue May 09 2023 20:53:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
