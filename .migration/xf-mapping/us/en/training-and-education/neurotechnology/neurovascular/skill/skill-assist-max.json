      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text_600211152": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "darek.jansen1@stryker.com",
          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "jcr:created": "Fri May 12 2023 16:18:03 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><b><span style=\"color: #1c5687;\">SKILL Assist MAX was created to meet HIPAA and GDPR privacy and security standards.</span></b></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Data transmission is protected using HMACSHA-256 message authentication codes</span></li>\n<li><span class=\"fontsize-1-25em\">Protection against passive and active attacks on confidentiality</span></li>\n<li><span class=\"fontsize-1-25em\">Data encryption</span></li>\n<li><span class=\"fontsize-1-25em\">Multilayer integration protection, designed to protect both data and service layers</span></li>\n<li><span class=\"fontsize-1-25em\">Personal or medical data is not stored within the application</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri May 12 2023 16:21:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_600211152_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "darek.jansen1@stryker.com",
          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "jcr:created": "Fri May 12 2023 16:18:03 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><b><span style=\"color: #1c5687;\">Education meets an environmental impact.</span></b></span></p>\n<p><span class=\"fontsize-1-25em\">Our mission is to improve healthcare not only for patients, caregivers and employees but also for the environment. We are driven by a strong mission but also feel great responsibility to make a positive impact on the world. SKILL Assist MAX reinforces that commitment by facilitating worldwide physician collaboration without increasing the air travel carbon footprint.</span><br>\n</p>\n",
          "jcr:lastModified": "Fri May 12 2023 16:22:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
