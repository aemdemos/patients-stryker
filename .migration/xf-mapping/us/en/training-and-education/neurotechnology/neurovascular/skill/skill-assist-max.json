    },
    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Tue May 09 2023 20:05:46 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\">With SKILL Assist MAX, time and distance are no longer barriers for interactive, collaborative and dynamic learning. With Stryker’s medical education platform, expert physicians can join your case and assist in real time, from any laptop. You can also stream a highly engaging learning experience and connect from anywhere, from any device.</span><br>\n</p>\n",
      "jcr:lastModified": "Tue May 09 2023 21:06:51 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "topPadding": "2",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "hideComponent": "false",
      "topMargin": "3",
      "jcr:created": "Tue May 09 2023 21:07:18 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\">We are living in a global world. SKILL Assist MAX was made for it.</span></span></span></p>\n",
      "jcr:lastModified": "Thu May 18 2023 20:12:13 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "backgroundColor": "rgba(255,181,0,1)",
      "textIsRich": "true",
      "bottomMargin": "5"
    },
    "accordion": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "jcr:created": "Tue May 09 2023 21:10:16 GMT+0000",
      "jcr:lastModified": "Tue May 09 2023 21:12:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/accordion",
      "accordion_parsys1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "darek.jansen1@stryker.com",
          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "jcr:created": "Tue May 09 2023 21:12:39 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b>Through SKILL Assist MAX’s 360º high-definition cameras, crystal clear two way audio, precise annotation capabilities and quick setup, physicians can train and proctor in real-time, as if they’re physically together in the same room.</b></span></p>\n<p><span style=\"color: #1c5687;\"><span class=\"fontsize-1-5em\"><b>Intuitive</b></span></span></p>\n<p><span class=\"fontsize-1-25em\">Full web proctor: Connect from everywhere, from any device (computer/tablet/phone) and have full control in seconds, with near-zero latency across the globe.&nbsp;<br>\n &nbsp;</span></p>\n<p><span style=\"color: #1c5687;\"><span class=\"fontsize-1-5em\"><b>Interactive</b></span></span></p>\n<p><span class=\"fontsize-1-25em\">Draw, annotate and communicate with your peers faster than a phone call.<br>\n &nbsp;</span></p>\n<p><b><span style=\"color: #1c5687;\"><span class=\"fontsize-1-5em\">Innovative</span></span></b></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Streaming/reverse proctoring capability</span></li>\n<li><span class=\"fontsize-1-25em\">Ability to share your live cases with others</span></li>\n<li><span class=\"fontsize-1-25em\">Ability to organize your own medical events</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\"><b>Invite your guest/viewers</b></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Invite your peers to virtually attend your live case</span></li>\n<li><span class=\"fontsize-1-25em\">Set your faculty to interact and chat during your live cases</span></li>\n<li><span class=\"fontsize-1-25em\">Your faculty can be seen, speak, hear, watch and chat with you and your guests</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\"><b>Record your live case directly on your USB stick.<br>\n &nbsp;</b></span></p>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: #1c5687;\"><b>Instantaneous and flexible</b></span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">A plug-and-play solution that offers flexibility for on-demand cases</span></li>\n<li><span class=\"fontsize-1-25em\">Built for quick setup—in 10 minutes or less</span></li>\n<li><span class=\"fontsize-1-25em\">Can be easily installed and uninstalled</span></li>\n</ul>\n<p><span class=\"fontsize-1-5em\"><b><span style=\"color: #1c5687;\">Autonomous</span></b></span></p>\n<p><span class=\"fontsize-1-25em\">Equipped with a powerful 4G/5G modem, the system is portable, scalable and autonomous of hospital internet networks, offering optimal coverage anywhere in the world.<br>\n &nbsp;</span></p>\n<p><span class=\"fontsize-1-5em\"><b><span style=\"color: #1c5687;\">Semi-permanent install (on demand, depending on region)</span></b></span></p>\n<p><span class=\"fontsize-1-25em\"><b>Within the same hospital</b></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">To support colleagues on call, discuss cases remotely and train young physicians, fellows and staff</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\"><b>Support between hospitals</b></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">To train remotely, support emergency cases and support traveling doctors</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu May 18 2023 20:17:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
