      "jcr:created": "Thu May 18 2023 18:00:10 GMT+0000",
      "text": "<h2>A <span class=\"futura-bold\">24/7</span> online training <span class=\"futura-bold\">platform</span></h2>\n<p><span class=\"fontsize-1-25em\">SKILL e-Lab is an online, interactive, experiential e-learning training platform available 24/7 directly to your computer, phone or tablet, sharing knowledge on anatomy, pathology, patient management, procedures, techniques and more.</span></p>\n",
      "jcr:lastModified": "Thu May 18 2023 18:01:13 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
