          "jcr:created": "Tue May 09 2023 20:07:07 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2>A <span class=\"futura-bold\">wide library</span> of learning material</h2>\n<ul>\n<li><span class=\"fontsize-1-25em\">Neurovascular pathology</span></li>\n<li><span class=\"fontsize-1-25em\">Treatment options</span></li>\n<li><span class=\"fontsize-1-25em\">Product training</span></li>\n<li><span class=\"fontsize-1-25em\">Case playbooks and videos</span></li>\n<li><span class=\"fontsize-1-25em\">Expert physician experiences</span></li>\n<li><span class=\"fontsize-1-25em\">Clinical evidence</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Jun 01 2023 14:18:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
