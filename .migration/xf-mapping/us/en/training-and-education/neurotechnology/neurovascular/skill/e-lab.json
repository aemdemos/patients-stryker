      "hideComponent": "false",
      "jcr:created": "Wed May 24 2023 15:47:44 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\">SKILL e-Lab is your</span> training and e-learning solution,<span style=\"color: #323232;\"><span style=\"color: #ffffff;\"> always available in one click</span></span></span></span></p>\n",
      "jcr:lastModified": "Mon Jul 10 2023 15:50:09 GMT+0000",
