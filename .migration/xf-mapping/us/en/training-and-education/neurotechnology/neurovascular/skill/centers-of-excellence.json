    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "jcr:created": "Thu Apr 16 2020 18:07:34 GMT+0000",
      "text": "<h2>A full range of&nbsp;<span class=\"futura-bold\">learning opportunities</span></h2>\n<p><span class=\"fontsize-1-25em\">The SKILL Centers of Excellence play a key role in the SKILL educational program and offer a full range of learning opportunities to participants (depending on region) including: live cases, case discussions, lectures, practice with flow models, simulators and animal labs.</span><br>\n</p>\n",
      "jcr:lastModified": "Thu May 18 2023 20:29:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
