    "text_2013921732": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "jcr:created": "Fri May 12 2023 17:40:38 GMT+0000",
      "text": "<p><span class=\"fontsize-1-25em\">Each course equips its participants with the resources and knowledge to <span class=\"futura-bold\">stay ahead of evolving patient management trends</span>. Emphasizing the importance of building a strong foundation of basic sciences, professional standards, and clinical training, Stryker’s Centers of Excellence around the globe offer a <span class=\"futura-bold\">full training pathway</span>.</span></p>\n",
      "jcr:lastModified": "Fri May 12 2023 17:41:25 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "darek.jansen1@stryker.com",
      "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
      "jcr:created": "Tue May 09 2023 20:06:57 GMT+0000",
      "jcr:lastModified": "Tue May 09 2023 20:10:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "darek.jansen1@stryker.com",
          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "hideComponent": "false",
          "topMargin": "20",
          "jcr:created": "Tue May 09 2023 20:07:07 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2>A unique <span class=\"futura-bold\">global training experience</span></h2>\n<p><span class=\"fontsize-1-25em\">While on-site education from leading experts and institutions is provided, each course is also customized based on learning needs, with progressive levels of training to advance neurointerventional education.</span></p>\n<p><span class=\"fontsize-1-25em\">With Stryker’s worldwide network of SKILL training centers, fellows and healthcare professionals can enjoy a unique global training experience.</span><br>\n</p>\n",
          "jcr:lastModified": "Fri May 12 2023 17:42:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "0"
        }
      },
