      "jcr:lastModifiedBy": "user-f03ac58e27@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue May 09 2023 20:05:46 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2>A powerful <span class=\"futura-bold\">peer-to-peer speaker series</span></h2>\n<p><span class=\"fontsize-1-25em\">Stryker’s SKILL Connect is a powerful peer-to-peer speaker series where leading experts are tapped to share their unique insights on the treatment of stroke. This speaker series brings together first-hand experience and clinical discovery to fuel healthy, informative and inspiring discussions on the application and use of advanced procedures and technology in neurovascular medicine.</span></p>\n",
      "jcr:lastModified": "Tue May 09 2023 20:36:08 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2": {
