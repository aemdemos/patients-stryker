      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f03ac58e27@example.invalid",
          "jcr:lastModifiedBy": "user-f03ac58e27@example.invalid",
          "hideComponent": "false",
          "topMargin": "20",
          "jcr:created": "Tue May 09 2023 20:07:07 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\">Connect to the next events</span></h2>\n<p><span class=\"fontsize-1-25em\">Each month, SKILL Connect features physician speakers from around the world to share their clinical experience with a variety of hemorrhagic stroke treatment options. Register to join the SKILL Connect community to gain access to our portal for all on-demand and upcoming live speakers in the series.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue May 09 2023 20:38:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "leftMargin": "0"
