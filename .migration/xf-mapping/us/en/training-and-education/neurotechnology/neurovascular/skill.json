          "jcr:created": "Fri Jul 14 2023 13:43:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span style=\"color: rgb(223,225,222);\"><span style=\"color: rgb(178,180,174);\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-5vw\">SKILL</span><span class=\"fontsize-3-5-vw\">™</span></span></span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(223,225,222);\"><span style=\"color: rgb(178,180,174);\">Stroke Knowledge Initiatives<br>\r\n for Learning and Leadership</span><br>\r\n <br>\r\n</span></span></p>\r\n<p><span style=\"color: rgb(223,225,222);\"><span class=\"fontsize-2-5-vw\"><span style=\"color: rgb(178,180,174);\">The right education</span><br>\r\n <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">at the right time</span></span></span></span></p>\r\n<p><span style=\"color: rgb(178,180,174);\"><span style=\"color: rgb(223,225,222);\"><span class=\"fontsize-1-5-vw\"><br>\r\n<span style=\"color: rgb(178,180,174);\">Whether you’re a nurse, technician, stroke coordinator, fellow, experienced physician or other key caregiver along the patient pathway, we’re committed to partnering with you to advance patient care with the right medical education at the right time in your career.</span></span></span></span></p>\r\n<p><span style=\"color: rgb(178,180,174);\"><span style=\"color: rgb(223,225,222);\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(178,180,174);\"><br>\r\nSKILL is our ecosystem of education, solutions and resources, combining live and virtual sessions. It’s led by respected leaders and tailored for the specific needs of your team.</span></span></span></span><br>\r\n</p>\r\n",
          "jcr:lastModified": "Fri Jul 14 2023 13:57:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      },
