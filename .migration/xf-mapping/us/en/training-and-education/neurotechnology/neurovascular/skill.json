      "topMargin": "3",
      "jcr:created": "Thu May 18 2023 19:51:16 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><b>By engaging with neurovascular experts far and wide, we deliver excellent training across the following programs:</b></p>\n",
