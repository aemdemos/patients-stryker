          "jcr:created": "Wed Jun 12 2024 15:02:41 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Our live webinars keep you connected to the latest clinical insights and professional development opportunities.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Led by expert faculty and guest speakers</span></li>\n<li><span class=\"fontsize-1-25em\">Case-based discussions and real-world clinical scenarios</span></li>\n<li><span class=\"fontsize-1-25em\">Practical tips and insights for transitioning from fellowship to practice</span></li>\n<li><span class=\"fontsize-1-25em\">On-demand access to recorded sessions through the PV-Learn curriculum</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Apr 10 2026 14:49:17 GMT+0000",
