          "gradientDirection": "left-to-right",
          "text": "<h4 style=\"text-align: left;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\">Live webinars</span></span></span></h4>\n",
