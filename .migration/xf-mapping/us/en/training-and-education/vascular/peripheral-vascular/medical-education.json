          "gradientDirection": "left-to-right",
          "text": "<h4 style=\"text-align: left;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\">Conferences</span></span></span></h4>\n",
          "jcr:lastModified": "Thu Apr 02 2026 15:17:18 GMT+0000",
