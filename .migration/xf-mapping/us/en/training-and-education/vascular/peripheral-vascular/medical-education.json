      "hideComponent": "false",
      "rightMargin": "10",
      "jcr:created": "Thu Apr 02 2026 14:01:16 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\">At Stryker, we believe leadership is shaped through meaningful educational experiences—grounded in the latest thinking, driven by real-world application and fueled by the freedom to ask bold questions.</span></p>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\">No matter where you are in your journey, we offer learning that equips you not just to grow, but to lead with purpose and vision.</span></p>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\">The teaching is tailored to your goals. The knowledge is practical and forward thinking. The impact is exponential.</span></p>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\"><b>The career you build. The patients you impact. The lives you change. It’s all elevated with education from Stryker.</b></span></p>\n",
      "jcr:lastModified": "Tue Apr 07 2026 19:40:40 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "10",
      "backgroundColor": "rgba(255,255,255,0)",
      "showDimensionalBox": "true",
      "textIsRich": "true",
