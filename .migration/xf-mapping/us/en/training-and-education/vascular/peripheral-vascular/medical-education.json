        "text_1739583688_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Thu Apr 02 2026 14:03:34 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">PV-Learn</span></span></span></h3>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Residents and fellows training program</span></span></p>\n<p><span class=\"fontsize-1-25em\">PV-Learn is a comprehensive educational program designed for physicians-in-training to deepen their understanding of vascular disease. Through a multidisciplinary curriculum tailored for both interventional and non-interventional specialties, participants explore the diagnosis, treatment, and management of conditions such as venous thromboembolism (VTE), arterial thrombosis, and chronic limb-threatening ischemia (CLTI). With a mix of virtual, on-demand, and in-person learning opportunities, PV-Learn provides clinical insights and access to a national network of peers and mentors — supporting professional growth and a successful transition into practice.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Apr 07 2026 19:42:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
