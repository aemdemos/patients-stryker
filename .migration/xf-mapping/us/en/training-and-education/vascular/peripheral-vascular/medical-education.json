          "jcr:created": "Wed Jun 12 2024 15:02:41 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">The PV-Learn Portal provides a flexible, self-paced learning environment designed to support physicians in training as they advance their knowledge in peripheral vascular management.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Curated podcasts and recorded webinars</span></li>\n<li><span class=\"fontsize-1-25em\">Short educational videos and interactive modules</span></li>\n<li><span class=\"fontsize-1-25em\">Structured yet flexible learning paths</span></li>\n<li><span class=\"fontsize-1-25em\">Accessible anytime through the PV-Learn platform</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Apr 02 2026 14:18:44 GMT+0000",
