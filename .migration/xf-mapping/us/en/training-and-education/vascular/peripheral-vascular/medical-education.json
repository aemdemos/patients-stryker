        "text_872081231_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "leftPadding": "3",
          "topPadding": "20",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "hideComponent": "false",
          "topMargin": "-15",
          "jcr:created": "Wed Jun 12 2024 15:02:41 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">PV-Learn attends select specialty conferences, offering opportunities to connect with course directors and faculty while gaining hands-on experience with the latest technologies.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Networking events including receptions and dinners</span></li>\n<li><span class=\"fontsize-1-25em\">Interactive hands-on sessions with simulation technology and flow models</span></li>\n<li><span class=\"fontsize-1-25em\">Exposure to our latest Peripheral Vascular devices</span></li>\n<li><span class=\"fontsize-1-25em\">Opportunities to engage directly with expert faculty</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Apr 07 2026 19:44:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "showDimensionalBox": "true",
