      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "errin.pace@stryker.com",
          "jcr:lastModifiedBy": "errin.pace@stryker.com",
          "jcr:created": "Thu Mar 17 2022 18:41:35 GMT+0000",
          "text": "<h2>Innovative Seated Positioning Device: Improves Safe Patient Handling While Reducing Risk Factors for Pressure Ulcers and Falls<br>\n</h2>\n<p><b>Author:&nbsp;</b>Craig Golden, MPT</p>\n<p>HCWs using the seated positioning system felt the product was better than current standard of care for helping to reduce risk factors for pressure ulcers, patient falls, and injury, mitigating several issues associated with patients in bedside chairs.</p>\n<p>Specifically, HCWs felt the product helped minimize downward migration, thus reducing the potential for friction and shear forces on the skin – two key risk factors for pressure ulcers. In addition, HCWs felt the product helped reduce patient fall risk as the patient was less likely to slide down the chair and onto the floor. Finally, HCWs felt the device made it easier to move and position patients with less physical effort, thus reducing the risk of musculoskeletal injury.<br>\n</p>\n",
          "jcr:lastModified": "Fri May 13 2022 20:31:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
