          "linkExternal": "https://www.stryker.com/content/dam/stryker/education-and-training/focusrn/resources/mobility/posters/Guy%20Fragala%20ANA%20Poster%20_%20FINAL.pdf",
          "jcr:created": "Fri Apr 15 2022 22:13:51 GMT+0000",
          "alt": "Helping Nurses Achieve the Objectives for Early Mobility",
          "srcFileRef": "/content/dam/stryker/education-and-training/focusrn/images/mobility/posters/Guy Fragala ANA Poster _ FINAL.png",
          "borderColor": "rgba(178,180,174,1)",
          "jcr:lastModified": "Fri May 13 2022 20:55:56 GMT+0000",
