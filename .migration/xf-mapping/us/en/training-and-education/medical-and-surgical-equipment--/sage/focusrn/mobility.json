          "jcr:created": "Fri Apr 15 2022 22:13:51 GMT+0000",
          "alt": "Innovative Seated Positioning Device: Improves Safe Patient Handling While Reducing Risk Factors for Pressure Ulcers and Falls",
          "srcFileRef": "/content/dam/stryker/education-and-training/focusrn/images/mobility/posters/Golden 2013 21909.png",
          "borderColor": "rgba(178,180,174,1)",
