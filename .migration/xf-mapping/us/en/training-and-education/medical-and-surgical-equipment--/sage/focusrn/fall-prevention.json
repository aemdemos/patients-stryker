          "jcr:created": "Thu Mar 17 2022 18:41:35 GMT+0000",
          "text": "<h2>Fall reduction<br>\n</h2>\n<h3>Learning objectives</h3>\n<ul>\n<li>Define the different types of falls</li>\n<li>Discuss injuries that may result from a fall</li>\n<li>Discuss financial implications of falls</li>\n<li>List risk factors</li>\n<li>Verbalize nursing interventions to minimize falls and fall-related injuries</li>\n<li>Describe how technology can assist in reduction of falls<br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Fri Apr 22 2022 18:06:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
