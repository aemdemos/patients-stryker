      "jcr:lastModifiedBy": "user-4a9aa678a2@example.invalid",
      "jcr:created": "Fri Aug 29 2025 13:37:23 GMT+0000",
      "text": "<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\">Innovation isn’t the only place we’re relentless. Our Medical Education team is driven to offer comprehensive trainings and events that can be customized to suit your needs. Our trainings focus in the following areas:</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><b>Vertebral compression fracture treatment</b></span></li>\n<li><span class=\"fontsize-1-25em\"><b>Bone tumor ablation</b></span></li>\n<li><span class=\"fontsize-1-25em\"><b>Radiofrequency nerve ablation</b></span></li>\n<li><span class=\"fontsize-1-25em\"><b>Basivertebral nerve ablation</b></span></li>\n<li><span class=\"fontsize-1-25em\"><b>Minimally invasive lumbar decompression (mild)</b></span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">Whether you’re an attending physician, resident, fellow, or APP take advantage of our broad and ever-expanding Medical Education opportunities.</span></p>\n",
      "jcr:lastModified": "Thu Feb 19 2026 17:02:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
