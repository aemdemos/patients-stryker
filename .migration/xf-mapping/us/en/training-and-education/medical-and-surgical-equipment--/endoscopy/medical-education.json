          "jcr:created": "Mon Sep 10 2018 18:16:45 GMT-0400",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2-5em\">Events</span></span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Your opportunity to learn is here</span></span></p>\n",
          "jcr:lastModified": "Tue Apr 28 2020 21:04:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
          "jcr:created": "Mon Sep 10 2018 18:16:13 GMT-0400",
          "text": "<p><span class=\"fontsize-1-25em\">Each year our MedEd&nbsp;courses provide direct training and education to over 1,000 individual surgeons and healthcare professionals across the United States.</span></p>\n<p><span class=\"fontsize-1-25em\">We bring together experts from all around the country to deliver best in class training to local healthcare professionals. Our MedEd&nbsp;programs include summits, conferences, lectures, cadaveric workshops, and our mobile operating room experience.&nbsp;</span><br>\n</p>\n",
          "jcr:lastModified": "Mon May 20 2019 20:16:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
