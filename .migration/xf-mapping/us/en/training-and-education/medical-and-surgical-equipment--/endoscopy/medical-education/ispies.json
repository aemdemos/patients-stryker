          "jcr:created": "Tue Jul 29 2025 19:18:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-25em\">Dynamic discussions on the use of Stryker's fluorescence imaging technology in breast and plastic surgical procedures.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">Hands-on human cadaveric lab to interact directly with the technology.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">An overview of Stryker's Breast Care Portfolio, including our most recent acquisition, MOLLI.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">Peer-to-peer roundtable discussions to broaden your knowledge and network.</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Aug 04 2025 20:23:44 GMT+0000",
