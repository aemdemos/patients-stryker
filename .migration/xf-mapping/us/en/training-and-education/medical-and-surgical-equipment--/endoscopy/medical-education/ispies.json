          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-25em\">Surgeons performing open surgeries including general, bariatric, and surgical oncology.<br>\n <br _rte_temp_br=\"brEOB\">\n </span></li>\n<li><span class=\"fontsize-1-25em\">Surgeons performing laparoscopic general, colorectal, hepatobiliary and other minimally invasive surgeries, including pediatric procedures.<br>\n <br _rte_temp_br=\"brEOB\">\n </span></li>\n<li><span class=\"fontsize-1-25em\">Surgeons interested in the progress and status of ongoing clinical research studies involving the use of fluorescence imaging technology.</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jul 30 2025 19:11:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
