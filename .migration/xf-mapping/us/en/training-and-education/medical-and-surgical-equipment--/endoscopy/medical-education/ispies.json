          "jcr:created": "Tue Jul 29 2025 19:18:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-25em\">First-hand experiences from leading surgeons on topics including but not limited to; anastomotic leaks, fluorescent cholangiographies, and laparoscopic cholecystectomies.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">Dynamic discussions on the use of Stryker's fluorescence imaging technology.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">Hands-on animal lab to interact directly with the technology.<br>\n <br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">Peer-to-peer roundtable discussions to broaden your knowledge and network.</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Jul 30 2025 19:11:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "3",
          "backgroundColor": "rgb(237,238,236)",
