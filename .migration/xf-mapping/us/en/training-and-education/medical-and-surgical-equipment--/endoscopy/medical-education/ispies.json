          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Tue Jul 29 2025 19:10:16 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">We’re hosting iSPIES at IRCAD’s brand new North American lab facilities in Charlotte, NC from October 16th – 18th 2025.&nbsp;Join us to enrich your knowledge of fluorescence imaging and gain valuable insights into this innovative technology.</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">In addition to expert insights from our panel, attendees will participate in a hands-on lab, where they can engage directly with the technology and explore its potential in real-world surgical settings.</span></span></p>\n",
          "jcr:lastModified": "Wed Jul 30 2025 19:10:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
