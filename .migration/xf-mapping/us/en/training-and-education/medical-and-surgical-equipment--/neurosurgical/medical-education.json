    "text_1125751980_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "jcr:created": "Wed Jul 22 2020 17:36:16 GMT+0000",
      "text": "<p>To us, delivering the best learning experience means providing you with accessible and convenient educational opportunities. Our Mobile Lab is a world-class operating room on wheels, equipped with eight integrated lab stations to provide professionals with realistic simulations in a high-tech setting.</p>\n<p>&nbsp;</p>\n",
      "jcr:lastModified": "Tue Oct 13 2020 14:15:42 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "jcr:created": "Wed Jul 22 2020 19:17:41 GMT+0000",
      "jcr:lastModified": "Wed Jul 22 2020 19:17:41 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "text_1125751980_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7065227e84@example.invalid",
          "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
          "jcr:created": "Wed Jul 22 2020 17:36:16 GMT+0000",
          "text": "<p>With content, equipment and location customized to you, the Mobile Lab is another example of how we’re dedicated to making healthcare better. The Mobile Lab provides an ideal environment for:<br>\n</p>\n<ul>\n<li>Medical Education</li>\n<li>Research and Development</li>\n<li>Customer Experiences<br>\n</li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Wed Jul 22 2020 19:16:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
