          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Feb 19 2021 18:26:20 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span style=\"color: #1c5687;\">Education at your doorstep</span></span></span><br>\n<br>\n<span class=\"fontsize-1-25em\">The Stryker Surgical Technologies Mobile Experience is a full length semi trailer that transforms into a teaching and showroom environment. The Mobile Experience is fully equipped to give participants hands on experience with our latest technologies that are redefining the surgical standards of care.</span></p>\n",
          "jcr:lastModified": "Fri Apr 30 2021 20:07:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
