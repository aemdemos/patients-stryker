          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "jcr:created": "Fri Feb 19 2021 18:26:20 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">With content, equipment and location customized to you, the Mobile Experience is another example of how we’re dedicated to making healthcare better. The Mobile Experience provides an ideal environment for:</span></p>\n<ul>\n<li>Medical education</li>\n<li>Continuing education<br>\n</li>\n<li>Customer experiences</li>\n</ul>\n",
          "jcr:lastModified": "Fri Apr 30 2021 20:07:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
