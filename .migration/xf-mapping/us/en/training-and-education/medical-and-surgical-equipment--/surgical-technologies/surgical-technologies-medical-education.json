        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "jcr:created": "Fri Feb 19 2021 20:13:29 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2-5-vw\"><span style=\"color: rgb(255,255,255);\">Our Goal is</span> <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Zero</span></span></span><span style=\"color: rgb(255,181,0);\"><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><sup>®</sup></span></span></span>",
          "jcr:lastModified": "Tue Jun 16 2026 14:14:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(84,88,87,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "jcr:created": "Fri Feb 19 2021 20:15:41 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">splashes and spills</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">lost polyps**</span><br>\n</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">surgical smoke</span><br>\n</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">retained surgical sponges</span><br>\n</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">maternal harm</span><br>\n</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">hypoxic injuries***</span><br>\n</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">trips and falls</span><br>\n</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Zero</span> <span class=\"urw-egyptienne\">drug diversions</span></span></p>\n",
          "jcr:lastModified": "Wed Jun 17 2026 15:20:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_832794957": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "topMargin": "10",
          "jcr:created": "Fri Feb 19 2021 20:19:29 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-8em\"><span style=\"color: #b2b4ae;\">*Zero splash and spills, zero airborne contaminants, zero smoke, zero retained surgical sponges, zero blind spots, zero trips&amp; falls, zero drug diversion, and zero doubt messages are not guarantees and are aspirational in nature.</span></span></p>\n<p><span style=\"color: #b2b4ae;\"><span class=\"fontsize-8em\">**2mm or smaller</span></span></p>\n<p><span style=\"color: #b2b4ae;\"><span class=\"fontsize-8em\">***POM mask can provide consistent and reliable capnography waveforms to identify hypoxic events</span></span></p>\n",
          "jcr:lastModified": "Wed Jun 17 2026 15:21:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
