      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Dec 11 2019 16:24:07 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2-5-vw\">As an industry leader, Stryker continues to innovate in the way it lives its mission and brings value to customers.<br>\r\n </span>______________________________<br>\r\n </span>",
          "line2": "<br />\r\n<span class=\"fontsize-2vw\">Together with our customers, <br />\r\n we are driven to make healthcare better.</span>",
          "jcr:lastModified": "Wed Dec 11 2019 16:32:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(237,238,236,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Dec 11 2019 16:24:07 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\">We began to brainstorm: Outside of products, how can we show customers we care? How can we share some of Stryker’s cultural “secret sauce” with hospitals? And thus, Stryker’s first externally available leadership course was born!&nbsp;</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">Healthcare professionals can bring The Happiness Impact to their hospitals. The course focuses on changing mindsets, boosting happiness and engagement at work and at home. If we can impact those outcomes, not only can we deepen our partnership, there is potential to raise HCAHP scores and even improve patient recovery.*&nbsp;</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">The Happiness Impact is a 60-90 minute course including a take-home booklet promoting reflection, gratitude and goal tracking.</span></p>\r\n",
          "jcr:lastModified": "Wed Dec 11 2019 16:24:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
    },
    "cols_127810191": {
      "jcr:primaryType": "nt:unstructured",
