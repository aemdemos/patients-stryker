      "jcr:created": "Wed Dec 11 2019 18:04:07 GMT+0000",
      "jcr:lastModified": "Wed Dec 11 2019 18:04:07 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Dec 11 2019 16:48:22 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\">The Happiness Impact is facilitated by <span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\">Mark Sims </span></span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\">Mark, a 30+ year Stryker veteran, is the Director of Sales Development for Stryker’s Instruments Division. Mark’s responsibilities include new hire training and development opportunities for the Instruments sales force. </span></p>\r\n<p><span class=\"fontsize-1-5-vw\">Mark is also part of Stryker’s international training process, a guest lecturer for the UAB Medical Distribution program, a licensed master facilitator for both the Matrix Achievement Group for sales and leadership training and Senn Delaney Corporate Culture programs. Mark was honored to be a contributing author to the “Warrior Sales Monk.”</span></p>\r\n",
          "jcr:lastModified": "Wed Dec 11 2019 18:04:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
