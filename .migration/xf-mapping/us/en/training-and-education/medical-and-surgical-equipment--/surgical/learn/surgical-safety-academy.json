      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "table": {
          "jcr:primaryType": "nt:unstructured",
          "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td width=\"30%\">7:30 - 8:00 a.m.</td>\n<td>Registration/Breakfast</td>\n</tr><tr><td width=\"30%\">8:00 - 8:10 a.m.</td>\n<td>Welcome</td>\n</tr><tr><td width=\"30%\">8:10 - 8:30 a.m.</td>\n<td>Get acquainted activity</td>\n</tr><tr><td width=\"30%\">8:30 - 10:00 a.m.</td>\n<td><p>General Session I – Patient Safety</p>\n<ul>\n<li>Accurate surgical counts</li>\n<li>Advanced photoimaging</li>\n<li>Enhanced visualization</li>\n</ul>\n</td>\n</tr><tr><td width=\"30%\">10:00 - 10:15 a.m.</td>\n<td>Break</td>\n</tr><tr><td width=\"30%\">10:15 - 12:00 p.m.</td>\n<td><p>General Session II – Caregiver Safety</p>\n<ul>\n<li>Smoke evacuation</li>\n<li>Drug diversion</li>\n</ul>\n</td>\n</tr><tr><td width=\"30%\">12:00 - 1:15 p.m.</td>\n<td>Lunch and panel discussion: Driving safety initiatives in your facility</td>\n</tr><tr><td width=\"30%\">1:15 -2:30 p.m.</td>\n<td><p>General Session III – Interactive session</p>\n<p>Rotation through 3 stations for hands-on practice with technologies to improve surgical safety:</p>\n<ul>\n<li>Prevention of retained foreign objects (RFOs)</li>\n<li>Enhanced visualization</li>\n<li>Tools for smoke evacuation</li>\n</ul>\n</td>\n</tr><tr><td width=\"30%\">2:30 p.m.</td>\n<td>Wrap up and evaluations</td>\n</tr></tbody></table>\n",
          "jcr:lastModifiedBy": "Dilara.Atkins@stryker.com",
          "title": "Agenda Overview",
