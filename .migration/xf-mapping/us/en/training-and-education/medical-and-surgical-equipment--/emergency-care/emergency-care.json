        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Dec 19 2023 16:14:53 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Product resources</span></span></h3>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Find a variety of documents, including best practices, datasheets and clinical information for easy download.</span></span><br>\n</p>\n<p><span class=\"fontsize-1-25em\">Explore case studies, white papers, checklists and more on topics including LUCAS 3, v3.1 chest compression system, LIFEPAK 15 monitor/defibrillator, biphasic technology, clinical overviews and AEDs in the community.</span><br>\n</p>\n",
          "jcr:lastModified": "Wed Sep 17 2025 13:43:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
