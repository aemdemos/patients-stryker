          "alt": "Bystander using a LIFEPAK CR2 AED on a sudden cardiac arrest victim ",
          "srcFileRef": "/content/dam/stryker/ems/news/images/Role of defib thumbnail.jpg",
          "borderColor": "rgba(76,125,122,1)",
