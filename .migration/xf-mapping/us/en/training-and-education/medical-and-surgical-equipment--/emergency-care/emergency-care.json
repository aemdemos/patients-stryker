    "experiencefragment": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Thu Aug 22 2024 19:16:52 GMT+0000",
      "text": "Upcoming webinars and events Burn management: High-stakes decisions from the scene to the emergency department Speaker: Asa Margolis DO, MPH, MS Associate Professor, Department of Emergency Medicine Johns Hopkins University School of Medicine November 4, 2026 1 p.m. - 2 p.m. ET/10 a.m. - 11 a.m. PT Description: Burn patients present a unique combination of airway, trauma, resuscitation and disposition challenges, with early decisions potentially influencing the course of their care. This presentation follows the burn patient from the scene through the emergency department, emphasizing practical assessment, recognition of inhalation injury, estimation of burn size and depth, initial resuscitation, pain and wound management and identification of patients requiring burn-center consultation or transfer. Register now",
      "jcr:lastModified": "Wed Mar 05 2025 15:53:25 GMT+0000",
      "sling:resourceType": "stryker/components/content/experienceFragment",
      "fragmentPath": "/content/experience-fragments/stryker/emergency-care/en/training/ec-te-webinars-and-events/master",
      "edsFragmentPath": "/us/en/fragments/stryker/emergency-care/en/training/ec-te-webinars-and-events/master"
    },
