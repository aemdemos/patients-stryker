          "alt": "Instructor leading clinical training course ",
          "srcFileRef": "/content/dam/stryker/ems/images/Product-resources-thumbnail_685x385.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Apr 23 2024 12:27:00 GMT+0000",
