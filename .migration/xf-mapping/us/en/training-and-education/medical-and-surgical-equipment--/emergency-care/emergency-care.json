          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Dec 19 2023 16:14:53 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Learning center</span></span></h3>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Enhance your product knowledge with online training.</span></span></p>\n<p><span class=\"fontsize-1-25em\">Discover on-demand webinars and online courses to strengthen your clinical knowledge and support your continuing education. Course offerings include 3D biphasic defibrillation animation, implementing AEDs in Law Enforcement, cprINSIGHT analysis technology and more.</span><br>\n</p>\n",
          "jcr:lastModified": "Wed Sep 17 2025 13:43:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
