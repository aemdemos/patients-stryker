            "text1180572359123043": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:lastModifiedBy": "katie.boertman@stryker.com",
              "text": "<h1><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Emergency Care</span></span></span></h1>\n<h2><span class=\"fontsize-1-25em\">Training and education</span></h2>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Discover on-demand webinars, online and in-person training and continuing education created specifically for EMS, first responders, nurses, hospital clinicians, the community and more.</span></span></p>\n",
              "jcr:lastModified": "Thu May 09 2024 13:45:41 GMT+0000",
