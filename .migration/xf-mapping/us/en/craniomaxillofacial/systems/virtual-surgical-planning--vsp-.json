  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p data-children-count=\"0\"><sup></sup>Plan with confidence.</p>\r\n",
    "shortDescTop": "<p data-children-count=\"0\">Working in collaboration with 3D Systems, we are pleased to provide you with a major leap forward in patient-specific care. With virtual surgical planning, you can use imaging data to accurately plan a surgical procedure in a computer environment through a web-based planning session with a 3D Systems Biomedical Engineer. After you complete and approve the surgical plan, it is taken to the next level by creating patient-specific, disposable guides and splints for use in the surgical procedure to assist in more predictable patient outcomes.&nbsp;<br>\r\n<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "andrew.reynolds@stryker.com",
    "jcr:lastModified": "Fri Nov 13 2020 18:38:41 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Plan your case using patient-specific CT data. You have the ability to visualize anatomical landmarks and ensure the surgical plan matches your patient's anatomy.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Web-based design session allows you to have direct input on every step of the pre-surgical plan.</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Transfer the plan to the operating room with patient-specific models, guides and templates.</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Case report outlines the step-by-step of the of the pre-surgical plan, serving as a reference before surgery and in the operating room.</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Our sales representatives support you throughout the process.</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
