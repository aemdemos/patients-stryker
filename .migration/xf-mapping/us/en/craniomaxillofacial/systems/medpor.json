    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Wed Aug 20 2025 20:45:30 GMT+0000",
      "jcr:lastModified": "Wed Aug 20 2025 20:45:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Aug 20 2025 20:45:41 GMT+0000",
          "text": "<h4><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Proven</span></span>​​</h4>\n<p><span class=\"fontsize-1-25em\">More than 400,000 procedures have been performed with MEDPOR Biomaterial, with more than 150 published clinical reports in cranial, reconstructive, oculoplastic, and cosmetic applications.<sup>3</sup></span></p>\n",
          "jcr:lastModified": "Wed Sep 10 2025 19:14:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Aug 20 2025 20:45:41 GMT+0000",
          "text": "<h4><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Adaptable</span></span>​​</h4>\n<p><span class=\"fontsize-1-25em\">If desired, MEDPOR material may be cut and shaped to fit patient and surgeon needs. It is designed to accept screws and plates without cracking, providing more flexibility in fixation options and placement.​</span></p>\n",
          "jcr:lastModified": "Wed Aug 20 2025 20:48:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Aug 20 2025 20:45:41 GMT+0000",
          "text": "<h4><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Comprehensive</span></span>​​</h4>\n<p><span class=\"fontsize-1-25em\">Wide variety of sterile oculoplastic and facial contour implants, including solutions for the cranium, orbital, maxface and MEDPOR sheets to fit patient and surgeon reconstructive and augmentation needs.</span></p>\n",
          "jcr:lastModified": "Wed Sep 10 2025 19:18:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Wed Aug 20 2025 20:45:30 GMT+0000",
      "jcr:lastModified": "Wed Aug 20 2025 20:45:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Aug 20 2025 20:45:41 GMT+0000",
          "text": "<h4><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Sterile</span></span>​​</h4>\n<p><span class=\"fontsize-1-25em\">Implants are packaged sterile and ready to use. They can be stored in the hospital or office to have on hand as needed.</span></p>\n",
          "jcr:lastModified": "Wed Aug 20 2025 20:49:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Aug 20 2025 20:45:41 GMT+0000",
          "text": "<h4><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">MEDPOR TITAN</span></span>​​</h4>\n<p><span class=\"fontsize-1-25em\">Combines high-density polyethylene sheets and titanium mesh in a single implant for increased flexibility, shape retention, radiographic visualization and strength.<sup>4</sup></span></p>\n",
          "jcr:lastModified": "Wed Sep 10 2025 19:15:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys"
      }
    },
