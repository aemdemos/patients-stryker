    "largeheadline": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Wed Aug 20 2025 20:57:37 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\">Proven. Adaptable.</span> Comprehensive</span></h2>\r\n",
      "jcr:lastModified": "Wed Aug 20 2025 21:01:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,0)",
