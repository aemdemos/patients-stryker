    "largeheadline_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Wed Aug 20 2025 20:57:37 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\">Off-the-shelf, biocompatible</span> implants.</span></h2>\r\n",
      "line2": "<br>\r\n<span class=\"fontsize-1-5-vw\">Since 1985, our MEDPOR porous polyethylene implants have provided you with a range of off the shelf, biocompatible implant options for your aesthetic, reconstruction and augmentation needs.</span>",
      "jcr:lastModified": "Wed Sep 10 2025 19:12:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,0)",
      "textIsRich": [
        "true",
        "true"
      ]
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Thu Aug 21 2025 14:03:28 GMT+0000",
      "jcr:lastModified": "Thu Aug 21 2025 14:03:28 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline_copy_c": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "jeannie.chan@stryker.com",
          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Dec 12 2018 22:04:13 GMT+0000",
          "gradientDirection": "left-to-right",
          "line2": "<p>&nbsp;</p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">We understand that bio-compatibility is paramount to help surgeons achieve <span class=\"futura-bold\">positive patient outcomes</span>. The omni-directional pore structure of our polyethylene implants may increase implant acceptance by allowing the patient‘s native tissue to integrate with the implant.<sup>1,2</sup></span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">&nbsp;</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">In addition to our <span class=\"futura-bold\">comprehensive line of stock sterile MEDPOR implants</span>, our iD Solutions portfolio offers CT-based <span class=\"futura-bold\">patient specific implants</span>, putting the implant design in your hands.</span></span></p>\r\n<p>&nbsp;</p>\r\n",
          "jcr:lastModified": "Wed Sep 10 2025 19:13:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,181,0,1)",
          "textIsRich": [
            "true",
            "true"
          ],
