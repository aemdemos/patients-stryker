      "hideComponent": "false",
      "jcr:created": "Mon Feb 10 2025 18:45:01 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">We are pleased to announce that 1000shapes became part of Stryker in June 2024 and has emerged as &quot;Stryker Berlin GmbH&quot;. Together we will continue to drive digital innovation in medical technology.&nbsp;</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">We would like to thank our partners and customers for their trust and support over the years!</span></span></p>\n<p>&nbsp;</p>\n",
      "jcr:lastModified": "Tue Feb 18 2025 14:23:35 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "backgroundColor": "rgb(255,255,255)",
      "textIsRich": "true"
    },
