          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "5",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Feb 28 2025 21:09:34 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><b><span class=\"fontsize-1-25em\">MEDPOR TITAN<br>\n</span> </b>Combines high-density polyethylene sheets and titanium mesh in a single implant for increased flexibility, shape retention, radiographic visualization and strength.<sup>2</sup></p>\n",
          "jcr:lastModified": "Fri May 09 2025 13:15:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
