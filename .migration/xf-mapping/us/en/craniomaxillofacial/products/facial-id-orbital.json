          "jcr:created": "Thu Feb 06 2025 18:52:38 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\">Overview</span></h2>\n<p>Facial iD Orbital, our newest addition to our iD Solutions platform utilizes CT data from your patient and your feedback and input to create an orbital implant customized to your preferences and your patient’s needs.</p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Individually designed.&nbsp;</span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Personalized</span></span><span class=\"urw-egyptienne\">&nbsp;care.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Mon Feb 17 2025 16:58:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true",
