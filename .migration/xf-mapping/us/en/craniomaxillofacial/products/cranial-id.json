          "jcr:created": "Thu Feb 06 2025 19:53:48 GMT+0000",
          "text": "<h2><span class=\"futura-bold\">Clinical evidence</span></h2>\n",
          "jcr:lastModified": "Mon Feb 17 2025 16:57:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
