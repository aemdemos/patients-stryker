          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: rgb(0, 0, 0);\">Cranial</span> <span style=\"color: #ffb500;\">iD</span></span></span><span class=\"fontsize-1-75em\"><sup>®</sup></span></h1>\n",
