      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "curatedcta_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-1f15d09fdf@example.invalid",
          "CTAOpenInNewTab": "true",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "ctaLinkType": "ext",
          "ctaOpenInNewTabOverride": "0",
          "jcr:created": "Thu Feb 06 2025 18:32:57 GMT+0000",
          "CTATitle": "Full Article",
          "ctaExternalLink": "http://www.ncbi.nlm.nih.gov/pubmed/19761905",
          "jcr:lastModified": "Wed Jun 04 2025 20:16:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/curatedcta",
          "CTAButtonColor": "rgb(133,69,138)"
