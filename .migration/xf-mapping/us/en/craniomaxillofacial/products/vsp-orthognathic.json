          "hideComponent": "false",
          "jcr:created": "Thu Feb 06 2025 18:28:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Case report</span></span></p>\n<p>Case report outlines the step-by-step of the pre-surgical plan, serving as a reference before surgery and in the operating room.<br>\n</p>\n",
          "jcr:lastModified": "Tue Jul 08 2025 14:01:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
