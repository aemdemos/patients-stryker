      "jcr:created": "Mon Apr 14 2025 20:47:16 GMT+0000",
      "jcr:lastModified": "Mon Apr 14 2025 20:49:43 GMT+0000",
      "sling:resourceType": "stryker/components/content/accordion",
      "accordionsGrid": {
        "jcr:primaryType": "nt:unstructured",
        "1": {
