          "ctaExternalLink": "https://pubmed.ncbi.nlm.nih.gov/22337427/",
          "jcr:lastModified": "Mon Apr 14 2025 20:54:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/curatedcta",
          "CTAButtonColor": "rgb(133,69,138)"
        },
