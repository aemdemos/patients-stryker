      "hideComponent": "false",
      "topMargin": "2",
      "jcr:created": "Thu May 01 2025 20:52:31 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Precise fit. </span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Proven</span></span><span class=\"urw-egyptienne\"> material.</span></span></p>\n",
      "jcr:lastModified": "Tue Apr 14 2026 15:24:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
