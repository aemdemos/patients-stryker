  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Individually designed. Personalized care.</p>\r\n",
    "shortDescTop": "<p>Our Facial iD mandible reconstruction plate gives you the flexibility you're looking for. Based on patient specific CT data and direct input from you, our Facial iD mandible reconstruction plate is designed to meet the individual needs of you and your patients. After the data is received, a design session is set up between you and a design engineer, placing the artistry of implant design into your hands.&nbsp;<br>\r\n</p>\r\n<p>In collaboration with 3D Systems/Medical Modeling, you can use Virtual Surgical Planning if desired. Their expertise in surgical planning, guide/template design, and additive manufacturing combine to offer a product useful for improving surgeon confidence and enhancing outcomes.<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "beth.sizemore@stryker.com",
    "jcr:lastModified": "Mon Aug 14 2017 19:33:07 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Plate is designed using patient specific CT data and is delivered preformed, matching the planned design of the patient's postoperative anatomy.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Ability to increase individual bar width up to 1mm. Increased bar width may improve the fatigue strength by approximately 40% compared to our standard Universal Mandible reconstruction plates.<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Proprietary software to select specific plate design features such as profile height, screw hole location, and 3D run of the plate.</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Allows for the transfer of the virtual plan to surgery using patient specific osteotomy and positioning guides.</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
