  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Mandibular solutions</p>\r\n",
    "shortDescTop": "<p>Built on the Leibinger platform, our Universal Mandible System features full and half size aluminum containers for your fracture and reconstruction needs.&nbsp;<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-76a17b8b97@example.invalid",
    "jcr:lastModified": "Fri Jul 28 2017 11:42:07 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Dedicated instrument trays with color coded instruments allow for easy identification.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Universal screwdriver for 2.0mm, 2.3mm and 2.7mm screws limiting the instrumentation required in a case.</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Features SMARTLock technology, a one step locking screw featuring locking capability with up to 10˚ of angulation.<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Plates accommodate multiple screw diameters and designs, allowing for more flexibility.</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fracture module includes a variety of low profile mini and 3D plates, fracture plates and compression plate options for your fixation needs.</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Reconstruction module features low profile primary reconstruction plates along with precontoured plates to fit your reconstructive needs.</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>SMARTLoad screw delivery field features recessed screw holes that may facilitate easy loading of the screw.</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
