  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Controlled mandibular distraction.<br>\r\n</p>\r\n",
    "shortDescTop": "<p>Designed to provide you with control in deficient or misshapen mandibles, this device is designed to provide you with the ability to gradually, independently and simultaneously distract the mandible in more than one plane.<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-76a17b8b97@example.invalid",
    "jcr:lastModified": "Mon Jul 10 2017 13:49:37 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
