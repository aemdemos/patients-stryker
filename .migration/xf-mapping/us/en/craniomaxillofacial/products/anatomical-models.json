      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">CT-based design</span></b></p>\n<p>Models created using patient-specific CT data, providing an accurate match to the patient's anatomy.</p>\n",
          "jcr:lastModified": "Tue Jul 29 2025 19:41:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">Anatomical template</span></b></p>\n<p>Patient-specific design allows for pre-contouring of necessary hardware in advance of surgery, which may reduce the time<sup>1</sup> historically spent on hardware manipulation.</p>\n",
          "jcr:lastModified": "Thu Jul 31 2025 20:30:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1814330717_cop_1612176152": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
