      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">Selective coloration</span></b></p>\n<p>ClearView models are translucent and have a unique ability for selective coloration to highlight vital structures such as tumors, vascular structures or tooth roots.</p>\n",
          "jcr:lastModified": "Wed Mar 05 2025 22:47:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
