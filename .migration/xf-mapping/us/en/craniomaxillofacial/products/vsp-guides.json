    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "jcr:created": "Fri Jun 06 2025 19:58:11 GMT+0000",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Titanium VSP<sup>®</sup>&nbsp;guides</span></span></p>\n",
      "jcr:lastModified": "Fri Jun 06 2025 19:58:57 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
