    "cols2_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "jcr:created": "Fri Jun 06 2025 21:03:22 GMT+0000",
      "jcr:lastModified": "Fri Jun 06 2025 21:03:22 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1201588021": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "2",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Jun 06 2025 21:04:00 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Features and benefits:</span></span></p>\n<p><b>Material made 88% tougher<sup>1</sup><br>\n </b>The nylon guides can better withstand mechanical forces, providing an improved performance.</p>\n<p><b>Customized by you, for you<br>\n </b>Select occlusal or bone-borne guides to fit your surgical needs. Further customize the guides with optional features such as nasal floor registration.</p>\n<p><b>Lower profile, easier placement<br>\n </b>Slimmer profile guides can provide easier placement in areas with limited exposure.</p>\n<p><b>Your visualization, increased<br>\n </b>Improve your visibility of the surgical site with lower profiles and a new cellular structure design which can help you better see anatomy.<br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 06 2025 21:58:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
