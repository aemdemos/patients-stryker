    "cols2_copy_496498813": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "jcr:created": "Fri Jun 06 2025 21:03:22 GMT+0000",
      "jcr:lastModified": "Fri Jun 06 2025 21:03:22 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "2",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Jun 06 2025 21:04:00 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Features and benefits:</span></span></p>\n<p><b>Material made 20x stronger<sup>1</sup></b><br>\nWith titanium, you can experience increased strength over our traditional guides, allowing cutting and drilling directly through the guides.</p>\n<p><b>Customized by you, for you</b><br>\nYou can maximize functionality of the guides by altering cut slots to match your surgical blade. You can choose the height of your drill guide and cutting slots to control trajectory or reduce guide profile height.</p>\n<p><b>Lower profile, easier placement</b><br>\nWith slimmer profiles, the guides can provide easier placement in areas with limited exposure.</p>\n<p><b>Your visualization, increased</b><br>\nImprove your visibility of the surgical site with lower profiles and a new cellular structure design which can help you better see anatomy.</p>\n",
          "jcr:lastModified": "Tue Jun 10 2025 14:08:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
