      "jcr:createdBy": "courtney.dickens@stryker.com",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "jcr:created": "Fri Jun 06 2025 21:03:22 GMT+0000",
      "jcr:lastModified": "Fri Jun 06 2025 21:03:22 GMT+0000",
