        "text_copy_902227187_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Fri Feb 14 2025 15:03:49 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Anchor screw</span></span></p>\n",
          "jcr:lastModified": "Wed Mar 12 2025 13:40:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_669411101_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Feb 14 2025 15:06:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>Designed to minimize patient trauma and provide quick removal compared to anchor plate.<br>\n</p>\n",
          "jcr:lastModified": "Mon Aug 04 2025 14:25:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Fri Feb 14 2025 15:03:49 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Locking anchor plate</span></span></p>\n",
          "jcr:lastModified": "Wed Mar 12 2025 13:40:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Fri Feb 14 2025 15:07:11 GMT+0000",
          "text": "<p>This technology allows orthodontists to secure orthodontic appliances or accessories in the guide holes, providing versatility and control throughout the treatment plan.</p>\n",
          "jcr:lastModified": "Wed Mar 12 2025 13:41:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_902227187": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Fri Feb 14 2025 15:03:49 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Anchor plate</span></span></p>\n",
          "jcr:lastModified": "Wed Mar 12 2025 13:40:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_669411101_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Feb 14 2025 15:06:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>Intended to provide more stable fixation and to prevent disturbance of teeth movement compared to anchor screws.</p>\n",
          "jcr:lastModified": "Mon Aug 04 2025 14:25:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
