  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>The standard in HA cement.</p>\r\n",
    "shortDescTop": "<p>HydroSet is a self-setting, calcium phosphate cement intended for use in the repair of neurosurgical burr holes, contiguous craniotomy cuts and other cranial defects as well as in the augmentation or restoration of bony contour in the craniofacial skeleton.<br />\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Wed Feb 19 2025 22:02:31 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Formulated to harden in the presence of water, blood and CSF.<sup>2,3</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Hardens to form hydroxyapatite and remodels to natural bone through osteoclastic resorption and new bone formation.<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Specifically designed to set quickly once implanted under normal physiological conditions.<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Avoids thermal injury as it does not give off any potentially damaging heat.<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>You can apply it manually&nbsp;by hand/spatula or injected through a syringe, enabling you to better meet unique closure needs.<sup>4</sup></p>\r\n",
        "textIsRich": "true"
      }
    }
  },
