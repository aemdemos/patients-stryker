              "ctaExternalLink": "http://www.ncbi.nlm.nih.gov/pubmed/?term=Advances+in+Cranioplasty%3A+A+Simplified+Algorithm+to+Guide+Cranial+Reconstruction+of+Acquired+Defects",
              "jcr:lastModified": "Wed Feb 19 2025 22:29:30 GMT+0000",
