              "ctaLinkType": "ext",
              "ctaOpenInNewTabOverride": "0",
              "jcr:created": "Thu Feb 06 2025 18:34:55 GMT+0000",
              "CTATitle": "Full Article",
              "ctaExternalLink": "http://www.ncbi.nlm.nih.gov/pubmed/?term=A+Novel+Method+of+Translabyrinthine+Cranioplasty+Using+Hydroxyapatite+Cement+and+Titanium+Mesh%3A+A+Technical+Report",
              "jcr:lastModified": "Wed Feb 19 2025 22:32:43 GMT+0000",
