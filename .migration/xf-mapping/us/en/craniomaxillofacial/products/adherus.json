          "ctaOpenInNewTabOverride": "0",
          "jcr:created": "Fri Feb 14 2025 15:16:44 GMT+0000",
          "CTATitle": "View the contraindications here.",
          "ctaDeepLinkID": "contraindications",
          "jcr:lastModified": "Fri Feb 14 2025 15:17:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/curatedcta",
          "CTAButtonColor": "rgba(76,125,122,1)"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-73104d59b2@example.invalid",
          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "jcr:created": "Fri Feb 14 2025 14:59:24 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Demonstrated to be&nbsp;</span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">99.1% effective</span></span><span class=\"urw-egyptienne\">&nbsp;in preventing CSF leaks through 14 days of post-operative follow-up.<sup>1</sup></span></span></p>\n",
