    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "jcr:created": "Tue Apr 29 2025 19:24:06 GMT+0000",
      "jcr:lastModified": "Tue Apr 29 2025 19:24:06 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "3",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Apr 29 2025 19:23:49 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">PEEK Single Stage</span></span></p>\n<p>PEEK Single Stage allows the surgeon to address their patients’ needs in one surgery. Through pre-surgical planning a predictive craniotomy is made, leading to the design of a patient-specific implant delivered to the hospital prior to surgery.</p>\n<p>Surgeon collaboration will be required at the design phase to best identify the important inputs needed for design which include the following:</p>\n<ul>\n<li>Define resection plan and design PEEK implant</li>\n<li>Anatomical landmarks and CT reference points</li>\n</ul>\n",
          "jcr:lastModified": "Tue Apr 29 2025 20:59:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
