      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "2",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><b><span class=\"fontsize-1-25em\">Reliable fit<br>\n </span></b>Designed and manufactured to produce a “drop-in” fit.</p>\n",
          "jcr:lastModified": "Mon Sep 15 2025 15:02:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_918462258": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "1",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Feb 26 2025 00:01:20 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><b><span class=\"fontsize-1-25em\">Host bone<br>\n </span></b>Provided in PEEK complex timelines, serving as a pre-operative guide to demonstrate fit.<br>\n</p>\n",
          "jcr:lastModified": "Tue Sep 02 2025 22:12:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "2",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><b><span class=\"fontsize-1-25em\">Thickness options<br>\n </span></b>Implant wall thickness provided in either 3.3 mm, 4 mm, 5 mm, or 6 mm to cater patient-specific needs.</p>\n",
          "jcr:lastModified": "Mon Jul 07 2025 19:49:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "topPadding": "1",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><b><span class=\"fontsize-1-25em\">Strong<br>\n </span></b>115 Mpa Yield Strength.<sup>1</sup></p>\n",
          "jcr:lastModified": "Wed Jul 09 2025 21:43:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
