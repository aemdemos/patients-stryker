          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\">Overview</span></h2>\n<p>The Advance Midface Distractor is an internal distraction device that provides temporary stabilization and gradual lengthening of the cranium and midface. It is designed for the treatment of cranial and midfacial conditions where reconstructive osteotomy and segment advancement are indicated.</p>\n",
          "jcr:lastModified": "Mon Feb 17 2025 16:56:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        }
