          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">Comprehensive portfolio</span></b></p>\n<p>The MEDPOR Neuro product line consists of implants to fit individual patient needs.</p>\n",
          "jcr:lastModified": "Fri Feb 28 2025 23:46:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
