      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">MEDPOR TITAN</span></b></p>\n<p>The MEDPOR TITAN line combines high-density polyethylene sheets and titanium mesh in a single implant for increased flexibility, shape retention, radiographic visualization and strength.<sup>1</sup></p>\n",
          "jcr:lastModified": "Fri Feb 28 2025 23:45:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "text_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "2",
      "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
      "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue Feb 25 2025 18:01:13 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-8em\">References<br>\n 1: Holck, D., Foster J., and Dahl T., “Custom Shaped Porous Polyethylene-Titanium Mesh Orbital Implants for Internal Orbital Floor/Medial- Wall Fracture Repair” ASOPRS 37th Annual Fall Scientific Syllabus, pp190, November 15-16, 2006<br>\n </span></p>\n",
      "jcr:lastModified": "Fri Feb 28 2025 21:12:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
