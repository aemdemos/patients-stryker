          "jcr:created": "Tue Feb 25 2025 21:59:44 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">Adaptable</span></b></p>\n<p>If desired, MEDPOR material may be cut and shaped to fit patient and surgeon needs.</p>\n",
          "jcr:lastModified": "Fri Feb 28 2025 23:44:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
