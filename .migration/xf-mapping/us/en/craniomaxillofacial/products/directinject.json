          "hideComponent": "false",
          "jcr:created": "Tue Feb 11 2025 21:09:16 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><b>On-demand</b></span></p>\n<p><span class=\"fontsize-1em\">Excellent wet field characteristics<sup>2,3</sup></span></p>\n",
          "jcr:lastModified": "Tue Apr 15 2025 13:15:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_578833878_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "jcr:created": "Tue Feb 11 2025 21:09:16 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">Flexible implantation</span></b></p>\n<p>A second mixer-cannula allows for dual interval implantation.</p>\n",
          "jcr:lastModified": "Wed Mar 05 2025 17:32:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Feb 11 2025 21:09:16 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><b>No mix or prep</b></span></p>\n<p>Requires no manual mixing or preparation.</p>\n",
          "jcr:lastModified": "Wed Mar 05 2025 17:32:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_578833878": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "courtney.dickens@stryker.com",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "jcr:created": "Tue Feb 11 2025 21:09:16 GMT+0000",
          "text": "<p><b><span class=\"fontsize-1-25em\">Consistent viscosity</span></b></p>\n<p>Fast-setting, isothermic and osteoconductive<sup>1</sup></p>\n",
          "jcr:lastModified": "Tue Apr 15 2025 13:20:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
