      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1056001227": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "topPadding": "5",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Apr 02 2025 21:59:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">Gold 3D mesh</span></h3>\n<ul>\n<li>Countersink - designed to reduce* palpability</li>\n<li>Has stiffness equivalent to golden 2D mesh<sup>2</sup></li>\n<li>Used for open defects up to 70mm and muscle attachment<sup>3</sup></li>\n<li>Pre-formed minimizes bending effort to fit&nbsp;patient</li>\n<li>MR conditional allows diagnostics after implantation</li>\n</ul>\n",
          "jcr:lastModified": "Thu Sep 04 2025 23:48:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
