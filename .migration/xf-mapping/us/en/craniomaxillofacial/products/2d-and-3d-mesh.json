        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "topPadding": "5",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Apr 02 2025 22:00:08 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">Silver 3D mesh</span></h3>\n<ul>\n<li>Countersink - designed to reduce* palpability</li>\n<li>Increased stiffness, for increased patient&nbsp;protection, compared to 2D mesh<sup>2</sup></li>\n<li>Used for open defects up to the size of the mesh and muscle attachment<sup>3</sup></li>\n<li>Anatomically pre-formed minimizes bending to fit patient</li>\n<li>MR conditional allows diagnostics after&nbsp;implantation</li>\n</ul>\n",
          "jcr:lastModified": "Thu Sep 04 2025 23:48:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
