      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "topPadding": "5",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Apr 02 2025 21:58:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">2D mesh</span></h3>\n<ul>\n<li>Countersink - designed to reduce* palpability</li>\n<li>Smooth edge aids insertion</li>\n<li>MR conditional - allows diagnostics&nbsp;after implantation</li>\n<li>Variety of mesh types - strength vs malleability</li>\n<li>New 0.3mm Hybrid mesh - 3x stronger than 0.3mm Dynamic&nbsp;mesh<sup>1</sup></li>\n</ul>\n",
          "jcr:lastModified": "Thu Sep 04 2025 23:48:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
