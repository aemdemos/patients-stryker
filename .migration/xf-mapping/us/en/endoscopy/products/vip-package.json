      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1229379705": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Feb 28 2022 23:29:01 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">PneumoClear<br>\n </span></span><span class=\"urw-egyptienne\">The smart insufflator</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Maintain a clear surgical environment and image with our smart inflow and outflow management </span></span><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">designed to maintain stability while actively evacuating smoke.</span></span></p>\n<p><span class=\"fontsize-1-25em\">Consolidate insufflation needs with Stryker's all-in-one heated, humidified, and smoke evacuation platform on the market.</span></p>\n",
          "jcr:lastModified": "Tue Apr 12 2022 21:32:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
