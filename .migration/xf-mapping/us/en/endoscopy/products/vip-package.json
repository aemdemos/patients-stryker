    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Mon Feb 28 2022 23:40:47 GMT+0000",
      "jcr:lastModified": "Mon Feb 28 2022 23:40:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Feb 28 2022 23:48:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">The future</span>&nbsp;</span><span class=\"urw-egyptienne\">is software</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">Anticipate</span> <span class=\"urw-egyptienne\">your needs</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Automated smoke detection and \u0003evacuation algorithm.</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">In combination with our PneumoClear Integrated Insufflator and Smoke Evacuator, the VIP package is furthering Stryker’s initiative to help transform the OR into a smoke-free environment through a first-of-its kind automation.</span></li>\n<li><span class=\"fontsize-1-25em\">The smoke detection algorithm is customizable and tailored to surgeon preference for enhanced efficiency.</span></li>\n</ul>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">Real-time</span> <span class=\"urw-egyptienne\">image enhancement</span></span></p>\n<p><span class=\"fontsize-1-25em\">In environments where surgical visualization is disrupted with surgical smoke or plume, automateor control the activation of our intelligent image enhancement.</span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Six Clarity enhancements\u0003</span></span></p>\n<p><span class=\"fontsize-1-25em\">Each enhancement utilizes a specific algorithm to apply different levels of contrast, saturation, and sharpness and are not specific to a single surgical environment.</span></p>\n",
          "jcr:lastModified": "Tue Apr 12 2022 21:30:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Tue Mar 01 2022 18:54:13 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-4-5-vw\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">93%</span></span></span>",
          "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-2-5-vw\">of surgeons believe the VIP Package </span></span><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">positively impacts the efficiency</span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-2-5-vw\"> of their OR.<sup>1</sup></span></span>",
          "jcr:lastModified": "Tue Mar 01 2022 21:36:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
