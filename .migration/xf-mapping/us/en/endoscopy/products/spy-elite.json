          "jcr:created": "Wed Aug 01 2018 18:33:00 GMT-0400",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-3-5-vw\"><span class=\"futura-bold\">Surgical complications</span><br>\r\n <span class=\"urw-egyptienne\">lead to <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">increased</span></span><br>\r\n healthcare costs</span></span>",
          "line2": "<p>&nbsp;</p>\r\n<p>Research has demonstrated that when combined with clinical judgment, use of SPY Fluorescence Imaging technology decreased the incidence of mastectomy skin necrosis and lowered costs to hospitals<sup>.2,3,4</sup><br>\r\n</p>\r\n",
          "jcr:lastModified": "Wed Aug 01 2018 18:34:41 GMT-0400",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
