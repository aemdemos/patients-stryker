  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Assess perfusion when it matters most<br>\r\n</p>\r\n",
    "shortDescTop": "<p>&nbsp;&nbsp;</p>\r\n",
    "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
    "jcr:lastModified": "Thu Aug 02 2018 22:47:59 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Intraoperative perfusion assessment: Allows surgeons to visualize perfusion intraoperatively and in real-time<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Repeatable technique: Involves no ionizing radiation and utilizes a fluorescence imaging agent (indocyanine green) with a very short half-life, thus allowing surgeons to repeat intraoperative perfusion assessment numerous times throughout the procedure<sup>1</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Clinical outcomes: Enhances the surgeon’s ability to assess perfusion, which may improve patient outcomes.<sup>2</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
