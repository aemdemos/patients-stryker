      "jcr:createdBy": "user-5891a4f69d@example.invalid",
      "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
      "jcr:created": "Wed Aug 01 2018 18:34:51 GMT-0400",
      "jcr:lastModified": "Wed Aug 01 2018 18:34:51 GMT-0400",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
          "jcr:created": "Wed Aug 01 2018 18:33:00 GMT-0400",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"urw-egyptienne\"><span class=\"fontsize-3-5-vw\">Complications<br />\r\n <span class=\"futura-bold\">can increase</span><br />\r\n hospital costs</span></span>",
          "line2": "<p>&nbsp;</p>\r\n<p>Published literature has long demonstrated the significant costs associated with surgical complications.<sup>4 </sup>Total hospital charges and professional fees were $1,158,954 for the flap necrosis group and $659,412 for the adequate healing group.<sup>4</sup> The average excess cost associated with a single case of flap necrosis group was $99,908 per patient representing $63,079 in hospital charges and $36,829 in professional fees.<sup>4</sup></p>\r\n<p>&nbsp;</p>\r\n",
          "jcr:lastModified": "Fri Feb 15 2019 17:26:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
