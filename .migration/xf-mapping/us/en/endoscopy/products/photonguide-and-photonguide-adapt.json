  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>PhotoGuide and PhotonGuide Adapt</p>\r\n",
    "shortDescTop": "<p>Patented total internal reflection design. T<span style=\"background-color: transparent;\">hermally cool illumination may help protect against thermal damage to tissues and surgical drapes.</span><sup style=\"background-color: transparent;\">2&nbsp;</sup><span style=\"background-color: transparent;\">Microlenses cover entire output surface for redundancy of light.</span></p>\r\n",
    "jcr:lastModifiedBy": "brittany.brady@stryker.com",
    "hideComponent": "false",
    "jcr:lastModified": "Wed Jul 15 2026 17:29:05 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ]
  },
  "rte": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
    "text": "<p><span class=\"futura-bold\">PhotonGuide: Intracavity illumination</span></p>\n<ul>\n<li>Narrow and wide styles for single use with Eikon LT retractors</li>\n</ul>\n<p><span class=\"futura-bold\">PhotonGuide Adapt: Extending your reach</span></p>\n<ul>\n<li>Ability to position lighting anywhere along entire retractor length</li>\n<li>Simply slide to adjust as desired throughout your case<br>\n</li>\n<li>Can be removed and reinserted into other Adapt retractors as case needs change<br>\n</li>\n</ul>\n",
    "jcr:lastModified": "Thu Sep 19 2019 17:27:37 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
