      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 19:25:59 GMT-0400",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\">DermACELL is</span><br>\r\n <span class=\"urw-egyptienne\">sterile and&nbsp;≥97% donor DNA free</span></span><br>\r\n",
          "line2": "<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\">&nbsp;</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\">Sterility assurance level (SAL) 10<sup>-6</sup> \u0003and ready to use - no rinsing required.</span></span><br>\r\n</p>\r\n<p>&nbsp;</p>\r\n<p><span class=\"fontsize-1vw\">Dermacell is decellularized using Matracell, a proprietary and patented technology that removes at least 97% of donor DNA without compromising the desired biomechanical structure or biochemical properties for its intended use.<sup>2</sup></span></p>\r\n<p>After being rendered acellular, Dermacell undergoes a terminal sterilization step to ensure a Sterility Assurance Level (SAL) of 10<sup>-6</sup>.</p>\r\n<p>Low-dose gamma irradiation performed at ultra-low temperatures is used to reach surgical device-grade sterility, which lowers the probability of an active organism in the graft to 1 in 1,000,000.<sup>2</sup></p>\r\n",
          "jcr:lastModified": "Thu Aug 02 2018 14:55:16 GMT-0400",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      },
