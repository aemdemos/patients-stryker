  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Eikon LT Adapt SE, Illuminated Retractor System</p>\r\n",
    "shortDescTop": "<p>Adjustable illumination provides bright light precisely where you want it, and its streamlined suction channel reduces smoke without impacting technique. Plus it’s non-conductive and thermally cool<sup>1</sup>, meaning you can focus less on thermal hazards and more on the surgical task at hand.</p>\r\n",
    "jcr:lastModifiedBy": "brittany.brady@stryker.com",
    "hideComponent": "false",
    "jcr:lastModified": "Wed Jun 03 2026 13:14:04 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
