      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Dilara.Atkins@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Fri May 15 2020 00:45:05 GMT+0000",
          "text": "<ul>\n<li>Bright and thermally cool illumintation; protects against thermal damage to tissues, surgical drapes, etc<sup>1</sup></li>\n<li>Volumetric spread provides even lighting across the cavity without washing out tissue color</li>\n<li>Microlenses shape light to reduce shadow and glare</li>\n<li>Solid core optical-grade polymer reduces light loss and thermal risks<sup>1</sup></li>\n<li>Adjustable illumination allows precision placement of light along entire retractor length</li>\n<li>Eliminates management of separate smoke device</li>\n<li>Helps fulfill government and clinical guidelines surrounding surgical smoke<sup>2-6</sup></li>\n</ul>\n",
          "jcr:lastModified": "Fri Aug 21 2026 19:52:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
