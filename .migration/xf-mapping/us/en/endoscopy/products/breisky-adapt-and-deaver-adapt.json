  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Breisky and Deaver , Illuminated Retractor System</p>\r\n",
    "shortDescTop": "<p>Breisky and Deaver accommodate multiple hand positions and a hollow handle for cable management.</p>\r\n",
    "jcr:lastModifiedBy": "user-bffe03609f@example.invalid",
    "jcr:lastModified": "Mon Dec 02 2019 16:01:36 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
