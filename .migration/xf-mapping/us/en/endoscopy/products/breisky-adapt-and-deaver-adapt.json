    ]
  },
  "rte": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "user-98fdffe29c@example.invalid",
    "gradientDirection": "left-to-right",
    "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Breisky </span>&nbsp; &nbsp;<br>\n </span>Used for Gynecology<br>\n<span class=\"futura-bold\"></span></p>\n<ul>\n<li>Offset, concave blade provides direct line of sight for enhanced visualization</li>\n<li>Most frequently used for vaginal procedures</li>\n<li>Used with flexible PhotonGuide Adapt illuminators<br>\n</li>\n</ul>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Deaver&nbsp;</span><br>\n </span><span class=\"urw-egyptienne\">“Question-mark” shaped retractor used to retract, expose or hold back tissue, muscle, and organs for surgical exposure</span></p>\n<ul>\n<li>Hook handle allows stable grip<br>\n</li>\n<li>Used with flexible PhotonGuide Adapt illuminators, helps maintain clear operative site for better visualization<br>\n</li>\n</ul>\n",
    "jcr:lastModified": "Wed Jun 03 2026 13:10:12 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
