      "topMargin": "5",
      "jcr:created": "Thu Dec 04 2025 05:08:33 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\"><span style=\"color: #ffffff;\">Experience the future of urology fluid management</span></span></span></p>\n<p><b style=\"font-size: 16.25px;\"><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><a href=\"#contact\"><span style=\"color: #ffb500;\"><br>\nREQUEST A DEMO</span></a>&nbsp;▸</span></span></span></b></p>\n",
