      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_auto",
          "jcr:created": "Wed Jul 30 2025 21:38:48 GMT+0000",
          "alt": "Thermaclear Product Image",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermaclear/images/thermaclear-cropped.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Aug 08 2025 17:12:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2.5",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Jul 30 2025 21:38:53 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Clarity in every procedure</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Consistent pressure. Clear visualization. Confident control.</span></span></p>\n<p><span class=\"fontsize-1-5em\">ThermaClear delivers steady irrigation and distention, enabling surgeons to maintain optimal visualization of vasculature and anatomy during urologic procedures.<sup>1</sup></span></p>\n",
          "jcr:lastModified": "Mon Aug 18 2025 21:14:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2.5",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Jul 30 2025 21:38:53 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Engineered for surgical efficiency</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Smarter fluid flow, without the surge</span></span></p>\n<p><span class=\"fontsize-1-5em\">The non-pulsatile system is designed to outperform gravity-fed irrigation and improve procedural control.<sup>1</sup></span><br>\n</p>\n",
          "jcr:lastModified": "Wed Oct 22 2025 21:48:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2.5",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Jul 30 2025 21:38:53 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Warming when it matters</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">On-demand fluid warming for patient stability</span></span></p>\n<p><span class=\"fontsize-1-5em\">ThermaClear provides fluid warming on demand, which may help reduce the drop in body temperature during surgery when compared to room-temperature fluids.<sup>1</sup></span></p>\n",
          "jcr:lastModified": "Mon Aug 18 2025 21:15:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy_1216309067": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2.5",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Jul 30 2025 21:38:53 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Designed with safety in mind</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Built-in safeguards, adjustable settings</span></span></p>\n<p><span class=\"fontsize-1-5em\">Customizable pressure and fluid bag volume settings, paired with low-fluid notifications, may help support a safer and more efficient surgical experience.<sup>*,1</sup></span></p>\n",
          "jcr:lastModified": "Wed Oct 22 2025 21:49:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
