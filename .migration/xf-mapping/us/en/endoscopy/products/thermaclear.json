      "hideComponent": "false",
      "rightMargin": "10",
      "jcr:created": "Wed Jul 30 2025 21:32:01 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\">Introducing ThermaClear - a fluid management system developed for the demands of modern urologic surgery, offering intuitive operation and consistent performance within Stryker’s surgical suite.</span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><b><br>\nThermaClear was designed with nurses in mind. </b>With step-by-step video instructions, you can spend less time focusing on equipment, and more time focused on the patient.<sup>1</sup><br>\n </span></p>\n",
      "jcr:lastModified": "Fri Dec 05 2025 00:39:55 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "3",
      "textIsRich": "true",
      "leftMargin": "10"
    },
