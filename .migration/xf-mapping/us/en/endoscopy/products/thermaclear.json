          "hideComponent": "false",
          "topMargin": "3",
          "jcr:created": "Wed Jul 30 2025 21:38:30 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Sleek.&nbsp;</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Powerful.&nbsp;</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Designed with you in mind.</span></span></span></p>\n",
          "jcr:lastModified": "Fri Dec 05 2025 00:41:33 GMT+0000",
