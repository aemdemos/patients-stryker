    "largeheadline_copy_c_987031291": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Wed Aug 01 2018 18:09:49 GMT-0400",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"fontsize-3-5-vw\"><span class=\"futura-bold\">The PINPOINT camera<br>\r\n </span><span class=\"urw-egyptienne\">is the next generation of fluorescence imaging technology</span></span>",
      "line2": "<p>&nbsp;</p>\r\n<p>The camera features leading-edge sensor technology and its custom optics provide for vividly colored and high contrast images across all PINPOINT display modes.<br>\r\n</p>\r\n",
      "jcr:lastModified": "Wed Aug 01 2018 19:54:02 GMT-0400",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
      "textIsRich": [
        "true",
        "true"
      ]
    },
    "cols2_1_3_2_3": {
      "jcr:primaryType": "nt:unstructured",
