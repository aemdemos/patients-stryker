    "largeheadline_copy_c": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Wed Aug 01 2018 18:09:49 GMT-0400",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"fontsize-3-5-vw\"><span class=\"futura-bold\">One technology,<br>\r\n </span><span class=\"urw-egyptienne\">multiple minimally invasive applications</span></span>",
      "line2": "<p>&nbsp;</p>\r\n<p>PINPOINT offers brilliant, high-definition, white light video with the added advantage of SPY Fluorescence Imaging technology, which has been demonstrated as beneficial in a variety of surgical applications.<sup>2, 3, 5</sup><br>\r\n</p>\r\n",
      "jcr:lastModified": "Wed Aug 01 2018 19:50:10 GMT-0400",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
      "textIsRich": [
        "true",
        "true"
      ]
    },
    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Wed Aug 01 2018 19:50:21 GMT-0400",
      "jcr:lastModified": "Wed Aug 01 2018 19:50:21 GMT-0400",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 19:50:31 GMT-0400",
          "srcFileRef": "/content/dam/stryker/endoscopy/images/SYK.Stryker.com.NovadaqPages_AssetsPINPOINT - Colon.jpg",
          "jcr:lastModified": "Thu Aug 02 2018 14:26:58 GMT-0400",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 18:42:49 GMT-0400",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Colon resection</span></span></p>\n<p>Assessing tissue perfusion may assist surgeons in making informed decisions that can positively impact outcomes.<sup>3</sup><br>\n</p>\n",
          "jcr:lastModified": "Wed Aug 01 2018 19:51:32 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 19:50:34 GMT-0400",
          "srcFileRef": "/content/dam/stryker/endoscopy/images/SYK.Stryker.com.NovadaqPages_AssetsPINPOINT - Laprochol.jpg",
          "jcr:lastModified": "Thu Aug 02 2018 14:27:06 GMT-0400",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 18:42:49 GMT-0400",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Laparoscopic cholecystectomy</span></span></p>\n<p>ApVisualizing biliary ducts and the critical view of safety, may be easier with PINPOINT.<sup>4</sup><br>\n</p>\n",
          "jcr:lastModified": "Wed Aug 01 2018 19:52:23 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 19:50:37 GMT-0400",
          "srcFileRef": "/content/dam/stryker/endoscopy/images/SYK.Stryker.com.NovadaqPages_AssetsPINPOINT - Esophag.jpg",
          "jcr:lastModified": "Thu Aug 02 2018 14:27:15 GMT-0400",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 18:42:49 GMT-0400",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Minimally invasive esophagectomy</span></span></p>\n<p>During esophagectomy, PINPOINT may help surgeons evaluate the gastric conduit.<sup>5</sup><br>\n</p>\n",
          "jcr:lastModified": "Wed Aug 01 2018 19:53:02 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
