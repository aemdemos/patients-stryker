          "jcr:created": "Wed Aug 01 2018 19:54:34 GMT-0400",
          "srcFileRef": "/content/dam/stryker/endoscopy/images/SYK.Stryker.com.NovadaqPages_AssetsPINPOINT - Dedicated improvement.jpg",
