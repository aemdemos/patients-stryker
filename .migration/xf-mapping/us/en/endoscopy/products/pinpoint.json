      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Wed Aug 01 2018 19:54:10 GMT-0400",
      "jcr:lastModified": "Wed Aug 01 2018 19:54:10 GMT-0400",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Aug 01 2018 19:54:17 GMT-0400",
          "srcFileRef": "/content/dam/stryker/endoscopy/images/SYK.Stryker.com.NovadaqPages_AssetsPINPOINT - Camera1.jpg",
          "jcr:lastModified": "Thu Aug 02 2018 14:50:03 GMT-0400",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Thu Aug 02 2018 14:46:12 GMT-0400",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Intraoperative perfusion assessment</span></span></p>\n<p>Allows surgeons to visualize tissue perfusion and biliary ducts intraoperatively and in real-time.</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Increased confidence</span></span></p>\n<p>Fluorescence imaging may assist surgeons with critical decisions during surgery.<sup>3</sup></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Improved outcomes</span></span></p>\n<p>Allows surgeons to assess perfusion, which may improve patient outcomes.<sup>3</sup></p>\n",
          "jcr:lastModified": "Thu Aug 02 2018 14:48:52 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
