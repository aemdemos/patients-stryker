      "jcr:created": "Wed Aug 01 2018 19:54:26 GMT-0400",
      "jcr:lastModified": "Wed Aug 01 2018 19:54:26 GMT-0400",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
