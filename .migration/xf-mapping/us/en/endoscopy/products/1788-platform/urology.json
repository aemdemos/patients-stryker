          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-3-5-vw\"><span class=\"urw-egyptienne\">Experience a new wave of</span><br />\r\n <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">surgical visualization.</span></span></span>",
