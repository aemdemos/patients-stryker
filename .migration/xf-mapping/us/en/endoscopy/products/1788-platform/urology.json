          "hideComponent": "false",
          "jcr:created": "Wed Sep 11 2024 14:35:55 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Introducing&nbsp;<br>\n <span style=\"color: #ffb500;\">F88 Flexible Ureteroscope<br>\n </span></span></span></p>\n",
          "jcr:lastModified": "Fri Jun 05 2026 19:18:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
