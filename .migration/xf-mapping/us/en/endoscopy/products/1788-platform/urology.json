      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Sep 11 2024 14:35:55 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Introducing&nbsp;<br>\n <span style=\"color: #ffb500;\">SPY Cyan Spectral Imaging<br>\n </span></span></span></p>\n",
          "jcr:lastModified": "Fri Jan 17 2025 15:21:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1668980546": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Fri Aug 16 2024 22:28:19 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">SPY Cyan Spectral Imaging (CSI) is an advanced imaging modality to enhance the visualization of vasculature in urology surgery.<sup>1</sup></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\"><br>\nThis technology works by emitting only green and short blue wavelengths to provide higher contrast of vascular structures on the mucosal surface.<sup>1</sup></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\"><br>\nCSI is an enhanced cystoscopic technique. AUA recommends considering the use of enhanced cystoscopy in patients with a history of NMIBC.<sup>6</sup></span></span></p>\n",
          "jcr:lastModified": "Thu Jun 18 2026 13:31:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
