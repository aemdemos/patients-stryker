          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Aug 16 2024 22:24:31 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Introducing the 1788 Platform, now equipped to evolve with a new&nbsp;mode. Featuring improved image lighting and 62.5x more visible colors, the 1788 Platform is Stryker’s re-imagined surgical visualization solution.<sup>1</sup></span></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Thu Jun 18 2026 13:30:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
