        "text_652839079": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Equipped with the ability to visualize multiple optical imaging agents across multiple specialties, the 1788 Platform features Stryker’s most vibrant surgical image yet. Entirely&nbsp;re-imagined fluorescence imaging offers clearer delineation of fluorescence, designed to improve visualization of critical anatomy when it matters most.<sup>1</sup></span></span><br>\n</p>\n",
          "jcr:lastModified": "Thu Sep 05 2024 13:52:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
