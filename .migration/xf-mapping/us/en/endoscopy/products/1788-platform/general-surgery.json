          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2-5em\"><span style=\"color: #ffb500;\"><a href=\"#about\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\">Fluorescence Imaging, </span><span style=\"color: #ffb500;\"><span class=\"futura-bold\">re-imagined.</span></span></span></span></a></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><a href=\"#about\"><span style=\"color: #ffb500;\"><br>\n</span></a></span></span></span></p>\n<p>&nbsp;</p>\n",
