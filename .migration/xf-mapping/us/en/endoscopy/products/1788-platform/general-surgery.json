    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "jcr:created": "Fri Jun 28 2024 17:45:01 GMT+0000",
      "jcr:lastModified": "Fri Jun 28 2024 17:45:01 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_652839079_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Clear, consistent <br>\n </span><span style=\"color: #ffb500;\"><span class=\"futura-bold\">fluorescence imaging</span></span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:46:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Experience a more consistent fluorescence image with camera movement, enabling you to work more freely whilst trusting in the fluorescence image.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:47:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy__1088331540": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"><br>\nMulti-modal<br>\n</span><span style=\"color: #ffb500;\"><span class=\"futura-bold\">advanced imaging</span></span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:53:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy__714987235": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Improves usability by enabling simultaneous visualization of fluorescence imaging and IRIS ureteral stents.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:53:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy__697363522": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"><br>\n Experience<br>\n </span><span style=\"color: #ffb500;\"><span class=\"futura-bold\">1 billion colors</span></span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:54:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy__31474363": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">See 62.5x more colors for improved differentiation between shades and an astonishingly vibrant surgical image.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:55:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy__1068491058": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"><br>\nNow with&nbsp;<br>\n</span><span style=\"color: #ffb500;\"><span class=\"futura-bold\">CSF mode</span></span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:55:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy__1239711875": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Color Segmented Fluorescence (CSF) mode provides a differentiable color map to more easily perceive a wider range of fluorescence intensities while displaying white light image.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jun 28 2024 17:55:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
