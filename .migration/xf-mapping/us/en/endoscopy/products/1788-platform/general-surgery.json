          "text": "<p><span class=\"fontsize-2-5em\"><span style=\"color: #ffb500;\"><a href=\"#about\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\">Experience a new wave of</span></span></span></a></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><a href=\"#about\"><span style=\"color: #ffb500;\"><br>\n surgical visualization</span></a></span></span><span class=\"urw-egyptienne\">&nbsp;</span></span></p>\n<p>&nbsp;</p>\n",
