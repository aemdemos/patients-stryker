        },
        "text_652839079_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The use of fluorescence imaging technology in laparoscopic cholecystectomy has been shown to help surgeons improve patient outcomes with respect to operative times, decreased conversion to open procedures and shorter length of hospitalization.<sup>2,3</sup></span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jul 12 2024 16:43:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
