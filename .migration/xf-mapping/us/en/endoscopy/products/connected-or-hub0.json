    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>User profiles: Surgeon Profiles allow customized settings to auto-populate before you even enter the OR, creating a consistent surgical environment.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Device and voice control: Allows surgeons to annotate on the fly from the 1688 camera head, wireless headset or wireless remote control.<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>iPad App: Use Stryker’s My Patient Hub iPad application to share custom post-operative reports and images with patients... and much more.</p>\r\n",
        "textIsRich": "true"
      }
    }
  }
