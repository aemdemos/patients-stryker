          "jcr:created": "Thu Jul 07 2022 19:55:43 GMT+0000",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/pneumoclear/images/protectingyou.png",
          "borderColor": "rgba(76,125,122,1)",
