      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-98fdffe29c@example.invalid",
          "jcr:created": "Thu Jul 07 2022 19:55:48 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Consistently clear images</span></span></p>\n<p><span class=\"fontsize-1-25em\">Smart inflow and outflow management designed to maintain stability while actively evacuating smoke.</span></p>\n<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Control of your environment</span></span></p>\n<p><span class=\"fontsize-1-25em\">Addresses fluctuations in pressure with developed operating modes.<br>\n <br>\n Helps control your operation by addressing fluctuations in pressure and improving post-operative patient recovery through the use of heated and humidified CO2 vs. cold and dry insufflation.<sup>7&nbsp;</sup></span></p>\n<p><span class=\"fontsize-1-25em\">PneumoClear is able to filter particles as small as .051 microns with up to 99.999993% efficiency for outflow. <sup>8</sup></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">All-in-one integration</span></span></p>\n<p><span class=\"fontsize-1-25em\">All-inclusive system of heated and humidified CO2 with active smoke evacuation in a single lightweight and flexible tube set.</span></p>\n<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Six operating modes</span></span></p>\n<p><span class=\"fontsize-1-25em\">The six operating modes available are standard, advanced flow, highflow/bariatric, pediatric, TAMIS and vessel harvest.</span></p>\n",
          "jcr:lastModified": "Wed Oct 21 2026 13:31:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
