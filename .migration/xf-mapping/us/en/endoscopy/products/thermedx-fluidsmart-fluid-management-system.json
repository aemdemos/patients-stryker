  "rte": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
    "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">FluidSmart features:</span>&nbsp;</span></p>\n<ul>\n<li>Step-by-step instructions displayed on screen for easy set-up</li>\n<li>On-demand fluid warming to specified set temperature*&nbsp;</li>\n<li>Adjustable fluid pressurization&nbsp;</li>\n<li>Non-pulsating flow to enhance visualization&nbsp;</li>\n<li>High pressure capabilities for ureteroscopies**</li>\n</ul>\n",
    "jcr:lastModified": "Tue Jul 05 2022 15:42:09 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
