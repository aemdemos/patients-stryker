          "preset": "max_width_1440",
          "jcr:created": "Wed Jun 29 2022 16:50:21 GMT+0000",
          "alt": "Highest nurse satisfaction",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermedx/images/Icon-2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 06 2022 15:47:16 GMT+0000",
