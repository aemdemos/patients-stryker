      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed Jun 29 2022 15:52:36 GMT+0000",
          "alt": "For Urology",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermedx/images/ForUrology.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 06 2022 15:46:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Jun 29 2022 15:52:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\">Fluid warming</span></span></span></p>\n<p><span class=\"fontsize-1-25em\">On-demand fluid warming to specified set temperature* which may help in the prevention of preoperative hypothermia<sup>1</sup></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\">Non-pulsatile flow</span></span></span></p>\n<p><span class=\"fontsize-1-25em\">Provides clear visualization during a procedure</span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\">Proprietary lure-lock adapters</span></span></span></p>\n<p><span class=\"fontsize-1-25em\">For all urological procedures, including ureteroscopy&nbsp;(for use up to 300 mmHg)</span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 18:47:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed Jun 29 2022 16:41:12 GMT+0000",
          "alt": "For Gynecology",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermedx/images/ForGynecology.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 06 2022 15:46:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Jun 29 2022 15:52:40 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Fluid deficit monitoring</span></span></span></span></p>\n<p><span class=\"fontsize-1-25em\">Real-time monitoring and display of fluid deficit</span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Enhanced safety features</span></span></span></span></p>\n<p><span class=\"fontsize-1-25em\">Adjustable notifications for deficit, pressure, and perforation</span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">User-friendly</span></span></span></span></p>\n<p><span class=\"fontsize-1-25em\">Change fluid bags and canisters without disrupting a surgical procedure</span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 16:46:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
