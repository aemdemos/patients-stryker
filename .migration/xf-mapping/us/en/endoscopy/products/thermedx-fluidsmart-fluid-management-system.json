          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed Jun 29 2022 16:50:21 GMT+0000",
          "alt": "Greater intraoperative blood loss",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermedx/images/Icon-5.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 06 2022 15:47:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Jun 29 2022 16:50:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Greater intraoperative<br>\n blood loss<sup>4</sup></span></span></span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 18:49:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols_166454813_copy_": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Wed Jun 29 2022 16:46:59 GMT+0000",
      "jcr:lastModified": "Wed Jun 29 2022 16:46:59 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Jun 29 2022 16:47:08 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span style=\"color: #000000;\"><span class=\"futura-bold\">FluidSmart increases cost savings by increasing OR turnover, OR efficiency, reducing pump set up and pump time.<sup>2</sup></span></span></span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 18:59:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols3_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Wed Jun 29 2022 16:47:48 GMT+0000",
      "jcr:lastModified": "Wed Jun 29 2022 16:47:48 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed Jun 29 2022 16:50:21 GMT+0000",
          "alt": "Less OR staff needed",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermedx/images/Icon-6.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 06 2022 15:48:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Jun 29 2022 16:50:33 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Less OR staff needed&nbsp;</span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">One less circulating nurse may be needed to manage fluid irrigation when using FluidSmart compared to hand pump irrigation in PCNL cases. Assuming total PCNL OR time is 2.3 hours and $57/hour as the average hourly salary of a circulating nurse. This results in an estimated savings of $131 per procedure.<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 18:54:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed Jun 29 2022 16:50:21 GMT+0000",
          "alt": "12 minutes less OR time",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermedx/images/Icon-7.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 06 2022 15:48:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Jun 29 2022 16:50:33 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">12 minutes less OR time&nbsp;</span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">Total procedure time for myomectomy procedures were reduced by an average of 12 minutes (46 min vs 34 min) when using FluidSmart’s continuously warmed fluid versus warming cabinet fluid.<sup>5</sup> This results in an estimated savings of $432 per procedure.<sup>5,6</sup></span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 18:55:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed Jun 29 2022 16:50:21 GMT+0000",
          "alt": "Reduced pump time",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/thermedx/images/Icon-8.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Jul 06 2022 15:48:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Jun 29 2022 16:50:33 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Reduced pump time&nbsp;</span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">Compared to a handpump, FluidSmart reduced the pump set up by an average of 7.6 minutes (9.8 min vs 2.2 min) and reduced pump time up to 29 minutes in PCNL cases.<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 18:55:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
