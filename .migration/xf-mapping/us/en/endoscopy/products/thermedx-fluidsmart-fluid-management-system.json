        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Wed Jun 29 2022 16:50:33 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Warmed fluid on demand&nbsp;</span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-25em\">An in vitro ureteroscopy model demonstrated FluidSmart has faster fluid heating capabilities compared to other automated irrigation systems.<sup>3</sup></span></p>\n",
          "jcr:lastModified": "Wed Jun 29 2022 16:51:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
