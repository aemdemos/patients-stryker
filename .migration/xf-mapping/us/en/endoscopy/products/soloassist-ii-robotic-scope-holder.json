          "jcr:created": "Tue Jul 05 2022 17:43:37 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-2-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\">19 minutes less</span></span></span></p>\n<p style=\"text-align: center;\">Per colon resection case for SoloAssist compared to human assistance, which translates to $684 in savings per case.<sup>6,7</sup></p>\n",
          "jcr:lastModified": "Tue Jul 05 2022 17:45:21 GMT+0000",
