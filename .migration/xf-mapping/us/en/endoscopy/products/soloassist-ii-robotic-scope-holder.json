    "cols_159068139_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Tue Jul 05 2022 17:36:37 GMT+0000",
      "jcr:lastModified": "Tue Jul 05 2022 17:36:37 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Tue Jul 05 2022 17:36:42 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">8 out of 9 surgeons</span></span> <span class=\"urw-egyptienne\">surveyed prefer using SoloAssist compared to human assistance.<sup>2,3</sup></span></span></p>\n",
          "jcr:lastModified": "Tue Jul 05 2022 17:37:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Tue Jul 05 2022 17:37:37 GMT+0000",
      "jcr:lastModified": "Tue Jul 05 2022 17:37:37 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Jul 05 2022 17:37:45 GMT+0000",
          "srcFileRef": "/content/dam/stryker/endoscopy/products/solo-assist-2/images/videoscreen.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jul 05 2022 22:51:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Tue Jul 05 2022 17:37:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b>The potential advantages of SoloAssist II include reduced bed days, reduced surgeon participation, improved OR efficiency, and associated cost savings.<sup>1,5,7</sup></b></span></p>\n<p><span class=\"fontsize-1-25em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Reduced length of stay</span></span></span><br>\nUp to 2.9 less median bed days for patients who used SoloAssist during surgery compared to patients that had human assistance (9.4 vs 6.5, p&lt;0.05)<sup>4</sup>, which translates to $7,560 in bed day savings.<sup>1,4</sup></p>\n<p><span class=\"fontsize-1-25em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Reduced surgical participation</span></span></span><br>\nFewer participants are needed in surgery compared to manual human-assisted laparoscopic procedures.<sup>1</sup></p>\n<p><span class=\"fontsize-1-25em\"><span style=\"color: #4c7d7a;\"><span class=\"futura-bold\">Improved OR efficiency</span></span></span><br>\nAssuming OR time costs an estimated $36 per minute<sup>6</sup>, reduced OR time ultimately results in cost savings per case.&nbsp;</p>\n",
          "jcr:lastModified": "Tue Jul 05 2022 17:39:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
