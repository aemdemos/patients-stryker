          "jcr:created": "Tue Jul 05 2022 17:43:37 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-2-5em\"><span style=\"color: #85458a;\"><span class=\"futura-bold\">8 minutes less</span></span></span></p>\n<p style=\"text-align: center;\">Per inguinal hernia case for SoloAssist compared to human assistance, which translates to $288 in savings per case.<sup>5,6</sup></p>\n",
          "jcr:lastModified": "Tue Jul 05 2022 17:44:25 GMT+0000",
