          "jcr:created": "Tue Jul 05 2022 17:47:09 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">A.</span></span><span class=\"fontsize-1-5em\"> <br>\n Intuitive control via joystick attachment<br>\n <br>\n</span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">B.</span></span><span class=\"fontsize-1-5em\"> <br>\n Manual positioning at the push of a button<br>\n <br>\n</span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">C.</span></span><span class=\"fontsize-1-5em\"> <br>\n Attachments for 5mm and 10mm laparoscopes<br>\n <br>\n</span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">D.</span></span><span class=\"fontsize-1-5em\"> <br>\n Quick-coupling device for easy mounting to a variety of surgical tables</span></span></p>\n",
          "jcr:lastModified": "Tue Jul 05 2022 22:53:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
