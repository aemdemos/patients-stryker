    "cols2_1_3_2_3_395427442": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Fri Jul 24 2020 18:24:26 GMT+0000",
      "jcr:lastModified": "Fri Jul 24 2020 18:24:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Fri Jul 24 2020 03:29:16 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Brilliant image quality<br>\n </span></span>The 1080p resolution at 60fps, designed to provide realistic color reproduction, results in a sharp, highly detailed image.<br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Multiple visualization modes</span></span><br>\nCombine fluorescence signal information with vivid white light images in real-time.<br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Flexible working distance \u0003and wide imaging field</span></span><br>\nSPY-PHI is to designed to allow clinicians to assess perfusion using a wide range of viewing distances, allowing for versatility in the operating room.<br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Ambient light immunity</span></span><br>\nUniform illumination field and ambient light immunity.</p>\n",
          "jcr:lastModified": "Fri Jul 24 2020 18:26:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
