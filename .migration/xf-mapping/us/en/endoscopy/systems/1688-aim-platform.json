            "largeheadline": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "lee.fuller1@stryker.com",
              "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
              "jcr:created": "Fri Jul 24 2020 19:02:18 GMT+0000",
              "gradientDirection": "left-to-right",
              "line1": "<p>&nbsp;</p>\r\n<p><span class=\"fontsize-4-5-vw\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(237,238,236);\">For use in multiple</span></span></span><br>\r\n <span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">surgical specialties</span></span></span></p>\r\n",
              "line2": "<span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(237,238,236);\">Three distinct SPY fluorescence imaging modalities; Contrast, <br />\r\n Overlay and ENV are integrated into the platform and enable <br />\r\n real-time 4K fluorescence images of perfusion and critical <br />\r\n anatomy. Studies have shown that the use of fluorescence <br />\r\n imaging may assist surgeons in making better clinical decisions <br />\r\n during colorectal, laparoscopic cholecystectomy and other <br />\r\n minimally invasive procedures.<sup>1</sup></span></span>",
              "jcr:lastModified": "Wed Sep 23 2020 19:52:57 GMT+0000",
