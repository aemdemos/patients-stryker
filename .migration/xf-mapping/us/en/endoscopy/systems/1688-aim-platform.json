      "jcr:lastModified": "Fri Jul 24 2020 03:36:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_163549757": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_auto",
          "jcr:created": "Fri Jul 24 2020 20:08:23 GMT+0000",
          "alt": "laparoscopic tower, endoscopic tower, stryker 1688, ICG",
          "srcFileRef": "/content/dam/stryker/endoscopy/systems/1688/main-page/images/1688-AssetsStack.png",
          "jcr:lastModified": "Fri Apr 29 2022 20:11:52 GMT+0000",
