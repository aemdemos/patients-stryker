    "largeheadline_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Fri Jul 24 2020 03:27:24 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"futura-bold\"><span class=\"fontsize-4-5-vw\"><span style=\"color: rgb(255,181,0);\">Do more.</span></span></span><br>\r\n<span class=\"urw-egyptienne\"><span class=\"fontsize-2-5-vw\">Standardization without compromise.&nbsp;<br>\r\nMeet the Connected OR Hub.&nbsp;</span></span>",
      "jcr:lastModified": "Fri Jul 24 2020 03:35:51 GMT+0000",
