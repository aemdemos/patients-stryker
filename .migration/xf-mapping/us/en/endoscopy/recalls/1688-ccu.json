      "gradientDirection": "left-to-right",
      "line1": "<h1><span class=\"futura-bold\">1688 CCU Flip Issue</span></h1>\r\n",
      "jcr:lastModified": "Thu May 05 2022 16:47:06 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,181,0,1)",
