    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "Bridget.Campomanes@stryker.com",
      "jcr:lastModifiedBy": "jeannie.chan@stryker.com",
      "jcr:created": "Thu May 05 2022 15:40:38 GMT+0000",
      "text": "<p>The purpose of this notification is to advise you that Stryker Endoscopy is conducting Part 2 of a voluntary recall of the 1688 Camera Control Unit (CCU). Please note, Part 1 only affected customers with a Pendulum Camera. Part 1 is&nbsp; now closed and will be&nbsp;superseded&nbsp;by Part 2, which affected all customers with a 1688 CCU. All affected consoles are required to install updated software.<br>\n</p>\n<p>&nbsp;</p>\n<p><b>Please choose what represents you: </b>(Please enable cookies on your browser.)</p>\n",
      "jcr:lastModified": "Thu May 05 2022 18:54:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
