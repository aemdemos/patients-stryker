      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1872607227": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Thu Feb 26 2026 15:51:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Real impact starts with the right partner. </span></span><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">Stryker’s Sustainability Solutions</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\"> (SSS) is the largest third-party reprocessor in the U.S. and Canada, bringing unmatched experience to your program.<sup>1</sup></span></span></p>\n<p><span class=\"fontsize-1-25em\">A successful reprocessing program depends on many variables. We provide a reliable supply of reprocessed products that fit seamlessly into your existing workflows, backed by a full-service support team that helps drive adoption from implementation through optimization.</span></p>\n<p><span class=\"fontsize-1-25em\">When your program is supported end-to-end, you can see the results: meaningful savings you can reinvest into innovation and facility improvements, all while diverting medical waste and being a responsible steward for the planet.<sup>2</sup></span></p>\n",
          "jcr:lastModified": "Fri Feb 27 2026 21:26:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
