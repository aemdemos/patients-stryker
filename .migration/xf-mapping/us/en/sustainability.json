      "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
      "jcr:created": "Thu Feb 26 2026 15:51:39 GMT+0000",
      "text": "<p><span class=\"fontsize-1-25em\">Environmental impact matters across the organization, from frontline staff to executive leadership. Programs like Products for the Planet deliver measurable, visible outcomes that drive engagement and support broader adoption. And each year, we celebrate the hospitals making the biggest difference through our Environmental Excellence Award, recognizing standout achievements in environmental stewardship. Over the last five years, our customers have diverted 22.7M pounds of waste from landfills.<sup>3</sup></span></p>\n",
      "jcr:lastModified": "Fri Feb 27 2026 21:26:21 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
