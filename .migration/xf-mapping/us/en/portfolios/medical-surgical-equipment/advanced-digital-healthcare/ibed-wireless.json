      "jcr:created": "Thu Aug 01 2024 16:31:59 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"futura-bold\">Stryker’s iBed Wireless System</span></h2>\n<p><span class=\"fontsize-1-25em\">Available on the ProCuity bed series, Stryker's S3 MedSurg Bed and InTouch Critical Care Bed – iBed Wireless helps enable wireless bed alarms designed to support fall prevention protocols*, asset management and documentation from the bedside<sup>1</sup>. iBed Wireless is compatible with many information management systems to enable each facility to build a custom end-to-end solution.&nbsp;</span></p>\n",
      "jcr:lastModified": "Thu Oct 17 2024 19:10:10 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "2"
    },
