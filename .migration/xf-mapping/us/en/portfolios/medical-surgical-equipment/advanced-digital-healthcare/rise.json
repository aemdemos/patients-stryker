              "jcr:created": "Thu Aug 01 2024 16:29:06 GMT+0000",
              "gradientDirection": "left-to-right",
              "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-3-5-vw\">Welcome to the RISE of a new OR for ENT and Neurosurgery</span></span></h1>\r\n",
              "jcr:lastModified": "Thu Aug 28 2025 23:25:30 GMT+0000",
              "sling:resourceType": "stryker/components/content/largeheadline",
              "backgroundColor": "rgba(255,255,255,0)",
