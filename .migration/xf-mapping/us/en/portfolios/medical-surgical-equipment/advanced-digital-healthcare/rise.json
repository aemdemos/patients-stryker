    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-1f15d09fdf@example.invalid",
      "jcr:lastModifiedBy": "user-1f15d09fdf@example.invalid",
      "hideComponent": "false",
      "topMargin": "5",
      "jcr:created": "Thu Aug 01 2024 16:44:29 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\">RISE integrates existing Stryker solutions to create a connected surgical experience tailored just for you. Designed to improve workflow efficiencies to create a better surgical experience.<sup>1</sup></span></p>\n<p><span class=\"fontsize-1-25em\">From conveniently mobile Neurotechnology Carts to permanently installed iSuite, RISE is a surgical evolution that can be customized and configured to meet your needs. Combined with the optimized visualization of the 1788 camera, RISE delivers an intuitive workflow.<sup>2</sup></span></p>\n<p><span class=\"fontsize-1-25em\">A completely redesigned and fully customizable RISE Neurotechnology Cart that accommodates unique demands of the RISE Ecosystem in ENT and Neurosurgery. New features include a flex arm with a wide range of motion for precise positioning and viewing angles<sup>2</sup>, multiple storage options for foot pedals and other accessories, keyboard and mouse tray and more.<br>\n </span>&nbsp;</p>\n",
      "jcr:lastModified": "Wed Jan 21 2026 21:33:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "2"
    },
