    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue Mar 05 2024 16:35:16 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\"><b>SILVER SPRING, MD</b> – Today, the <a href=\"https://www.nursingworld.org/ana/\">American Nurses Association</a> (ANA) and the <a href=\"https://www.nursingworld.org/foundation/\">American Nurses Foundation</a> (the Foundation) announced the winners of the 2024 <a href=\"https://www.nursingworld.org/practice-policy/innovation-in-nursing/ana-innovation-award/\">ANA Innovation Awards</a> sponsored by <a href=\"https://www.stryker.com/\">Stryker</a>, a leading global medical technology company. The ANA Innovation Awards highlight, recognize, and celebrate exemplary nurse innovators who improve patient safety and health outcomes within their communities.</span></p>\n",
      "jcr:lastModified": "Fri Mar 08 2024 01:18:20 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "3"
    },
    "section_title": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "deepLinkingId": "winners",
      "jcr:created": "Tue Mar 05 2024 16:40:29 GMT+0000",
      "title": "Winners of the Nurse-led Team Award",
      "jcr:lastModified": "Tue Mar 05 2024 16:40:50 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title"
    },
    "text_1904168436": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "hideComponent": "false",
      "topMargin": "-2",
      "jcr:created": "Tue Mar 05 2024 16:48:30 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-25em\">Dr. Lena Gould is the Founder and CEO of The Diversity in Nurse Anesthesia Mentorship Program, a 501(c)(3) non-profit organization dedicated to promoting and advancing diversity within graduate nurse anesthesia programs. This is primarily accomplished through the Immersion Model for Diversifying Nurse Anesthesia Programs (The Immersion Model), an innovative, evidence-based program focused on the diversification of the nursing workforce. It was created specifically for nurses of color who have been historically underrepresented as certified registered nurse anesthetists (CRNAs); thereby, aiming to help reduce health disparities, structural inequities, and institutional biases. The Immersion Model is preparing nurses of color to be competitive applicants for graduate anesthesia programs and successful students while equipping them to provide better health outcomes for the diverse population.</span></p>\n<p><span class=\"fontsize-1-25em\">For example, health disparity issues facing Black women stemming from providers’ biases include high maternal mortality rates and racial bias in pain management which would be significantly improved through a diverse nurse anesthesia workforce that will proactively address the social determinants of health. What’s unique about the Immersion Model is that it’s the only program that actively engages with HBCUs and other higher education institutions serving nurses of color. With the award funds, The Immersion Model seeks to expand its professional events for CRNAs across the country. It also seeks to replicate this successful program for Advance Practice Nurses (APRNs).</span></p>\n",
      "jcr:lastModified": "Fri Mar 08 2024 01:19:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "3"
    },
