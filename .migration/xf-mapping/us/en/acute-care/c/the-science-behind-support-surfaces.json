        "text_908007915_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "eleni.maistrellis@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "jcr:created": "Thu Sep 10 2020 13:09:36 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span style=\"color: #1c5687;\"><span style=\"color: #4c7d7a;\"><span style=\"color: #000000;\"><span style=\"color: #ffb500;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">The Science Behind Support Surfaces</span></span></span></span></span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Stryker in partnership with Becker’s Healthcare are presenting an on-demand webinar focusing on the utilization of support surfaces technology for prevention and treatment of pressure injuries. Participants will be introduced to the different types of surfaces technologies, terminologies and discuss the clinical benefits of gel and air surfaces.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Specifically, you will learn:</span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">The different surfaces in healthcare</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">How to define microclimate, envelopment, and immersion </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">The benefits of gel and air surfaces</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Dec 01 2022 20:03:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
      }
    },
