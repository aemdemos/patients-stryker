          "col2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-f123ca2978@example.invalid",
              "topPadding": "3",
              "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
              "hideComponent": "false",
              "jcr:created": "Tue Jan 02 2024 17:23:23 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"fontsize-1-25em\">“Nursing innovation is a priority for Stryker and when we innovate we think about the nurse, the front line workers, that are caring for patients every single day. We want to make sure we’re innovating to give them the tools they need to do their jobs, but also to protect them from harm on a daily basis.”&nbsp;</span></p>\n<p><span class=\"fontsize-1-25em\"><b>– Jessica Mathieson,&nbsp;</b><br>\nPresident, Medical<br>\n</span></p>\n",
              "jcr:lastModified": "Fri Mar 07 2025 13:53:17 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        },
        "cols": {
          "jcr:primaryType": "nt:unstructured",
