              "preset": "max_width_1440",
              "jcr:created": "Thu Jan 04 2024 15:50:21 GMT+0000",
              "alt": "Nurse tending to paitent",
              "srcFileRef": "/content/dam/stryker/acute-care/campaigns/nurse-innovation/male-nurse-assisting-patient.jpeg",
              "borderColor": "rgba(76,125,122,1)",
              "jcr:lastModified": "Mon Mar 18 2024 14:06:09 GMT+0000",
              "sling:resourceType": "stryker/components/content/standaloneimage",
