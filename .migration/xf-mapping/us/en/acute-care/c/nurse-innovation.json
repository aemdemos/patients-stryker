              "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
              "jcr:created": "Mon Feb 12 2024 17:50:54 GMT+0000",
              "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">The <span style=\"color: #ffb500;\">transformative power</span> of nursing innovation</span></span></h2>\n",
