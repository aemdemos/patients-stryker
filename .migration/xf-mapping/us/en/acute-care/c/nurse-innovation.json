          "col2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-f123ca2978@example.invalid",
              "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
              "jcr:created": "Thu Jan 04 2024 15:51:01 GMT+0000",
              "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Frontline experience and patient-centric insights</span></span></p>\n<p><span class=\"fontsize-1-25em\">Nurses are at the forefront of patient care, providing them with a unique perspective on the challenges and opportunities within healthcare. Their daily interactions with patients enable them to identify areas for improvement and innovation, leading to the creation of medical devices that address specific needs and enhance the overall patient experience.</span></p>\n",
              "jcr:lastModified": "Thu Feb 08 2024 21:15:06 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        },
        "cols2_1_3_2_3_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Thu Jan 04 2024 15:50:15 GMT+0000",
          "jcr:lastModified": "Thu Jan 04 2024 15:50:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "standaloneimage": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-f123ca2978@example.invalid",
              "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
              "preset": "max_width_1440",
              "jcr:created": "Thu Jan 04 2024 15:50:21 GMT+0000",
              "alt": "Nurse looking at monitor on wall ",
              "srcFileRef": "/content/dam/stryker/acute-care/campaigns/nurse-innovation/nurse-looking-at-monitor-on-wall.jpeg",
              "borderColor": "rgba(76,125,122,1)",
              "jcr:lastModified": "Mon Mar 18 2024 14:05:57 GMT+0000",
              "sling:resourceType": "stryker/components/content/standaloneimage",
              "enableBorder": "false"
            }
          },
          "col2": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-f123ca2978@example.invalid",
              "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
              "jcr:created": "Thu Jan 04 2024 15:51:01 GMT+0000",
              "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Data collection and analysis</span></span><br>\n</p>\n<p><span class=\"fontsize-1-25em\">In an era of data-driven healthcare, nurses contribute significantly to the collection and analysis of health-related data. They are instrumental in monitoring patient outcomes, identifying trends and providing valuable feedback for refining and enhancing medical devices. This iterative feedback loop is essential for the continuous improvement of technology in healthcare.</span></p>\n",
              "jcr:lastModified": "Thu Feb 08 2024 21:15:31 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        },
