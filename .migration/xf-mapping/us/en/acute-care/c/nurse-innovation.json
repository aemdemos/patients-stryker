              "preset": "max_width_1440",
              "jcr:created": "Thu Jan 04 2024 15:50:21 GMT+0000",
              "alt": "Nurse talking with patient in bed",
              "srcFileRef": "/content/dam/stryker/acute-care/campaigns/nurse-innovation/male-nurse-takling-with-patient-in-a-bed.jpeg",
              "borderColor": "rgba(76,125,122,1)",
              "jcr:lastModified": "Mon Mar 18 2024 14:05:18 GMT+0000",
