              "ctaLinkType": "none",
              "ctaOpenInNewTabOverride": "0",
              "jcr:created": "Tue Mar 05 2024 16:42:21 GMT+0000",
              "CTAImageAltText": "nurses attending to patient",
              "jcr:lastModified": "Wed Aug 28 2024 13:41:44 GMT+0000",
              "sling:resourceType": "stryker/components/content/curatedcta",
              "CTAButtonColor": "rgba(76,125,122,1)",
              "CTAImageFileReference": "/content/dam/stryker/acute-care/news/2024-ana-innovation-award-winners/nurses-attending-to-patient_1380x773.jpg"
            },
            "text_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "user-f123ca2978@example.invalid",
              "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
              "jcr:created": "Wed Aug 28 2024 12:52:30 GMT+0000",
              "text": "<h3>Engaging Communities to Combat Social Determinants of Health and Racial Disparities</h3>\n<p>The ANA Innovation Awards highlight, recognize, and celebrate exemplary nurse innovators who improve patient safety and health outcomes within their communities.</p>\n<p><a href=\"https://author-stryker-prod.adobecqms.net/content/stryker/us/en/acute-care/news/2024-ana-innovation-award-winners.html\"><span class=\"standalone-link\">Learn more</span></a></p>\n",
              "jcr:lastModified": "Wed Aug 28 2024 13:46:41 GMT+0000",
