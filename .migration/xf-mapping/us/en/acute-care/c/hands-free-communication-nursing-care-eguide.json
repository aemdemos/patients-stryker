          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Thu Sep 10 2020 13:09:36 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span style=\"color: #1c5687;\"><span style=\"color: #4c7d7a;\"><span style=\"color: #000000;\"><span style=\"color: #ffb500;\"><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">The closer you are to the patient, the more you need your hands</span><sup>1</sup></span></span></span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">A nurse’s touch is essential to quality care—it comforts patients and connects clinicians to their purpose<sup>1</sup>. But as care environments grow more complex and digitized, preserving hands-on care is more critical than ever. Hands-free communication can help maintain the nurse-patient connection by enabling seamless collaboration across units and roles, without requiring clinicians to step away or reach for a device.&nbsp;</span></p>\n<p><span class=\"fontsize-1-25em\">This eGuide explores how four hospitals strengthened communication and coordination with our enterprise workflow platform—now featuring the hands-free Sync Badge. Discover how these facilities improved stroke and sepsis response, ED throughput, on-time surgical starts and more.&nbsp;</span></p>\n",
          "jcr:lastModified": "Mon Jun 16 2025 16:56:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
