            "jcr:created": "Tue Jul 20 2021 20:50:05 GMT+0000",
            "gradientDirection": "left-to-right",
            "line1": "<span class=\"fontsize-3vw\"><span class=\"futura-bold\">Unity Recliner Series Launch | 2023</span><br />\r\nWe’ve got the clinical edge</span>",
            "line2": "<p><span class=\"fontsize-1-5-vw\">Our new line of modern, durable and comfortable recliners were developed to meet the needs of both caregivers and patients to help aid in the recovery and treatment process. This line includes three different models (Value, Clinical and Treatment) with optional features and upgrades for all. Each model meets the highest standards of clinical efficacy and safety that our competitors in this market can’t match.</span></p>\r\n<p>&nbsp;</p>\r\n<p><span class=\"fontsize-1-5-vw\">These clinically focused recliners provide a safe, versatile solution that can be standardized throughout the continuum of care to help improve nursing workflow and patient comfort.</span></p>\r\n",
            "jcr:lastModified": "Fri Jul 28 2023 13:49:16 GMT+0000",
            "sling:resourceType": "stryker/components/content/largeheadline",
            "backgroundColor": "rgba(255,255,255,0)",
