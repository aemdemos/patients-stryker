      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_551469827": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Thu Jan 18 2024 17:29:28 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Care that connects</span></span></h2>\n<h4><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">From the field to the floor and everywhere in between&nbsp;</span></span></h4>\n<p><span class=\"fontsize-1-25em\">Care doesn’t start or stop at a department door.&nbsp;It moves from first response to recovery, from technology to touch, from urgency to everyday prevention. And when care is connected, teams can work efficiently, feel less burdened and support strong outcomes for patients and clinicians.</span></p>\n",
          "jcr:lastModified": "Fri Apr 17 2026 17:15:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Fri Jun 06 2025 20:56:32 GMT+0000",
      "jcr:lastModified": "Fri Jun 06 2025 20:56:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "preset": "max_width_1440",
          "alt": "Smart Hospital platform infographic showing connectivity in the emergency department between Stryker products",
          "srcFileRef": "/content/dam/stryker/smart-care/images/SmartHospital-Platform_SmartED_web-hero_1200x680.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Apr 17 2026 17:57:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1784218658": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">Many solutions. One purpose.</span></span></span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">Built for efficiency, continuity and alignment wherever care happens.</span></p>\n<p><span class=\"fontsize-1-25em\">Visit us at NTI for hands-on demos with our latest innovations, including <a href=\"/content/stryker/us/en/smart-care.html\">SmartHospital Platform</a>, <a href=\"/content/stryker/us/en/sage/c/hygh-tec-fecal-management.html\">hygh-tec drainage</a>, <a href=\"/content/stryker/us/en/emergency-care/products/lifepak-35.html\">LIFEPAK 35</a>, <a href=\"/content/stryker/us/en/acute-care/products/procuity.html\">ProCuity</a>, <a href=\"/content/stryker/us/en/emergency-care/products/lucas-3.html\">LUCAS</a>&nbsp;and more. See how our solutions are designed to connect across the continuum of care. When equipment, data and teams connect—workflows improve, caregiver burden eases and care teams are supported throughout the care journey.</span></p>\n",
          "jcr:lastModified": "Tue May 26 2026 15:06:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
