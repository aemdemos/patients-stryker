          "accordion_parsys14": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "accPosId": 14,
            "table_copy_copy": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:createdBy": "chris.kleckner@stryker.com",
              "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\r\n<tbody><tr><td><b>Action</b></td>\r\n<td><b>Voice Command</b><i> (examples in italics)</i></td>\r\n</tr><tr><td><p>Log in at your home site.</p>\r\n</td>\r\n<td><p>Press the Call button, say your first and last name when prompted.</p>\r\n</td>\r\n</tr><tr><td><p>Log in at a site you are visiting</p>\r\n</td>\r\n<td><p>1. Press the Call button, then wait to hear the login prompt.</p>\r\n<p>2. Connect to your home site: Connect to San Jose.</p>\r\n<p>3. Wait for the prompt, then say your name to log in: April Buckley.</p>\r\n</td>\r\n</tr><tr><td>Call a user at your current site.</td>\r\n<td><p>Call April Buckley.</p>\r\n</td>\r\n</tr><tr><td>Call a user at a remote site or any arbitrary site.*</td>\r\n<td><p>1. Connect to San Jose.</p>\r\n<p>2. Call April Buckley</p>\r\n</td>\r\n</tr></tbody></table>\r\n",
              "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
              "jcr:created": "Tue Aug 29 2023 20:12:47 GMT+0000",
              "jcr:lastModified": "Tue Aug 29 2023 20:20:31 GMT+0000",
