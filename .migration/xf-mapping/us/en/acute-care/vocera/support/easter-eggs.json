        "text_2049588629_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Thu Sep 07 2023 21:37:04 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><a href=\"https://www.stryker.com/us/en/acute-care/vocera/support.html\" title=\"Vocera Support home page\">Vocera Support</a>&nbsp;&gt; Vocera Easter Eggs</p>\n",
          "jcr:lastModified": "Tue Sep 19 2023 19:22:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Aug 29 2023 17:05:51 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\"></span><span class=\"fontsize-1-5em\">Vocera Easter Eggs</span></span></span></h1>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Easter eggs are secret messages or jokes intentionally hidden within software code. The name borrows from the holiday ritual of Easter egg hunts, where children hunt for eggs that often contain surprises and treasures.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Users of the&nbsp;Vocera Badge&nbsp;can invoke Easter eggs by using certain&nbsp;<a title=\"Got to Vocera Voice Commands\" href=\"/content/stryker/us/en/acute-care/vocera/support/voice-commands.html\">commands</a>. We’ve seen customers use them to defuse tension, to distract or calm children, or to just have fun.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">To access an Easter egg, press the Call button of the Vocera Badge and say the command in the same way you would any other command.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Below are some of the more popular Easter Egg commands.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Tue Sep 19 2023 16:25:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "3"
        }
      }
    },
    "cols2_2_3_1_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Aug 29 2023 20:36:44 GMT+0000",
      "jcr:lastModified": "Tue Aug 29 2023 20:36:44 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "table": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\r\n<tbody><tr><td>Commands</td>\r\n<td>The Genie Says...</td>\r\n<td> </td>\r\n</tr><tr><td><p>Call Captain Kirk </p>\r\n</td>\r\n<td><p>Captain Kirk is busy in another Galaxy at the moment!</p>\r\n</td>\r\n<td> </td>\r\n</tr><tr><td><p>Make it so</p>\r\n</td>\r\n<td><p>OK, I made it but you will have to unmake it!</p>\r\n</td>\r\n<td> </td>\r\n</tr><tr><td><p>Beam me up! </p>\r\n</td>\r\n<td><p>Sorry the transporter feature is still under development.</p>\r\n</td>\r\n<td> </td>\r\n</tr><tr><td><p>Beam me down! </p>\r\n</td>\r\n<td><p>I don't think I can do that!</p>\r\n</td>\r\n<td> </td>\r\n</tr><tr><td><p>Goodbye</p>\r\n</td>\r\n<td><p>Live long and prosper!</p>\r\n</td>\r\n<td> </td>\r\n</tr><tr><td><p>I’m having a bad day</p>\r\n</td>\r\n<td>&quot;Take a deep breath and know that you are helping to save a life today.&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>My Vocera is broken</p>\r\n</td>\r\n<td>&quot;Are you sure it’s not your wireless or the way you are holding your badge.&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>Genie, I have a wish *</p>\r\n</td>\r\n<td>&quot;Your wish is my command.&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>Genie, obey my commands</p>\r\n</td>\r\n<td>&quot;First you must follow my rules!&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>Santa Claus</p>\r\n</td>\r\n<td>&quot;Ho Ho Ho, Santa hopes you feel better.&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>Mrs. Claus</p>\r\n</td>\r\n<td>&quot;Santa is watching you, be brave.&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>Easter Bunny *</p>\r\n</td>\r\n<td>&quot;Hopping you feel better.&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>I need a hug</p>\r\n</td>\r\n<td>&quot;Warm fuzzies coming your way.&quot; </td>\r\n<td> </td>\r\n</tr><tr><td><p>Houston, we have a problem</p>\r\n</td>\r\n<td>&quot;Keep calm, and call a super hero.&quot; </td>\r\n<td> </td>\r\n</tr></tbody></table>\r\n",
          "description": "Below are some of the more popular Easter Egg commands. ",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Tue Aug 29 2023 17:09:59 GMT+0000",
          "title": "Command Reference",
          "jcr:lastModified": "Tue Aug 29 2023 17:11:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/table",
          "mobileDesign": "true",
          "textIsRich": "true"
        }
      },
