          "jcr:created": "Tue Nov 16 2021 20:11:51 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Vocera University</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Vocera University offers a hands-on, interactive educational experiences through classroom training, distance learning and customized courseware. Training courses are provided for systems administrators, IT professionals, as well as industry-specific, end-user educators.</span></span></p>\n",
          "jcr:lastModified": "Fri Sep 01 2023 16:25:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
