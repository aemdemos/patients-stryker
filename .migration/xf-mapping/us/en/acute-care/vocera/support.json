          "gradientDirection": "left-to-right",
          "text": "<p><span style=\"font-size: 28px;\"><b><span class=\"futura-bold\">Voice commands reference</span></b></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">The Vocera Platform offers the ability to call by name, group or role from a range of devices including iPhone and Android smartphones, and the Vocera hands-free wearable Badge. Below you will find a list of the top voice commands commonly used by Vocera customers.</span></span></p>\n",
          "jcr:lastModified": "Tue Sep 26 2023 14:19:44 GMT+0000",
