      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "text": "<h2>Strategies for Reducing Falls in the ED</h2>\n<p><span class=\"fontsize-1-25em\">As more and more patients enter the hospital through the ED, emergency nurses are not only tasked with saving lives in emergencies – but they’re also responsible for keeping patients safe from adverse outcomes such as falls. In this educational webinar we will share eye-opening statistics, discuss human and financial costs of falls, identify risk factors and interventions, and focus on evidence-based practices in the utilization of technology for prevention of patient falls.</span></p>\n<p><span class=\"standalone-link\"><a href=\"https://www.stryker.com/us/en/acute-care/c/strategies-for-reducing-falls-in-the-ed.html\" title=\"Learn more about Strategies for reducing falls in the ED\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Mon Mar 18 2024 13:54:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
