          "hideComponent": "false",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2>Leading the Digital Shift: Nurse Executives Driving the Future of Care</h2>\n<p><span class=\"fontsize-1-25em\">Healthcare is experiencing a digital shift, and nurse executives are critical to its success. This webinar will feature a fireside chat with nursing leaders who are guiding organizations through change. Topics include integrating new technologies, preparing the workforce and addressing equity and ethics in digital adoption. Participants will gain insights into practical strategies, leadership priorities and what the future of digital care looks like for nursing.</span></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/acute-care/c/leading-the-digital-shift-nurse-executives-driving-future-care.html\" target=\"_blank\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Wed May 13 2026 17:43:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "3"
        }
      },
