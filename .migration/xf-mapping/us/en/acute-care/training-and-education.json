          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2>EmpowerED to Care: Safe Patient Handling &amp; Nurse Protection in the ED</h2>\n<p><span class=\"fontsize-1-25em\">Nurse safety is often discussed at a high level – across entire hospitals or the profession. This course will focus on the unique safety risks nurses face in the Emergency Department, including the cost of unsafe environments. Participants will review recommendations for safe patient handling, violence prevention, and explore best practices and technologies that help support nurse safety in the ED.</span></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/acute-care/c/empowered-to-care-safe-patient-handling-and-nurse-protection.html\" target=\"_blank\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Sun Apr 05 2026 12:03:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "3"
        }
      },
