      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "text": "<h2>Reclaiming time for care: The future of human-centered workflows in healthcare</h2>\n<p><span class=\"fontsize-1-25em\">Today’s healthcare environment is inundated with devices and systems, often leading to alarm fatigue and increased administrative burdens for nurses. This webinar will delve into the challenges faced by nurses, such as excessive documentation and lack of connected devices, and propose a vision for a future where technology empowers nurses to deliver exceptional patient care.</span></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/acute-care/c/reclaiming-time-for-care-human-centered-workflows-in-healthcare.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Fri Sep 26 2025 13:55:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
