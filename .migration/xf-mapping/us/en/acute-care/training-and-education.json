          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Feb 06 2024 23:11:48 GMT+0000",
          "text": "<h2>Applying technology to fall prevention</h2>\n<p><span class=\"fontsize-1-25em\">This course will focus on evidence-based practices in the utilization of technology for prevention of patient falls and injury management. Participants will be introduced to patient bed technologies and wireless features and learn how the key components of a patient’s bed enable clinical success in reducing patient falls and injury from falls.</span></p>\n<p><span class=\"standalone-link\"><a href=\"/content/stryker/us/en/acute-care/c/applying-technology-to-fall-prevention.html\">Learn more</a></span></p>\n",
          "jcr:lastModified": "Fri Sep 26 2025 13:54:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
