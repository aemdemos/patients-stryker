          "jcr:created": "Fri Jul 26 2024 20:08:40 GMT+0000",
          "alt": "ProClinical can help turn healthcare data into actionable insights",
          "srcFileRef": "/content/dam/stryker/acute-care/proclinical/images/proclinical_actionalable-data-screen_secondary-hero_1200x680.jpg",
          "borderColor": "rgba(76,125,122,1)",
