        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Targeted solutions</span></span></span></h3>\n<p><span class=\"fontsize-1-25em\">Drive sustainable, improved outcomes supported by our team of clinical experts that will collaborate and develop goals and review protocols and practices with you.</span></p>\n",
