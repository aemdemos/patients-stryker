        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Turning data into action</span></span></span></h3>\n<p><span class=\"fontsize-1-25em\">There’s plenty of data in healthcare, but meaningful, relevant and timely data is hard to come by. ProClinical’s sophisticated tools collect key information efficiently and our dashboard translates data into viewable, understandable and actionable insights that empower improvement.</span></p>\n",
          "jcr:lastModified": "Tue Jul 30 2024 21:29:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
