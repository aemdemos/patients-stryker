          "jcr:created": "Wed Aug 20 2025 13:26:02 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Embedded. Invested. Empowering your system.</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Technology only works if it works for you. That’s where ProAssure comes in. Our ProAssure specialists work with your team, either remotely or on site, to help maintain, enhance and support your Vocera solution. From software updates and user training to inventory management and utilization reporting, ProAssure helps take the pressure off your system administrators and protects the performance of your system.</span></p>\n",
          "jcr:lastModified": "Thu Oct 02 2025 16:10:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
