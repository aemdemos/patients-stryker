      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Thu Feb 22 2024 14:15:10 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Convenient. Complete. Effective.</span></span></h2>\n<p><span class=\"fontsize-1-25em\">The SPR Plus Overlay combines three layers of interlocking air cells to create a contoured support surface with low air loss microvents throughout to help minimize moisture buildup and manage the patient microclimate.&nbsp;Air-channeling technology redistributes a patient’s weight to reduce tissue interface pressure</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Protects sensitive bony prominences susceptible to pressure injuries</span></li>\n<li><span class=\"fontsize-1-25em\">Direct low air loss vents to help manage patient’s microclimate</span></li>\n<li><span class=\"fontsize-1-25em\">Lightweight, waterproof and easy to clean</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Feb 22 2024 14:16:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
