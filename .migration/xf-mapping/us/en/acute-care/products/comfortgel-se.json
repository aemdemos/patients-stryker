          "preset": "max_width_1440",
          "jcr:created": "Fri Feb 28 2020 19:08:04 GMT+0000",
          "alt": "ComfortGel SE hospital strectcher support surface ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/comfortgelse/images/ComfortGelSE_BigWheel_small.jpg",
          "jcr:lastModified": "Wed Jun 19 2024 17:09:13 GMT+0000",
