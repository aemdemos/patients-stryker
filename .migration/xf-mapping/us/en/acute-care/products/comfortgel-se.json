      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Marissa.DeBruyn@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 02 2018 16:27:35 GMT+0000",
          "text": "<h3><span style=\"color: #323232;\"><span style=\"color: #ffb500;\"><span class=\"futura-bold\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">Bringing preventative cover features to the surface.</span></span></span></span></span></h3>\n<p><span class=\"fontsize-1-25em\">In line with our commitment to aiding in proactive prevention, we designed the cover of ComfortGel SE with specialized features intended to make it more durable and effective at infection control.</span></p>\n<p><span class=\"fontsize-1-25em\">It was engineered for ease of use, especially during the maintenance and care process.&nbsp;Its cover is made with Dartex for increased chemical resistance.</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:57:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text": {
