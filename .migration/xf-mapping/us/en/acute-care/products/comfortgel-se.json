          "jcr:created": "Fri Feb 28 2020 17:59:19 GMT+0000",
          "alt": "ComfortGel SE includes a sloped heel section to help reduce the risk of skin breakdown on the heel. ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/comfortgelse/images/SE_ComfortGel_SF2_SlopedHeel1.jpg",
          "jcr:lastModified": "Wed Jun 19 2024 17:11:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Sloped heel section</span><span class=\"urw-egyptienne\"><br>\n</span></span></h3>\n<p><span class=\"fontsize-1-25em\">ComfortGel SE features a sloped heel section to further address our commitment to pressure injury prevention by helping reduce the risk of heel breakdown.</span><br>\n</p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:55:52 GMT+0000",
