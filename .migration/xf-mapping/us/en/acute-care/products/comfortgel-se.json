          "jcr:created": "Mon Oct 08 2018 15:44:07 GMT+0000",
          "alt": "Hospital gel support surface includes a specialized mattress cover made with Dartex.",
          "srcFileRef": "/content/dam/stryker/acute-care/products/comfortgelse/images/ComfortGelSE_cover_story_visual-2.jpg",
          "jcr:lastModified": "Wed Jun 19 2024 17:13:10 GMT+0000",
