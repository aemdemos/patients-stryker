        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "eleni.maistrellis@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Apr 24 2020 01:37:57 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">CoreGel Technology**</span><br>\n</span></h3>\n<p><span class=\"fontsize-1-25em\">Located in the sacral region, CoreGel creates a positioning pocket to help prevent patient migration<sup>1</sup>. Its design helps absorb and disperse patient weight to aid in pressure redistribution.</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:53:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
