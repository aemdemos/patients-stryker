        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Experience gel technology.</span></span></h3>\n<p><span class=\"fontsize-1-25em\">When we developed the SE series of stretcher surfaces, we focused our innovative design on aiding in proactive prevention.</span></p>\n<p><span class=\"fontsize-1-25em\">ComfortGel SE's incorporation of gel provides immersion – meaning the surface can effectively absorb and redistribute patient weight for added protection and pressure injury prevention.</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:52:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2056626090_cop": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "garrett.shue@stryker.com",
      "jcr:lastModifiedBy": "garrett.shue@stryker.com",
      "jcr:created": "Fri Feb 28 2020 19:08:45 GMT+0000",
      "jcr:lastModified": "Fri Feb 28 2020 19:08:45 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "garrett.shue@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Feb 28 2020 19:08:04 GMT+0000",
          "alt": "ComfortGel SE includes CoreGel and a sloped heel section ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/comfortgelse/images/SE_ComfortGel_LF2_Innovation.jpg",
          "jcr:lastModified": "Wed Jun 19 2024 17:10:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Innovation. Inside and out.</span></span></h3>\n<p><span class=\"fontsize-1-25em\">It’s true: Pressure injuries can begin in as little as the first two hours* of a patient’s admittance into a clinical setting. They pose a serious threat and should be treated as such.</span></p>\n<p><span class=\"fontsize-1-25em\">With the severity of pressure injuries in mind, we designed ComfortGel SE with specific features to aid in treatment and prevention. Most important of these features, is gel.</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:52:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "eleni.maistrellis@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Apr 24 2020 01:08:08 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b>A</b> CoreGel<br>\n <b>B</b> Sloped heel section</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:53:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
