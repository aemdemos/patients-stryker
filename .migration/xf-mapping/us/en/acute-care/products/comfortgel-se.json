          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Apr 24 2020 01:29:40 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b>A</b> Welded seams<br>\n <b>B</b> Three-sided zipper</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:58:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
