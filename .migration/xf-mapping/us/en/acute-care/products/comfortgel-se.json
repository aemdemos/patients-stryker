          "preset": "max_width_1440",
          "jcr:created": "Fri Feb 28 2020 17:59:19 GMT+0000",
          "alt": "CoreGel technology creates a positioning pocket to aid in pressure redistribution",
          "srcFileRef": "/content/dam/stryker/acute-care/products/comfortgelse/images/SE_ComfortGel_SF1_CoreGel1.jpg",
          "jcr:lastModified": "Wed Jun 19 2024 17:10:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
