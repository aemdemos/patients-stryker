        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">SofCare Manual Hand Pump</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The SofCare Manual Hand Pump is a non-powered inflation device that can go home with the patient.</span></p>\n",
          "jcr:lastModified": "Tue Feb 20 2024 20:24:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Mar 03 2020 21:15:03 GMT+0000",
          "alt": "Stryker's SofCare 3-layer air-channeling technology to help prevent pressure injuries ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/sofcareoverlay/images/PC_SofCareOverlay_LF1_3Layer.jpg",
          "jcr:lastModified": "Fri Feb 23 2024 17:39:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Pressure Management with 3-Layer Technology</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The unique 3-layer air-channeling technology creates interlocking air cells to immerse and envelop the patient, providing low tissue interface pressure. The 3-layer design provides total air support, which helps to prevent bottoming out, because the patient is always supported by a pocket of air.</span></p>\n",
          "jcr:lastModified": "Tue Feb 20 2024 20:24:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
