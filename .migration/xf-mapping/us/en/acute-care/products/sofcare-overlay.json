          "preset": "max_width_1440",
          "jcr:created": "Tue Mar 03 2020 21:15:03 GMT+0000",
          "alt": "Stryker's SofCare manual hand pump ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/sofcareoverlay/images/PC_SofCareOverlay_SmF3_ManualPump.jpg",
          "jcr:lastModified": "Fri Feb 23 2024 17:38:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
