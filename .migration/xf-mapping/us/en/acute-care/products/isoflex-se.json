          "jcr:created": "Tue Oct 02 2018 16:23:24 GMT+0000",
          "alt": "ShearGel technology",
          "srcFileRef": "/content/dam/stryker/acute-care/products/isoflexse/images/SE_IsoFlex_SF1_ShearGel.jpg",
