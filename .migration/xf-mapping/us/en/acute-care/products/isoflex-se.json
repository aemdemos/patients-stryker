          "jcr:created": "Tue Oct 02 2018 16:06:05 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Slip-resistant bottom</span></span></h3>\n<p><span class=\"fontsize-1-25em\">IsoFlex SE features a slip-resistant bottom to help improve infection prevention through the elimination of Velcro while maintaining affixation to the stretcher during patient movement and transfers.</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 16:51:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
