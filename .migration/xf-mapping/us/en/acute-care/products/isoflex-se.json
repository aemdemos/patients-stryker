          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\">Our cover story</span></span></span></h2>\n",
          "jcr:lastModified": "Thu Jun 20 2024 14:57:08 GMT+0000",
