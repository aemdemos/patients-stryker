          "alt": "CoreGel Technology",
          "srcFileRef": "/content/dam/stryker/acute-care/products/isoflexse/images/SE_IsoFlex_SF2_CoreGel.jpg",
          "jcr:lastModified": "Mon Oct 08 2018 15:43:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-82a520efa4@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 02 2018 16:06:05 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">CoreGel Technology**</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Located in the sacral region, CoreGel creates a positioning pocket to help prevent patient migration1. Its design helps absorb and redistribute patient weight to aid in pressure redistribution.</span></p>\n",
          "jcr:lastModified": "Thu Jun 20 2024 16:54:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
