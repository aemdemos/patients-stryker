          "jcr:createdBy": "user-82a520efa4@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Tue Oct 02 2018 16:06:05 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Welded seams</span></span></h3>\n<p><span class=\"fontsize-1-25em\">IsoFlex SE features RF welded seams that utilize electromagnetic bonding to limit fluid ingress and infiltration.</span></p>\n",
