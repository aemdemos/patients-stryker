          "jcr:created": "Wed Feb 21 2024 19:20:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Early patient mobility</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Long-term patient immobility can potentially have negative effects on a patient’s&nbsp;recovery and overall health. TruRize helps to promote early patient mobility by supporting the patient to a standing position.</span></p>\n",
          "jcr:lastModified": "Wed Feb 21 2024 19:21:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
