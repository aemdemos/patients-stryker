        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Feb 05 2024 14:18:52 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Image Quality. Access. Versatility.</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Our Prime X X-ray Stretcher, utilizing ClearView Technology in a dual-deck design, offers a similar image quality to an X-ray table with the convenience and efficiency of a mobile platform.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Advanced mobility options: Big Wheel or Zoom Motorized Drive System</span></li>\n<li><span class=\"fontsize-1-25em\">Electric powered base and lift</span></li>\n<li><span class=\"fontsize-1-25em\">Integrated scale</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Feb 05 2024 14:20:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
