          "jcr:created": "Fri Feb 28 2020 17:59:19 GMT+0000",
          "alt": "Exclusive ClearView technology offers image quality comparabel to traditional X-ray tables",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primexx-ray/images/PH_TPPX_SmF2_CvTech1.jpg",
