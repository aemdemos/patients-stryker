          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/stretchers.html\">Stretchers and transport chairs</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/stretchers/emergency-and-transport-stretchers.html\">Emergency and transport stretchers</a></p>\n",
          "jcr:lastModified": "Mon Feb 05 2024 14:18:45 GMT+0000",
