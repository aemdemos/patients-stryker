          "jcr:created": "Fri Feb 28 2020 17:59:19 GMT+0000",
          "alt": "Prime X x-ray stretcher includes easy cleaning ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primexx-ray/images/PH_TPPX_SmF5_Cleanability.jpg",
