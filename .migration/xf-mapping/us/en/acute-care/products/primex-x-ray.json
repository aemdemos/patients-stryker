          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Glideaway siderails</span></span></h3>\n<p><span class=\"fontsize-1-25em\">These siderails offer maximum patient security when raised, yet are completely out of the way when lowered, to ensure zero transfer gap.</span></p>\n",
          "jcr:lastModified": "Mon Feb 05 2024 14:52:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
