          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Feb 21 2024 15:19:48 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Access. Simple. Functionality.</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Our Eye Surgery Stretcher offers maximum headend clearance, giving surgeons ample leg room to maneuver while performing delicate eye procedures. The reliable work surface and mobile design combine to help with surgical throughput.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Enhanced head end clearance</span></li>\n<li><span class=\"fontsize-1-25em\">Retractable fifth wheel</span></li>\n<li><span class=\"fontsize-1-25em\">Metal tooth and groove braking system</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Feb 21 2024 15:20:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
