          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Thu Oct 12 2023 20:09:33 GMT+0000",
          "text": "<h2>Key features</h2>\n<ul>\n<li>Reduce clinician interruptions: Identify the frequency and sources of interruptions from phone calls, broadcasts, texts, notifications, alarms, and alerts.</li>\n<li>More effectively manage clinical communication workflows and processes: Pinpoint issues or gaps in call flows and workflows to identify areas that need to be adjusted. Identify delays in response to alerts, alarms, and code calls and optimize escalation paths</li>\n<li>Identify root causes of sentinel events faster: See the full picture of interplaying factors in one place, rather than compiling information from multiple systems.</li>\n<li>Proactively identify infrastructure issues: Spot potential software and hardware issues in near-real time.</li>\n<li>Optimize usage and adoption of Vocera technology and help demonstrate ROI: Track usage trends for all Vocera software and traffic from clinical and operational systems integrated with the Vocera Platform.</li>\n</ul>\n",
          "jcr:lastModified": "Thu Oct 12 2023 20:10:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
