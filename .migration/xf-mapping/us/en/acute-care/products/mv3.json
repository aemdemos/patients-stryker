      "sling:resourceType": "stryker/components/content/columncontrol/cols4",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Oct 25 2019 13:27:18 GMT+0000",
          "alt": "MV3 helps keep your patients safe and secure during their hospital stay with low bed height",
          "srcFileRef": "/content/dam/stryker/acute-care/products/mv3/images/MV3_800x500_Lowbedheight.png",
          "jcr:lastModified": "Mon Nov 07 2022 16:22:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Oct 25 2019 13:18:55 GMT+0000",
          "text": "<h3><span class=\"futura-bold\">Promotes fall prevention</span></h3>\n<p><span class=\"fontsize-1-25em\">Featuring advanced fall prevention technologies like our exclusive iBed Awareness exit system and a low height of 12 inches, MV3 helps keep your patients safe and secure during their hospital stay.</span></p>\n",
          "jcr:lastModified": "Mon Nov 18 2024 22:09:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Oct 25 2019 13:27:18 GMT+0000",
          "alt": "MV3 can accommodate bariatric patients up to 1,102 pounds safe working load",
          "srcFileRef": "/content/dam/stryker/acute-care/products/mv3/images/Image 2_300x300.jpg",
          "jcr:lastModified": "Mon Nov 07 2022 16:23:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_1268259589": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Oct 25 2019 13:18:55 GMT+0000",
          "text": "<h3><span class=\"futura-bold\">Safely accommodates patients of various sizes&nbsp;</span></h3>\n<p><span class=\"fontsize-1-25em\">MV3 can accommodate up to 1,102 pounds safe working load – beating the industry standard by 100 lbs.<sup>2</sup>&nbsp;– and features an adjustable litter deck that expands to three widths: 36”/42”/48&quot;.</span></p>\n",
          "jcr:lastModified": "Mon Nov 18 2024 22:09:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Oct 25 2019 13:27:18 GMT+0000",
          "alt": "Stryker's MV3 bariatric hospital bed has an aesthetically-pleasing design",
          "srcFileRef": "/content/dam/stryker/acute-care/products/mv3/images/20190524-Stryker_MV3xBariMat-1.png",
          "jcr:lastModified": "Mon Nov 07 2022 16:25:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Oct 25 2019 13:18:55 GMT+0000",
          "text": "<h3><span class=\"futura-bold\">Designed with dignity in mind</span></h3>\n<p><span class=\"fontsize-1-25em\">With its aesthetically-pleasing design, MV3 looks and feels like the rest of our fleet – helping to preserve the dignity of bariatric patients.&nbsp;</span></p>\n",
          "jcr:lastModified": "Mon Nov 18 2024 22:10:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Oct 25 2019 13:27:18 GMT+0000",
          "alt": "MV3 bariatric bed encourages independence with a multi-handle patient helper",
          "srcFileRef": "/content/dam/stryker/acute-care/products/mv3/images/encourage.jpg",
          "jcr:lastModified": "Mon Nov 07 2022 16:27:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Oct 25 2019 13:18:55 GMT+0000",
          "text": "<h3><span class=\"futura-bold\">Encourages independence</span></h3>\n<p><span class=\"fontsize-1-25em\">MV3’s multi-pivotal patient helper is an optional accessory intended to help patients of size reposition themselves in bed and to the edge of the bed.</span></p>\n",
          "jcr:lastModified": "Mon Nov 18 2024 22:10:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
