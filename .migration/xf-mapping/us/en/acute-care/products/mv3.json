        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Oct 25 2019 18:00:58 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Boost your ROI with MV3</span></span></h3>\n<p><span class=\"fontsize-1-25em\">MV3 is more than a bariatric bed frame —it’s a smart, long-term investment. Eliminating the need to rent a bariatric bed every time a patient of size arrives at your facility, MV3 is ready for your patient.</span></p>\n",
          "jcr:lastModified": "Mon Nov 18 2024 22:05:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "brittany.brady@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Oct 25 2019 18:00:40 GMT+0000",
          "alt": "Stryker’s Financial Guarantee Program for MV3",
          "srcFileRef": "/content/dam/stryker/acute-care/products/mv3/images/Guarantee-image.jpg",
          "jcr:lastModified": "Mon Nov 07 2022 16:37:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Oct 25 2019 18:00:58 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Stryker’s Financial Guarantee Program</span></span></h3>\n<p><span class=\"fontsize-1-25em\">That’s why we’re willing to share the risk with you – by guaranteeing a 30% reduction in bed-related falls occurring on our beds with a combination of our bed exit system and falls-education training. If a 30% reduction is not met, Stryker will pay back a portion of the cost of the product.*</span></p>\n",
          "jcr:lastModified": "Mon Nov 18 2024 22:05:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
