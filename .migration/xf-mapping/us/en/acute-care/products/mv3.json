      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1516447756_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "4",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "hideComponent": "false",
          "topMargin": "12",
          "jcr:created": "Tue Dec 10 2019 15:17:18 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Between 1975 and 2018, worldwide obesity nearly</span>&nbsp;<span class=\"futura-bold\">tripled</span><sup>1</sup></span></p>\n<p><span class=\"fontsize-1-75em\">&nbsp;</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Nearly</span>&nbsp;<span class=\"futura-bold\">40%</span><span class=\"urw-egyptienne\">&nbsp;of americans are obese<sup>3</sup></span></span></p>\n<p><span class=\"fontsize-1-75em\">&nbsp;</span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">By 2030, it's estimated that&nbsp;</span><span class=\"futura-bold\">50%</span><span class=\"urw-egyptienne\">&nbsp;of the population will be obese<sup>3</sup></span></span></p>\n",
          "jcr:lastModified": "Mon Nov 18 2024 22:19:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
