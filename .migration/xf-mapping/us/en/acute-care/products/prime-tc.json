          "alt": "Three hospital patient transport wheelchairs nested together to save valuable space ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/PH_TPTC_SmF1_Nesting1.jpg",
          "jcr:lastModified": "Thu Nov 16 2023 16:19:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Rigid, nestable frame</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The rigid frame of the Prime TC helps prevent theft, while the nesting design helps save valuable space throughout the facility. Prime TC has undergone rigorous life cycle testing to ensure that it will stand the test of time.</span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:54:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
