          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">One-touch central brake</span></span></h3>\n<p><span class=\"fontsize-1-25em\">This brake enhances caregiver efficiency and is foot-operated to help reduce bending and reaching. Enclosed mechanics protect the braking system from varying climates, while integrated anti-tip wheels increase safety.</span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:55:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
