          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Upright oxygen bottle holder</span></span></h3>\n<p><span class=\"fontsize-1-25em\">This holder minimizes the bending and lifting required to place a heavy O2 tank underneath the chair.</span></p>\n",
          "jcr:lastModified": "Tue Sep 24 2024 17:51:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
