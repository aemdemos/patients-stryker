          "alt": "Upright oxygen bottle on the back of a Prime TC hospital transport chair ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/PH_TPTC_SmF3_O2Tank-2.jpg",
          "jcr:lastModified": "Thu Nov 16 2023 16:19:50 GMT+0000",
