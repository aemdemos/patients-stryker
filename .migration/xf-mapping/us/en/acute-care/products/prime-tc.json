          "alt": "A nurses uses the BackSmart push handles on the Prime TC hospital transport wheelchair",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/prime-tc-push-handles.jpg",
          "jcr:lastModified": "Tue Oct 15 2024 15:58:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_1647507244": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">BackSmart push handles</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Upright, extended handles allow caregivers to position their elbows at an ergonomic 90-degree angle during transport and accommodate caregivers of virtually any height.</span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:56:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
