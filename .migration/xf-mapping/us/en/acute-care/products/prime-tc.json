          "preset": "max_width_1440",
          "jcr:created": "Fri Feb 28 2020 17:59:19 GMT+0000",
          "alt": "Top down view of the Prime TC patient transport chair ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/PH_TPTC_LF1_Seamless1.jpg",
          "jcr:lastModified": "Tue May 09 2023 15:07:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Long-lasting, seamless design</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Molded plastic and powder-coated steel eliminate fabric rips and reduce the risk of rust that can be difficult to clean and often harbors infectious bacteria. A simple, power-washable frame makes cleaning quick and easy.</span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:56:35 GMT+0000",
