          "alt": "Upright footrests provide a clear path to help reduce trip hazards",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/PH_TPTC_LF2_Footrests1.jpg",
          "jcr:lastModified": "Tue May 09 2023 14:58:03 GMT+0000",
