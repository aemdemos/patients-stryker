          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Feb 28 2020 19:08:04 GMT+0000",
          "alt": "Patient using the stand assist armrests on the Prime TC transport chair ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/PH_TPTC_LF4_StandAssist1.jpg",
          "jcr:lastModified": "Tue May 09 2023 14:22:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Stand assist armrests</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Uniquely designed, these armrests feature a raised and extended touchpoint for patients during ingress and egress to encourage nose-over-toes positioning. Armrests fold back easily for better patient access.</span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:55:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
