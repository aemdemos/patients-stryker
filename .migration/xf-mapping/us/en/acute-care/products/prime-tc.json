          "alt": "A nurse engages the one-touch central brake on the Prime TC transport wheelchair",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/PH_TPTC_LF5_Brake1.jpg",
          "jcr:lastModified": "Thu Nov 16 2023 16:20:05 GMT+0000",
