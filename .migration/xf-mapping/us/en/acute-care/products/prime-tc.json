          "preset": "max_width_1440",
          "jcr:created": "Fri Feb 28 2020 17:59:19 GMT+0000",
          "alt": "Patient is transported around a hospital on the Prime TC hospital wheelchair ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/primetc/images/PH_TPTC_LF6_BigWheel1.jpg",
          "jcr:lastModified": "Thu Nov 16 2023 16:19:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-c26bb7a766@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Big Wheel maneuverability</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The Prime TC utilizes innovation from Stryker stretchers to help ease cornering and steering of patients up to 500 pounds.</span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:54:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
