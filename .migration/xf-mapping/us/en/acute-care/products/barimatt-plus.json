        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7a617b9e44@example.invalid",
          "jcr:lastModifiedBy": "user-7a617b9e44@example.invalid",
          "jcr:created": "Thu Jun 20 2024 15:18:37 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The BariMatt Plus provides care for a wide range of patients. The versatile surface configurations allow for the surface to be customized to each individual patient with foam bolster inserts. The seamless cover helps to minimize infection control issues while the visco-elastic foam maximizes patient comfort.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">1000 lb weight capacity&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Visco-elastic foam</span></li>\n<li><span class=\"fontsize-1-25em\">Four size conversions&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Seamless sleeves for insertion of bolsters to main surfaceCustomizable width and length</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Jun 20 2024 15:19:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
