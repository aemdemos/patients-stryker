          "jcr:created": "Fri Feb 09 2024 17:59:31 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Versatile. Simple. Compact.</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Ideal for surgery centers and small spaces, our stretcher chair maximizes patient throughput without compromising patient care. Choose optimal positioning from horizontal to upright to achieve exceptional performance and patient comfort.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">All the benefits of the standard stretcher chair plus a dual-articulation, enhanced clearance headpiece for surgical positioning</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Feb 09 2024 18:06:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
