        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 1,
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Sep 11 2024 20:41:58 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The LD304 hospital birthing bed has a height range to litter top of 17.5&quot; (44 cm) to 35.5&quot; (90 cm).</span></p>\n",
          "jcr:lastModified": "Wed Sep 11 2024 20:43:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Sep 11 2024 20:41:58 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The seat depth is 12.5&quot; (32 cm) to 8.5&quot; (22 cm) with the patented Skoocher technology.</span></p>\n",
          "jcr:lastModified": "Wed Sep 11 2024 20:43:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 3,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Sep 11 2024 20:41:58 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">The lift capacity of the bed section is 500 lbs (226.7 kg), and the foot section has a lift capacity of 300 lbs (136.0 kg).</span></p>\n",
          "jcr:lastModified": "Wed Sep 11 2024 20:44:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "accordion_parsys4": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 4,
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Wed Sep 11 2024 20:41:58 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\">There is a two year parts and labor warranty for the LD304.</span></p>\n",
          "jcr:lastModified": "Wed Sep 11 2024 20:45:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
