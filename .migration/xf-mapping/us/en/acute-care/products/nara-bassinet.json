          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span style=\"color: #1c5687;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">A hospital bassinet designed for closeness</span></span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">Nära's simple, safe design helps mothers stay close to their newborns, during the time when closeness matters most. The narrow cabinet design helps to promote mother-to-infant closeness from the bedside.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Sep 24 2024 17:36:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
