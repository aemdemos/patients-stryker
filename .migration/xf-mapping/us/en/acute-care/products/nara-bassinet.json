          "jcr:created": "Mon Sep 16 2024 15:26:46 GMT+0000",
          "text": "<p><a href=\"https://techweb.stryker.com/\" target=\"_blank\"><span class=\"standalone-link\">Operations and maintenance manuals</span></a><br>\n</p>\n",
