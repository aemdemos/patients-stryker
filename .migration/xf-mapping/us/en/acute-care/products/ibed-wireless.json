          "preset": "max_width_1440",
          "jcr:created": "Tue Aug 29 2023 14:09:38 GMT+0000",
          "alt": "Stryker's ProCare Services provides preventative maintenance plans for your hospital equipment",
          "srcFileRef": "/content/dam/stryker/acute-care/products/procuity/images/2023-update/procare-services-2550x750.jpg",
          "borderColor": "rgb(178,180,174)",
