    "cols": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Fri Feb 02 2024 17:08:49 GMT+0000",
      "jcr:lastModified": "Fri Feb 02 2024 17:08:49 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Fri Feb 02 2024 17:01:52 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Innovation that <span style=\"color: #ffb500;\">empowers outcomes</span></span></span></h2>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">With nurses caring for more patients than ever before, the demands upon them have only increased. We offer caregivers connected and confident care at their fingertips.</span></span></p>\n<p><span class=\"fontsize-1-25em\">Available with Stryker's Prime Connect stretchers, ProCuity bed series, S3 MedSurg and InTouch Critical Care beds, our connected solutions are compatible with most healthcare information management systems, allowing your facility to build a custom end solution. Our connected solutions were designed to help support patient fall prevention protocols*, simplify workflows and enhance patient safety. We can wirelessly communicate hospital bed data, hospital stretcher data and priority alerts to caregivers when they can’t be at the patient’s side.<sup>1</sup>&nbsp;At the heart of our system is iBed Wireless-the enabling technology that allows us to bring these solutions to your healthcare facility.</span></p>\n",
          "jcr:lastModified": "Fri Sep 05 2025 15:12:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "brittany.brady@stryker.com",
      "jcr:lastModifiedBy": "brittany.brady@stryker.com",
      "jcr:created": "Thu Dec 01 2022 17:25:07 GMT+0000",
      "jcr:lastModified": "Thu Dec 01 2022 17:25:07 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Dec 06 2022 15:31:32 GMT+0000",
          "alt": "Reduce patient safety risks through connected care",
          "srcFileRef": "/content/dam/stryker/acute-care/products/ibedwireless/images/reduce-risk_icon_440x220.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Feb 26 2024 14:37:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Marissa.DeBruyn@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Oct 02 2018 16:06:05 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Focus on patient safety</span></span></p>\n<p><span class=\"fontsize-1-25em\">Take a proactive approach to help prevent patient injuries, such as falls. With bed alarm notifications and an enhanced ability to monitor risk, our system can assist your hospital staff respond to patient safety risks quickly.</span></p>\n",
          "jcr:lastModified": "Fri Sep 05 2025 15:12:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_1964102089": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Dec 06 2022 15:31:49 GMT+0000",
          "alt": "Connected care can simplify clinical workflows ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/ibedwireless/images/simplify-workflow_icon_440x220.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Feb 26 2024 14:38:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Marissa.DeBruyn@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Oct 02 2018 16:06:05 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Simplify workflows</span></span></p>\n<p><span class=\"fontsize-1-25em\">With our connected solutions in your hospital, caregivers can access data-driven insights that aid in effective clinical decision-making, and help improve processes related to patient care protocols, asset management and asset maintenance.</span></p>\n",
          "jcr:lastModified": "Fri Sep 05 2025 15:14:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Dec 06 2022 15:32:07 GMT+0000",
          "alt": "Stryker's connected solutions work with various EHRs and nurse call systems ",
          "srcFileRef": "/content/dam/stryker/acute-care/products/ibedwireless/images/Integrate_your_systems_icon_440x220.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Feb 26 2024 14:39:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_1965872455": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Marissa.DeBruyn@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Tue Oct 02 2018 16:06:05 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Integrate your systems</span></span></p>\n<p><span class=\"fontsize-1-25em\">Stryker's connected products are an open-architecture and adaptable solution that can work with dozens of third-party systems. Protect and enhance your hospital's investments by sharing and coordinating data across various electronic health records (EHR)**, nurse call systems, communication devices and applications.</span></p>\n",
          "jcr:lastModified": "Fri Sep 05 2025 15:14:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
