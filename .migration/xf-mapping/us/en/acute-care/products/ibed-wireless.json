        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Dec 29 2021 16:23:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Vision</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Vision is a protocol management dashboard that gives caregivers visibility to safe hospital bed and stretcher configuration compliance and bed exit alarm activity.</span></p>\n<p><span class=\"fontsize-1-25em\">It takes fall risk data pulled directly from a patient’s EHR** and associates it with appropriate fall prevention protocols, set by HCPs, to help provide a safer patient experience and an easier workflow for caregivers.</span></p>\n",
          "jcr:lastModified": "Fri Sep 05 2025 15:10:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
