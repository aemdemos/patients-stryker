          "jcr:created": "Wed Sep 30 2020 18:42:49 GMT+0000",
          "alt": "Flex Financial offers numerous payment structures to meet budgetary needs",
          "srcFileRef": "/content/dam/stryker/acute-care/products/procuity/images/2023-update/flex-financial-2550x750.jpg",
