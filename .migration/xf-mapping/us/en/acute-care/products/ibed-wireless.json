          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Oct 06 2023 14:02:42 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">ProCare Services</span></span></p>\n<p><span class=\"fontsize-1-25em\">Our expert medical device technicians help ensure your equipment is ready to perform when you need it. With preventive maintenance plans and tailored service support, we help you maximize the life of your equipment—and your investment.</span><br>\n</p>\n<p><a href=\"/content/stryker/us/en/acute-care/services/procare.html\"><span class=\"standalone-link\">Learn more</span></a></p>\n",
          "jcr:lastModified": "Wed Nov 22 2023 20:53:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
