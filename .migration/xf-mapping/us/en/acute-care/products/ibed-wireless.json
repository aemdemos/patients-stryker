      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "brittany.brady@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Dec 29 2021 16:23:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Smart Equipment Management (SEM)</span></span></h3>\n<p><span class=\"fontsize-1-25em\">SEM is a cloud-based application available for hospitals who are looking to gather near real-time data from their Stryker connected beds and stretchers. With SEM, you will be able to remotely identify the bed and stretcher’s location, serial number, operational status, preventive maintenance, error codes and more.</span></p>\n<p><span class=\"fontsize-1-25em\">This intuitive application is compatible with computers, tablets and mobile phones, allowing you flexibility to remotely evaluate your equipment. The SEM application provides you with product information to work smarter, not harder and can save you valuable time.</span></p>\n",
          "jcr:lastModified": "Fri Sep 05 2025 15:10:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
