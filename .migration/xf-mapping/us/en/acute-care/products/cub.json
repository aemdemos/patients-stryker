        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">Safe and convenient care</span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">Large-slatted siderails provide a warm and friendly appearance and can be completely lowered for 360-degree unobstructed access to the patient.</span></p>\n<p><span class=\"fontsize-1-25em\">Quiet swing-open access doors allow convenient patient care without disturbing a sleeping child.&nbsp;The access doors have built in safety features to help ensure a child cannot open it from the inside.</span></p>\n<p><span class=\"fontsize-1-25em\">All activation points are colored red and require two adult size hand movements to initiate. This helps to ensure movements are deliberate and the patient remains in the crib.</span></p>\n",
          "jcr:lastModified": "Wed Feb 21 2024 19:35:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
