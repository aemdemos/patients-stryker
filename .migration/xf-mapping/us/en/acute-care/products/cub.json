          "jcr:created": "Fri Apr 24 2020 03:06:04 GMT+0000",
          "text": "<p>&nbsp; &nbsp;</p>\n",
          "jcr:lastModified": "Fri Apr 24 2020 03:06:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
