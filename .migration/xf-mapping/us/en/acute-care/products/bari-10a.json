          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Bariatric patient helper</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Made with heavy-gauge, tubular steel, the optional bariatric patient helper adds to patient dignity by allowing independent patient repositioning.</span></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 22:02:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
