          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Fifth wheel</span></span></h3>\n<p><span class=\"fontsize-1-25em\">A center-mounted fifth wheel provides an additional pivot point to turn the bed in a tighter arc. The fifth wheel retracts to allow unobstructed space for equipment and furniture.</span></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 22:02:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
