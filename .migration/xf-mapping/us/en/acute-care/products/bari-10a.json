      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Tue Oct 15 2024 22:03:52 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Bari10A at a glance</span></span></h2>\n<p><span class=\"fontsize-1-25em\">A practical solution for better patient care and comfort for all patients. Bari10A can be used as a standard hospital bed, but can easily expand to accommodate your heaviest patients. Easy-to-use expansion and retraction with color-coded levers expands 6 inches on each side. Centrally located fifth wheel improves maneuverability and steering.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">True, 1,050 pound safe working load</span></li>\n<li><span class=\"fontsize-1-25em\">Patient helper provides a BackSmart solution for patient repositioning</span></li>\n<li><span class=\"fontsize-1-25em\">Centrally-located fifth wheel adds an additional pivot point, improving maneuverability and steering</span></li>\n<li><span class=\"fontsize-1-25em\">BackSmart expansion with color coded levers allow the bed to easily expand and retract</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Oct 15 2024 22:04:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
