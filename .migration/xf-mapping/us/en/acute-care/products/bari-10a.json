          "hideComponent": "false",
          "topMargin": "1",
          "jcr:created": "Tue Nov 28 2023 18:15:59 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Related categories</span></span></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment.html\">Medical and surgical equipment</a></p>\n<p><a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/bedframes.html\" target=\"_blank\">Bed frames</a></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 22:05:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
