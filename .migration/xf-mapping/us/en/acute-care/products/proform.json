          "jcr:created": "Mon Feb 05 2024 15:01:56 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">ProForm at a glance</span></span></h3>\n<p><span class=\"fontsize-1-25em\">ProForm Support Surface is used to assist in the prevention and treatment of pressure injuries and is recommended to be implemented in combination with clinical evaluation of risk factors and skin assessments made by a healthcare professional.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Viscoelastic foam</span></li>\n<li><span class=\"fontsize-1-25em\">Convoluted foam</span></li>\n<li><span class=\"fontsize-1-25em\">Calcaneus curve</span></li>\n<li><span class=\"fontsize-1-25em\">Articulation cuts</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Feb 05 2024 15:03:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
