          "jcr:created": "Tue Mar 03 2020 16:37:08 GMT+0000",
          "srcFileRef": "/content/dam/stryker/acute-care/products/michaelgraveswithstryker/images/PC_MG_OBT_SmF2_UshapedBase.jpg",
