          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Multiple Configurations</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The noteworthy aesthetics of the Michael Graves with Stryker Patient Chair pave the way for superior functionality. Ottoman is optional and chair is available in two seat heights with highback, lowback, Comfort-Flex and armless configurations.</span></p>\n",
          "jcr:lastModified": "Fri Feb 02 2024 20:15:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
