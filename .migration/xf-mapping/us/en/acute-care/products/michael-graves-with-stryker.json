          "jcr:lastModified": "Tue Mar 03 2020 16:38:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Promotes Proper Positioning</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Beautifully designed extended chair arms promote independence in sitting and standing. This ergonomic design helps patients learn nose-over-toes positioning.</span></p>\n",
          "jcr:lastModified": "Fri Feb 02 2024 20:16:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
