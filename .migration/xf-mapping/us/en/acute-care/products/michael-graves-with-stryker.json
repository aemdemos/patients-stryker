          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Optional Ottoman</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The practical design of the ottoman easily fits underneath the patient chair when not in use. Its height makes it functional for additional guest seating.</span></p>\n",
          "jcr:lastModified": "Fri Feb 02 2024 20:16:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
