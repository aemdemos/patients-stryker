          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Fri Feb 28 2020 17:00:49 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">U-Shaped Base</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The U-shaped base fits easily around even the latest mobility solutions on beds and stretchers. A low profile allows placement under recliners and seating.</span></p>\n",
          "jcr:lastModified": "Fri Feb 02 2024 20:14:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col4": {
        "jcr:primaryType": "nt:unstructured",
