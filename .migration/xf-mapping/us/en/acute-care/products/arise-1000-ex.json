        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kent.schwartz@stryker.com",
          "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
          "jcr:created": "Mon Jan 29 2024 18:29:54 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Arise 1000 EX at a glance</span></span></h2>\n<p><span class=\"fontsize-1-25em\">The Stryker Arise 1000 EX surface design and aesthetics provide versatile options for all patients. The surface can be customized to each patient with intuitive controls, and inflatable width and length air bladders. The combination of low air-loss and pulsation therapy help provide the best in patient care and wound healing. To maximize patient comfort during transports, the visco-elastic foam bottom helps prevent the patient from bottoming out.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Low air-loss</span></li>\n<li><span class=\"fontsize-1-25em\">Maximum inflate</span></li>\n<li><span class=\"fontsize-1-25em\">Pulsation therapy</span></li>\n<li><span class=\"fontsize-1-25em\">Surface comfort adjustment</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Jan 29 2024 18:30:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
