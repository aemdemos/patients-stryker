        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Workflow Intelligence</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Vocera Engage middleware is the core of Vocera’s communication and workflow intelligence. By routing, filtering and prioritizing alarms* and notifications, Engage ensures critical information reaches the right person at the right time, supporting efficient workflows and coordinated care.</span></p>\n",
          "jcr:lastModified": "Tue Jan 13 2026 21:31:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
