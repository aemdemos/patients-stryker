          "alt": "doctor pointing to mobile device beside two nurses wearing badges",
          "srcFileRef": "/content/dam/stryker/smart-care/images/Clinical_communication_badges_1200x680.jpg",
          "borderColor": "rgba(76,125,122,1)",
