          "jcr:created": "Tue Mar 09 2021 17:49:47 GMT+0000",
          "alt": "ProAssure wordmark",
          "srcFileRef": "/content/dam/stryker/acute-care/Services/proassure/images/proassure-wordmark_1440x424.jpg",
          "borderColor": "rgb(178,180,174)",
          "jcr:lastModified": "Tue Jan 13 2026 21:59:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "linkInternal": "/content/stryker/us/en/acute-care/proclinical",
