        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Clinical Communication</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Break down communication barriers and help improve staff safety with Stryker's hands-free communication devices. The Sync Badge, Smartbadge and Minibadge are lightweight and purpose-built to connect teams seamlessly across the hospital.</span></p>\n",
          "jcr:lastModified": "Tue Jan 13 2026 21:31:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "curatedcta": {
