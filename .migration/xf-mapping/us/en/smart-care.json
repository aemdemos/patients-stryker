    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "kent.schwartz@stryker.com",
      "jcr:created": "Tue Dec 09 2025 14:29:12 GMT+0000",
      "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Connecting data, devices and people</span></span></h2>\n<p><span class=\"fontsize-1-25em\">Healthcare is at a pivotal moment. Fragmented systems, clinician burnout and inefficient workflows challenge modern care delivery. At Stryker, we are committed to partnering with you to integrate advanced digital capabilities across your facility, enhancing clinical and operational workflows and improving outcomes. Through connected solutions such as care.ai and Vocera, part of our <a href=\"/content/stryker/us/en/portfolios/medical-surgical-equipment/smart-hospital.html\">SmartHospital Platform</a>, we bring data, devices and people together to create smart, response and proactive care environments.</span></p>\n",
      "jcr:lastModified": "Wed Jun 10 2026 15:35:44 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
