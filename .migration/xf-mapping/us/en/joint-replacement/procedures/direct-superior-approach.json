    "largeheadline_copy_4": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "topMargin": "0",
      "jcr:created": "Thu Dec 07 2023 14:02:51 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><span style=\"color: rgb(133,69,138);\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\"><span class=\"fontsize-2vw\"><span style=\"color: rgb(0,0,0);\">Implants</span></span></span></span></span></h2>\r\n",
      "jcr:lastModified": "Mon Dec 09 2024 20:42:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgb(255,181,0)",
