    "largeheadline_copy_c_2051235302": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "topMargin": "2",
      "jcr:created": "Tue Oct 25 2022 18:06:05 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h2><span style=\"color: rgb(133,69,138);\"><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\"><span class=\"fontsize-2vw\"><span style=\"color: rgb(237,238,236);\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\">Mako Total Hip</span></span></span></span></span></span></span></h2>\r\n",
      "line2": "<span class=\"fontsize-1-5-vw\">Elevating total hip procedures</span>",
      "jcr:lastModified": "Mon Nov 25 2024 19:54:15 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgb(255,181,0)",
