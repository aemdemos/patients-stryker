    "text_440130316": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "joelle.battista@stryker.com",
      "leftPadding": "1",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Mon Nov 18 2024 17:26:37 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Designed to <b>maximize visibility</b> while ​<b>minimizing soft tissue damage​</b></span></span></p>\n",
      "jcr:lastModified": "Mon Nov 25 2024 19:55:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols2_2_3_1_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "joelle.battista@stryker.com",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "jcr:created": "Mon Nov 18 2024 18:24:19 GMT+0000",
      "jcr:lastModified": "Mon Nov 18 2024 18:24:19 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_738572298": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "leftPadding": "2",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Nov 18 2024 17:31:56 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">​Meet the latest tools in our exclusive Direct Superior approach instrument set.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">Our high offset reamer handle and specialized instruments are designed to help facilitate acetabular and femoral exposure along with bone preparation.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">The Direct Superior approach retractor and reamer set features downsized retractors with longer arms designed to increase visualization within the surgical field.</span></span></p>\n",
          "jcr:lastModified": "Fri Jan 24 2025 15:47:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
