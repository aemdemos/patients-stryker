        "true",
        "true"
      ]
    },
    "cols2_1786469458": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "joelle.battista@stryker.com",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "jcr:created": "Mon Nov 18 2024 17:55:33 GMT+0000",
      "jcr:lastModified": "Mon Nov 18 2024 17:55:33 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "leftPadding": "2",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Nov 18 2024 17:56:30 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">The Direct Superior approach is compatible with Mako SmartRobotics<sup>TM</sup> for primary procedures, marrying this minimally invasive approach with today’s latest technology in functional hip alignment.</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">​Enhance your surgical approach with Mako Total Hip through:</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><b>​<span class=\"futura-bold\">CT-based 3D modeling</span></b> and elevated planning features, Mako Total Hip provides unprecedented information with the goal of helping surgeons enhance patient outcomes.<sup>8</sup></span></span></li>\n</ul>\n<p>&nbsp;</p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><span class=\"futura-bold\">​Patient-specific planning</span> to enable more accurate implant positioning to plan.<sup>9</sup>​</span></span></li>\n</ul>\n<p>&nbsp;</p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">Surgeons can visualize potential impingement by looking at the changes to their <b><span class=\"futura-bold\">patient’s pelvic tilt</span> </b>in the sitting, standing, and supine positioning to plan.<sup>10</sup></span></span></li>\n</ul>\n<p>&nbsp;</p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">Using <b><span class=\"futura-bold\">AccuStop™ haptic technology</span></b> and a patient-specific CT scan, Mako Total Hip enables single-stage reaming and guided cup impaction to help promote accurate implant placement to plan.<sup>10</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jan 24 2025 15:48:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
