        "text_1046836216": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "1",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "topPadding": "5",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Oct 30 2024 15:40:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"fontsize-1-5em\"><span style=\"color: #ffffff;\"><span style=\"color: #000000;\">How </span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">we move lives&nbsp;</span></span></span></h3>\n",
          "jcr:lastModified": "Tue Nov 05 2024 16:00:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1996734239": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "7",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "topPadding": "0",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Oct 30 2024 15:41:18 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">We help our customers solve a patient’s pain by understanding their needs and then providing technologies that help our customers move lives.</span></p>\n<p><span class=\"fontsize-1-25em\">Driven by results, we help our customers deliver meaningful outcomes by advancing innovative technologies that improve efficiency and deliver enhanced clinical outcomes.<sup>1-6</sup></span></p>\n<p><span class=\"fontsize-1-25em\">We build trusted partnerships by offering innovative products and services that help improve patient and healthcare outcomes.</span></p>\n<p><span class=\"fontsize-1-25em\">We’re actively shaping the future of joint replacement by advancing technologies like additive manufacturing, robotics and embracing the future of digital and AI.</span></p>\n",
          "jcr:lastModified": "Thu Dec 19 2024 20:24:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
