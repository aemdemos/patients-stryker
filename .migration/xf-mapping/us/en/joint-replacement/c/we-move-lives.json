          "hideComponent": "false",
          "jcr:created": "Wed Oct 30 2024 15:30:48 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Our </span>purpose</span></span></h2>\n",
          "jcr:lastModified": "Thu Nov 07 2024 21:08:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1191076190": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "topPadding": "2",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Oct 30 2024 15:30:53 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Around the globe, <b>we move lives</b>.</span></p>\n<p><span class=\"fontsize-1-25em\">Together, we help get your patients back to the activities they love. Through our <b>products</b>, <b>services</b> and <b>people</b>, we are motivated and empowered every day to <b>help move lives</b>.</span><br>\n</p>\n",
          "jcr:lastModified": "Thu Nov 07 2024 21:09:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
