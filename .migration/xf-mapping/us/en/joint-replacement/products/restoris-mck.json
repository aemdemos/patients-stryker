        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "stephen.brown@stryker.com",
          "jcr:lastModifiedBy": "stephen.brown@stryker.com",
          "jcr:created": "Tue Aug 08 2017 12:55:52 GMT-0400",
          "text": "<h4>Restoris MCK implants<br>\nwith X3 polyethylene inserts<br>\n</h4>\n<p>Our patented<sup>2 </sup>process for creating precisely engineered polyethylene&nbsp;results in a polyethylene that is uniquely strong<sup>3,4</sup> and intrinsically resistant to wear<sup>3</sup> and oxidation.<sup>5</sup> X3’s manufacturing process of sequential crosslinking uses three separate gamma irradiation doses with an annealing step after each.</p>\n",
          "jcr:lastModified": "Fri Aug 25 2017 16:26:41 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured"
      }
    },
