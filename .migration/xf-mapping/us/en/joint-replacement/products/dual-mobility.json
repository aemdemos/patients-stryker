    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "5",
      "jcr:createdBy": "joelle.battista@stryker.com",
      "leftPadding": "2",
      "topPadding": "5",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Wed Oct 01 2025 18:34:51 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2 style=\"text-align: center;\"><span class=\"fontsize-1-25em\"><b>Not all <span class=\"futura-bold\"><span style=\"color: #ffb500;\">Dual Mobility</span></span> is the same.&nbsp;</b></span></h2>\n<h2 style=\"text-align: center;\"><span class=\"fontsize-1-25em\"><b><span class=\"futura-bold\"><span style=\"color: #85458a;\">Stability.</span> <span style=\"color: #1c5687;\">Adaptability.</span> <span style=\"color: #4c7d7a;\">Heritage.</span></span></b></span></h2>\n<h2>&nbsp;</h2>\n<h3><span class=\"futura-bold\"><span style=\"color: #85458a;\">Stability. ​</span></span></h3>\n<p><span class=\"fontsize-1-5em\">Stryker's Dual Mobility offerings have demonstrated <span class=\"futura-bold\">greater jump distance</span> compared to certain competitor designs via numerical methods (CAD analysis).<sup>5-6</sup></span></p>\n<p>&nbsp;</p>\n<h3><span class=\"futura-bold\"><span style=\"color: #1c5687;\">Adaptability.</span></span></h3>\n<p><span class=\"fontsize-1-5em\">Our Dual Mobility portfolio allows for <span class=\"futura-bold\">adaptability</span> with monobloc and modular constructs, that can be cementless or cemented, based on primary, complex or revision indications.<sup>1-3</sup></span></p>\n<h3>&nbsp;</h3>\n<h3><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">Heritage.</span>&nbsp;</span></h3>\n<p><span class=\"fontsize-1-5em\">Stryker's Dual Mobility portfolio offers <span class=\"futura-bold\">clinical success<sup>7,8</sup> backed by data</span>:​</span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\">With over 50 clinical publications, Modular Dual Mobility (MDM) is supported by a robust body of published evidence.<sup>7​​</sup></span></li>\n<li><span class=\"fontsize-1-5em\">Novae achieved a 98.6% survival rate at 10 years and 96.2% at 13 years with a revision rate of 1.6% at 10-year follow-up.<sup>8​</sup></span></li>\n</ul>\n<h3>&nbsp;</h3>\n",
      "jcr:lastModified": "Mon Oct 06 2025 17:51:48 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "2",
      "textIsRich": "true"
    },
