    "experiencefragment": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "joelle.battista@stryker.com",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "jcr:created": "Fri Oct 03 2025 16:28:07 GMT+0000",
      "text": "Modular Dual Mobility Designed to help prevent dislocation1,3 and assist operative goals of stability1, longevity9 and advanced fixation for fractures. Dedicated to primary or revision cementless THA. Novae SunFit TH (Primary) Simple hemispherical cup with demonstrated increased jump distance compared to fixed bearing.1 Dedicated to primary cementless THA. Press fit fixation and dual coating (Ti+HA). Novae Stick (Cemented) Cemented dual mobility for acetabular revisions and poor bone quality. Dedicated to acetabular revisions. Novae E TH (Primary and Revision) Dedicated to primary cementless THA or small revision. Press fit fixation with pegs, screw and dual coating (Ti+HA). Fixation with: 1 flange 2 pegs Novae Coptos TH (Primary and Revision) Dedicated to revision cementless THA. Press fit fixation with pegs, screw and dual coating (Ti+HA). Cage-like construct with: 2 flanges Obturator hook 2 pegs",
      "jcr:lastModified": "Mon Oct 06 2025 18:43:33 GMT+0000",
      "sling:resourceType": "stryker/components/content/experienceFragment",
      "fragmentPath": "/content/experience-fragments/stryker/joint-replacement/en/products/dual_mobility/dual-mobility/product-offerings",
      "edsFragmentPath": "/us/en/fragments/stryker/joint-replacement/en/products/dual-mobility/dual-mobility/product-offerings"
    },
