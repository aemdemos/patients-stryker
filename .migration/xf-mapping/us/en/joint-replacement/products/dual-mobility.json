          "hideComponent": "false",
          "jcr:created": "Wed Oct 01 2025 17:20:27 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><b><span class=\"futura-bold\">Key benefits and <span style=\"color: #ffffff;\">clinical evidence</span></span></b></h2>\n",
          "jcr:lastModified": "Fri Oct 03 2025 15:42:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
