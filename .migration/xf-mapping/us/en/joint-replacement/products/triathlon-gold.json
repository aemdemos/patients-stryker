      "hideComponent": "false",
      "topMargin": "2",
      "jcr:created": "Thu Feb 12 2026 19:13:56 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h3 style=\"text-align: left;\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Your workflow, your choice</span></span></span></span></h3>\n<p style=\"text-align: left;\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\">The Triathlon Gold femoral component is dual-indicated for cementless or cemented use, allowing you to combine your preferred fixation method and workflow for trust beyond the surface.</span></span></p>\n",
      "jcr:lastModified": "Thu May 07 2026 15:53:13 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "5",
      "backgroundColor": "rgb(28,86,135)",
