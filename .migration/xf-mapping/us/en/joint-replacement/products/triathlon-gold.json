          "topPadding": "8",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Feb 17 2026 20:08:46 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1em\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Triathlon Gold is built on the legacy of the&nbsp;trusted </span></span><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">Triathlon CR design</span></span></span><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">, which has a clinical history of delivering stability,<sup>7&nbsp;</sup>satisfaction<sup>1&nbsp;</sup>and survivorship<sup>1&nbsp;</sup>in total knee arthroplasty.</span></span></span></p>\n",
          "jcr:lastModified": "Tue Jun 30 2026 13:25:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": "true",
          "leftMargin": "0",
