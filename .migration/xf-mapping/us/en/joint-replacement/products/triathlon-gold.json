          "jcr:created": "Thu Feb 12 2026 19:13:56 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Engineered to endure</span></span></span></h3>\n<p><span class=\"fontsize-1-25em\"><span class=\"standalone-link\">A titanium nitride (TiN) surface combined with our market-leading<sup>11</sup> Tritanium cementless technology, Triathlon Gold is designed to deliver fixation<sup>12</sup> and long-term durability<sup>13</sup> with scratch resistance superior to competitive surfaces.<sup>14</sup></span></span></p>\n",
          "jcr:lastModified": "Thu May 07 2026 15:52:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "2",
          "textIsRich": "true"
