          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1-75em\">Triathlon<sup>®</sup>&nbsp;Gold</span></span></span></span></h1>\n<h1><b><span class=\"futura-bold\">Trust beyond the surface.&nbsp;</span></b></h1>\n<h1>&nbsp;</h1>\n<h2><span class=\"fontsize-1em\">You asked us to bring you Triathlon as an option for patients with metal sensitivity concerns, and we listened. Combining our proven Triathlon design<sup>1-6</sup> and trusted cementless fixation technology<sup>2,5-6</sup> with a titanium nitride surface, Triathlon Gold Femoral Component is a premium addition to the Triathlon portfolio that you and your patients can <b><span class=\"futura-bold\">trust beyond the surface</span></b>.</span></h2>\n",
          "jcr:lastModified": "Fri Aug 21 2026 13:50:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
