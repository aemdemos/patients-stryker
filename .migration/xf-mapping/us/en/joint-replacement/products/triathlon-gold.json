          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "topMargin": "12",
          "gradientDirection": "left-to-right",
          "text": "<h4><span class=\"fontsize-1em\">Compatible with <u><a href=\"/content/stryker/us/en/joint-replacement/systems/mako-total-knee.html\">Mako Total Knee</a></u></span></h4>\n<p><span class=\"fontsize-1em\">The unique features of<span class=\"urw-egyptienne\"> </span><span style=\"color: #ffb500;\"><span class=\"futura-bold\">Mako SmartRobotics™</span></span> and the powerful combination with Triathlon are designed to help surgeons achieve Functional&nbsp;Knee Positioning<sup>TM</sup> through 3D CT-based implant planning, dynamic joint balancing and AccuStop<sup>TM</sup> haptic technology. <span class=\"futura-bold\">Mako Total Knee allows you to know more about your patient, so you can cut less.*<sup>15,16</sup></span></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Tue Mar 03 2026 16:49:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
