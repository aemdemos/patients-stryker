      "topPadding": "5",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Tue Nov 25 2025 17:42:18 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-25em\">Explore <span class=\"futura-bold\"><span style=\"color: #ffb500;\">Triathlon TS</span></span></span></h2>\n",
      "jcr:lastModified": "Tue Nov 25 2025 20:54:59 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "joelle.battista@stryker.com",
      "jcr:lastModifiedBy": "joelle.battista@stryker.com",
      "jcr:created": "Tue Nov 25 2025 17:47:14 GMT+0000",
      "jcr:lastModified": "Tue Nov 25 2025 17:47:14 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Nov 25 2025 20:55:06 GMT+0000",
          "alt": "Triathlon Revision Baseplate",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/Baseplate (1) 1.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Dec 29 2025 16:18:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "15",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "leftPadding": "2",
          "topPadding": "1",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 25 2025 17:47:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Triathlon Revision Baseplate</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Easily converts to any Stryker revision procedure with the Triathlon Revision Baseplate.</span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Nov 26 2025 17:50:53 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Nov 25 2025 20:55:12 GMT+0000",
          "alt": "Revision Insert X3",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/Figure_40_PR (2).jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Dec 29 2025 16:17:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "15",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "leftPadding": "2",
          "topPadding": "1",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 25 2025 17:47:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Revision Insert X3</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Maintains the articular surface shape and insert post of the preceding TS Insert.<sup>1</sup>&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Designed to allow 135° of flexion, ± 7° of internal/external rotation and ± 2° of varus/valgus constraint.<sup>2,3</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Nov 26 2025 17:50:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Nov 25 2025 20:55:16 GMT+0000",
          "alt": "TKA Outcomes Chart",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/TKA Outcomes Chart v1.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Dec 29 2025 18:56:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "15",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "leftPadding": "2",
          "topPadding": "1",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 25 2025 17:47:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Primary TKA outcome similarities&nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Early functional outcomes are similar to those reported for primary arthroplasty, demonstrating that high levels of patient function can be achieved following revision knee arthroplasty with semi-constrained devices.<sup>4</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Nov 26 2025 17:51:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
