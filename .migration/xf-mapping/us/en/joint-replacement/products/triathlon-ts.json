              "hideComponent": "false",
              "jcr:created": "Tue Nov 25 2025 17:42:18 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<h2><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Simplicity</span></span></h2>\n<ul>\n<li><span class=\"fontsize-1-25em\">Reamer-based instruments designed for accurate tibial and femoral preparation.<sup>1,5-10</sup></span></li>\n<li><span class=\"fontsize-1-25em\">Reduced femoral offsetting to 8.7% compared to 55.4 % in other systems.<sup>6</sup></span></li>\n</ul>\n",
              "jcr:lastModified": "Wed Nov 26 2025 14:40:14 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          }
        },
