              "alt": "Reduced femoral offsetting",
              "srcFileRef": "/content/dam/stryker/joint-replacement/images/Screenshot 2025-11-25 160045.png",
              "borderColor": "rgba(76,125,122,1)",
              "jcr:lastModified": "Tue Nov 25 2025 21:04:12 GMT+0000",
