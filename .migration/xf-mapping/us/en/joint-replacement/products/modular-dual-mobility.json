          "jcr:created": "Thu Jan 19 2023 14:41:18 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Modular Dual Mobility</span></span></span></h1>\r\n<h2><span class=\"fontsize-2-5-vw\"> <span class=\"futura-bold\">Mobile Bearing Hip System</span></span><br>\r\n<span class=\"fontsize-2-5-vw\"> </span></h2>\r\n",
          "line2": "<span class=\"fontsize-1-5-vw\">Dislocation is one of the most common causes of THA failure in both primary and revision procedures.<sup>1-4</sup> Modular Dual Mobility (MDM) is designed to help prevent dislocation and assist your operative goals of stability, longevity, and advanced fixation for fractures, primary or revision total hip arthroplasty cases.</span>",
          "jcr:lastModified": "Wed Oct 25 2023 19:51:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
    },
