        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Wed Jan 11 2023 16:56:00 GMT+0000",
          "text": "<p><span class=\"fontsize-8em\">*Although resurfacing type shells have lower jump heights, they have the greatest ROM which is needed when the native femoral neck is retained.</span></p>\n",
          "jcr:lastModified": "Wed Jan 11 2023 16:57:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "topPadding": "7",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Wed Jun 08 2022 19:23:22 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\">The X3 polyethylene inserts of the MDM system are available in large sizes offering increased jump distance – the distance the femoral head must travel to dislocate.<sup style=\"background-color: transparent;\">1</sup><span style=\"font-size: 1.5vw; background-color: transparent;\">&nbsp;The greater the jump distance, the greater the stability of the hip.</span><sup style=\"background-color: transparent;\">7</sup><br>\r\n</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">When compared to a conventional THA with a 36mm femoral head, MDM offers a 59% increase in jump distance.<sup>5,8</sup></span></p>\r\n",
          "jcr:lastModified": "Fri Feb 03 2023 15:11:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
    },
