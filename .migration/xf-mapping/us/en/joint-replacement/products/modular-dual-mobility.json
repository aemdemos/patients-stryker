      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "topPadding": "7",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Wed Jun 08 2022 19:23:22 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-1-5-vw\">MDM can reduce cost by decreasing the risk of dislocations.<sup style=\"background-color: transparent;\">13-16</sup><span style=\"font-size: 1.5vw; background-color: transparent;\"> Compared to conventional total hip arthroplasty, Dual Mobility total hip arthroplasty for primary procedures showed “absolute dominance” with lowered accrued cost and higher accrued utility.</span><sup style=\"background-color: transparent;\">13</sup></span>",
          "jcr:lastModified": "Fri Feb 03 2023 15:14:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
