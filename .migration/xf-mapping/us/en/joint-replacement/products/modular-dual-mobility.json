    "section_title_2088336336": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Wed Jan 11 2023 15:39:28 GMT+0000",
      "title": "Clinical evidence",
      "jcr:lastModified": "Wed Jan 11 2023 15:40:14 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title"
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Wed Jan 11 2023 16:03:23 GMT+0000",
      "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">Modular Dual Mobility (MDM), </span></span></span><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\"><span class=\"urw-egyptienne\">the most studied modular dual mobility implant in literature.</span></span></span></span></p>\n",
      "jcr:lastModified": "Wed Jan 11 2023 16:10:59 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "kristian.bocage@stryker.com",
      "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
      "jcr:created": "Fri Sep 02 2022 19:19:29 GMT+0000",
      "jcr:lastModified": "Fri Sep 02 2022 19:19:29 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "topPadding": "7",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Sep 02 2022 19:19:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\"><span style=\"color: #000000;\">“Dual Mobility demonstrated improved PROMS and lower rates of dislocation, readmission and revision.”</span></span></span></span></p>\n",
          "jcr:lastModified": "Wed Jan 11 2023 16:11:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,1)",
          "showDimensionalBox": "true",
          "textIsRich": "true"
        },
        "text_291786503": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Thu Feb 02 2023 14:50:42 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-8em\">In a 27-center retrospective study of 664 dual mobility vs. 218 fixed bearings, dual mobility demonstrated improved PROMs and lower rates of dislocation, readmission and revision<sup>18</sup></span></p>\n",
          "jcr:lastModified": "Thu Feb 02 2023 14:51:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "topPadding": "7",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Sep 02 2022 19:19:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\"><span style=\"color: #000000;\">“Excellent clinical outcomes and patient-reported outcomes at seven-years minimum follow-up (7 - 8.5 yrs.) with zero cup failures in a cohort of 143 patients.”</span></span></span></span></p>\n",
          "jcr:lastModified": "Wed Jan 11 2023 16:12:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,1)",
          "showDimensionalBox": "true",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Thu Feb 02 2023 14:51:39 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-8em\">Excellent clinical outcomes and patient-reported outcomes at seven-years minimum follow-up (7 - 8.5 yrs.) with zero cup failures in a cohort of 143 patients<sup>17</sup></span></p>\n",
          "jcr:lastModified": "Thu Feb 02 2023 14:52:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "topPadding": "7",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Sep 02 2022 19:19:33 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\"><span style=\"color: #000000;\">“4x reduced incidence of dislocation.”</span></span></span></span></p>\n",
          "jcr:lastModified": "Wed Jan 11 2023 16:11:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgba(255,255,255,1)",
          "showDimensionalBox": "true",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Thu Feb 02 2023 14:51:36 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-8em\">In a retrospective review of 267 patients who underwent revision, even with a selection bias of using dual mobility for patients at high risk of instability, patients who received an MDM bearing had a 4x reduced incidence of dislocation (2.1%, vs. 8.7% for conventional polyethylene single bearing, P=0.067) at the mean follow-up of 37.8 months<sup>19</sup></span></p>\n",
          "jcr:lastModified": "Thu Feb 02 2023 14:52:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
