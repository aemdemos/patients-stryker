        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "topPadding": "7",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "jcr:created": "Wed Jun 08 2022 19:23:22 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\">MDM is a versatile bearing option, as its indications include both primary and revision cases.<sup style=\"background-color: transparent;\">1-4 </sup><span style=\"font-size: 1.5vw; background-color: transparent;\">MDM utilizes the Trident Innerchange Locking Mechanism, allowing surgeons intraoperative flexibility.</span><br>\r\n</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">MDM X3 is compatible with Trident, Trident II and Restoration Anatomic acetabular components, offering surgeons a choice of fixation surfaces and screw hole configurations.</span></p>\r\n",
          "jcr:lastModified": "Fri Feb 03 2023 15:14:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
