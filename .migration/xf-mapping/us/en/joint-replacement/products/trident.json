        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "text": "<h4>Trident hemispherical shell</h4>\n<ul>\n<li>Hemispherical acetabular shell</li>\n<li>Arc-deposited CPTi (commercially pure titanium)</li>\n<li>Available with or without PureFix HA (hydroxyapatite)<br>\ncoating</li>\n<li>Compatible with Trident Torx acetabular screws</li>\n<li>Sizes: 42 – 74mm</li>\n<li>Solidback &amp; clusterhole option</li>\n<li>Clusterhole options<br>\n<br>\n&nbsp; &nbsp; &nbsp; • 42 – 50mm: 3 holes<br>\n&nbsp; &nbsp; &nbsp; • 52 – 74mm: 5 holes<br>\n</li>\n</ul>\n",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
