          "preset": "max_width_1440",
          "jcr:created": "Mon Dec 29 2025 21:21:49 GMT+0000",
          "alt": "Locking",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/locking revision1.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Jan 02 2026 17:43:59 GMT+0000",
