          "hideComponent": "false",
          "topMargin": "5",
          "jcr:created": "Tue Aug 26 2025 17:39:14 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><b><span class=\"futura-bold\">Triathlon TS</span></b></h2>\n<p><span class=\"fontsize-1-25em\"><span class=\"standalone-link\"><span class=\"fontsize-1em\">Triathlon TS is designed to facilitate joint line restoration.<sup>2</sup> Failure to accurately restore joint line position in revision knee arthroplasty has been associated with decreased motion, decreased extensor strength, anterior knee pain, patellar clunk, patellar instability and midflexion instability.<sup>3</sup></span></span></span></p>\n",
          "jcr:lastModified": "Mon Jan 05 2026 17:19:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true",
