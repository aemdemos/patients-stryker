      "gradientDirection": "left-to-right",
      "text": "<h2><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Triathlon Revision</span> <span style=\"color: #ffb500;\">Knee</span> System</span></span></h2>\n",
