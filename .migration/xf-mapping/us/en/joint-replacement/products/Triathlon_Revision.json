          "preset": "max_width_1440",
          "jcr:created": "Mon Dec 29 2025 21:21:46 GMT+0000",
          "alt": "Keel design ",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/baseplate high res.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Jan 02 2026 17:41:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
