      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_33529287_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "15",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "leftPadding": "5",
          "topPadding": "10",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 25 2025 17:42:18 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Triathlon Revision Baseplate</span></span></span></h1>\n<h1>&nbsp;</h1>\n<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">Triathlon Revision now offers a single platform for revision and limb salvage surgeries in patients with significant bone loss and/or ligament deficiencies.&nbsp;</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\"><br>\nThe Triathlon Revision Baseplate can be utilized in Triathlon TS and Triathlon Hinge procedures and is compatible with the Global Modular Rotating System (GMRS) Distal Femur</span>.</span></p>\n",
          "jcr:lastModified": "Fri Jan 02 2026 17:37:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
