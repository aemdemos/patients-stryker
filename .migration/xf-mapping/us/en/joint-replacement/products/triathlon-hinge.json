          "preset": "max_width_1440",
          "jcr:created": "Mon Dec 29 2025 18:08:50 GMT+0000",
          "alt": "Femoral sizing",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/Femoral Sizing.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Dec 29 2025 19:19:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "15",
          "jcr:createdBy": "user-16113fe70d@example.invalid",
          "leftPadding": "2",
          "topPadding": "1",
          "jcr:lastModifiedBy": "user-16113fe70d@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 25 2025 17:47:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Femoral sizing</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">The sizing for the Triathlon Hinge femur has been standardized to match that of our existing Triathlon Femurs. In a validated model,<sup>7</sup> Triathlon Hinge demonstrated enhanced patellar fixation and tracking within the trochlear groove compared to the clinically successful<sup>6</sup> predicate design, mirroring the performance observed in primary systems.<sup>8</sup></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jan 13 2026 19:00:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
