          "preset": "max_width_1440",
          "jcr:created": "Mon Dec 29 2025 18:08:50 GMT+0000",
          "alt": "distal augment 2",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/distal augment 2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Dec 29 2025 19:09:43 GMT+0000",
