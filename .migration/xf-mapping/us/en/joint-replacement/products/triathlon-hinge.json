        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "15",
          "jcr:createdBy": "user-16113fe70d@example.invalid",
          "leftPadding": "2",
          "topPadding": "1",
          "jcr:lastModifiedBy": "user-16113fe70d@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 25 2025 17:47:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Built-in 5mm distal augment</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">With revision surgery in mind, the Triathlon Hinge Femoral component offers a built-in 5mm distal augment compared to Triathlon TS femurs.</span></li>\n<li><span class=\"fontsize-1-25em\">The built-in augments are designed to reduce the number of surgical steps needed and may help minimize the need to use additional stand-alone augments.</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Dec 29 2025 17:42:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-16113fe70d@example.invalid",
          "jcr:lastModifiedBy": "user-16113fe70d@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Mon Dec 29 2025 18:08:50 GMT+0000",
          "alt": "Boss location",
          "srcFileRef": "/content/dam/stryker/joint-replacement/images/Boss location.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Dec 29 2025 19:20:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "15",
          "jcr:createdBy": "user-16113fe70d@example.invalid",
          "leftPadding": "2",
          "topPadding": "1",
          "jcr:lastModifiedBy": "user-16113fe70d@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 25 2025 17:47:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Models Triathlon TS boss location</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Triathlon Hinge models Triathlon TS anatomic boss location relative to the anterior flange, which has been shown to reduce the need for offsetting<sup>3-5&nbsp;</sup>compared to clinically successful<sup>6</sup> predicate hinge.</span></li>\n<li><span class=\"fontsize-1-25em\">The updated boss location is designed to minimize posterior resection<sup>5&nbsp;</sup>compared to the predicate hinge.&nbsp;</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jan 13 2026 18:59:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
