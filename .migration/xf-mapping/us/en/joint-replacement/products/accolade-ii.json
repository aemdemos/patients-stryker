      "jcr:lastModified": "Wed Nov 23 2022 14:56:26 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "1",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "leftPadding": "1",
          "topPadding": "1",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Sep 19 2022 15:10:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Muscle-sparing surgical approaches continue to gain popularity, due to the potential patient benefits of faster recovery<sup>13,14</sup>, less pain<sup>13,14</sup>&nbsp;and greater satisfaction.<sup>15</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Stryker’s portfolio of muscle-sparing techniques features modern instrumentation and dynamic Medical Education programs to support the Direct Anterior Reconstructive Technology (DART™) and the Direct Superior Approach.</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Stryker developed a training platform to help surgeons during the learning curve of a new surgical approach, Stryker’s Training Academy. For access to Stryker’s Training Academy, contact your local Stryker sales representative.</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Mar 20 2024 19:55:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "1",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
      }
    },
    "section_title_copy_794338709": {
