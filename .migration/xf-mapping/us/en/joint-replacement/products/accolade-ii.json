      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "leftPadding": "4",
          "topPadding": "4",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Sep 19 2022 15:10:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Offers increasing proximal conformity to enhance primary stability.<sup>8,9</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Initial stability may be increased by creating a higher conformity between the implant and&nbsp;the femoral cortices, leading to a larger area of contract.<sup>10</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Nov 28 2022 17:07:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "4",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
      }
    },
    "section_title_copy_1446219483": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Fri Nov 18 2022 19:18:43 GMT+0000",
      "title": "Enhanced proximal-distal proportions¹",
      "jcr:lastModified": "Fri Nov 18 2022 19:20:13 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title"
    },
    "cols2_2_3_1_3_1445503995": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Fri Nov 18 2022 19:52:15 GMT+0000",
      "jcr:lastModified": "Fri Nov 18 2022 19:52:15 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "leftPadding": "4",
          "topPadding": "4",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Sep 19 2022 15:10:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Distal-only engaged femoral stems can experience stress shielding<sup>10</sup>&nbsp;and consequently may lead to elevated failure rates due to loosening and migration.<sup>3</sup>&nbsp;In order to better mimic the femoral anatomy and avoid distal-only engagement, a more anatomic implant growth rate is needed.</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Utilizing the SOMA femoral morphology study, a more anthropomorphic proximal-distal stem growth rate was identified. This rate led to enhanced implant proportions<sup>6</sup>, as the distal geometry of Accolade II increases in size less than the proximal geometry.</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">These proportions enable Accolade II to achieve a significantly better canal fit and fill<sup>3</sup>, and Accolade II has shown a decreased incidence of distal-only engagement.<sup>3</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Nov 23 2022 17:14:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "4",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "hannah.white@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Nov 18 2022 19:44:56 GMT+0000",
