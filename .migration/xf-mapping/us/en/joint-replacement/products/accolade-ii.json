    },
    "cols2_2_3_1_3_1490113875": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "hannah.white@stryker.com",
      "jcr:lastModifiedBy": "hannah.white@stryker.com",
      "jcr:created": "Fri Nov 18 2022 19:52:30 GMT+0000",
      "jcr:lastModified": "Fri Nov 18 2022 19:52:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "leftPadding": "4",
          "topPadding": "4",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Sep 19 2022 15:10:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">There exists a complex relationship between stem length and implant stability.<sup>11</sup>&nbsp;Shortening stem length without geometry optimization has been shown to increase the potential for micromotion<sup>11</sup>, which is a strong indicator for implant failure.<sup>12</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Accolade II utilized the SOMA database and stability analyses to establish an optimized length for each stem size which not only accommodates muscle-sparing approaches<sup>11</sup>, but demonstrated improved initial stability.<sup>4</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Nov 23 2022 17:15:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "4",
          "backgroundColor": "rgba(255,255,255,0)",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
