          "topMargin": "3",
          "jcr:created": "Tue Nov 29 2022 21:05:00 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Accolade II</span>&nbsp;<br>\n Designed to fit more patients, designed to fit your approach</span></h1>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Accolade II’s Morphometric Wedge is designed to address modern demands with novel technology by evolving conventional tapered wedge femoral stem design with size specific medial curvature to more closely fit a broad range of bone sizes and shapes of today’s patient population.<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Thu Dec 01 2022 17:37:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
