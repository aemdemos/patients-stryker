      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "kristian.bocage@stryker.com",
          "jcr:lastModifiedBy": "hannah.white@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Nov 29 2022 21:08:21 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">Stryker Orthopaedic Modeling and Analytics (SOMA)</span></h3>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Stryker Orthopaedic Modeling and Analytics, or SOMA, is a system that enables population-based design and has powerful functionality with which to design, model, and analyze novel orthopaedic devices. Stryker utilized SOMA technology to design a novel stem building upon the conventional tapered wedge femoral design, incorporating features to allow for an enhanced implant fit in today’s patient population.<sup>3</sup></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">By establishing an increased canal fit and fill<sup>3</sup>, Accolade II has been shown to allow for enhanced stability<sup>3</sup>, decreased intraoperative femoral fractures<sup>5</sup>, as well as survivorship and functional outcomes<sup>6,7</sup>,&nbsp;which may lead to satisfied patients.<sup>7,8</sup>&nbsp;An illustrated look at the process by which SOMA technology is employed in implant design is described below.</span></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Thu Dec 01 2022 17:43:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
