              "hideComponent": "false",
              "jcr:created": "Thu Feb 26 2026 17:08:10 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Discover the power of planning</span><br>\n ​Blueprint is a surgeon-controlled, 3D preoperative planning software, allowing surgeons to perform real-time, precise virtual surgery for added confidence prior to stepping foot in the O.R.<sup>1</sup>​<br>\n <br>\n <br>\n <span class=\"futura-bold\">Leading orthopaedic teams trust Blueprint with over 250k case plans globally<sup>2</sup></span><br>\n ​Blueprint provides the necessary tools for surgeons to understand patient pathology, anticipate intraoperative challenges and evaluate the range of implant types that could be used.<sup>3,4</sup> Blueprint automatically creates the virtual implantation environment, enabling convenient planning without the wait.*​</span><br>\n<br>\n<br>\n*For Blueprint primary planning only. Manual segmentation required for Revision Planning</p>\n",
              "jcr:lastModified": "Thu Feb 26 2026 17:33:42 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "rightPadding": "5",
              "textIsRich": "true"
            }
