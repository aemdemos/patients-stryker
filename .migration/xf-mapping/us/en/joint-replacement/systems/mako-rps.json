      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_19707447": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "joelle.battista@stryker.com",
          "leftPadding": "5",
          "topPadding": "8",
          "jcr:lastModifiedBy": "joelle.battista@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Jul 24 2026 16:43:30 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1em\"><span class=\"fontsize-1-25em\">The Mako RPS Total Knee workflow does not require preoperative imaging and uses intraoperative registration and real-time guidance technology to support implant planning, alignment assessment and bone resection throughout the procedure. After tracker fixation and anatomy registration, the system enables the surgeon to evaluate alignment, visualize soft tissue balance data and adjust implant positioning before performing guided resections. Following bone preparation, trial and final alignment analyses help the surgeon confirm implant positioning and overall knee balance prior to final implantation.</span></span></p>\n",
          "jcr:lastModified": "Tue Aug 11 2026 15:54:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        }
      }
    },
