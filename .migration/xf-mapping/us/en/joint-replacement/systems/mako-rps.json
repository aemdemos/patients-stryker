          "alt": "OR staff looking at Mako RPS software screen",
          "srcFileRef": "/content/dam/stryker/joint-replacement/systems/mako-rps/3713450 STRYKER.COM PHOTO RETOUCH-TRANSPARENT.png",
          "borderColor": "rgba(76,125,122,1)",
