          "col1": {
            "jcr:primaryType": "nt:unstructured",
            "sling:resourceType": "wcm/foundation/components/parsys",
            "text": {
              "jcr:primaryType": "nt:unstructured",
              "bottomPadding": "5",
              "jcr:createdBy": "joelle.battista@stryker.com",
              "leftPadding": "5",
              "topPadding": "6",
              "jcr:lastModifiedBy": "joelle.battista@stryker.com",
              "hideComponent": "false",
              "jcr:created": "Fri Jul 24 2026 16:45:04 GMT+0000",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"fontsize-1em\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Step 1</span>: <b><span style=\"color: #4c7d7a;\">Anatomy registration</span></b>&nbsp;&nbsp;</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">The surgeon completes bone registration on the femur and tibia by collecting points on the surface of the patient's bone.&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"fontsize-1em\">During anatomy registration the surgeon selects the tibial boundary point. This registration point is used to generate a plane that deactivates resection capabilities if crossed, helping prevent cutting beyond this surgeon defined boundary.&nbsp;</span></span></li>\n</ul>\n",
              "jcr:lastModified": "Tue Aug 11 2026 14:33:05 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "rightPadding": "5",
              "textIsRich": "true"
            }
