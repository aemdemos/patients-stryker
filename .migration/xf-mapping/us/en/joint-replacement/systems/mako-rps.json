          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-1-75em\">Mako RPS</span></span></span></h1>\n<h2>&nbsp;</h2>\n<h2><span class=\"fontsize-1em\">Mako RPS (Robotic Power System) is a robotically enabled handpiece designed to give surgeons an intuitive, controlled cutting experience with robotic precision and a familiar handheld experience. The workflow does not require preoperative imaging and provides real-time intraoperative guidance to support bone preparation, implant positioning and alignment assessment throughout total knee arthroplasty.&nbsp;</span></h2>\n",
          "jcr:lastModified": "Fri Aug 21 2026 13:25:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
