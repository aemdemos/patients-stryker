      "hideComponent": "false",
      "jcr:created": "Fri Jul 12 2024 13:50:03 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-5em\">Join us in Las Vegas for an exclusive opportunity to learn more about our evolution from a nailing company to your go-to partner for everything trauma with the addition of the Pangea plating system.&nbsp;On <span class=\"futura-bold\">August 9th or 10th</span>, network with orthopaedic surgeons and healthcare administrators while gaining valuable insights from top industry experts.&nbsp;</span></p>\n",
      "jcr:lastModified": "Mon Jul 15 2024 15:40:40 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "4",
      "backgroundColor": "rgba(255,255,255,1)",
