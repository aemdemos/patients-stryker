      "gradientDirection": "left-to-right",
      "line1": "<span class=\"futura-bold\"><span class=\"fontsize-3vw\">At Stryker’s Trauma business, we are going <span style=\"color: #323232;\"><span style=\"color: #ffb500;\">full force.&nbsp;</span></span></span></span>",
