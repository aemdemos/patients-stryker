        "largeheadline_copy_1_59484456": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5b105250fc@example.invalid",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Thursday, October 24<sup>th</sup></span></span></span>",
          "line2": "<h3><span><span style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span class=\"futura-bold\">12:10pm - 1:00pm (lunch session)</span></span></span><br>\r\n</h3>\r\n<p><span class=\"fontsize-2-5-vw\"><span class=\"urw-egyptienne\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Industry session:<br>\r\n Case calamities &amp; coffee</span></span>&nbsp;<br>\r\n </span></span><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">at Industry Theatre B</span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">Featuring: Dr. Mark Reilly - Moderator, Dr. Krystin Hidden, Dr. Shasta Henderson and Dr. Joshua Gary&nbsp;</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><b>&nbsp;</b></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><b>Nothing is ever as simple as it seems.</b>&nbsp;Stryker invites you to join an interactive session where our faculty will present and discuss some of their own case calamities and experiences in orthopaedic trauma.</span></p>\r\n",
          "jcr:lastModified": "Mon Sep 09 2024 17:35:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
    },
