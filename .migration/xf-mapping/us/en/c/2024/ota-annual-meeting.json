        "largeheadline_copy_1_919440488": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5b105250fc@example.invalid",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Wednesday, October 23<sup>rd</sup></span></span></span>",
          "line2": "<h3><span><span style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span class=\"futura-bold\">12:00pm – 4:00pm</span></span></span><br>\r\n</h3>\r\n<p><span class=\"fontsize-2-5-vw\"><span class=\"urw-egyptienne\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><b>High School Scholars Program</b></span></span>&nbsp;<br>\r\n </span></span><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">at the Westin Hotel&nbsp;</span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">&nbsp;</span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><br>\r\n</span></span><span class=\"fontsize-1-5-vw\">The OTA High School Scholars Program (HSSP) launched in 2022 as way to provide early exposure to orthopaedic surgery and related careers. Due to the success of the initial program and the OTA's value of diversity, equity and inclusion, the HSSP has now become an annual event. This year's guest school will be Kahnawake Survival School.</span></p>\r\n<p>&nbsp;</p>\r\n",
          "jcr:lastModified": "Wed Sep 04 2024 20:31:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "sectionseparator_585930177": {
          "jcr:primaryType": "nt:unstructured",
