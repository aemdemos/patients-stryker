        "largeheadline_copy_1_920744147": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5b105250fc@example.invalid",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Thursday, October 24<sup>th</sup></span></span></span>",
          "line2": "<h3><span><span style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span class=\"futura-bold\">8:30am – 12:30pm</span></span></span><br>\r\n</h3>\r\n<p><span class=\"fontsize-2-5-vw\"><span class=\"urw-egyptienne\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Industry Partner Education Forum</span></span>&nbsp;<br>\r\n </span></span><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">at the Exhibit Hall (TBD)</span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">Chair: Dr. Mir</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\">This course is intended to provide an educational discussion forum with leading OTA Faculty and our Industry Partners to benefit our field and patient care.</span></p>\r\n<p>&nbsp;</p>\r\n",
          "jcr:lastModified": "Wed Sep 04 2024 15:09:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
