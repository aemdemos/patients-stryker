          "jcr:lastModifiedBy": "Marissa.DeBruyn@stryker.com",
          "jcr:created": "Thu Sep 13 2018 16:32:48 GMT-0400",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Rental Reduction Guarantee</span></span></p>\n<p>We guarantee a 50% reduction in non-capital support surface costs in the first year when using our surfaces.<sup>6</sup></p>\n",
          "jcr:lastModified": "Thu Sep 13 2018 17:02:45 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
