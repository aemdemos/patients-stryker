          "jcr:created": "Thu Sep 06 2018 16:29:18 GMT-0400",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">An inclusive Stryker <span style=\"color: #ffb500;\">experience</span></span></span></p>\n",
          "jcr:lastModified": "Thu Sep 13 2018 14:04:16 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1246167642": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Marissa.DeBruyn@stryker.com",
          "jcr:lastModifiedBy": "Marissa.DeBruyn@stryker.com",
          "jcr:created": "Thu Aug 02 2018 15:57:48 GMT-0400",
          "text": "<p>The Prevention 360 program is an outcomes-based partnership with Stryker. It provides a comprehensive financial guarantee for your facility helping to reduce falls, pressure injuries, and rentals—all in one package.<br>\n</p>\n",
          "jcr:lastModified": "Thu Sep 06 2018 16:28:41 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
