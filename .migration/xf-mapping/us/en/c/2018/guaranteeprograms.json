          "line1": "<p><span class=\"fontsize-4-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">$11 Billion</span><br>\r\n </span></span><span class=\"fontsize-2vw\"><span class=\"urw-egyptienne\">The annual treatment costs&nbsp;<br>\r\nfor pressure injuries<sup style=\"font-family: URWEgyptienneW01-Light, Rockwell, Georgia, Times, serif;\">1</sup></span></span></p>\r\n<p><b><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span class=\"fontsize-2vw\"><br>\r\n</span></span></span></b><b style=\"color: rgb(0,0,0);\"><span class=\"fontsize-4vw\"><span class=\"futura-bold\"><span class=\"fontsize-2vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\">Stryker's Guarantee Programs</span></span></span></span></span></span></span></b></p>\r\n",
          "line2": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\"><b>Reduce:</b>&nbsp;Pressure injuries by 30% | Surface rentals by 50%&nbsp;|<br>\r\n</span></span></p>\r\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">Falls by 50% or you get your money back.<sup>2</sup></span></span><br>\r\n</p>\r\n",
