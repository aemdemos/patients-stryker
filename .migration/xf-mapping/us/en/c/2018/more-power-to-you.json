          "gradientDirection": "left-to-right",
          "line1": "<div style=\"text-align: left;\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(28,86,135);\"><span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Introducing a new generation of better outcomes.&nbsp;</span></span></span></span></span></span></div>\r\n",
          "jcr:lastModified": "Tue Dec 18 2018 16:05:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,0)",
