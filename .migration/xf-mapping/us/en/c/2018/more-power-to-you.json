        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "Marissa.DeBruyn@stryker.com",
          "jcr:lastModifiedBy": "Marissa.DeBruyn@stryker.com",
          "jcr:created": "Mon Dec 17 2018 19:22:25 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\">Our powered system - Power-LOAD and Power PRO-XT – works together to allow EMS personnel to do their jobs more safely by raising, lowering, loading and unloading the cot at the touch of a button. Stop lifting. Start loading.</span></p>\n",
          "jcr:lastModified": "Tue Dec 18 2018 16:05:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
