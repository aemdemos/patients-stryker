    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "joseph.bonofiglio@stryker.com",
      "jcr:lastModifiedBy": "Marissa.DeBruyn@stryker.com",
      "jcr:created": "Tue May 01 2018 14:44:54 GMT-0400",
      "text": "<p><span class=\"fontsize-1-75em\">The industry’s <b>first and only</b> powered cot fastening system, Power-LOAD® is a <b>safe, durable and easy to use</b> solution that helps reduce the risk of debilitating back injuries for EMS caregivers.&nbsp;</span></p>\n<p><span class=\"fontsize-1-75em\">Power-LOAD hasn’t just stood the test of time – it’s evolved to meet our customers' needs. A decade of customer input has contributed to continuous design, quality, and reliability improvements – all designed with you, the healer, in mind.</span><b data-rte-class=\"rte-temp\"><span class=\"fontsize-1-75em\"></span></b></p>\n",
      "jcr:lastModified": "Mon Jan 14 2019 16:12:46 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
