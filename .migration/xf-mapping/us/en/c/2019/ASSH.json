              "gradientDirection": "left-to-right",
              "line2": "<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">• Fit for patients<br>\r\n</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">• Fit for procedures</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">• Fit for you</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"urw-egyptienne\">• Fit for the future</span></span></p>\r\n",
              "jcr:lastModified": "Mon Aug 26 2019 20:31:31 GMT+0000",
