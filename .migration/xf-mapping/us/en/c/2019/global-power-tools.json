          "gradientDirection": "left-to-right",
          "line1": "<div style=\"text-align: right;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-3-5-vw\">Built on history.&nbsp;<br>\r\n Built on innovation.&nbsp;<br>\r\n Built on solutions.</span></span><span class=\"fontsize-2-5-vw\"><span class=\"urw-egyptienne\"><br>\r\n </span></span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-4vw\">Built on trust.</span></span></span></div>\r\n",
          "jcr:lastModified": "Thu Apr 04 2019 17:43:34 GMT+0000",
