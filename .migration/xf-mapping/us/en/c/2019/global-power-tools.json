      "line1": "<div style=\"text-align: center;\"><span class=\"fontsize-3vw\"><span class=\"urw-egyptienne\">We don't just build power tools.&nbsp;</span><span class=\"futura-bold\"><span style=\"color: rgb(255,255,255);\">We build trust.</span></span></span></div>\r\n",
