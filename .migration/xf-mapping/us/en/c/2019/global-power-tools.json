    "cols2_1_3_2_3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "jcr:created": "Thu Apr 04 2019 17:23:48 GMT+0000",
      "jcr:lastModified": "Thu Apr 04 2019 17:23:48 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7065227e84@example.invalid",
          "jcr:lastModifiedBy": "user-5a4ae9843d@example.invalid",
          "jcr:created": "Wed Apr 03 2019 19:58:34 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">We don’t just<br>\n build power tools.&nbsp;<br>\n </span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">We build trust.</span></span></span></span></p>\n<p>No matter where you are in the world, no matter your surgical setting, Stryker is there to support you. Our surgical power tools, sales, and service offerings are created to help you do your best work, every time.&nbsp;</p>\n",
          "jcr:lastModified": "Fri May 10 2019 14:43:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7065227e84@example.invalid",
          "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
          "jcr:created": "Wed Apr 03 2019 20:03:37 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Let's </span><span class=\"futura-bold\"><span style=\"color: #ffb500;\">talk</span></span></span></span></p>\n<p><span class=\"urw-egyptienne\">At Stryker, we offer you a total value experience that includes an obsessive level of service from the operating room to the boardroom. Every customer is seen as a long-term surgical power tool partner. From day one we offer you unsurpassed sales, service, and financing support to tailor your experience to your needs.</span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"futura-bold\">Contact a rep today and get the conversation started.</span></span></p>\n",
          "jcr:lastModified": "Thu Apr 04 2019 17:21:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
