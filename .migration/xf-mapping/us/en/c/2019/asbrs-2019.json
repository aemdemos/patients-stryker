          "jcr:created": "Thu Apr 04 2019 16:21:34 GMT+0000",
          "text": "<h3><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #323232;\"><span style=\"color: #85458a;\">Learn from the experiences of Invuity Experts</span></span></span></span></h3>\n<h3>&nbsp;</h3>\n<h3>Thursday, May 2</h3>\n<p><span class=\"fontsize-1-25em\"><b>7:30-9pm<br>\n</b></span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">PhotonBlade<sup>®</sup> Dynamic Precision Illuminator with Enhanced Energy</span></span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Eikon<sup>®</sup> LT Illuminated Retractor System</span></span></p>\n<h3>&nbsp;</h3>\n<h3>Friday, May 3</h3>\n<p><span class=\"fontsize-1-25em\"><b>9:30-10am</b></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">PhotonBlade<sup>® </sup>Dynamic Precision Illuminator with Enhanced Energy</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Eikon<sup>®</sup> LT Illuminated Retractor System</span></span></p>\n<p><b><span class=\"fontsize-1-25em\">12-1:15pm</span></b></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">PhotonBlade® Dynamic Precision Illuminator with Enhanced Energy</span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Eikon® LT Illuminated Retractor System</span></span></p>\n",
