          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line2": "<h3><span style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span class=\"futura-bold\">Did you attend the <span style=\"color: #ffb500;\">experience?</span></span></span><br>\r\n</h3>\r\n<p><span class=\"fontsize-1-5-vw\">This year at OTA we showcased our latest technologies including T2 Alpha, ADAPT for Gamma3 and announced our upcoming launch of VariAx 2 Mini Fragment System.<br>\r\n <br>\r\n To bring our customers together, we hosted an educational experience allowing over 300 HCP's to learn more about our most recent product offerings.</span></p>\r\n<p><span class=\"fontsize-1-5-vw\">Missed this year’s event? Experience it for yourself by watching our event highlight video.</span><br>\r\n</p>\r\n",
          "jcr:lastModified": "Tue Oct 15 2019 17:22:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
