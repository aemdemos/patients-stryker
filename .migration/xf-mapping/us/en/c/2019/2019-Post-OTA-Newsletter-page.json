        "largeheadline_copy_1": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "jeannie.chan@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line2": "<p><a name=\"_Hlk21959727\" id=\"_Hlk21959727\"></a>T2 Alpha nails adapt to diverse intraoperative needs, addressing varying patient anatomy and preferences of the surgeon. New to the T2 Alpha nail is the Advanced Locking Screw option, which provides added axial and angular stability. &nbsp;These screws limit relative motion between the nail and screw, allowing surgeons to provide additional nail stability when needed.&nbsp; The implants are supported by new instrumentation which was designed for simplicity to improve the operative workflow.&nbsp;</p>\r\n<p>Learn more about the T2 Alpha nailing system here.</p>\r\n",
          "jcr:lastModified": "Wed Oct 30 2019 20:01:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
