          "jcr:created": "Tue Oct 15 2019 17:34:36 GMT+0000",
          "text": "<p><span style=\"font-size: 24.5px;\"><b><span class=\"futura-bold\">T2 Alpha</span><br>\n <span class=\"urw-egyptienne\">Nailing System</span></b></span></p>\n",
          "jcr:lastModified": "Tue Oct 29 2019 18:06:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
