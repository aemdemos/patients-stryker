        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Mon Apr 06 2020 22:19:43 GMT+0000",
          "srcFileRef": "/content/dam/stryker/communications/products/connectedor-ip/images/SYKC.Stryker.com.Products.COR-IP_R2-ASSETSPic1.png",
          "jcr:lastModified": "Mon Apr 06 2020 22:39:22 GMT+0000",
