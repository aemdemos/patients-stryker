          "srcFileRef": "/content/dam/stryker/communications/products/connectedor-ip/images/SYKC.Stryker.com.Products.COR-IP_R2-ASSETSPic3.png",
          "jcr:lastModified": "Mon Apr 06 2020 22:39:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Apr 06 2020 22:19:56 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\">Multiple install options</span></span></span></p>\n<ul>\n<li>Available Zero Footprint OR reduces clutter and creates more space</li>\n<li>Minimizes clinical impact and makes service easier</li>\n<li>Customizable to meet your project needs<sup>1</sup><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Thu Jul 16 2020 19:02:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
