        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Apr 06 2020 22:19:56 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\">Future-ready OR</span></span></span></p>\n<ul>\n<li>4K video routing today, ready for 8K and beyond</li>\n<li>Modular, scalable and upgradeable</li>\n<li>Platform for future growth</li>\n<li>Plug &amp; play functionality seamlessly connects your devices<sup>1</sup></li>\n</ul>\n",
          "jcr:lastModified": "Thu Jul 16 2020 19:02:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Mon Apr 06 2020 22:19:48 GMT+0000",
          "srcFileRef": "/content/dam/stryker/communications/products/connectedor-ip/images/SYKC.Stryker.com.Products.COR-IP_R2-ASSETSPic2.png",
          "jcr:lastModified": "Mon Apr 06 2020 22:39:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Apr 06 2020 22:19:56 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\">Delivers clinical value</span></span></span></p>\n<ul>\n<li>Uncompressed video ensures pixel-perfect images</li>\n<li>Connected device control improves efficiency and intraoperative workflow</li>\n<li>Staff command the room from a centrally-located intuitive user interface<sup>1</sup><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Thu Jul 16 2020 19:02:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
