  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Visum Blade LED</p>\r\n",
    "shortDescTop": "<p>We minimize the effects of shadows by using proprietary refractor technology to deliver consistent bright light, designed to ensure that your surgical field stays clearly illuminated no matter how crowded the case. With a simple flick of your wrist, you can adjust the brightness level and turn the light on and off from the surgical light handle. The Visum Blade surgical light provides simplified and intuitive sterile control so you can focus on the patient, not your surgical light.<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
    "jcr:lastModified": "Thu Aug 24 2017 14:15:24 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
