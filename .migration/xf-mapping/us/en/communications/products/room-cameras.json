  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>PTZ camera</p>\r\n",
    "shortDescTop": "<p>Stryker’s HD PTZ camera is a 1080p camera with 12X optical zoom for capturing both wide angles and long shots. With the ability to be controlled from Stryker’s Connected OR touch panel and support for 3G-SDI, HDMI, and IP Streaming (H.264, H.265 &amp; MJPEG), our HD PTZ camera offers a highly effective method of streaming HD video within your facility or to the rest of the world.&nbsp;&nbsp;</p>\r\n",
    "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
    "jcr:lastModified": "Tue Aug 22 2017 14:03:46 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
