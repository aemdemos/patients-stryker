  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Visum LED II</p>\r\n",
    "shortDescTop": "<p>The Visum LED II surgical light provides exceptional illumination with brilliant, pure white light. Delivering superior shadow resolution by utilizing reflector pod technology to ensure your surgical field stays clearly illuminated no matter how crowded the case. And the substantial depth of field allows you to set the light at the start of a case and trust it to keep the surgical site well lit without adjusting. This is truly a workhorse for the OR.<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
    "jcr:lastModified": "Thu Aug 24 2017 14:10:28 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
