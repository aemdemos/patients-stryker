      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Tue Apr 26 2022 16:31:35 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"urw-egyptienne\">Building a</span><br>\n <span class=\"futura-bold\"><span style=\"color: #ffb500;\">brighter future</span></span><br>\n <span class=\"urw-egyptienne\">together.</span></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Tue Apr 26 2022 16:34:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1836518206": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Tue Apr 26 2022 16:32:33 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Optimal illumination<br>\n </span><br>\n </span><span class=\"fontsize-1-25em\">With the power of dual reflector technology, the Accend surgical light provides you with bright, white illumination for your surgical site.</span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><br>\nSlim profile<br>\n </span><br>\n </span><span class=\"fontsize-1-25em\">A sleek, lightweight frame offers a reduced footprint and impressive maneuverability.</span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><br>\nSterile control<br>\n </span><br>\n </span><span class=\"fontsize-1-25em\">With convenience and ease of use at top of mind, sterile control offers your surgical staff the functionality to control your lights from the sterile field.</span></p>\n",
          "jcr:lastModified": "Tue Apr 26 2022 16:34:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
