  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>OR renovation services</p>\r\n",
    "shortDescTop": "<p>Our comprehensive solution provides complete control of the renovation project and equipment installation. We manage your patient care environment projects&nbsp;through every phase-from the design concept, construction and the first case.</p>\r\n<p>&nbsp;</p>\r\n<p>Mitigate risks, realize consistent outcomes, and capitalize on more efficient project timelines through the utilization of our consolidated project planning and management services. Coupled with our extensive product portfolio of booms, lights, tables and integration equipment we create a true consolidated solution.</p>\r\n",
    "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
    "jcr:lastModified": "Tue Aug 22 2017 14:55:22 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
