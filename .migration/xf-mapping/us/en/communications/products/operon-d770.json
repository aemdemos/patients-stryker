  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Operon D770</p>\r\n\r\n",
    "shortDescTop": "<p>The Operon D770 offers an 18.3” wide integrated x-ray channel designed to eliminate the need for separate x-ray tops. The D770 maintains a 1,000lb weight capacity in any articulation in normal orientation.</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>With a focus on safety, the D770 provides your OR staff peace of mind with a manual backup system with foot pump and emergency keypad located on the column.<br>\r\n\r\n</p>\r\n\r\n",
    "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
    "jcr:lastModified": "Thu Aug 24 2017 13:56:09 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
