      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-98fdffe29c@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Jan 24 2024 19:35:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Enhance clarity</span></span></span></p>\n<p><span class=\"fontsize-1-25em\">The Oculan Platform delivers Stryker’s first clinical advancement in surgical lighting.&nbsp;The Oculan + feature of SHD Mode.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">SHD (Surgical High-Definition) Mode, offered exclusively with Oculan +, enables the removal of perceived red from the surgical site which is designed to improve contrast, tissue differentiation, and reduction of glare off instrumentation to improve the visual experience.&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">The Oculan Platform includes specialized clinical applications such as Microspot and SHD Mode* (Oculan +) to enhance clarity and improve the visualization experience in open surgeries. These cutting-edge features provide new levels of illumination and precision.</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jun 19 2026 18:18:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
