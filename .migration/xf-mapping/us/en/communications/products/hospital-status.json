        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
          "jcr:created": "Mon Apr 06 2020 23:18:56 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Increase</span><br>\n <span class=\"urw-egyptienne\">hospital efficiency</span></span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\">Hospital Status system</span></span></span></p>\n<ul>\n<li>Stream up to 40 independent video feeds</li>\n<li>Configure an unlimited number of groups for organized room views</li>\n<li>Intuitive touch control for easy room viewing</li>\n<li>Cycle through configured room groups</li>\n<li>Viewing on desktop or tablet&nbsp;</li>\n</ul>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #4c7d7a;\">HD room camera</span></span></span></p>\n<ul>\n<li>H.264 video streaming format reduces strain on hospital network</li>\n<li>High-definition video signal</li>\n<li>Provides visible image under dark lighting conditions</li>\n<li>Multiple points of control are supported</li>\n<li>Multiple mounting options</li>\n<li>Digital PTZ control&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Mon Apr 06 2020 23:21:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
