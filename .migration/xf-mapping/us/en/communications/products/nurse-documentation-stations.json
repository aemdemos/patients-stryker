  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Nurse documentation stations</p>\r\n",
    "shortDescTop": "<p>Whether you need extra countertop workspace for charting or robust upper cabinets for equipment storage, we have a documentation station design just for you.</p>\r\n",
    "jcr:lastModifiedBy": "user-5891a4f69d@example.invalid",
    "jcr:lastModified": "Tue Aug 22 2017 14:00:31 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Strategically placed vents on every configuration allow for maximum heat dissipation from medical equipment stored within the unit&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Built-in cable passes, removable shelves, and snap-in false backs facilitate easy equipment installation and servicing&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Brackets mounted to each frame provide provision for 10 dual power junction boxes per cabinet&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Sliding shelf in base cabinet provided for simplified servicing and upgrading of integration equipment&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Optional GCX touch panel mount, extended countertop and mobile desk allow the nurse to face the surgical field from the documentation station</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
