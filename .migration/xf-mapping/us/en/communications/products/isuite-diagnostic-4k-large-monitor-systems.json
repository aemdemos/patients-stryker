  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>iSuite diagnostic 4K large monitor systems<br>\r\n</p>\r\n",
    "shortDescTop": "<p>Along with its size and resolution, Eizo’s large scale monitors for procedural suites display images from multiple modalities simultaneously. This improves your efficiency by consolidating images in one location, resulting in better comfort, concentration and visualization.</p>\r\n<p>&nbsp;</p>\r\n<p>Critical video and images can be scaled and displayed to preference and non-critical data can be dynamically removed. Preferred video layouts can be predefined and recalled on demand.</p>\r\n",
    "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
    "jcr:lastModified": "Tue Aug 22 2017 14:01:20 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
