  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>High-definition LCD monitors</p>\r\n",
    "shortDescTop": "<p>We offer a portfolio of high-definition LCD monitors that deliver quality images and efficient power consumption.&nbsp;&nbsp;</p>\r\n",
    "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
    "jcr:lastModified": "Tue Aug 22 2017 13:50:57 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Full high-definition (HD) display that produces HD content with clarity and accuracy for enhanced visualization&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Excellent power efficiency by LED backlight&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Auto-dimming that detects light in the surrounding area and automatically optimizes the brightness of the display&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fan control to protect the panel from damage caused by overheating&nbsp; &nbsp;&nbsp;<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
