  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>The Stryker Sirca Exam Light provides bright and shadow-resistant exam lighting. Along with the excellent depth of field, the Sirca Exam Light can be used in several critical applications. Multiple mounting options make for easy positioning. With 80,000 lux, and 5 levels of intensity control, Sirca brings light where you need it. The Sirca Exam Light is a functional lighting solution designed to meet your critical care and emergency needs across the ED, Trauma, and ICU environments.</p>\r\n",
    "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
    "hideComponent": "true",
