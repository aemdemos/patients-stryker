            "gradientDirection": "left-to-right",
            "line1": "<h1><span class=\"fontsize-5vw\"><span class=\"futura-bold\">ProCare</span><br>\r\n <span class=\"urw-egyptienne\">Service Advantage</span></span></h1>\r\n",
