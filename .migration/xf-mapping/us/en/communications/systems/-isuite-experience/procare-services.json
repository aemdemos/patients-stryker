      "jcr:created": "Mon Mar 30 2020 18:29:09 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"fontsize-4vw\"><span class=\"urw-egyptienne\">Everyday, you count on your medical equipment<br>\r\n </span><span class=\"futura-bold\">to perform at its best.</span></span>",
      "line2": "<span class=\"fontsize-1-5-vw\"><br />\r\nProcare isn't just a service program, it's a relationship you can count on from the very beginning.</span>",
      "jcr:lastModified": "Fri Apr 03 2020 20:00:06 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
