          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Invision</span></span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><sup><span class=\"fontsize-1-5em\">®</span></sup></span></span><span class=\"fontsize-2-5em\"><br>\n <span class=\"urw-egyptienne\">Total Ankle Revision System</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"><br>\n</span><span class=\"futura-bold\">First and only</span><sup>2</sup><span class=\"futura-bold\"> true TAR revision system</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The </span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">Invision</span><sup><span class=\"fontsize-1-5em\">®</span></sup><span class=\"fontsize-2em\"> Total Ankle Revision System</span></span></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> was designed with revision surgery in mind. Used as a standalone construct or in conjunction with Inbone</span></span><span class=\"urw-egyptienne\"><sup><span class=\"fontsize-1-5em\">®</span></sup></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> and Infinity</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\"><sup>®</sup></span></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> components, Invision</span></span><span class=\"urw-egyptienne\"><sup><span class=\"fontsize-1-5em\">®</span></sup></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> adds a level of modularity never seen before* in Total Ankle Arthroplasty.</span></span></p>\n",
          "jcr:lastModified": "Tue Mar 18 2025 16:38:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
