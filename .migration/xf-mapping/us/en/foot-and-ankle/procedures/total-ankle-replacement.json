          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">Total Ankle Continuum of Care</span></span></span></h2>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Stryker addresses&nbsp;<span class=\"futura-bold\">End Stage Ankle Arthritis (ESAA)</span> with a full range of solutions. Whether you’re planning a primary or addressing a complex revision, our Total Ankle Replacement&nbsp;portfolio provides a range of solutions for patients with differing needs for their ankle pain issues.</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The <span class=\"futura-bold\">Total Ankle Continuum of Care</span> is the perfect example of how Stryker is working with our customers to make healthcare better.</span></span></p>\n",
          "jcr:lastModified": "Tue Mar 04 2025 15:01:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
