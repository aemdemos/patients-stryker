          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Inbone</span></span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><sup><span class=\"fontsize-1-5em\">®</span></sup></span></span><span class=\"fontsize-2-5em\"><br>\n <span class=\"urw-egyptienne\">Total Ankle Replacement</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">Enhanced Tibial Fixation for complex primaries</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Since its inception in 2005, the <span class=\"futura-bold\"><span style=\"color: #ffb500;\">Inbone</span></span></span></span><span class=\"urw-egyptienne\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><sup>®</sup></span></span></span></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"> Total Ankle System</span></span> has continued to be one of the most distinctive and innovative total ankle replacement systems on the market. For almost 20 years, the Inbone system has aided countless surgeons in addressing&nbsp;high priority complex ankle cases with enhanced tibial fixation.&nbsp;</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"><br>\nAfter almost 2 decades, Inbone remains the only<sup>2</sup> modular stemmed ankle prosthesis on the market and continues to be one of the fastest growing choices of TAR surgeons.<sup>6</sup></span></span></p>\n",
          "jcr:lastModified": "Tue Mar 18 2025 16:38:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
