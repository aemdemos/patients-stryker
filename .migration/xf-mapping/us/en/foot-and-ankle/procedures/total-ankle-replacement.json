        "text_652839079": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Total ankle replacement is a procedure used to treat ankle arthritis. By replacing the ankle joint and allowing motion to occur, it provides an alternative to ankle arthrodesis.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Stryker is constantly innovating in the Total Ankle Replacement space.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">As the market leader in Total Ankle&nbsp;Replacement</span><sup><span class=\"fontsize-1-5em\">1</span></sup><span class=\"fontsize-2em\">, our knowledge, expertise, and passion for improving outcomes for&nbsp;patients suffering from Ankle Arthritis is best displayed by the clinical&nbsp;outcomes of the implants that form our </span></span><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">Total&nbsp;Ankle Continuum of Care</span></span></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">.</span></span></p>\n",
          "jcr:lastModified": "Wed Oct 09 2024 19:10:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
