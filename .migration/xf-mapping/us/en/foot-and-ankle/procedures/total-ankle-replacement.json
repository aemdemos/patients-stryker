          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Prophecy</span></span></span><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><sup><span class=\"fontsize-1-5em\">®</span></sup></span></span><span class=\"fontsize-2-5em\"><br>\n <span class=\"urw-egyptienne\">Surgical Planning</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><br>\n</span></span><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">The first</span></span><span class=\"fontsize-1-5em\"><sup>2</sup></span><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"> patient specific instrumentation for Total Ankle Replacement</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Since 2014, </span></span><span style=\"color: #ffb500;\"><span class=\"futura-bold\"><span class=\"fontsize-2em\">Prophecy</span><sup><span class=\"fontsize-1-5em\">®</span></sup><span class=\"fontsize-2em\"> Surgical Planning</span></span></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> has been leading the way in accurate</span></span><span class=\"urw-egyptienne\"><sup><span class=\"fontsize-1-5em\">3</span></sup></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> implantation of Total Ankle Replacement.</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Through Prophecy, surgeons are able to take the headache out of the operating room by knowing sizing, alignment, and other valuable case details long before stepping into the OR.&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Wed Oct 09 2024 19:14:01 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
