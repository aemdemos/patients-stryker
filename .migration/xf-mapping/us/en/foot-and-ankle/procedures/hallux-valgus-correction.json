          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><b>Hallux valgus correction</b> may involve a combination of osteotomy, fusion, and soft tissue procedures depending on deformity severity, joint stability, and patient-specific anatomy. Stryker supports these procedures with a portfolio of fixation technologies designed for use across both minimally invasive and traditional surgical workflows.</span></p>\n",
          "jcr:lastModified": "Fri Sep 18 2026 18:51:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
