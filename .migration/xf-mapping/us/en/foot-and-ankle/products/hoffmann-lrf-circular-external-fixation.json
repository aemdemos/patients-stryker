      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_652839079_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">Designed for stability</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">A typical Hoffmann</span></span><span class=\"urw-egyptienne\"><sup><span class=\"fontsize-1-25em\">®</span></sup></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> LRF construct may feature two or more rings bridged by three to four telescopic struts with multiplanar, ball-jointed fixation bolts. Once applied, the LRF can be unlocked for gross frame adjustment and fracture reduction. The frame can be finely adjusted to aid in precise limb alignment and definitively locked with secure, advanced locking features.</span></span></p>\n",
          "jcr:lastModified": "Sun Aug 11 2024 17:30:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
