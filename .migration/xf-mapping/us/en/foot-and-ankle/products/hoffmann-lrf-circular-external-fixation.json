          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Circular external fixation for applications in fractures, joint contractures, fusions, limb lengthening, deformity correction and bone and soft tissue reconstruction.</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2-5em\">Stable. Smart. Simple.</span></span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The Hoffmann LRF is a modern circular fixation system designed to reduce construct complexity and simplify application.</span></span></p>\n",
          "jcr:lastModified": "Fri Jul 26 2024 14:43:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
