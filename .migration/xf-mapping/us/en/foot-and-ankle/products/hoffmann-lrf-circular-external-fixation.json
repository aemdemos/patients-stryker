      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_652839079_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">System highlights</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Choice of aluminum rings or radiolucent carbon fiber rings</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Telescopic struts designed to allow for controlled dynamization without compromising frame stability</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The length of the telescopic struts can be fine-tuned once the frame is assembled.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Wire bolts designed to increase tension holding power compared to the predicate device</span></span><span class=\"urw-egyptienne\"><sup><span class=\"fontsize-1-5em\">*1</span></sup></span></li>\n</ul>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-25em\">*Tested against the Ilizarov Wire Bolt from Smith &amp; Nephew.</span></p>\n",
          "jcr:lastModified": "Fri Jul 26 2024 14:56:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
