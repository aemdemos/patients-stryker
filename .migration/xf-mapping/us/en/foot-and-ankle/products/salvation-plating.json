    "cols2_1692718478": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "jcr:created": "Tue Dec 26 2023 18:45:29 GMT+0000",
      "jcr:lastModified": "Tue Dec 26 2023 18:45:29 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Tue Dec 26 2023 18:47:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Two distinct plate options<br>\n </span></span><span style=\"font-size: 1.25em; font-family: URWEgyptienneW01-Light, Rockwell, Georgia, Times, serif;\"><span class=\"fontsize-1-25em\">Specific plate geometry is designed to enhance construct strength while still facilitating soft tissue closure; compression features in all plates.</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Bridge plate<br>\n </span></span><span style=\"font-size: 1.25em; font-family: URWEgyptienneW01-Light, Rockwell, Georgia, Times, serif;\"><span class=\"fontsize-1-25em\">Contoured to fit the specific anatomy of the medial column and provides the maximum number of screw hole options available in the system.</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Recon plate<br>\n </span></span><span style=\"font-size: 1.25em; font-family: URWEgyptienneW01-Light, Rockwell, Georgia, Times, serif;\"><span class=\"fontsize-1-25em\">A low-profile option, while maintaining strength and anatomic fit.</span></span></p>\n",
          "jcr:lastModified": "Wed Jun 12 2024 15:15:52 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
