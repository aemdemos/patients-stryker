          "hideComponent": "false",
          "jcr:created": "Tue Dec 19 2023 23:00:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">Designed to address</span><span style=\"color: #000000;\"><span style=\"color: #ffb500;\">&nbsp;</span>the unique demands of advanced midfoot reconstruction</span></span></span></h3>\n",
          "jcr:lastModified": "Wed Jun 12 2024 15:14:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "topPadding": "2",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Dec 26 2023 18:44:28 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">This system focuses on treating cases such as neuropathic deformity requiring arthrodesis of the medial column, with or without corrective osteotomies. Patients with poor quality, soft bone (e.g. Charcot), require a larger, more stable construct than traditional plates, as well as improved screw design for enhanced fixation. The Salvation&nbsp;3Di Plating System is designed to specifically address these patients, while allowing for ease of soft tissue closure over the construct.</span></span></p>\n",
          "jcr:lastModified": "Tue Oct 15 2024 14:00:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
