          "hideComponent": "false",
          "jcr:created": "Wed Apr 17 2024 16:02:00 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Based on the long-standing tradition of simplicity of the original Hoffmann Fixator, the Hoffmann family of products are designed to match today’s biological repair and reconstruction methods. Following suit with the Hoffmann LRF’s advanced component foundation, telescopic motors and hinged telescopic struts offered in the Gradual Correction tray augment the Hoffmann LRF platform for indications requiring gradual corrective adjustments. The gradual correction tray introduces telescopic hinge struts and telescopic motor struts for procedures requiring gradual corrective adjustments.</span></span></p>\n",
          "jcr:lastModified": "Sun Jul 28 2024 16:35:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
