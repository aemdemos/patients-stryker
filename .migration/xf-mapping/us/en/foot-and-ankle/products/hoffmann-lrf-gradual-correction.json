    "cols2_655850619": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Apr 17 2024 16:12:57 GMT+0000",
      "jcr:lastModified": "Wed Apr 17 2024 16:12:57 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Apr 17 2024 16:12:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">Performance inspired by simplicity</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The Hoffmann LRF System includes a streamlined set of components designed to accomplish reconstructive procedures. With fewer subcomponents to assemble and minimal points of adjustment, the struts are designed to be less cumbersome to apply and easier for the patient to adjust.&nbsp;</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Engineered with high-performance materials machined to precise tolerances, components are designed to be low-profile, which may improve physical access and radiographic visibility without compromising stability.</span></span></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Sun Aug 11 2024 17:35:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
