    "cols2_92696720": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Apr 17 2024 16:13:44 GMT+0000",
      "jcr:lastModified": "Wed Apr 17 2024 16:13:44 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Apr 17 2024 16:13:52 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">Hinged telescopic struts</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Designed to align and pivot around a specified axis of rotation. This is accomplished via universal hinged couplings integrated into the telescopic strut’s design.</span></span></p>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Quick release mechanism allows for rapid gross length adjustment.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Ball-jointed fixation bolts allow the struts to be mounted to rings that are not parallel or of different diameters.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Length of the strut can be fine-tuned by rotating the quick release mechanism (in a locked position) relative to the threaded portion of the strut. One full revolution represents 2mm of travel.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Adjustable from 125-150mm in length ring-to-ring.</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jul 26 2024 16:08:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
