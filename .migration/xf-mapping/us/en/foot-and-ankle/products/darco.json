        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Fri May 17 2024 15:35:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Headless compression screw</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">7.0mm titanium-alloy composition ranging in lengths from 40-110mm with short (16mm) and long (32mm) distal thread length options</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Aggressive distal top and proximal cutting flutes to enhance fixation and prevent screw spin-out</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Single tray system to provide logistical and surgical efficiency</span></span></li>\n</ul>\n",
