          "jcr:created": "Fri May 17 2024 15:35:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Headed compression screws</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Options include 2.7mm, 3.5mm, 4.0mm, 4.5mm, 6.5mm, and 7.5mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Titanium-alloy composition</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Short, long, and fully threaded options available</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jun 11 2024 16:02:30 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
