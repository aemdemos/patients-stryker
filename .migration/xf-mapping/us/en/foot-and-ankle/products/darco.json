        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Fri May 17 2024 15:32:29 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The <span class=\"futura-bold\">Darco Cannulated Compression screw&nbsp;system</span> is a multi-size, multi-indication screw system designed specifically for the forefoot, midfoot, and hindfoot anatomy. All screws are designed to be self-drilling and self-tapping, and feature a reverse cutting flute for easy removal. With headed screw diameters ranging from 2.7mm to 7.5mm and a headless 7.0mm option, the Darco Cannulated Compression&nbsp;screw system offers multiple options to solve a variety of foot and ankle issues.</span></span></p>\n",
          "jcr:lastModified": "Fri Jul 12 2024 14:11:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
