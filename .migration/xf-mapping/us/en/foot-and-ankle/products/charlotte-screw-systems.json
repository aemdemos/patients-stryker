          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The <span class=\"futura-bold\"><span style=\"color: #ffb500;\">Charlotte</span> Multi-Use Compression Screw System</span>&nbsp;features a headless, cannulated design made from stainless steel. These screws are appropriate for certain osteotomies and fusions of the forefoot, midfoot, and hindfoot. The screw distinguishes itself with a double-lead helical thread pattern at the leading end of the screw, which doubles the thread engagement in the distal bone fragment. In addition, its spiral-fluted cutting design allows the screw to be self-tapping and self-drilling.&nbsp;</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Jul 12 2024 14:19:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
