    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "daniela.marino1@stryker.com",
      "jcr:lastModifiedBy": "david.gilmour@stryker.com",
      "jcr:created": "Tue Jun 11 2024 19:39:53 GMT+0000",
      "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">The <span class=\"futura-bold\"><span style=\"color: #ffb500;\">Charlotte</span> Snap-Off Screws</span> are made from titanium alloy and feature self-drilling and self-tapping abilities. Simply place the bony fragments in the desired position and drive the screws to secure. The next generation snap-off feature ensures that the screw head is smooth after the driving shank has been broken off.</span></span></p>\n",
      "jcr:lastModified": "Fri Jul 12 2024 14:20:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
