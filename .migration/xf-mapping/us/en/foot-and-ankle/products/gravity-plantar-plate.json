          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\"><span style=\"color: #ffb500;\">Key benefits</span></span></span><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><br>\n</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Quick&nbsp;<br>\n </span></span><span style=\"font-size: 1.5em; font-family: URWEgyptienneW01-Light, Rockwell, Georgia, Times, serif;\">Simplified instrumentation with two surgical steps eliminated</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Easy<br>\n </span></span><span style=\"font-size: 1.5em; font-family: URWEgyptienneW01-Light, Rockwell, Georgia, Times, serif;\">Reusable and disposable kits streamlined for ease of use and waste reduction</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Reproducible<br>\n </span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">The Gravity Double Barrel<sup>®</sup> Drill Guide ensures zero probability of crossing bone tunnels</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Sep 09 2024 19:35:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
