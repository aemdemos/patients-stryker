  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Cannulated screw systems</p>\r\n",
    "shortDescTop": "<p>Stanley Asnis, MD invented the cannulated screw in the 1980’s, which became a major facilitator for advancing minimally invasive surgery in orthopaedics.<sup>1, 2</sup> The Asnis cannulated screw system continues to offer foot and ankle surgeons an extensive range of lengths and diameters for a multitude of procedural purposes.<br />\r\n</p>\r\n",
    "jcr:lastModifiedBy": "david.gilmour@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Mon May 12 2025 19:35:16 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Full range of size options – Ø4.0, 5.0, 6.5, 8.0</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Low profile screw head may reduce potential for soft-tissue irritation and offers improved external aesthetics</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Self-drilling/self-tapping design</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      }
    }
  },
