          "hideComponent": "false",
          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Stanley Asnis, MD invented the cannulated screw in the 1980’s, which became a major facilitator for advancing minimally invasive surgery in orthopaedics.</span><sup><span class=\"fontsize-1-25em\">1, 2</span></sup><span class=\"fontsize-2em\"> The Asnis cannulated screw system continues to offer foot and ankle surgeons an extensive range of lengths and diameters for a multitude of procedural purposes.</span></span></p>\n",
          "jcr:lastModified": "Mon May 12 2025 19:30:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Full range of size options – Ø4.0, 5.0, 6.5, 8.0</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Low profile screw head may reduce potential for soft-tissue irritation and offers improved external aesthetics</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Self-drilling/self-tapping design</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon May 12 2025 19:32:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
