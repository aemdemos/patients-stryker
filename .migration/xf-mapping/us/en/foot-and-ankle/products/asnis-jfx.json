          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Designed for efficiency and strength, the Asnis JFX system is indicated to treat 5th metatarsal fractures.</span></span></p>\n",
          "jcr:lastModified": "Mon May 12 2025 20:04:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\"><b>Efficient: </b>Use the same K-wire, drill and screwdriver for all screw diameters (4.0, 5.0, 6.0mm)</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\"><b>Strong:</b> Solid and cannulated screws are made from Type 2 anodized titanium. Our solid screws show increased fatigue strength across all diameters when compared to similar dedicated Jones Fracture Systems.<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Tue Apr 28 2026 13:37:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
