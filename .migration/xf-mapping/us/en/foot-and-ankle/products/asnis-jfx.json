  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>Designed for efficiency and strength, the Asnis JFX system is indicated to treat 5<sup>th</sup> metatarsal fractures. <br />\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Mon May 12 2025 20:06:57 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Efficient:&nbsp;Use the same K-wire, drill and screwdriver for all screw diameters (4.0, 5.0, 6.0mm)</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Strong: Solid and cannulated screws are made from Type 2 anodized titanium. Our solid screws show increased fatigue strength across all diameters when compared to similar dedicated Jones Fracture Systems.<sup>1</sup><br>\r\n</p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
