          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"futura-bold\"><span class=\"fontsize-5vw\"><span style=\"color: rgb(255,181,0);\">Asnis<sup><span class=\"fontsize-1-5-vw\">® </span></sup>JFX<br>\r\n</span></span></span><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(0,0,0);\"><span class=\"urw-egyptienne\"><span class=\"fontsize-3-5-vw\">Screws System</span></span></span></span></h1>\r\n",
