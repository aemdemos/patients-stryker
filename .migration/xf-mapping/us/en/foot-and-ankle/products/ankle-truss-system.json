        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Tue Jun 18 2024 18:07:50 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\"><span style=\"color: #1c5687;\">Spherical reamers for foot &amp; ankle</span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">First acetabular reamers designed specifically for revision ankle fusion and limb preservation, including smaller sizes more commonly needed for this procedure.<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Wed Mar 26 2025 21:33:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
