    "table_copy_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-42b58e166b@example.invalid",
      "tableData": "<table width=\"100%\" cellspacing=\"2\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td style=\"text-align: center;\"><b>&nbsp;</b></td>\n<td style=\"text-align: center;\"><b>ATS clinical evidence<sup>2,3,4</sup></b></td>\n<td style=\"text-align: center;\"><b>IM nail literature for failed TAA or AA<sup>5,6,7,8</sup></b></td>\n<td style=\"text-align: center;\"><b>IM nail + bulk allograft literature<sup>9,10</sup></b></td>\n</tr><tr><td style=\"text-align: center;\"><b>Mean follow up time months [range]</b></td>\n<td style=\"text-align: center;\">28.9 [1-65]<br>\n(n=68)</td>\n<td style=\"text-align: center;\">41.0 [2-88]<br>\n(n=43)</td>\n<td style=\"text-align: center;\">45.5 [11.4-67.2]<br>\n(n=16)</td>\n</tr><tr><td style=\"text-align: center;\"><b>Fusion rates % [range]</b></td>\n<td style=\"text-align: center;\">92.6% [80.0-95.2]<br>\n(n=68)</td>\n<td style=\"text-align: center;\">69.8% [33.3-100]<br>\n(n=43)</td>\n<td style=\"text-align: center;\">62.5% [60-64]<br>\n(n=16)</td>\n</tr><tr><td style=\"text-align: center;\"><b>Pain score</b></td>\n<td style=\"text-align: center;\">100 mm VAS<br>\n<b>Preop:</b> 74.6 (Severe)*<br>\n<b>Postop:</b> 25.4 (Mild)*<br>\nn=49</td>\n<td style=\"text-align: center;\">AOFAS pain<br>\n<b>Preop:</b> 11.7 (Severe, n=12)<br>\n<b>Postop:</b> 33.5 (Mild, n=28)</td>\n<td style=\"text-align: center;\">NR</td>\n</tr><tr><td style=\"text-align: center;\"><b>Functional score</b></td>\n<td style=\"text-align: center;\"><p>AOFAS<br>\n<b>Preop:</b> 28.4 (n=15)<br>\n<b>Postop:</b> 64.8 (n=15)</p>\n<p>FAAM ADL<br>\n<b>Preop:</b> 28.9 (n=36)<br>\n<b>Postop:</b> 64.9 (n=36)</p>\n</td>\n<td style=\"text-align: center;\">AOFAS pain<br>\n<b>Preop:</b> 11.7 (Severe, n=12)<br>\n<b>Postop:</b> 33.5 (Mild, n=28)</td>\n<td style=\"text-align: center;\"><p>AOFAS<br>\n<b>Postop:</b> 73.9 (n=16</p>\n<p>FFI<br>\n<b>Preop:</b> 77.06 (n=5)<br>\n<b>Postop:</b> 34.82 (n=5)</p>\n</td>\n</tr></tbody></table>\n",
      "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
      "jcr:created": "Fri Aug 16 2024 13:27:39 GMT+0000",
      "jcr:lastModified": "Mon Jul 07 2025 22:48:31 GMT+0000",
      "sling:resourceType": "stryker/components/content/table",
      "textIsRich": "true"
    },
    "cols_901297270_copy": {
      "jcr:primaryType": "nt:unstructured",
