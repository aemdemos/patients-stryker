      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Ankle Truss System Clinical Evidence included the retrospective study and two white papers (Raikin et. al' and Dekker et. al') reporting results of theirown ATS studies.</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The Ankle Truss System data was compared to the two current standards of care: arthrodesis with just an IM Nail and arthrodesis with an IM nail + Bulk allograft.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Thu Mar 27 2025 00:26:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
