        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2-5em\">Fusion for patients who need it the most.</span></span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">In a retrospective study, over 92% of patients showed fusion throughout the ankle joint using ATS implant technology, compared to the literature on IM nail with bulk allograft, showing 62.5% fusion rate.</span></span></p>\n",
          "jcr:lastModified": "Mon Mar 31 2025 19:48:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
