          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">The Ankle Truss System (ATS) is an innovative solution for failed ankle replacements and limb salvage, offering standardized implants for faster treatment. Powered by Truss Implant Technology™, it is designed to promote bone growth, distribute load efficiently, and minimize subsidence. With digital pre-planning tools and specialized reamers, ATS can streamline surgery with a viable solution in patients whose only alternative may be amputation (BKA).</span></span></p>\n",
          "jcr:lastModified": "Mon Jul 07 2025 22:48:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
