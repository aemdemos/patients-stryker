          "jcr:created": "Tue Jun 18 2024 18:07:50 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #85458a;\"><span style=\"color: #85458a;\"><span style=\"color: #ffb500;\">Care delivered faster</span></span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Instead of a 4-to-6 week typical waiting time for a custom designed implant<sup>1</sup>, time-sensitive patients can be treated as soon as next day.</span></span></p>\n",
          "jcr:lastModified": "Mon Apr 07 2025 20:02:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
