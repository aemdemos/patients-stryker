          "jcr:created": "Tue Jun 18 2024 18:07:50 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\">Off-the-shelf sizes</span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">First FDA cleared product offering standardized sizes for failed ankle replacements and complex limb salvage cases.<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Wed Mar 26 2025 21:32:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
