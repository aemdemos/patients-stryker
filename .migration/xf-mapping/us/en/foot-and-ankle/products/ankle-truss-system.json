          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Tue Jun 18 2024 18:07:50 GMT+0000",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #4c7d7a;\"><span style=\"color: #85458a;\">Foot &amp; ankle focused</span></span></span></span></p>\n<p style=\"text-align: center;\"><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">No more customs required. No more sourcing loose instruments. Everything you need in one place.</span></span></p>\n",
