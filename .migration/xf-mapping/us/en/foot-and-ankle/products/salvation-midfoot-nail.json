        "text_864176890": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Dec 19 2023 23:00:35 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffb500;\">Designed to address</span> the unique demands of advanced midfoot reconstruction</span></span></h3>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">The Salvation Midfoot Nailing System can be used in conjunction with external fixation, additional nails, beams, plates, or contact casting until bony fusion has occurred.</span></span></p>\n",
          "jcr:lastModified": "Mon Oct 14 2024 20:34:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1143458872": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Dec 19 2023 23:01:14 GMT+0000",
      "jcr:lastModified": "Tue Dec 19 2023 23:01:14 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Tue Dec 19 2023 23:01:28 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-75em\">Designed for strength</span></span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">The Salvation Midfoot Nail is an 8mm intramedullary device that provides the strength of a nail with the ease of a beam.</span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Withstands bending</span></span><span class=\"fontsize-1-75em\"><br>\n <span class=\"urw-egyptienne\">Proven to withstand bending force better than beams and bolts.<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:10:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
