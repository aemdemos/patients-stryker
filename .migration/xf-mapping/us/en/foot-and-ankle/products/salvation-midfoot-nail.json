      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Tue Dec 19 2023 23:01:28 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Specifications</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Lengths: 60-160mm by 5mm increments</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">25mm thread length</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">3.5mm non-locking screw</span></span></li>\n</ul>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Controlled compression</span><span class=\"urw-egyptienne\"><br>\n Cross-locking technology provides anti-migration capabilities while also being capable of providing up to 8mm of controlled compression across the fusion sites.</span></span></p>\n",
          "jcr:lastModified": "Mon Sep 16 2024 19:11:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
