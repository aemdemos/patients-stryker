    "text": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "3",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "topPadding": "1",
      "jcr:lastModifiedBy": "david.gilmour@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Tue Dec 19 2023 22:55:49 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">This system focuses on treating cases such as neuropathic deformity requiring arthrodesis of the medial and lateral columns, with or without corrective osteotomies. Patients with poor quality, soft bone (e.g. Charcot), require implants specifically designed to deliver strength and maintain purchase in these difficult cases.</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Indicated for fixation of fractures, osteotomies, reconstruction procedures, non-unions, and fusions of bones in the foot and ankle including the Metatarsals, Cuneiforms, Cuboid, Navicular, Calcaneus and Talus. Specific examples include: Intramedullary Medial Column Fusion, Lateral Column Fusion and Subtalar Fusions resulting from neuropathic osteoarthropathy (Charcot).</span></span></p>\n",
      "jcr:lastModified": "Wed Jun 12 2024 15:50:00 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "cols": {
