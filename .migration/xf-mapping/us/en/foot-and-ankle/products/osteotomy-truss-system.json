    "cols_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-42b58e166b@example.invalid",
      "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
      "jcr:created": "Wed Sep 11 2024 14:30:47 GMT+0000",
      "jcr:lastModified": "Wed Sep 11 2024 14:30:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_652839079_copy__2125200229": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The Osteotomy Truss System</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">™</span></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> has an Advanced Structural Design that incorporates 4WEB Medical’s proprietary Truss Implant Technology</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">™</span></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">. Under normal loading conditions the struts in the truss implant transfer strain to adjacent cellular material which stimulates a mechanobiologic response.</span></span><span class=\"urw-egyptienne\"><sup><span class=\"fontsize-1-5em\">1-3</span></sup></span></p>\n",
          "jcr:lastModified": "Mon Nov 17 2025 22:09:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Key features</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Provides a snowshoe interface that distributes load minimizing point loading and reducing the risk of subsidence (collapsing).</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Truss Implant is designed to provide maximum strength with a minimal amount of material, which limits imaging artifacts.<sup>7</sup></span></span><span style=\"font-family: URWEgyptienneW01-Light, Rockwell, Georgia, Times, serif; font-size: 2em;\"></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Hierarchical surface roughness stimulates cell differentiation.<sup>4,5</sup></span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Open architecture design allows for greater graft volume and bone growth throughout the entire construct.<sup>6,7</sup></span></span></li>\n</ul>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Mon Nov 11 2024 20:17:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy__1522618116": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">System offerings</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The Osteotomy Truss System consists of three sterile-packed implant designs in a variant of footprints and opening wedge height options. There are 28 utility wedge sizes, 28 cotton wedge sizes, and 18 Evans wedge sizes.</span></span></p>\n",
          "jcr:lastModified": "Fri Sep 27 2024 19:12:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
