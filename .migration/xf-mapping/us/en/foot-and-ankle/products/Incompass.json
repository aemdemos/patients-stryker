          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Jun 01 2026 17:55:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">A harmonized continuum</span></span></p>\n<p><span class=\"fontsize-1-5em\">Incompass allows seamless switching between peg and stemmed implants, with a low-profile, bone preserving approach.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:22:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
