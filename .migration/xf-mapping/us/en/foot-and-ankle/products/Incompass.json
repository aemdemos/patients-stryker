          "preset": "max_width_1440",
          "jcr:created": "Tue Jun 02 2026 18:18:32 GMT+0000",
          "alt": "surgeon-centric-img",
          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/incompass/images/surgeon-centric-img.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jun 02 2026 23:02:48 GMT+0000",
