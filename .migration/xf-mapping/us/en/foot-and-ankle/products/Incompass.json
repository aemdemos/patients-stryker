      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "hideComponent": "false",
      "topMargin": "-2",
      "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p style=\"text-align: center;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Incompass isn’t just our next advancement—it’s a reimagining of the arthritic ankle, built from the ground up with surgeon insight and real-world data. Every decision was driven by the goal to reinvent what’s possible for total ankle care—streamlining workflow, expanding intraoperative flexibility, and enabling surgeons in their pursuit of improved patient outcomes.</span></span></p>\n",
      "jcr:lastModified": "Tue Jun 02 2026 23:22:24 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
