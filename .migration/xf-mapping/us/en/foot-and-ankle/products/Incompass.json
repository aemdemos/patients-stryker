          "jcr:created": "Mon Jun 01 2026 17:55:25 GMT+0000",
          "alt": "shapedbydata-img",
          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/incompass/images/shapedbydata-img.png",
          "borderColor": "rgba(76,125,122,1)",
