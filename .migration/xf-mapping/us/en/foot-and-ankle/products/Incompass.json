          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/incompass/images/CTA -2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jul 07 2026 18:31:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "linkInternal": "/content/stryker/us/en/foot-and-ankle/products/Incompass.html#contact",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "topPadding": "3",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Jun 02 2026 18:13:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span class=\"fontsize-2-5em\">Stryker’s ankle <span class=\"futura-bold\"><span style=\"color: #ffb500;\">legacy and data.</span></span></span><br>\n</span> <span class=\"fontsize-1-75em\">Instruments driven by a total understanding of surgeon needs</span></span></p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:24:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2064985580_cop_1116567206": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Jun 02 2026 18:18:17 GMT+0000",
      "jcr:lastModified": "Tue Jun 02 2026 18:18:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Jun 02 2026 18:18:32 GMT+0000",
          "alt": "provensuccess-img",
          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/incompass/images/provensuccess-img.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jun 02 2026 23:05:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Jun 01 2026 17:55:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Built on proven success</span></span></p>\n<p><span class=\"fontsize-1-5em\">Incompass Total Ankle System was designed to mimic the profile and fixation of both Infinity and Inbone. The profile, fixation, and sulcus articulation from both Infinity and Inbone and the clinical survivorship (98% survivorship at 5 years for Inbone Total Ankle3 &amp; 1.6% Revision Rate for Infinity Total Ankles at 2-5 year follow-up<sup>4</sup>) informed the initial design.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:24:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Jun 02 2026 18:18:32 GMT+0000",
          "alt": "enhancedfixation-img",
          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/incompass/images/enhancedfixation-dropshadow.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jun 02 2026 23:08:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Jun 01 2026 17:55:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Enhanced fixation</span></span></p>\n<p><span class=\"fontsize-1-5em\">Incompass offers a complete system of 3D-printed porous metal tibial and talar components, which act like scaffolds, promoting early boney ingrowth (often as early as four weeks).<sup>2</sup></span><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:27:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2064985580_cop_1926666548": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Jun 02 2026 18:18:17 GMT+0000",
      "jcr:lastModified": "Tue Jun 02 2026 18:18:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Jun 02 2026 18:18:32 GMT+0000",
          "alt": "surgicalflex-img",
          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/incompass/images/surgicalflex-img.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jun 02 2026 23:06:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Jun 01 2026 17:55:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Surgical flexibility</span></span></p>\n<p><span class=\"fontsize-1-5em\">The Incompass instrumentation is designed specifically for intraoperative flexibility, allowing surgeons to seamlessly switch implant types to meet the needs of a variety of patient’s unique anatomies.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:24:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Tue Jun 02 2026 18:18:32 GMT+0000",
          "alt": "opefficiency-img",
          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/incompass/images/opefficiency-img-dropshadow.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Jun 02 2026 23:08:09 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Jun 01 2026 17:55:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Operational efficiency</span></span></p>\n<p><span class=\"fontsize-1-5em\">The system streamlines OR flow by reducing the instrument burden, enhancing planning accuracy, and saving the hospital sterilization time leading to a reduction in cost.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:24:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "text_298313840_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
