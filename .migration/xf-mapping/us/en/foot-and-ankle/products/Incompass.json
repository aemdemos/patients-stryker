        },
        "text_copy_copy_copy_1717217014": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "text": "<p><span class=\"fontsize-1-25em\">Have questions or inquiries? We’re&nbsp;here to help! Fill out the contact form, and our dedicated team will get back to you promptly. Your feedback and inquiries are important to us, and we look forward to assisting you with any information or support you may need.</span></p>\n",
          "jcr:lastModified": "Mon Aug 18 2025 20:12:23 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
