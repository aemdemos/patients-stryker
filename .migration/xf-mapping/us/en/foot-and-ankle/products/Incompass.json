      "jcr:created": "Mon Jun 01 2026 17:44:00 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-4vw\">Not just our next innovation.</span></span></p>\r\n<p style=\"text-align: center;\"><span class=\"futura-bold\"><span class=\"fontsize-4vw\"><span style=\"color: rgb(255,181,0);\">A new understanding.</span></span></span></p>\r\n",
      "jcr:lastModified": "Tue Jun 02 2026 23:41:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
