      "textIsRich": "true"
    },
    "fullbleedpanel": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Jun 02 2026 18:32:00 GMT+0000",
      "jcr:lastModified": "Tue Jun 02 2026 18:32:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/fullbleedpanel",
      "backgroundColor": "rgb(66,83,97)",
      "fbleedparsys": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "topPadding": "5",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Jun 02 2026 18:32:38 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span style=\"color: #ffffff;\"><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">We applied the science of the Stryker Orthopaedic Modeling and Analytics (SOMA) system to define the anatomy of the arthritic ankle. We then merged this knowledge with the data and experience of Infinity and Inbone to create the ideal next generation implant. With Incompass, we have designed a total ankle replacement that harmonizes pegged and stemmed implants into a single streamlined system that is designed to match the anatomy of the arthritic ankle.&nbsp;</span></span></span></p>\n<p style=\"text-align: center;\"><span style=\"color: #ffffff;\"><br>\n<span class=\"fontsize-2em\"><span class=\"futura-bold\">“Incompass is a <span style=\"color: #ffb500;\">technically advanced, easy to use total ankle system</span> that surgeons can implant efficiently to optimize patient outcomes.”</span></span></span></p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:47:38 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Jun 02 2026 18:13:58 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p style=\"text-align: center;\"><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Jeremy McCormick, MD<br>\n </span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #ffffff;\">Chief, Foot and Ankle Surgery<br>\n Washington University in St. Louis</span></span></span></p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\"><span style=\"color: #ffffff;\"><span class=\"fontsize-8em\">Dr. McCormick is a paid-consultant of Stryker Orthopaedics.<br>\nThe opinions expressed by Dr. McCormick are those of Dr. McCormick and not necessarily those of Stryker.&nbsp;Individual experiences may vary.</span></span></p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:42:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
