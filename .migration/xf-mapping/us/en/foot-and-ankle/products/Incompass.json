      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Jun 01 2026 17:55:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Surgeon-centric design</span></span></p>\n<p><span class=\"fontsize-1-5em\">Designed with insights from 100,000 total ankle cases<sup>1</sup>, the Incompass instrumentation is refined for precision, efficiency and ease of use. The Adjustment Arc and C-Bracket are designed to deliver the stability and accuracy you count on, while the additional redesigned instruments deliver enhanced feel and fit.</span></p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:23:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2064985580": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Jun 02 2026 18:18:17 GMT+0000",
      "jcr:lastModified": "Tue Jun 02 2026 18:18:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Jun 01 2026 17:55:30 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Less instruments. More choices.</span></span></p>\n<p><span class=\"fontsize-1-5em\">By harmonizing the system and streamlining the instruments, Incompass helps minimize setup and sterilization time and improve overall efficiency. Incompass offers a continuum of implant options which support versatility across cases, allowing surgeons to respond quickly intraoperatively to different anatomies.</span><br>\n</p>\n",
          "jcr:lastModified": "Tue Jun 02 2026 23:23:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
