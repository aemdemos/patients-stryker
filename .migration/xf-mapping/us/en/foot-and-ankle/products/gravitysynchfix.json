          "jcr:created": "Mon Mar 04 2024 22:36:59 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\">Compatible with Ortholoc 2 LP Ankle Fracture Plates</span></span></p>\n",
          "jcr:lastModified": "Mon Oct 27 2025 19:56:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
