        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Mon Mar 04 2024 22:36:59 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Gravity Synchfix is compatible with plates from the Ortholoc 2 LP Ankle Fracture Plating System. The system includes a Syndesmosis Plate and a Lateral Fibula Plate that both come in Straight and Offset options for the syndesmotic plate holes.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Tue Mar 12 2024 03:13:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
