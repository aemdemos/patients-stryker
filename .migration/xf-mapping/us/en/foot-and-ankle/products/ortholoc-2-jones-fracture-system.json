    "cols_104421577_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "jcr:created": "Wed Mar 06 2024 21:02:05 GMT+0000",
      "jcr:lastModified": "Wed Mar 06 2024 21:02:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Mar 06 2024 21:04:31 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">Ortholoc 2 Jones Fracture</span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Screws are available in 2 types (chamfered and headless), 3 diameters (4.5, 5.5, and 6.5mm), and multiple lengths (35-60mm, in 5mm increments)</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Type II anodized titanium-alloy, solid core make up for increased material fatigue strength</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Headed screws have a chamfer head to avoid cuboid impingement (a site of painful hardware in 9-30% of patients), while the headless screws have a differential proximal to distal thread pitch for compression.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">System includes a 5th metatarsal specific targeting guide designed to help visualize implant trajectory and reduce alignment time</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Jul 01 2024 18:57:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
