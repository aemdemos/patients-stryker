    "cols2_1515544698_cop": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "jcr:created": "Wed Mar 06 2024 19:49:10 GMT+0000",
      "jcr:lastModified": "Wed Mar 06 2024 19:49:10 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Mar 06 2024 19:49:50 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">Reinvented profile</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The first and only</span></span><span class=\"urw-egyptienne\"><sup><span class=\"fontsize-1-25em\">1</span></sup></span><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> anatomically designed chamfered screw head to reduce lateral cuboid impingement; a site of painful hardware in 9%-30% of patients.</span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><sup>2</sup></span></span></p>\n",
          "jcr:lastModified": "Mon Jun 17 2024 18:07:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Mar 06 2024 19:49:57 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">Dual headless compression</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Instrument assisted dual compression for increased fracture reduction.</span></span></p>\n",
          "jcr:lastModified": "Wed May 08 2024 15:11:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
