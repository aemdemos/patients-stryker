          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">We offer comprehensive options for your headless and twist-off screw needs. Both types of screws are manufactured from titanium alloy and available in a range of sizes. The patented screw thread design features reverse thread angles designed for enhanced compression&nbsp;and fixation.<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Tue Jul 14 2026 21:36:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\">Self-drilling, self-tapping</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\">Fixation for a variety of fusions and osteotomies</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\">Headless feature is&nbsp;designed to help reduce soft tissue injuries</span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jul 14 2026 21:28:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
