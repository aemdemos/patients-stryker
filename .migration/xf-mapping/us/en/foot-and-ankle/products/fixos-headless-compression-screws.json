  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>We offer comprehensive options for your headless and twist-off screw needs. Both types of screws are manufactured from titanium alloy and available in a range of sizes. The patented screw thread design features reverse thread angles for optimized compression and stable fixation<sup>1</sup><br />\r\n<br />\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Mon May 12 2025 18:02:34 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Self-drilling, self-tapping&nbsp;</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Stable fixation for a variety of fusions and osteotomies</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Headless feature is designed to reduce soft tissue injuries</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      }
    }
  },
