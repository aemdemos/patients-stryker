    "text_652839079_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
      "hideComponent": "true",
      "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h3><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-25em\">Key benefits</span></span></span></h3>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Maintained strength - Biofoam<sup>®</sup> Cancellous Titanium<sup>™</sup> matrix maintains compressive strength throughout the remodeling process.<sup>1</sup></span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Precise and reliable correction - pre-sized wedges designed specifically for foot &amp; ankle indications.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Porosity of the osteoconductive matrix allows for integration of bone.</span></span></li>\n</ul>\n<p>&nbsp;</p>\n",
      "jcr:lastModified": "Fri Oct 18 2024 20:36:30 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
