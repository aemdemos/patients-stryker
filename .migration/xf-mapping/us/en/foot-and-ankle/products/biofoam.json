          "jcr:created": "Tue Aug 30 2022 19:17:34 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-5vw\">Biofoam<sup><span class=\"fontsize-1-5-vw\">®</span> <br />\r\n</sup></span></span></span><span style=\"color: rgb(255,181,0);\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span class=\"urw-egyptienne\"><span class=\"fontsize-4-5-vw\">Wedge System</span></span></span></span></span></h1>\r\n",
          "line2": "<h2><span style=\"font-weight: normal;\"><span class=\"fontsize-2-5-vw\">Biofoam Innovative Cancellous Titanium<sup>™</sup> provides consistent strength and fixation for osteotomies.&nbsp;</span></span><br>\r\n</h2>\r\n",
          "jcr:lastModified": "Mon May 05 2025 18:32:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
