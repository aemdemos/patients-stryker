          "hideComponent": "false",
          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Low profile. Dynamic compression.</span></span></h3>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Designed to facilitate fast and easy fixation in a variety of applications, EasyClip allows for active compression across the osteotomy site avoiding pin tract infections and stress risers to promote healing.<sup>1</sup></span></span></p>\n",
          "jcr:lastModified": "Wed May 14 2025 15:18:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "text": "<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">No heat activation required</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Fast and easy insertion</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Range of sizes available from 8-25mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Symmetric or asymmetric leg lengths to fit anatomy</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Patented forceps allow for simple intraoperative repositioning<sup>2</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed May 14 2025 14:58:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
