  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Low profile. Dynamic compression.</p>\r\n",
    "shortDescTop": "<p>Designed to facilitate fast and easy fixation in a variety of applications, EasyClip allows for active compression across the osteotomy site avoiding pin tract infections and stress risers to promote healing.<sup>1</sup> <br />\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Wed May 14 2025 15:18:30 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>No heat activation required</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Fast and easy insertion</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Range of sizes available from 8-25mm</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Symmetric or asymmetric leg lengths to fit anatomy</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Patented forceps allow for simple intraoperative repositioning<sup>2</sup></li>\r\n</ul>\r\n",
        "textIsRich": "true"
      }
    }
  },
