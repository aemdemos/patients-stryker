          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Nov 01 2023 18:48:56 GMT+0000",
          "text": "<p><span class=\"fontsize-2-5em\"><span class=\"futura-bold\">Mini Maxtorque zero profile headed screws</span></span></p>\n",
          "jcr:lastModified": "Fri Jun 07 2024 17:55:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
