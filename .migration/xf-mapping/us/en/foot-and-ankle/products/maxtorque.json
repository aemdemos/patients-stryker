        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Mon Apr 08 2024 23:38:22 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Options include 2.5mm, 3.2mm, and 3.8mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Zero profile head for reduced soft tissue irritation</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Self-drilling, self-tapping and reverse cutting flutes for ease of removal</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Cutting flutes in the head to facilitate insertion</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jun 07 2024 17:54:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
