        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Mon Apr 08 2024 23:16:54 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Options include 4.0mm, 5.5mm, and 7.0mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Titanium-alloy and color coded for a user friendly system</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Self-drilling, self-tapping and reverse cutting flutes for ease of removal</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jun 07 2024 17:53:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
