    "cols2_2_3_1_3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "david.gilmour@stryker.com",
      "jcr:lastModifiedBy": "david.gilmour@stryker.com",
      "jcr:created": "Tue Jul 23 2024 16:02:17 GMT+0000",
      "jcr:lastModified": "Tue Jul 23 2024 16:02:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_652839079_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Key features</span></span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Thin, low-profile design for minimal bone resection</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Stem offset dorsally for anatomically correct alignment in medullary canal</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Rectangular shape base minimizes chance of rotation</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Vertical cut angle reduces potential for dorsal impingement</span></span></li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Wed Sep 11 2024 17:50:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_652839079_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-1-75em\"><span style=\"color: #ffb500;\"><span class=\"futura-bold\">Impant features</span></span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Single-piece, sterile-packed implant</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Highly polished cobalt chrome articular surface</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Plasma spray titanium coating on stem</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jul 23 2024 17:43:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
