        "text_652839079_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The Lesser Metatarsal Head (LMH) Implant is a hemi-resurfacing implant intended to replace a portion of the articular surface of the lesser metatarsal head. The device is intended to articulate against the proximal phalanx. The implant is available in three sizes, which are individually sterile-packed.</span></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Wed Sep 11 2024 17:49:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
