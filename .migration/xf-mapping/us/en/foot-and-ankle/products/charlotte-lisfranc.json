          "jcr:created": "Tue Apr 09 2024 18:22:17 GMT+0000",
          "text": "<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Screws available in diameters of 3.7mm and 4.5mm along with 4-, 5-, 6-, or 9-hole plate options.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">All screws and plates manufactured from solid-core surgical-grade stainless steel for strength, stiffness and resistance to bending fatigue.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Market-first cannulated technique allows for accuracy and surgical efficiency.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Radiolucent targeting guide for X-ray visualization.</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Jul 15 2024 20:40:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
