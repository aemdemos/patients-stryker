    "cols_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Nov 01 2023 18:43:29 GMT+0000",
      "jcr:lastModified": "Wed Nov 01 2023 18:43:29 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Nov 01 2023 18:43:36 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Intended to treat hyperpronated foot and stabilize the subtalar joint. The&nbsp;</span></span><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Futura CSI Implant</span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">&nbsp;is a one-piece device made of Titanium (6AL-4V ELI). The implant is intended to be implanted into the sinus tarsi of the foot.&nbsp;The Futura CSI Implants are intended to block forward, downward, and medial displacement of the talus, thus allowing normal subtalar joint motion but blocking excessive pronation and the resulting sequela.</span></span></p>\n",
          "jcr:lastModified": "Fri Jan 09 2026 17:44:20 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_219915771": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Dec 13 2023 22:46:58 GMT+0000",
      "jcr:lastModified": "Wed Dec 13 2023 22:46:58 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 13 2023 22:49:21 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">Key features</span></span></span></p>\n",
          "jcr:lastModified": "Fri Jan 09 2026 17:42:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 13 2023 22:49:21 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Conical implant geometry accommodates the sinus tarsi anatomy, aids insertion, and allows for an adjustment in blocking motion.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Progressively softened threads are designed to minimize edge effects that may lead to pain while resisting migration.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Fully cannulated to guide accurate insertion. Apertures allow for soft tissue in-growth.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Supporting instrumentation features color-coded, radio-opaque trials for verification of placement.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Acts as a spacer for the joint, maintaining the joint space, allowing for range of motion, but limiting excessive pronation.</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jan 09 2026 17:42:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
