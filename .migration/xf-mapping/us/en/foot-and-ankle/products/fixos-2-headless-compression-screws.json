  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Not just a screw.</p>\r\n",
    "shortDescTop": "<p>We offer a full range of headless compression screw options for your midfoot and rearfoot fusion needs. The patented thread configuration features a reverse thread design for optimized compression and stable fixation.<sup>1</sup></p>\r\n<p><sup> </sup></p>\r\n<ul>\r\n</ul>\r\n",
    "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Mon May 12 2025 18:57:24 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>4.0, 5.0, 7.0 size options</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Stable fixation for a variety of fusions and osteotomies</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Type 2 Anodized Titanium</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Reverse cutting flutes</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Interchangeable instrument tray modules and modular screw racks to meet the needs of your practice</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      }
    }
  },
