        "text_652839079": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">The </span></span><b><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Dart-Fire Cannulated Screw System</span></span></b><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\"> is comprised of cannulated, partially-threaded titanium-alloy screws that are indicated for use in bone reconstruction, osteotomy, arthrodesis, joint fusion, fracture repair, and fracture fixation. With self-drilling and self-tapping headed and headless compression screws in diameters ranging from 2.0mm to 4.0mm, the Dart-Fire small screw system provides extensive versatility for surgical procedures of the foot, within one comprehensive system.</span></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Wed Jul 17 2024 18:04:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "section_title": {
