      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Jun 11 2024 20:42:09 GMT+0000",
      "jcr:lastModified": "Tue Jun 11 2024 20:42:09 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 27 2023 00:59:17 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Headed cannulated screws</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Options include 2.0mm, 2.5mm, 3.0mm, 3.5mm, and 4.0mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Titanium-alloy composition and color-coded by diameter to easily identify associated instrumentation</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Self-drilling and self-tapping</span></span><br>\n</li>\n</ul>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Mon Jun 24 2024 18:37:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Wed Dec 27 2023 00:59:17 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Headless cannulated screws</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Options include 2.5mm and 3.0mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Differential thread pitch on proximal vs. distal thread to allow for compression</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Titanium-alloy composition and color-coded by diameter to easily identify associated instrumentation</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jun 21 2024 18:11:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
