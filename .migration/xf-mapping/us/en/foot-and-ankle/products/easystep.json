          "gradientDirection": "left-to-right",
          "line1": "<h1><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-5vw\">EasyStep</span><sup><span class=\"fontsize-1-5-vw\">®</span></sup><span class=\"fontsize-5vw\"> <br />\r\n </span></span></span><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-4-5-vw\"><span style=\"color: rgb(0,0,0);\"><span class=\"urw-egyptienne\">Nitinol implant</span></span></span></span></h1>\r\n",
