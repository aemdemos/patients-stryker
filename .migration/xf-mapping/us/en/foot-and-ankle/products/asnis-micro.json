  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Cannulated screw systems</p>\r\n",
    "shortDescTop": "<p>Stanley Asnis, MD invented the cannulated screw in the 1980’s, which became a major facilitator for advancing minimally invasive surgery in orthopaedics.<sup>1, 2</sup> The Asnis Micro cannulated screw systems enhances this legacy, offering dedicated screws for the foot and ankle surgeon.</p>\r\n<ul>\r\n</ul>\r\n",
    "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Tue May 13 2025 13:54:36 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Ø2.0 and 3.0mm titanium screw size options</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Low profile screw head may reduce potential soft-tissue irritation and offer improved external aesthetics</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Self-drilling/self-tapping design with a reverse cutting flute</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      }
    }
  },
