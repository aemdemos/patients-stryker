  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Transforming the soft tissue experience.</p>\r\n",
    "shortDescTop": "<p>SonicAnchor utilizes SonicFusion™ technology to allow for interdigitation of the implant with the surrounding cancellous bone structure.<br />\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Mon Mar 17 2025 15:21:47 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Ultrasonic technology liquefies anchor tip – the polymer interdigitates in surrounding cancellous bone and solidifies</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<ul>\r\n<li>Small footprint: 2.5mm suture anchor for all indications</li>\r\n</ul>\r\n",
        "textIsRich": "true"
      }
    }
  },
