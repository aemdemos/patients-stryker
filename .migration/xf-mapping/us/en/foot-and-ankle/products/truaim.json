          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Fri May 17 2024 17:27:38 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">TruAim </span>Lisfranc</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Radiolucent, single use targeting guide with instrumentation to reduce the Lisfranc joint</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Pre-determined trajectories to aid in accurate and reproducible percutaneous screw placement</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Designed to accept Asnis III 5.0mm and Charlotte Lisfranc 4.5mm screws</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Aug 12 2024 19:14:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
