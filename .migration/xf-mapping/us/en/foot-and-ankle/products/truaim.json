          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Fri May 17 2024 17:28:00 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">TruAim</span> Lapidus</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Two radiolucent, single use guides to assist in anatomic placement of a two screw Lapidus construct</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Aim for speed and reproducibility with pre-determined trajectories for two screws, allowing the setup for an additional screw, plating, or staple to be placed&nbsp;</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Accepts multiple screw systems including Asnis III, Fixos 2, DartFire Edge, and PROstep MIS Chamfered screws</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Jun 25 2024 16:56:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
