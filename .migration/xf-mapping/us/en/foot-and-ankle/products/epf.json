      "jcr:created": "Fri May 09 2025 18:50:17 GMT+0000",
      "jcr:lastModified": "Fri May 09 2025 18:50:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Tue Dec 12 2023 22:34:40 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\">The plantar fascia is the flat band of tissue (ligament) that connects the heel bone to the toes. It supports the arch of the foot.&nbsp;</span></p>\n<p><span class=\"fontsize-1-5em\">The EPF system is a minimally invasive surgical technique when compared with traditional open surgical techniques for chronic plantar fasciitis (fasciosis).&nbsp;&nbsp;</span></p>\n<p><span class=\"fontsize-1-5em\">The bi-portal system is designed to allow for placement of the cannula, inferior to the surface of the plantar fascia. Instrumentation is procedure-specific and is designed for endoscopic visualization of the plantar fascia.&nbsp;Cannula guide markings allow the surgeon to execute a medial 1/3 fascia division.</span></p>\n",
          "jcr:lastModified": "Mon Jun 08 2026 15:37:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
