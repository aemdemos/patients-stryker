  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>The T2 Ankle Arthrodesis Nail offers strong biomechanical intramedullary stabilization using cannulated implants for the tibiotalocalcaneal fusion. The nailing system’s targeting device is made of radiolucent carbon fiber and features our patented friction locking mechanism. T2 also offers controlled internal compression, so with every turn, you achieve 1mm of internal compression and better control.</p>\r\n",
    "jcr:lastModifiedBy": "user-4ed7efab4d@example.invalid",
    "jcr:lastModified": "Wed Feb 12 2020 17:15:23 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Type II anodized alloy (Ti6A14V)</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Integrated internal compression option allows for controlled tibiotalar compression</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Axial stable distal locking screws designed for increased stability</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>5° lateral (valgus) bend</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
