  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>The Hoffman II MRI External Fixation System has been designed in compliance with ASTM Designation F2503-05. This unique systemic approach focuses on the two key areas of concern in MRI use: frame displacement due to magnetic (mechanical) forces and frame heating due to induced electrical currents (thermal forces).&nbsp;</p>\r\n",
    "jcr:lastModifiedBy": "douglas.depreker@stryker.com",
    "jcr:lastModified": "Mon Feb 10 2020 21:43:59 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Hoffmann II MRI system is made of nonferromagnetic and nonconductive materials.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Allows surgeons to build different types of frame construct without additional risk for patient in MRI environment up to 3.0 Tesla.</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
