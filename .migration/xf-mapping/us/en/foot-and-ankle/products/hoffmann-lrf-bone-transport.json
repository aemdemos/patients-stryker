    "cols2_1100056983": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Fri Apr 12 2024 22:19:46 GMT+0000",
      "jcr:lastModified": "Fri Apr 12 2024 22:19:46 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Fri Apr 12 2024 22:27:49 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">Goals of bone transport surgery</span></span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">1. Restore osseous integrity (continuity)</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">2. Maintain mechanical axis</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">3. Restore length and normal rotation</span></span></p>\n<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">4. Minimize infection</span></span></p>\n",
          "jcr:lastModified": "Fri Jul 26 2024 15:40:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
