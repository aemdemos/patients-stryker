          "jcr:created": "Fri Apr 12 2024 21:54:39 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Based on the long-standing tradition of simplicity of the original Hoffmann Fixator, the Hoffmann family of products are designed to match today’s biological repair and reconstruction methods. Continuing the legacy of innovation found in the Hoffmann External Fixation product family, the market’s first dedicated bone transport strut is available in the Hoffmann LRF Circular External Fixation System.</span></span></p>\n",
          "jcr:lastModified": "Fri Jul 26 2024 15:37:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
