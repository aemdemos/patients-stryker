    "cols2_740527475": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Fri Apr 12 2024 22:30:05 GMT+0000",
      "jcr:lastModified": "Fri Apr 12 2024 22:30:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Apr 12 2024 22:30:12 GMT+0000",
          "alt": "Transport Struts",
          "srcFileRef": "/content/dam/stryker/foot-and-ankle/products/hoffmann-lrf-bone-transport/images/TransportStruts.png",
          "borderColor": "rgb(0,0,0)",
          "jcr:lastModified": "Thu Jun 06 2024 23:03:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "david.gilmour@stryker.com",
          "jcr:created": "Fri Apr 12 2024 22:27:49 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">Transport struts</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Designed for bone transport procedures but can be modified for bone lengthening procedures.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Derotation posts on the moving and distal ring mounting arms allow for ring attachment above or below the mounting arm depending upon the anatomy at the affected site.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">If necessary, the moving ring ball joint can be unlocked to allow for +/- 6º of multiplanar angulation of the moving ring.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Quick release mechanisms on the moving and distal ring mounting arms allow for rapid adjustment.</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Dimples located around the strut’s clicking mechanism are designed to help patients track adjustment progress and keep consistent record of their corrections, which may improve compliance.</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Fri Jul 26 2024 15:39:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
