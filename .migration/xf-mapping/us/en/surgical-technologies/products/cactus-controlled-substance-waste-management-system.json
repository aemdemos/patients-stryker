  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Cactus Smart Sink System</p>\r\n",
    "shortDescTop": "<p>Securely captures unused pharmaceutical waste and renders it unusable and non-recoverable - ensuring discarded medications do not end up in the wrong hands or negatively impact the environment. The Smart Sink System is designed to accept raw liquid pharmaceuticals directly from syringes, vials and IV bags, and features a one-way funnel that accepts tablets, capsules and patches. </p>\r\n",
    "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Mon Feb 16 2026 16:48:46 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Reduce opportunities for drug diversion</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Bring your facility into compliance with disposal requirements</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Help protect the environment</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
