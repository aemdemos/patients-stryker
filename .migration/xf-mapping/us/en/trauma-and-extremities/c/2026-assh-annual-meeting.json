    "cols_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-b2cf110515@example.invalid",
      "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
      "jcr:created": "Fri Aug 08 2025 16:09:02 GMT+0000",
      "jcr:lastModified": "Fri Aug 08 2025 16:09:02 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b2cf110515@example.invalid",
          "topPadding": "4",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "hideComponent": "false",
          "rightMargin": "5",
          "jcr:created": "Fri Aug 08 2025 16:07:56 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Together with you, </span><span class=\"futura-bold\"><span style=\"color: #ffffff;\"><span style=\"color: #ffb500;\">we are full force&nbsp;</span></span></span><br>\n <span class=\"urw-egyptienne\">More than a portfolio. </span><span class=\"futura-bold\">A trusted partner in the <span style=\"color: #ffb500;\">moments that count.&nbsp;</span>&nbsp;</span></span></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">At this year's ASSH Annual Meeting, we're showing up with intention, for hand and wrist surgeons, their patients and the future of hand and wrist care.&nbsp;&nbsp;</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Together with you, we are full force is more than a message. It reflects our commitment to being a trusted partner - listening, learning and continuously evolving to help address today's challenges while investing in what's next.&nbsp;</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Explore how we're bringing that commitment to life at ASSH, from product innovation and hands-on education to opportunities to connect with our team throughout the meeting.</span></span></p>\n",
          "jcr:lastModified": "Mon Aug 03 2026 16:45:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
