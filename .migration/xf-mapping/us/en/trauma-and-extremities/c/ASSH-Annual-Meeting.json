          "line2": "<h3><span><b style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span>Thursday, October 9 – Friday, October 10</span></b></span><br>\r\n</h3>\r\n<p><span style=\"background-color: transparent; color: rgb(255,181,0);\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Time:</span></span></span></span></span></span><span class=\"urw-egyptienne\" style=\"background-color: transparent;\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\">&nbsp;8:00am – 4:00pm</span></span></span></span></span></p>\r\n<p><span class=\"urw-egyptienne\" style=\"background-color: transparent;\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Location:</span></span>&nbsp;Exhibit Hall - Mini Surgical Suite 843</span></span></span></span></span></p>\r\n<p><span class=\"urw-egyptienne\" style=\"background-color: transparent;\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Audience:</span></span>&nbsp;Hand &amp; Wrist Surgeons</span></span></span></span></span></p>\r\n<p><span class=\"urw-egyptienne\" style=\"background-color: transparent;\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Faculty:</span></span>&nbsp;Dr. Glenn Gaston &amp; Dr. Asif Ilyas&nbsp;</span></span></span></span></span>