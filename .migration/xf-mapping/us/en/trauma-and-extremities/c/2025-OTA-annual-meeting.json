      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Wed Sep 04 2024 15:19:51 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n",
          "jcr:lastModified": "Wed Sep 04 2024 15:19:55 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "largeheadline_copy_1": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "jeannie.chan@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-2-5-vw\">Resident Comprehensive Fracture Course</span></span></span></p>\r\n<p><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-1-5-vw\">Wednesday, October 15 – 17</span></span></span></p>\r\n",
          "line2": "<h3><span style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span class=\"futura-bold\"><br>\r\nTime: All day</span></span><span style=\"background-color: transparent; font-weight: normal;\"></span></h3>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">at&nbsp;PCC West Building Level 1</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><br>\r\nThis course will be presented in separate small group modules, with 125-150 residents and 8+ experienced faculty leaders. Stryker will be providing support to two modules this year: Diaphyseal and Upper Extremity.</span></p>\r\n",
          "jcr:lastModified": "Tue Sep 02 2025 13:55:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "sectionseparator": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Wed Sep 04 2024 15:08:49 GMT+0000",
          "jcr:lastModified": "Wed Sep 04 2024 15:08:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "largeheadline_copy_1_919440488": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "jeannie.chan@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><br />\r\n</span></span></span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><b><span class=\"fontsize-2-5-vw\">High School Scholars Program</span></b></span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Wednesday, October 15</span></span></span></p>\r\n",
          "line2": "<h3><span><span style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span class=\"futura-bold\"><br>\r\n9:00am – 2:00pm</span></span></span><span style=\"font-size: 35.0px; background-color: transparent; font-weight: normal;\"></span></h3>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">at&nbsp;Convention Center - Room 225AB&nbsp;</span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">&nbsp;</span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\"><br>\r\n</span></span><span class=\"fontsize-1-5-vw\">The OTA High School Scholars Program (HSSP) launched in 2022 as way to provide early exposure to orthopaedic surgery and related careers. Due to the success of the initial program and the OTA’s value of diversity, equity and inclusion, the HSSP has now become an annual event.</span></p>\r\n",
          "jcr:lastModified": "Tue Sep 02 2025 13:57:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        },
        "sectionseparator_99116950": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Thu Aug 28 2025 13:38:15 GMT+0000",
          "jcr:lastModified": "Thu Aug 28 2025 13:38:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/sectionseparator"
        },
        "largeheadline_copy_1_59484456": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "jeannie.chan@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Fri Feb 23 2018 11:50:11 GMT-0500",
          "gradientDirection": "left-to-right",
          "line1": "<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><br>\r\n</span></span></span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-2-5-vw\">Industry session:<br>\r\nCase calamities &amp; coffee</span></span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\">Thursday, October 16</span></span></span></p>\r\n",
          "line2": "<h3><span><span style=\"font-family: &quot;Futura LT W01&quot; , &quot;Arial Black&quot; , Arial , sans-serif; background-color: transparent;\"><span class=\"futura-bold\"><br>\r\n12:10pm - 1:00pm (lunch session)</span></span></span><span style=\"font-size: 35px; background-color: transparent; font-weight: normal;\">&nbsp;</span></h3>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">at Industry Theatre D</span></span></p>\r\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5-vw\">Featuring: Dr. Marcus Sciadini, Moderator; Dr. Sarah Pierrie, Dr. Julius Bishop and Dr. Michael Maceroli&nbsp;</span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><b>&nbsp;</b></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><b>Nothing is ever as simple as it seems.</b>&nbsp;Stryker invites you to join an interactive session where our faculty will present and discuss some of their own case calamities and experiences in orthopaedic trauma.</span></p>\r\n",
          "jcr:lastModified": "Tue Sep 02 2025 13:57:59 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ]
        }
      }
    },
