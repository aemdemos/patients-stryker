          "hideComponent": "false",
          "topMargin": "4",
          "jcr:created": "Tue Sep 02 2025 13:52:29 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1><span class=\"fontsize-1em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Expanding our portfolio.</span>&nbsp; <br>\n</span><span class=\"urw-egyptienne\">Strengthening our commitment to you.</span></span></h1>\n",
          "jcr:lastModified": "Wed Sep 03 2025 19:26:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1545110166": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
          "topPadding": "4",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "hideComponent": "false",
          "rightMargin": "5",
          "jcr:created": "Fri Aug 08 2025 16:07:56 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">At Stryker, we recognize the dedication it takes to do what you do. Your commitment to your patients inspires us, and together with you, we are full force. We are expanding our trauma portfolio, adding value programs that align care and cost, and strengthening our commitment to you with service that’s there when you need it most.</span></p>\n<p><span class=\"fontsize-1-25em\"><b>Thank you for joining us at Chase Field for The Stryker Experience. Continue to stay connected with us at OTA’s Annual Meeting.&nbsp;</b></span></p>\n<p>&nbsp;</p>\n",
          "jcr:lastModified": "Thu Oct 16 2025 02:39:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
