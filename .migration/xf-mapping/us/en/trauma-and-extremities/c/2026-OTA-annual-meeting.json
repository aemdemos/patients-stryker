      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b2cf110515@example.invalid",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Sep 02 2025 13:52:29 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h1>More than a portfolio.</h1>\n<h1><span class=\"futura-bold\">A trusted partner in the moments that count.&nbsp;</span><br>\n</h1>\n",
          "jcr:lastModified": "Fri Jun 19 2026 17:16:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_1545110166": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b2cf110515@example.invalid",
          "topPadding": "4",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "hideComponent": "false",
          "rightMargin": "5",
          "jcr:created": "Fri Aug 08 2025 16:07:56 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Trauma care demands relentless focus and absolute accountability. No matter your role in Trauma, you work at that pace every day. That’s why our partnership is built to match your speed and intensity, ready when the moment arises, responsive when conditions change and committed to the same purpose.&nbsp;&nbsp;</span></p>\n<p><span class=\"fontsize-1-25em\">Together with our customers, we've been advancing orthopaedic trauma care dating back to 1939. Continuous R&amp;D. Streamlined instrumentation. Ergonomics directly informed by physician feedback. A pipeline designed to define what's next.</span></p>\n<p><span class=\"fontsize-1-25em\">But innovation extends beyond the implant itself. Its impact depends on the people who use it, the systems that support it and the knowledge that surrounds it. That's why we apply the same rigor used to engineer our devices to education, service and the partnerships that help our customers rebuild lives.</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">The Stryker Experience brings that commitment to life.&nbsp;</span></span></span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Connect with peers.<br>\n </span>Explore new technologies.<br>\n <span style=\"color: #4c7d7a;\">Learn from experts.<br>\n </span><span style=\"color: #b2b4ae;\">Gain practical insights all designed to help you prepare for what's next.</span></span></span></p>\n",
          "jcr:lastModified": "Thu Sep 24 2026 14:06:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
