      "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
      "jcr:created": "Tue Jul 16 2019 20:03:12 GMT+0000",
      "text": "<p><span class=\"fontsize-2-5em\"><span class=\"fontsize-1-5em\"><span class=\"fontsize-1-75em\"><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\">2026</span></span></span></span></span><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span class=\"fontsize-1-75em\">&nbsp;<span style=\"color: #ffb500;\">OTA Annual Meeting</span></span></span></span><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><br>\n </span></span></span><span style=\"color: #ffb500;\">__________________________________________________________________________________________________________________________________________________________</span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Nashville, TN | September 23-26, 2026 | Visit us at booth #101</span></span></span></p>\n",
      "jcr:lastModified": "Mon Jun 22 2026 20:16:03 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
    "text_1063445144_copy_154128658": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
      "hideComponent": "false",
      "jcr:created": "Tue Jul 16 2019 20:03:12 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h2>&nbsp;</h2>\n<h2><span class=\"fontsize-1-25em\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\">Together with you,</span></span></span><span class=\"futura-bold\"> <br>\n<span style=\"color: #ffb500;\">we are full force<br>\n </span></span></span></span><br>\n</h2>\n",
      "jcr:lastModified": "Tue Aug 04 2026 19:33:16 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
