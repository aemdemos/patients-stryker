    "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
    "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Key benefits</span></span><br>\n</p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Anatomic Design: Stem shape designed from the inside out based upon CT data<br>\n <br>\n </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Convertible Platform: Simple conversion from anatomic to reverse without stem removal<br>\n <br>\n </span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Reversed Positioning: Dialable eccentric trays allow for enhanced ROM</span></span><br>\n</li>\n</ul>\n",
    "jcr:lastModified": "Tue Nov 30 2021 15:10:11 GMT+0000",
