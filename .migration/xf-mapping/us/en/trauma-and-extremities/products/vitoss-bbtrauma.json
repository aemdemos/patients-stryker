  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p><b>Vitoss BBTrauma Bioactive Bone Graft Substitute</b><br>\r\n</p>\r\n",
    "shortDescTop": "<p>This unique Vitoss formulation features an ultraporous, open interconnected structure with BBTrauma bioactive glass particles that promote the deposition of calcium phosphate on the implant surface.<sup>1</sup> A broader range of particle size distribution leads to an increased surface area of bioactive glass that allows for both an immediate burst and sustained release of calcium, sodium, and silicon ions.<sup>2</sup></p>\r\n",
    "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
    "jcr:lastModified": "Thu Nov 09 2017 14:39:51 GMT-0500",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Latest formulation of Vitoss, the #1 selling synthetic bone graft.<sup>3</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Demonstrated increased calcium phosphate deposition as shown in in-vitro models compared to other forms of Vitoss with bioactive glass.<sup>4</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Offers a broader range of bioactive glass particle distruntion, resulting in both an immediate burst and sustained release of Ca2+, Na+, and Si+ ions.<sup>2</sup></p>\r\n",
        "textIsRich": "true"
      }
    }
  },
