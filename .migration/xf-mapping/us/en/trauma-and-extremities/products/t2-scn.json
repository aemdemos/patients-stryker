  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>T2 Supracondylar Nailing System</p>\r\n",
    "shortDescTop": "<p>The T2 IM Nailing Platform offers a combination of innovation, simplicity and versatility that is designed to suit your various needs.</p>\r\n",
    "jcr:lastModifiedBy": "devin.doran@stryker.com",
    "jcr:lastModified": "Mon Jul 17 2017 14:27:44 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Four locking holes in distal 32mm with three planes of fixation<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Short and long nail options available</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Distal screw only 6mm from distal tip</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Sizes range from 9-14mm</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Ream less bone on driving end</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Condyle bolts for intra-frag compression</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>End cap for distal end of nail creates fixed angle construct with distal screw</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
