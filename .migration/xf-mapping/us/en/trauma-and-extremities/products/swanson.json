    "cols2_1_3_2_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Fri Sep 23 2022 18:31:11 GMT+0000",
      "jcr:lastModified": "Fri Sep 23 2022 18:31:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Swanson Finger</span><br>\n </span><span class=\"urw-egyptienne\">Implant Design</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Designed to act as a dynamic spacer to maintain proper joint space and alignment.<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Joint stability can be achieved through reconstruction of ligamentous and musculotendinous systems around the implant which acts as an internal mold for this soft tissue.<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The slight movement of the implant stem allows compressive forces to be distributed over a broader section of the bone and is designed to allow the flexible hinge to find position with respect to the axis of rotation of the joint.</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Sat Oct 15 2022 22:12:29 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
