  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits.</p>\r\n",
    "shortDescTop": "<p>The VariAx 2 Wrist Fusion Plating System provides you with a comprehensive range of anatomic plating options that work with a common instrument and screw platform. Plates utilize SmartLock technology which permits polyaxial screw placement. You can angle locking screws up to 15˚ in each direction for a total range of 30˚ providing surgeons with the flexibility to position screws based on the patient, not a plate’s pre-existing design. </p>\r\n",
    "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Fri May 27 2022 14:03:55 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>SOMA designed short bend, standard bend and straight options with a low distal profile designed for minimal plate prominence<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>9º dorsiflexion angle of pre-bent plates designed for optimal hand position</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Proximal oblong hole for axial compression of radio-carpal fragments<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Distal transverse oblong hole for precise ulnar or radial alignment<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Combining T8 2.4mm and 2.7mm screws and T10 3.5mm screws<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
