          "jcr:created": "Mon Aug 22 2022 21:31:10 GMT+0000",
          "gradientDirection": "left-to-right",
          "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-2vw\">The VariAx 2 Compression Plating Systems provides you with a comprehensive range of anatomic plating options that work with a common instrument and screw platform.&nbsp; Plates utilize SmartLock technology which permits polyaxial screw placement. You can angle locking screws up to 15˚ in each direction for a total range of 30˚ providing you with the flexibility to position screws based on the patient’s needs, not a plate’s pre-existing design.</span></span>",
          "jcr:lastModified": "Thu Nov 17 2022 23:45:15 GMT+0000",
