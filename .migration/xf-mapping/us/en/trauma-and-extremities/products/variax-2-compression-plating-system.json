    "largeheadline_copy_c_4586379": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "0",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "leftPadding": "0",
      "topPadding": "0",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Mon Aug 22 2022 21:31:10 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<span class=\"fontsize-3vw\"><span style=\"color: rgb(255,181,0);\"><span class=\"urw-egyptienne\"><span style=\"color: rgb(0,0,0);\">System</span></span></span><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"> offering</span></span><span class=\"urw-egyptienne\"></span></span>",
      "line2": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">The VariAx 2 Compression Plating System is indicated to treat a variety of small fragment midshaft fractures. These locking compression plates come in a variety of lengths, shapes, and widths, which offer the ability to compress, neutralize, or bridge a fracture depending on the fracture pattern and the surgeon’s fixation preference.</span></span></p>\r\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">The VariAx 2 SmartLock technology allows the surgeon to lock a screw in any of the circular holes in the plate in a variable angle of 30º. Finally, made of titanium alloy (Ti6Al4V) and treated with a Type II anodization, these plates are designed to carry the loads that are required of them.</span></span></p>\r\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5-vw\">The VariAx 2 Compression Plating System offers narrow straight plates from 3 holes to 22 holes. The broad plates are offered in a straight design from 3 holes to 22 holes and a radial curved design from 9 holes to 20 holes with 2 holes steps from 12 to 20. Also, specific 7-hole plates are designed with additional locking holes in which the surgeon can insert more locking screws if desired.</span></span></p>\r\n",
      "jcr:lastModified": "Fri Dec 02 2022 08:24:10 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "rightPadding": "0",
      "backgroundColor": "rgba(255,255,255,1)",
      "textIsRich": [
        "true",
        "true"
      ],
      "bottomMargin": "2"
    },
