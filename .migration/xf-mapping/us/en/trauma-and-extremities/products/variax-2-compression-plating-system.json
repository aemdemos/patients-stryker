    "cols2_2_3_1_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Thu Nov 17 2022 00:47:58 GMT+0000",
      "jcr:lastModified": "Thu Nov 17 2022 00:47:58 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Thu Nov 17 2022 00:47:40 GMT+0000",
          "alt": "Screwheads",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/variaxcompression/images/screwheads-v2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Dec 15 2022 03:51:37 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The circular holes in the plates provide an option for locking and non–locking. The oblong compression holes are designed to work with non-locking screws.&nbsp; In order to distinguish a locking screw from a non-locking screw, the top of the locking screw heads are laser marked with a black circular ring and inner dot as shown here.The VariAx 2 Compression Plates are used with either 3.5mm or 2.7mm screws, giving the choice of screws size based on the anatomy and fracture pattern. Additionally, all screws in the system are inserted with the same T10 screwdriver for ease–of–use.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Thu Nov 17 2022 23:51:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2_3_1_3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Thu Nov 17 2022 00:47:58 GMT+0000",
      "jcr:lastModified": "Thu Nov 17 2022 00:47:58 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_2-3_1-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Thu Nov 17 2022 00:47:40 GMT+0000",
          "alt": "Screw Angles",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/variaxcompression/images/screwangle1.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Dec 15 2022 03:51:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">All screws can be angulated up to +/-15 degrees in circular holes. In oblong holes, non-locking screws placed in the neutral position can be angled up to 15 degrees in the off–axis plane. These angles are controlled by using the appropriate polyaxial drill guide (703882 for 3.5mm screws and 703883 for 2.7mm screws) when drilling.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Thu Nov 17 2022 23:52:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
