  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits.</p>\r\n",
    "shortDescTop": "<p>The VariAx 2 Compression Plating Systems provides you with a comprehensive range of anatomic plating options that work with a common instrument and screw platform. Plates utilize SmartLock technology which permits polyaxial screw placement. You can angle locking screws up to 15˚ in each direction for a total range of 30˚ providing you with the flexibility to position screws based on the patient, not a plate’s pre-existing design.</p>\r\n",
    "jcr:lastModifiedBy": "vince.wolff@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Thu May 26 2022 18:45:34 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>SOMA designed broad and narrow plates provide flexibility to choose option based on patient anatomy</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Anatomic plate designed to match the curve of the radial bow</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Flexibility to use both 2.7mm or 3.5mm locking/non-locking screws</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Common T10 screw interface allows for one screwdriver regardless of locking or non-locking screws for ease of use</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
