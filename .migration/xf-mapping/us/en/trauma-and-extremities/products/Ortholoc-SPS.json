      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\">Designed for</span></span></span><span class=\"futura-bold\"><br>\n <span style=\"color: #ffb500;\">accuracy.</span></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">A calcar first technique, Ortholoc SPS is designed for an accurate and simple calcar screw placement with three anatomic guide blocks that offer different screw patterns according to patient anatomy to accurately target medial calcar and help prevent screw cut-out.</span></span></p>\n",
          "jcr:lastModified": "Sun Oct 16 2022 00:20:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Mon Nov 14 2022 18:50:22 GMT+0000",
          "alt": "Designed for accuracy",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/ortholoc-sps/images/accuracy-v2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Dec 15 2022 14:45:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\">Designed for</span></span></span><span class=\"futura-bold\"><br>\n <span style=\"color: #ffb500;\">adjustability.</span></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Features a 20mm slot hole for further height adjustment with 2mm increments. Additionally, 3DSi polyaxial locking technology offers 20° variable angle locking to alter the direction of locking screw to find desired screw placement.<br>\n&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Mon Oct 17 2022 21:42:51 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "standaloneimage_5070": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
