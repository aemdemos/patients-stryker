          "jcr:created": "Mon Sep 19 2022 17:22:41 GMT+0000",
          "alt": "Posterior Plates",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/ortholoc-sps/images/posterior-update.png",
          "borderColor": "rgba(187,188,188,1)",
          "jcr:lastModified": "Thu Jan 12 2023 05:51:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "true"
        },
        "text_copy_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\">Posterior plates</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Designed to capture the greater tuberosity to counteract the pull off force of the infraspinatus<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Right and left options<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">6 proximal suture holes<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">2 posterior bendable branches to match patient anatomy<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Posterior exposure of the proximal humerus may be preferable</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Sun Oct 16 2022 00:26:24 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
