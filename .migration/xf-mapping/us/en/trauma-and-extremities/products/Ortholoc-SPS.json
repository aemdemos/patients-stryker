          "preset": "max_width_1440",
          "jcr:created": "Mon Sep 19 2022 17:22:41 GMT+0000",
          "alt": "Standard Plates",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/ortholoc-sps/images/standared.png",
          "borderColor": "rgba(187,188,188,1)",
