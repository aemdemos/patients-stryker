          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/ortholoc-sps/images/adjustability-v2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Dec 15 2022 14:45:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy_copy_12291": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\">Designed for</span></span></span><span class=\"futura-bold\"><br>\n <span style=\"color: #ffb500;\">anchoring.</span></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">With three calcar screws, Ortholoc SPS offers reliable and strong fixation. Furthermore, the anatomic guide blocks place the screws at the periphery of the humeral head to purchase harder bone and to prevent direct articular surface perforation.</span></span></p>\n",
          "jcr:lastModified": "Mon Nov 14 2022 18:51:05 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
