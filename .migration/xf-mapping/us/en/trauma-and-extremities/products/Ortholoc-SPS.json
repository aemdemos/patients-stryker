          "jcr:created": "Mon Nov 14 2022 21:25:48 GMT+0000",
          "alt": "Plate design",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/ortholoc-sps/images/plate-design-v3.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Dec 15 2022 15:08:39 GMT+0000",
