  "rte": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "jeannie.chan@stryker.com",
    "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Key benefits</span></span><br>\n</p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Clinical benefits</span></span></p>\n<ul>\n<li>Autologous humeral head bone graft spares iliac crest</li>\n<li>Lateralization reduces scapular notching<sup>1</sup><br>\n</li>\n<li>Designed to maintain the center of rotation within bone<br>\n</li>\n</ul>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Surgical benefits</span></span></p>\n<ul>\n<li>Designed to eliminate difficult peripheral reaming</li>\n<li>Cannulated preparation of bone graft<br>\n</li>\n<li>Long post baseplate allows for native bone purchase<br>\n</li>\n<li>Cut guide allows for 7mm or 10mm graft<br>\n</li>\n</ul>\n",
    "jcr:lastModified": "Fri Aug 27 2021 15:29:41 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Bony Increased Offset for Reversed Shoulder Arthroplasty allows for lateralization of the glenoid implant using the patient’s own native bone.</p>\r\n",
    "shortDescTop": "<p>  </p>\r\n",
