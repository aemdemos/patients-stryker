    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "vince.wolff@stryker.com",
    "disclaimer-type": "text",
    "disclaimer": "<p><b>Source documentation</b></p>\r\n<ol>\r\n<li>Baumann, Axel et al. Ti6Al4V with anodization type II: biological behavior and biomechanical effects. March 2005</li>\r\n<li>Born et al. Hip Screw Migration Testing: First Results for Hip Screws and Helical Blades utilizing a new oscillating Test Method. J Orthop Res. 2011 May;29(5):760-6.</li>\r\n<li>Adam et al. External distal targeting device for safe insertion of distal locking screws when performing long Gamma nail: Comparison with the freehand technique. Bone and Joint. Vol 94-B Supp XXXVII. 14 Sept 2012</li>\r\n</ol>\r\n<p>&nbsp;</p>\r\n",
    "jcr:lastModified": "Wed Jun 22 2022 19:16:20 GMT+0000",
