    "cols_copy_copy_copy_": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Mon Aug 22 2022 21:30:31 GMT+0000",
      "jcr:lastModified": "Mon Aug 22 2022 21:30:31 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "0",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "leftPadding": "0",
          "topPadding": "0",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 21:31:10 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\">Cephalomedullary nailing system for the treatment of intertrochanteric fractures as well as a wide range of proximal femur fractures and associated femoral shaft fractures.</span></span>",
          "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-2vw\"><br />\r\nGamma3 is a comprehensive intramedullary nailing system for the treatment of a wide range of proximal femur fractures as well as associated femoral shaft fractures. The system is the result of over 30 years of continuous innovation and clinical history.</span></span>",
          "jcr:lastModified": "Wed Dec 28 2022 00:01:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "rightPadding": "0",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ],
          "bottomMargin": "2"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Wed Dec 28 2022 00:00:27 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Type II anodization for titanium implants offers increased fatigue strength<sup>1</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Reduced proximal nail diameter to facilitate a minimally invasive technique</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Radiolucent carbon fiber targeter compatible with short and long nails with 120°, 125°, and 130°&nbsp;neck angles</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Distal targeting options</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Plus targeter available for cases where added soft tissue clearance is required</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Set screw prevents rotations of the lag screw and asymmetric depth profile only allows</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Four locking grooves allow for quarter turn advancement of 0.8mm to allow for precise lag screw positioning</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 00:02:12 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
