  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Gamma3 Hip Fracture Nailing System</p>\r\n",
    "shortDescTop": "<p>Gamma3 is a comprehensive intramedullary nailing system for the treatment of a wide range of proximal femur fractures as well as associated femoral shaft fractures. The system is the result of over 30 years of continuous innovation and clinical history.</p>\r\n",
    "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Wed Dec 28 2022 00:20:28 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Type II anodization for titanium implants offers increased fatigue strength<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Reduced proximal nail diameter to facilitate a minimally invasive technique</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Radiolucent carbon fiber targeter compatible with short and long nails with 120°, 125°, and 130°&nbsp;<span style=\"font-size: 0.8125rem;\">neck angles</span></p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Distal targeting options</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Plus targeter available for cases where added soft tissue clearance is required</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Set screw prevents rotations of the lag screw and asymmetric depth profile only allows</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Four locking grooves allow for quarter turn advancement of 0.8mm to allow for precise lag screw positioning</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
