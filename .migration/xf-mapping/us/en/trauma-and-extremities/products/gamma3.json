    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Dec 28 2022 00:04:23 GMT+0000",
      "jcr:lastModified": "Wed Dec 28 2022 00:04:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Gamma3&nbsp;</span><br>\n </span><span class=\"urw-egyptienne\">Trochanteric Nail</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The Gamma3 System is intended to achieve functionally stable osteosyntheses and stabilization of bones and bonefragments.</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">170 and 180mm length options</span></span><br>\n</li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Distal targeting achieved through the standard targeting arm</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 00:11:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "devin.doran@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Thu Oct 04 2018 19:09:13 GMT+0000",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/gamma3/images/Gamma-Troch-Nail.png",
          "jcr:lastModified": "Thu Aug 06 2020 18:26:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        }
      }
    },
    "cols2_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Dec 28 2022 00:04:23 GMT+0000",
      "jcr:lastModified": "Wed Dec 28 2022 00:04:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Gamma3&nbsp;</span><br>\n </span><span class=\"urw-egyptienne\">Long Nail</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Gamma3 Long Nail is intended for fixation of stable and unstable femoral fractures occurring from the base of the femoral neck extending distally to a point approximately 10cm proximal to the intracondylar notch including fractures of the basilar neck, intertrochanteric fractures, peritrochanteric fractures, subtrochanteric fractures and femoral shaft fractures.</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Distal diameters 10mm, 11mm, 13mm and 15mm&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Nails available 240mm - 480mm in 20mm increments</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">1.5m and 2.0m radius of curvature nails available</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Distal targeting achieved with the Distal Targeting System</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 00:24:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "devin.doran@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Thu Oct 04 2018 19:09:13 GMT+0000",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/gamma3/images/Gamma-Long-Nail.png",
          "jcr:lastModified": "Thu Aug 06 2020 18:45:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage"
        }
      }
    },
    "cols2_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Dec 28 2022 00:04:23 GMT+0000",
      "jcr:lastModified": "Wed Dec 28 2022 00:04:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Gamma3&nbsp;</span><br>\n </span><span class=\"urw-egyptienne\">RC Lag Screw</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The Gamma3 RC Lag Screw can be used with either nail type and may be used to treat patients with highly osteoporotic bone.</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Combination of standard Gamma3 lag screw with a spreading U-clip</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">U-clip provides an additional 2mm of spread to increase the surface area for enhanced rotational control and resistance to cut-out</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">RC Lag Screw showed a 15% higher resistance to migration over the standard lag screw.<sup>2</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 00:24:57 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
