  "rte": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
    "text": "<p>Pro-Dense was the first bone graft substitute indicated for the use in bone voids resulting from the resection of benign bone cysts in children 6 years and older. It delivers predicable bone regeneration with it’s triphasic resorption profile for faster, denser bone regeneration, stronger new bone, and a graft that remodels to normal bone.</p>\n",
    "jcr:lastModified": "Fri Feb 18 2022 20:09:35 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
  "disclaimer": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
    "disclaimer-type": "text",
    "disclaimer": "<p>*All claims based on a critically sized canine proximal humerus defect model. It is unknown how results from the canine modelcompare with clinical results in humans. Data on file at Stryker</p>\r\n<ol>\r\n<li>Growth factor binding based on in vitro data of BMP-2 and VEGF. Data on file.</li>\r\n</ol>\r\n",
    "jcr:lastModified": "Fri Feb 18 2022 20:10:07 GMT+0000",
    "sling:resourceType": "stryker/components/structure/disclaimer",
    "textIsRich": "true"
  }
