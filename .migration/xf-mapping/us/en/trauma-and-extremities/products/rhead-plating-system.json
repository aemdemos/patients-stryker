  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Small joints</p>\r\n",
    "shortDescTop": "<p>The rHead Plating System consists of four different plates with various rim and neck designs to treat radial head fractures. The system offers traditional non-locking, low profile side screws to capture proximal fragments and locking screw options in the shaft of the plate.&nbsp;<span style=\"font-size: 0.8125rem;\">The rHead Plating System is part of the Elbow Management Solutions Tray.&nbsp;</span></p>\r\n",
    "jcr:lastModifiedBy": "frank.mastrangelo@stryker.com",
    "jcr:lastModified": "Wed Aug 16 2017 09:26:27 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
