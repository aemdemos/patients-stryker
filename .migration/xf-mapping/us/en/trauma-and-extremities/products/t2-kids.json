  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTop": "<p>T2 Flexible Nail is intended for the temporary stabilization of bone segments or fragments until bone consolidation has been achieved for upper and lower extremity fractures of pediatric patients. Specific indications include the fixation of mid-diaphyseal, proximal and distal fractures of the femur, tibia, fibula, humerus and forearm fractures in pediatric patients only.</p>\r\n",
    "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Wed Dec 14 2022 02:17:00 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Titanium and stainless steel flexible nails</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Sizes of 300 or 450mm</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Diameters range from 1.5 - 4mm</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Pre-curved shaft designed for easy insertion</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Dedicated instrumentation allows for small and large bone treatment and extraction</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
