    "cols_copy_copy_copy_": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Mon Aug 22 2022 21:30:31 GMT+0000",
      "jcr:lastModified": "Mon Aug 22 2022 21:30:31 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "0",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "leftPadding": "0",
          "topPadding": "0",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 21:31:10 GMT+0000",
          "gradientDirection": "left-to-right",
          "line2": "<span class=\"urw-egyptienne\"><span class=\"fontsize-2vw\">T2 Flexible Nail is intended for the temporary stabilization of bone segments or fragments until bone consolidation has been achieved for upper and lower extremity fractures of pediatric patients. Specific indications include the fixation of mid-diaphyseal, proximal and distal fractures of the femur, tibia, fibula, humerus and forearm fractures in pediatric patients only.</span></span>",
          "jcr:lastModified": "Wed Dec 14 2022 02:13:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "rightPadding": "0",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ],
          "bottomMargin": "2"
        },
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">T2 Kids</span><br>\n </span><span class=\"urw-egyptienne\">Product features&nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Titanium and stainless steel flexible nails</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Sizes of 300 or 450mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Diameters range from 1.5 - 4mm</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Pre-curved shaft designed for easy insertion</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Dedicated instrumentation allows for small and large bone treatment and extraction</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 14 2022 02:14:10 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
