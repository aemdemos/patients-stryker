        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "devin.doran@stryker.com",
          "jcr:lastModifiedBy": "frank.mastrangelo@stryker.com",
          "jcr:created": "Fri Aug 04 2017 11:19:55 GMT-0400",
          "text": "<p>The Distal Targeting System allows for guided distal locking for our Gamma 3 long and T2 Recon nails</p>\n<ul>\n<li>May reduce x-ray exposure and improve OR efficiency<sup>1</sup></li>\n<li>Radiolucent design is compatible with existing targeting handle</li>\n<li>May provide additional working space due to 30 degree C-arm alignment</li>\n</ul>\n",
          "jcr:lastModified": "Thu Aug 24 2017 14:33:40 GMT-0400",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
