  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Bone graft substitute</p>\r\n",
    "shortDescTop": "<p>These implants are designed to act as bone void fillers and are available in three forms: gel, putty, and putty combined with cancellous chips (putty plus) which allows you to tailor the graft selection to the needs of the patient. DBM is designed to resist washing away when irrigated, and has a pliable consistency for handling.&nbsp;<br>\r\n</p>\r\n",
    "jcr:lastModifiedBy": "frank.mastrangelo@stryker.com",
    "jcr:lastModified": "Mon Aug 28 2017 09:25:58 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Each final lot of DBM is tested using the gold standard Urist Mouse Model to confirm osteoinductive potential<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>DBM utilizes a reverse phase media carrier which allows the product to be malleable at room temperature and increase in viscosity after implantation<sup>2</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Gel, Putty and Putty Plus demonstrated equivalent bone&nbsp;formation results to autograft in adult rabbits<sup>3</sup></p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Gel, Putty and Putty Plus are formulated to resist irrigation</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Putty Plus configurations contain cancellous bone<sup>4</sup></p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Gel is available in 1cc, 5cc and 10cc syringes, Putty in 1cc, 2.5cc, 5cc and&nbsp;10cc vials, and Putty Plus in 5cc and 10cc vials</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
