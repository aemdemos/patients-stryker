  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Imbibe Bone Marrow Aspiration and Delivery System</p>\r\n",
    "shortDescTop": "<p>Bone marrow aspirate (BMA) is an alternative to traditionally harvested iliac crest without the associated complications or morbidity.<sup>1</sup> Surgeons can easily aspirate BMA from several anatomical locations throughout the body including iliac crest, vertebral body or calcaneus. The Imbibe bone marrow aspiration needles provide you a minimally invasive way to harvest bone marrow. These needles come with either sharp beveled or trocar stylets, which are color coded to distinguish each needle.&nbsp;</p>\r\n",
    "jcr:lastModifiedBy": "Katie.Powers@stryker.com",
    "jcr:lastModified": "Thu Aug 24 2017 16:04:30 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Bullet-tip stylet design for controlled navigation</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Trocar and bevel cutting stylet to penetrate cortical bone</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Color-coded stylets to quickly and easily identify sharp-tip vs. bullet-tip design</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Optimized fenestrated hole design and placement</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Ergonomic handle for surgeon control and comfort</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Unique snap-lock design promotes a secure connection between stylet and handle</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Hammering platform</p>\r\n",
        "textIsRich": "true"
      },
      "8": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Versatility, useful for multiple anatomic locations</p>\r\n",
        "textIsRich": "true"
      },
      "9": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Multiple needle sizes and styles available (11 gauge x 4 inch, 11gauge x 6 inch, 8 gauge x 6 inch, 8 gauge x 8 inch, and a fenestrated 8 gauge x 6 inch)</p>\r\n",
        "textIsRich": "true"
      },
      "10": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>10, 20 and 30cc syringe options</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
