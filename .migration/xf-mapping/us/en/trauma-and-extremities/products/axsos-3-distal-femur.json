    "cols2_1_3_2_3_copy_c": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "jcr:created": "Fri Sep 23 2022 18:31:11 GMT+0000",
      "jcr:lastModified": "Fri Sep 23 2022 18:31:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Plating that fits.&nbsp;&nbsp;</span><br>\n</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Every minute counts in the OR. From a population-based implant design, a patented screw-to-plate interface, and streamlined instrumentation, our focus is on creating a well-designed plating system, giving you more time to focus on other things.&nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">8 metaphyseal screw hole options<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">1.8mm radius of curvature<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Designed to avoid interference in the intercondylar notch<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Available in lengths up to 415mm</span></span><b data-rte-class=\"rte-temp\"><span class=\"fontsize-1-5em\"><b data-rte-class=\"rte-temp\"><span class=\"urw-egyptienne\"><br>\n <br>\n </span></b></span></b></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>1</sup></span></span><b data-rte-class=\"rte-temp\"><span class=\"fontsize-1-5em\"><b data-rte-class=\"rte-temp\"><span class=\"urw-egyptienne\"><br>\n <br>\n </span></b></span></b></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Provides increased CT imaging clarity<sup>2</sup><br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Offers excellent biocompatibility<sup>3,4</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Dec 13 2022 21:09:35 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
