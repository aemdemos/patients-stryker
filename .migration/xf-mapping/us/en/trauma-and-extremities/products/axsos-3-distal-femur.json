  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits. </p>\r\n",
    "shortDescTop": "<p>Every minute counts in the OR. From a population-based implant design, a patented screw-to-plate interface, and streamlined instrumentation, our focus is on creating a well-designed plating system, giving you more time to focus on other things.</p>\r\n<p> </p>\r\n",
    "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Tue Dec 13 2022 20:55:22 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>8 metaphyseal screw hole options</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>1.8mm radius of curvature</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Designed to avoid interference in the intercondylar notch</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Available in lengths up to 415mm</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>1</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Provides increased CT imaging clarity<sup>2</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Offers excellent biocompatibility<sup>3,4</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
