          "hideComponent": "false",
          "jcr:created": "Mon Aug 12 2024 22:54:10 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"futura-bold\">Key benefits</span></h3>\n<ul>\n<li>Designed with anatomic restoration of joint in mind: Stemless humeral components have shown increased restoration of anatomic joint line.*</li>\n</ul>\n<ul>\n<li>Precision: Fifty-seven head total combinations. Tornier Perform Stemless is the only Tornier stemless component that offers centered, low and high offset heads providing surgeons more options for accurate head coverage.</li>\n</ul>\n<ul>\n<li>Adaptis fit: Tri-tier 3D printed design, tapered porous side walls.</li>\n</ul>\n<ul>\n<li>Streamlined: Shared instrumentation provides intraoperative flexibility for a seamless transition from stemless to stem.</li>\n</ul>\n",
          "jcr:lastModified": "Mon Aug 12 2024 23:38:40 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "textIsRich": "true"
        }
