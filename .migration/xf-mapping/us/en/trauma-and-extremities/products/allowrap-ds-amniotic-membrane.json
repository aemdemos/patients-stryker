  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p><sup>AlloWrap DS &nbsp;</sup></p>\r\n",
    "shortDescTop": "<p>Amniotic membranes are commonly used for wound coverage and nerve or tendon protection.<sup>1</sup> AlloWrap DS is a dual layer graft that is processed so the epithelial layer is facing outwards on both sides of the graft. This allows for omni-directional implantation.<sup>2</sup></p>\r\n",
    "jcr:lastModifiedBy": "user-c66c5d4a4b@example.invalid",
    "jcr:lastModified": "Thu Aug 10 2017 11:21:26 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Packaged ready-to-use, not dehydrated or cryopreserved.</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Product is 0.1-0.2mm thick</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Room temperature storage</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Terminally sterilized to 10<sup>-6</sup> SAL</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
