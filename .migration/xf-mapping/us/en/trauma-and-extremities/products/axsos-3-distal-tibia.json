  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits. </p>\r\n",
    "shortDescTop": "<p>We understand the importance of a well-fitting implant. An implant that fits may reduce OR time, may decrease fracture malalignment, and potentially reduce patient discomfort, especially in areas such as the distal tibia where there is little soft tissue coverage. </p>\r\n<p> </p>\r\n",
    "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Wed Dec 28 2022 01:12:22 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Low profile plate designed to minimize screw prominence&nbsp;</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Patented locking screw head design helps ease extraction<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>2</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Provides increased CT imaging clarity<sup>3</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Offers excellent biocompatibility<sup>4,5</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
  "disclaimer": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "devin.doran@stryker.com",
    "disclaimer-type": "text",
    "disclaimer": "<ol>\r\n<li>AxSOS-WP-4 White Paper: Konowalczyk, S . et al. AxSOS 3 Titanium Plating System- Screw Removal Safety. September 2014</li>\r\n<li>Henderson, CE et al. 2010 Mid-America Orthopedic Association Physician in Training Award: Healing Complications are Common After Locked Plating for Distal Femurs. Clinical Orthopaedics and Related Research (2011) 469:1757-1765.</li>\r\n<li>Kataoka, ML et al. A Review of factors that affect artifact from metallic hardware on multi-row detector computed tomography. Current Problems in Diagnostic Radiology, July/August 2010.</li>\r\n<li>Williams, DF. On the mechanisms of biocompatibility. Biomaterials (2008), 1-13</li>\r\n<li>Pohler, O EM. Unalloyed titanium for implants in bone surgery. Injury 31 (2000) S-D7-13.</li>\r\n</ol>\r\n<p>CP-AWI-14, 07-2017<br>\r\n</p>\r\n",
    "jcr:lastModified": "Fri Aug 11 2017 11:48:04 GMT-0400",
    "sling:resourceType": "stryker/components/structure/disclaimer",
    "textIsRich": "true"
  },
