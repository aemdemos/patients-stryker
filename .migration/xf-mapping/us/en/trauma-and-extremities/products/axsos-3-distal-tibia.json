      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">AxSOS 3 Ti&nbsp;</span><br>\n </span><span class=\"urw-egyptienne\">Distal Anterolateral Tibia</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">4 rafting screws close to articular surface<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">2.7mm/3.5mm cortical screws used in the distal extension&nbsp;<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Kickstand screw designed to capture medial malleolus</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 01:04:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_1060583734_1601389303": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">AxSOS 3 Ti</span><br>\n</span><span class=\"urw-egyptienne\">Distal Medial Tibia</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Designed to minimize screw prominence<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Diverging screw trajectories in parallel plane<br>\n</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 01:05:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
