      "jcr:lastModified": "Mon Aug 22 2022 21:30:31 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "largeheadline": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "0",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "leftPadding": "0",
          "topPadding": "0",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 21:31:10 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"fontsize-2-5-vw\"><span class=\"futura-bold\">Monoaxial locking plate system for treating distal tibia fractures.</span></span>",
          "line2": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2vw\"><br>\r\n </span></span><span class=\"fontsize-2vw\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Plating that fits.&nbsp;</span></span></span></p>\r\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2vw\">We understand the importance of a well-fitting implant. An implant that fits may reduce OR time, may decrease fracture malalignment, and potentially reduce patient discomfort, especially in areas such as the distal tibia where there is little soft tissue coverage.&nbsp;</span></span></p>\r\n",
          "jcr:lastModified": "Wed Dec 28 2022 00:55:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/largeheadline",
          "rightPadding": "0",
          "backgroundColor": "rgba(255,255,255,1)",
          "textIsRich": [
            "true",
            "true"
          ],
          "bottomMargin": "2"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "cedu.ocson@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Wed Dec 28 2022 00:00:27 GMT+0000",
          "text": "<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Low profile plate designed to minimize screw prominence</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Patented locking screw head design helps ease extraction<sup>1</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>2</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Provides increased CT imaging clarity<sup>3</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Offers excellent biocompatibility<sup>4,5</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 00:55:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
