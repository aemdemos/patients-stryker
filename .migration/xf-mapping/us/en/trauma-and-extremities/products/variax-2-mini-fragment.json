        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">In addition to the full implant offering of the Mini Fragment portfolio, there is an arsenal of reduction instruments, positioning instruments, and tools to cut and contour your plates to fit the needs of your patient included in the tray. Additional contouring of all plates is possible using the Plate Bender. The multiple-use plate bender can be used for both in-plane and out-of-plane bending for all plate sizes. Both sides of the bender have a laser etching identifying which plate size may be contoured on that respective side. Cutting of all profile and narrow locking plates as well as 2.0mm broad locking plates is possible using the plate cutter.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Nov 18 2022 18:50:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
