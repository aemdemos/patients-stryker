    "cols2_1_3_2_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-65eab19e7c@example.invalid",
      "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
      "jcr:created": "Thu Nov 17 2022 01:24:23 GMT+0000",
      "jcr:lastModified": "Thu Nov 17 2022 01:24:23 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The VariAx 2 Mini Fragment System offers Profile, Narrow Locking, and Broad Locking plates with the narrow and broad locking plate options offering variable angle locking. The Broad Locking plates are designed to provide a stronger option compared to the Narrow Locking plates. Profile and Broad Locking plates are offered as straight plates only, ranging from 4 – 20-hole lengths. Narrow Locking plates are offered in straight, T, Y, and triangle plate options. T-plates are offered in 5 and 10-holes lengths, and Y and Triangle plates are offered in 10-hole options. The top side of the plates always feature a circumferential chamfer.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Nov 18 2022 18:49:44 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
