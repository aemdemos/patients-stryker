    "cols2_1_3_2_3_copy_c": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "jcr:lastModifiedBy": "lee.fuller1@stryker.com",
      "jcr:created": "Mon Aug 22 2022 22:13:33 GMT+0000",
      "jcr:lastModified": "Mon Aug 22 2022 22:13:33 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "vince.wolff@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">Revolutionary approach to tendon repair</span></span></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The CoNextions TR Tendon Repair System provides a stronger,<sup>1</sup> faster,<sup>2</sup> and smoother<sup>3</sup> alternative to traditional suture repair techniques. CoNextions TR can be used for the repairs of severed or lacerated flexor and extensor tendons in the hand, wrist, and forearm.<span style=\"font-size: 0.8125rem;\"></span></span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Novel stainless steel and ultra high tenacity polyethylene implant&nbsp;helps provide a strong and flexible repair.<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Implant is designed for the repair of&nbsp;tendons 1.5 - 4.0 mm in thickness and 3.0 mm to 9.0 in width.<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Implant automatically sizes to the thickness of the tendon during deployment to ensure a custom fit for every repair.<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Indicated for digital flexor tendons, digital extensor tendons proximal to the metacarpophalangeal Joint (Zones 6-8).</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Mar 20 2024 18:42:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
