    "largeheadline_copy_c_1627942197": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "0",
      "jcr:createdBy": "lee.fuller1@stryker.com",
      "leftPadding": "0",
      "topPadding": "0",
      "jcr:lastModifiedBy": "vince.wolff@stryker.com",
      "jcr:created": "Mon Aug 22 2022 21:31:10 GMT+0000",
      "gradientDirection": "left-to-right",
      "line2": "<h2><span class=\"fontsize-2vw\"><span class=\"urw-egyptienne\">When deployed, the CoNextions TR Implant is 18 mm in length and 2.5 mm wide.<br>\r\n The delivery instrumentation requires 20 mm (10 mm on either side of the repair site) of surgical site access to allow for proper implant deployment.</span></span></h2>\r\n",
