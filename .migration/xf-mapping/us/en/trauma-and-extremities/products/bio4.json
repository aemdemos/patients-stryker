  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>BIO<sup>4</sup> Viable Bone Matrix</p>\r\n",
    "shortDescTop": "<p>BIO<sup>4&nbsp;</sup>possesses all four characteristics involved in bone repair and regeneration: osteoconductive, osteoinductive, osteogenic, and angiogenic.<sup>1-3&nbsp;</sup>It is an alternative to autograft that minimizes the potential for harvest site comorbidities. BIO<sup>4</sup>:</p>\r\n",
    "jcr:lastModifiedBy": "vince.wolff@stryker.com",
    "jcr:lastModified": "Mon Mar 12 2018 14:19:13 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Is lot tested for the presence of VEGF (vascular endothelial growth factor)<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Is lot tested for ≥ 70% cell viability post-thaw<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Contains ≥ 600,000 cells/cc (endogenous bone forming cells including mesenchymal stem cells)<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Is ready to use out of the package; no decanting is required, and thaws in 15 minutes<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Has differentiated handling compared to competition&nbsp;<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Is non-immunogenic&nbsp;<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "7": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Is available in 1, 2.5, 5 and 10cc sizes&nbsp;&nbsp;<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
