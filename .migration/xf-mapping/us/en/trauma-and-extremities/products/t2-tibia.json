      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Up to 7mm of active internal compression<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Most distal hole 5mm from tip<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Compression screw and fully threaded end cap creates a fixed angle construct<br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
