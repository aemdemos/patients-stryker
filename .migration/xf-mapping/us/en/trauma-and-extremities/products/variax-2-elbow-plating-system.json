      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Elbow fractures remain one of the\u000bmore difficult fractures for orthopaedic surgeons to treat These fractures are commonly intra-articular and/or involve poor bone quality, and therefore, achieving stability can be problematic. Stable fixation allows early motion which may lead to better functional outcomes<sup>1,2,3</sup> At the same time, the limited soft tissue coverage and the distinct anatomic shape demands implants that can adapt to the anatomy. With this in mind, Stryker has developed the VariAx 2 Elbow implants: anatomically shaped, variable angled locking plates.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Thu Jan 12 2023 21:02:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_2_3_1_3_copy": {
      "jcr:primaryType": "nt:unstructured",
