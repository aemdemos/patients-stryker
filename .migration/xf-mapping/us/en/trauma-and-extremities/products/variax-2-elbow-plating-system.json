      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_12291": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The VariAx 2 Platform is designed to offer a comprehensive, modular and easy-to-use platform for treating various small fragment applications including clavicle, humerus, radius, ulna, fibula, fore-/mid and hind foot.</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Stryker's plating portfolio is 'plating that fits' because we carefully consider how our entire portfolio- plates, procedures and support- best fit your needs.</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Core tray includes one set of T8/T10 screws plus standardized instrumentation and reduction instruments.</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-25em\">Add-on trays hold the comprehensive range of plating options designed to accommodate a certain procedure.&nbsp; Add on trays include: Wrist, Elbow, Clavicle, Foot, and Small Fragment.</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-25em\">Color coded screws and instruments designed to easily identify screw diameter, screw type, and corresponding instrumentation. A black laser marking on the screw head indicates a locking screw.</span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Sat Nov 19 2022 21:31:54 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
