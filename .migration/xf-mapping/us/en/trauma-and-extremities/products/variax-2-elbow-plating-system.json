  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits.</p>\r\n",
    "shortDescTop": "<p>The VariAx 2 Elbow plating system provides you with a comprehensive range of anatomic plating options that work with a common instrument and screw platform. Plates utilize SmartLock technology which permits polyaxial screw placement. You can angle locking screws up to 15˚ in each direction for a total range of 30˚ providing you with the flexibility to position screws based on the patient, not a plate’s pre-existing design. </p>\r\n",
    "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Thu May 26 2022 13:55:33 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Two different 180° and two different 90° distal humerus plating options</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Plates designed with a bridging support between the diaphyseal and metaphyseal regions, making the plate stronger where the primary fracture line normally lies</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Flexibility to use both 2.7mm or 3.5mm locking/non-locking screws</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Common T10 screw interface allows for one screwdriver regardless of locking or non-locking screws for ease of use</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
