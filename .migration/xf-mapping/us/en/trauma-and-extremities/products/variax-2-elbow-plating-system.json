        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The range of distal humeral plates allows for the option to treat a fracture based on anatomy, surgeon preference, and fracture type.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Fri Nov 18 2022 18:25:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
