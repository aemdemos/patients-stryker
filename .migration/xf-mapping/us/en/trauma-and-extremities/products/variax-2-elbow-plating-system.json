      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_47067": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-5891a4f69d@example.invalid",
          "jcr:lastModifiedBy": "user-b2cf110515@example.invalid",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">The polyaxial locking technology works by using two different grades of titanium. Locking screws are made of titanium alloy (Ti6Al4V) and when a screw is driven into a plate hole, the locking threads on the underside of the screw engage the circular ‘lip’ in the hole. Unlike monoaxial locking systems, where the screws follow a predetermined path, this technology allows the user to aim and lock the screw within a 30 degree cone.&nbsp; The plates are used with either 3.5mm or 2.7mm screws, giving the choice of screws size based on the anatomy and fracture pattern. Additionally, all screws in the system are inserted with the same T10 screwdriver for ease-of-use.</span></span><br>\n</p>\n",
          "jcr:lastModified": "Thu Jan 12 2023 21:44:14 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
