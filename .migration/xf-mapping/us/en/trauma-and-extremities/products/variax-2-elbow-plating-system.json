          "preset": "max_width_1440",
          "jcr:created": "Thu Nov 17 2022 01:17:31 GMT+0000",
          "alt": "Screw options",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/variaxelbow/images/Screwheads-v2.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Dec 15 2022 00:27:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
