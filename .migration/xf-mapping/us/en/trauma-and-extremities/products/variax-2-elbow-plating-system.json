          "jcr:created": "Thu Nov 17 2022 01:17:31 GMT+0000",
          "alt": "Plate offerings",
          "srcFileRef": "/content/dam/stryker/trauma-and-extremeties/products/variaxelbow/images/Family-v3.png",
          "borderColor": "rgba(76,125,122,1)",
