  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>ReUnion Shoulder&nbsp;</p>\r\n",
    "shortDescTop": "<p>The ReUnion TSA Shoulder System offers novel technologies such as X3 highly crosslinked polyethylene and patented intuitive instrumentation designed to provide simple solutions to complicated procedures.</p>\r\n",
    "jcr:lastModifiedBy": "frank.mastrangelo@stryker.com",
    "jcr:lastModified": "Wed Aug 23 2017 13:19:25 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Streamlined and intuitive platform instrument system</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fully convertible platform humeral stems provides intraoperative and postoperative flexibility for you and your patients when deciding between a hemi, anatomic total or reverse shoulder arthroplasty<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Wide range of humeral head sizes; both concentric and eccentric with 360° of possible rotation and staggered humeral head thicknesses to provide more options for obtaining proper tensioning of the joint</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>The first self-pressurizing, highly crosslinked polyethylene glenoid prosthesis<sup>1</sup> designed to pressurize and interdigitate cement into surrounding bone, while helping prevent cement egress</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
