  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>HA injectable bone substitute&nbsp;</p>\r\n",
    "shortDescTop": "<p>HydroSet is specifically formulated to effectively set in a wet field environment and exhibits outstanding wet-field characteristics. The crystalline structure and porosity offer osteoconductive and osteointegrative properties, with biocompatibility and mechanical characteristics. Hydroset is designed to offer rigidity, structure, and to encourage new bone formation.<sup>1,2,3,4</sup><br />\r\n</p>\r\n",
    "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
    "hideComponent": "false",
    "jcr:lastModified": "Tue Mar 29 2022 14:33:17 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Under wet conditions, HydroSet is shown to set significantly faster than competitive products<sup>5,6</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Indicated to augment provisional hardware to support bone fragments during the surgical procedure<sup>7</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fast setting crystalline structure is able to set within eight minutes after implantation under normal physiological circumstances<sup>8</sup></p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>HydroSet XT simplifies product preparation by eliminating bowl mixing, mixing inconsistencies and the transfer into syringe<sup>1,8,9</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>HydroSet XT enhances ease of use by using a self-contained delivery system with a locking torque handle<sup>1,8,9</sup></p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>HydroSet XT increases working time by reducing preparation time and using a torque handle to continue working while HydroSet XT begins to set<sup>1,9</sup></p>\r\n",
        "textIsRich": "true"
      }
    }
  },
