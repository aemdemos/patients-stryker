          "jcr:created": "Wed Mar 13 2024 20:31:04 GMT+0000",
          "text": "<p><span class=\"urw-egyptienne\"><span class=\"fontsize-2em\">Pro-Dense LoVisc injectable regenerative graft is Pro-Dense Graft in a lower viscosity form. Pro-Dense LoVisc allows for easier injectability, improved flowability, and extended working time compared to the original Pro-Dense formulation. Pro-Dense LoVisc graft sets hard, is radiopaque, and regenerates stronger, denser new bone.¹</span></span></p>\n",
          "jcr:lastModified": "Wed Aug 07 2024 18:26:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
