        "text_652839079_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-65eab19e7c@example.invalid",
          "jcr:lastModifiedBy": "user-42b58e166b@example.invalid",
          "jcr:created": "Wed Dec 27 2023 00:57:23 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"urw-egyptienne\">Pro-Dense is the first bone graft substitute indicated for the use in bone voids resulting from the resection of benign bone cysts in children 6 years and older. It delivers predicable bone regeneration with its triphasic resorption profile for faster, denser bone regeneration, stronger new bone, and a graft that remodels to normal bone.</span></span></p>\n",
          "jcr:lastModified": "Wed Aug 07 2024 18:23:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
