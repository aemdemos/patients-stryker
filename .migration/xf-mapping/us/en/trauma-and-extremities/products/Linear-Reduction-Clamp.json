    "cols2_809014751": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Dec 27 2022 23:24:21 GMT+0000",
      "jcr:lastModified": "Tue Dec 27 2022 23:24:21 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span style=\"font-size: 28px;\"><b><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Modern Reduction.</span></span></b></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Ratchet-based mechanism of action</span><span class=\"urw-egyptienne\"><br>\n Allows for consistent and repeatable compressive forces</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Four hook options</span><span class=\"urw-egyptienne\"><br>\n Four different hook options with varying sizes and tip ends to suit your indication needs. Hook attachments can be oriented in eight different ways relative to the handle and can be changed intra-operatively.</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Removable handle technology</span><span class=\"urw-egyptienne\"><br>\n The handle can be removed from the assembly without any loss of compressive forces. This allows for multiple hook attachments from the same set to be assembled and reduces obstruction at site-of-care.</span></span></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Tue Dec 27 2022 23:31:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "vince.wolff@stryker.com",
