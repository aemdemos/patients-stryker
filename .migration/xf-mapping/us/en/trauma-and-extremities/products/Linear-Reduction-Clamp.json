    "cols2_809014751_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Tue Dec 27 2022 23:24:21 GMT+0000",
