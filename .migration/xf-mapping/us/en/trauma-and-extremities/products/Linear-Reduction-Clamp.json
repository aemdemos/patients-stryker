          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Tue Dec 27 2022 23:34:36 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2em\"><span style=\"color: #ffb500;\">Instrumentation made simple.</span></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Cannulated compression rod for direct screw placement</span><br>\n <span class=\"urw-egyptienne\">Cannulated compression rod can accept ø2.7mm cortical, ø3.5mm cortical, ø4.5mm cortical, and ø6.5mm cancellous screws</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Compatible with PRO system</span><br>\n <span class=\"urw-egyptienne\">Complements our existing PRO pelvis portfolio</span></span></p>\n",
          "jcr:lastModified": "Tue Dec 27 2022 23:35:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
