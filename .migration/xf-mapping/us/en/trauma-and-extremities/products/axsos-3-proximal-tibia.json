    "cols2_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Wed Dec 28 2022 00:59:41 GMT+0000",
      "jcr:lastModified": "Wed Dec 28 2022 00:59:41 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">AxSOS 3 Ti&nbsp;</span><br>\n </span><span class=\"urw-egyptienne\">Proximal Medial Tibia</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Designed for direct medial or posteromedial placement</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">You can use it in conjunction with proximal lateral tibia plate</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>1</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Provides increased CT imaging clarity<sup>2</sup>&nbsp;</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Offers excellent biocompatibility<sup>3,4</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 01:21:36 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "text_copy_1060583734_1777640615": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">AxSOS 3 Ti&nbsp;</span><br>\n </span><span class=\"urw-egyptienne\">Proximal Lateral Tibia</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">5 metaphyseal screw hole option</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Superior posterior rafting and kick-stand</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">You can use it in conjunction with proximal medial tibia plate</span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>1</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Provides increased CT imaging clarity<sup>2</sup></span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Offers excellent biocompatibility<sup>3,4</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 28 2022 01:22:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
