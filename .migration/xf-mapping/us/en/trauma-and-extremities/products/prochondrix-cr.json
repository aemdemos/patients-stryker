  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>ProChondrix CR Cryopreserved Fresh Osteochondral Allograft<br>\r\n</p>\r\n",
    "shortDescTop": "<p>ProChondrix CR is a cryopreserved, fresh osteochondral allograft that contains live cells and other biological components for the repair of damaged cartilage tissues.<sup>1</sup></p>\r\n<p>ProChondrix CR can be used in a variety of orthopedic reconstructive procedures to aid in the repair of articular cartilage.<sup>2</sup></p>\r\n",
    "jcr:lastModifiedBy": "vince.wolff@stryker.com",
    "jcr:lastModified": "Tue Feb 27 2018 08:56:30 GMT-0500",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>The extracellular matrix is designed to help support a structure for cellular migration and adhesion while preserving growth factors<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Presence of native growth factors may help maintain healthy cartilage and facilitate chondrocyte functionality<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Viable chondrocytes have been shown to be present and may aid in cartilage repair by generating extracellular matrix proteins that help promote chondrgensis<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      }
    }
  },
