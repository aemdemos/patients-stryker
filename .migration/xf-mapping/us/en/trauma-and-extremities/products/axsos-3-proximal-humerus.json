    "cols2_1_3_2_3_copy_c": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
      "jcr:created": "Fri Sep 23 2022 18:31:11 GMT+0000",
      "jcr:lastModified": "Fri Sep 23 2022 18:31:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_1060583734": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "lee.fuller1@stryker.com",
          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Plating that fits.&nbsp;&nbsp;</span><br>\n</span></span></p>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Every minute counts in the OR. From a population-based implant design, a patented screw-to-plate interface, and streamlined instrumentation, our focus was on creating a well-designed plating system, giving you more time to focus on other things.</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">8 metaphyseal K-wire and suture holes<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Available in lengths up to 306mm<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Patented locking screw head design helps ease extraction<sup>1</sup></span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>2</sup><br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Provides increased CT imaging clarity<sup>3</sup><br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Offers excellent biocompatibility<sup>4,5</sup></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Dec 13 2022 21:31:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
