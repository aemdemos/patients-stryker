  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits. </p>\r\n",
    "shortDescTop": "<p>Every minute counts in the OR. From a population-based implant design, a patented screw-to-plate interface, and streamlined instrumentation, our focus was on creating a well-designed plating system, giving you more time to focus on other things.</p>\r\n",
    "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Tue Dec 13 2022 21:31:55 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>8 metaphyseal K-wire and suture holes</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Available in lengths up to 306mm</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Patented locking screw head design helps ease extraction<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>May allow for a less rigid construct, potentially resulting in increased callus formation and secondary healing<sup>2</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Provides increased CT imaging clarity<sup>3</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Offers excellent biocompatibility<sup>4,5</sup><br>\r\n</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
