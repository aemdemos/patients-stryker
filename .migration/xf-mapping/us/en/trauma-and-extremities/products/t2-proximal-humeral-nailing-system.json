          "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">T2 Proximal Humeral Nail</span><br>\n </span><span class=\"urw-egyptienne\">Product features&nbsp;</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Nylon bushings in proximal locking hole</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Bushings designed to decrease screw back-out</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Targeted short and long nail lengths</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Cannulated nail allows for easy insertion</span></span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Distal hole allows for dynamic locking</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 14 2022 02:22:30 GMT+0000",
