  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p><sup>ProLayer Acellular Dermal Matrix</sup></p>\r\n",
    "shortDescTop": "<p>ProLayer provides a three dimensional collagen elastin matrix for the patient’s own cells to infiltrate and repopulate and begin the vascularization and remodeling process.</p>\r\n",
    "jcr:lastModifiedBy": "devin.doran@stryker.com",
    "jcr:lastModified": "Thu Aug 10 2017 11:24:45 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Exhibited higher tensile strength in benchtop testing compared to published values for competitive acellular dermal matrices<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Prehydrated to allow for immediate use in operative setting and availible in meshed and unmeshed forms in a variety of sizes</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Proprietary cleansing technology utilizes no detergents or enzymes. ProLayer is terminally sterilized using E-Beam to a SAL of 10<sup>-6.</sup></p>\r\n",
        "textIsRich": "true"
      }
    }
  },
