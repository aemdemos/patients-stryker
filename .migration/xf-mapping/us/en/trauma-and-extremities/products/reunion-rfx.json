  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>ReUnion Shoulder&nbsp;</p>\r\n",
    "shortDescTop": "<p>The ReUnion Shoulder System offers novel technologies such as X3 highly crosslinked polyethylene, Tritanium 3D porous metal, and SmartLock variable angle locking screws in a shoulder arthroplasty system, combined with patented intuitive instrumentation designed to provide simple solutions to complicated procedures.</p>\r\n",
    "jcr:lastModifiedBy": "user-98ada7da8d@example.invalid",
    "jcr:lastModified": "Wed Aug 23 2017 13:18:12 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Fully-convertible, SOMA-designed, fracture specific platform fracture stems provide a common humeral implant for treating proximal humeral fractures with a hemiarthroplasty or reverse shoulder arthroplasty; as well as revisions or stem conversions<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>First and only patented expanding intramedullary humeral trial allows for height and version adjustments, while allowing you to complete a full trial reduction of the shoulder, including the tuberosities</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Streamlined and intuitive, platform instruments for total and reverse shoulder arthroplasty&nbsp;</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
