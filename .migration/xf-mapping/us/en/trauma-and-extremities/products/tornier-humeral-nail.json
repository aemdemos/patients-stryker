          "jcr:lastModifiedBy": "cedu.ocson@stryker.com",
          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"fontsize-2em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Tornier Humeral Nail</span><br>\n </span><span class=\"urw-egyptienne\">Product features&nbsp;<br>\n &nbsp;</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Fixation philosophy</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Fix the tuberosities in order to support the head<br>\n &nbsp;</span></span></li>\n</ul>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Nail design</span></span></p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Tuberosity-based screw pattern lags fragments perpendicular to the pull of the muscles<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Screw pattern supports periphery of humeral head fragment and avoids the articular surface<br>\n <br>\n </span></span></li>\n<li><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Straight nail design avoids rotator cuff insertion</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Wed Dec 14 2022 02:44:11 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
