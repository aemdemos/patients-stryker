          "jcr:created": "Mon Aug 22 2022 22:16:19 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Lateral</span></span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">A.</span></span><span class=\"urw-egyptienne\">&nbsp;The superior lateral clavicle plate offers an optional fixed-angle aiming block which may be used to help guide the surgeon in placing screws in a reproducible divergent screw pattern.</span></span></li>\n</ul>\n",
          "jcr:lastModified": "Sat Nov 19 2022 21:56:25 GMT+0000",
