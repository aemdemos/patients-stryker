  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits.</p>\r\n",
    "shortDescTop": "<p>Simplicity and adaptability with seven new indication specific plates using the comprehensive locking and non-locking screw system. The patented polyaxial locking technology and low profile design were created using our SOMA database. The adaptable design allows for modularity and variable angles, you can base screw positioning on your patient at hand, not a plate’s pre-existing design.</p>\r\n",
    "jcr:lastModifiedBy": "devin.doran@stryker.com",
    "jcr:lastModified": "Mon Jul 17 2017 16:13:27 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Compression and locking in one step</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Patented SmartLock Polyaxial Locking Technology <sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Seven new indication specific plates</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Locking screws can be angled ±15° for a total range of 30°</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Anodization type II</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Low profile plate design</p>\r\n",
        "textIsRich": "true"
      }
    }
