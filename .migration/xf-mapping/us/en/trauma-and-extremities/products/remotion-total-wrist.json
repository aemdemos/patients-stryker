  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Small joints</p>\r\n",
    "shortDescTop": "<p>We provide the ReMotion Total Wrist implant in left and right hand configurations with geometrically scaled sizes to accommodate anthropomorphic size variations of the radio-carpal joint. The prosthesis is composed of three primary articulating components: radial, carpal ball and carpal plate.</p>\r\n",
    "jcr:lastModifiedBy": "user-65eab19e7c@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Wed Dec 14 2022 01:28:52 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Reservation of the ligamentous structures may allow for more anatomic wrist kinematics</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Surface replacement implant designed for minimal resection of the distal radius and carpal bones</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
