  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>ReUnion Shoulder<br>\r\n</p>\r\n",
    "shortDescTop": "<p>The ReUnion Shoulder System offers novel technologies such as X3 highly crosslinked polyethylene, Tritanium 3D porous metal, and SmartLock variable angle locking screws in a shoulder arthroplasty system, combined with patented intuitive instrumentation designed to provide simple solutions to complicated procedures.</p>\r\n<p>&nbsp;</p>\r\n<p>Fully convertible platform humeral stems provides intraoperative and postoperative flexibility for you and your patients when deciding between a hemi, anatomic total or reverse shoulder arthroplasty.</p>\r\n<p>&nbsp;</p>\r\n",
    "jcr:lastModifiedBy": "user-c66c5d4a4b@example.invalid",
    "jcr:lastModified": "Fri Jul 21 2017 12:59:45 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Tritanium 3D porous metal backed glenoid baseplate; allows mechanism for bony ingrowth<sup>1</sup></p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Curved back baseplate geometry allows mechanism for shear resistance<sup>2</sup></p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>SmartLock compressive locking center screws</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>SmartLock variable angle locking peripheral screws with a 30° cone of angulation</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Humeral inserts made with X3 highly crosslinked polyethylene</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Streamlined and intuitive platform instrument system</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
