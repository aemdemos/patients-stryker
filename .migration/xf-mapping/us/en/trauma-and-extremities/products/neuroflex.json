  "rte": {
    "jcr:primaryType": "nt:unstructured",
    "jcr:lastModifiedBy": "user-c26bb7a766@example.invalid",
    "text": "<ul>\n<li>Neuro<i>flex</i> is the only nerve conduit indicated for the treatment of symptomatic or painful neuromas and features corrugated walls allowing it to bend up to approximately 60 degrees without forming an occlusion<sup>3,4</sup></li>\n<li>Designed to be an interface between the nerve and the surrounding tissue to prevent the ingrowth of scar tissue<sup><br>\n </sup></li>\n</ul>\n",
    "jcr:lastModified": "Thu Mar 31 2022 14:40:15 GMT+0000",
    "sling:resourceType": "stryker/components/content/text",
    "textIsRich": "true"
  },
