  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Plating that fits.</p>\r\n",
    "shortDescTop": "<p>The VariAx Hand Locking and Profyle Hand<b> </b>System which offers the benefits of a comprehensive range of variable angled locking and non-locking plating options to treat a full range of hand fractures. Plates utilize SmartLock Technology which permits polyaxial screw placement. You can angle locking screws up to 10º in each direction for a total range of 20º providing you with the flexibility to position screws based on the patient, not a plate’s pre-existing design. </p>\r\n",
    "jcr:lastModifiedBy": "vince.wolff@stryker.com",
    "hideComponent": "true",
    "jcr:lastModified": "Tue May 31 2022 19:50:11 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Various 1.7mm and 2.3mm locking plate options and 1.2mm, 1.7mm and 2.3mm non-locking plating options for flexibility to treat different fractures</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Specialty plate options including fifth metacarpal and rotation plate with vertical gliding hole</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Rounded, low-profile screw heads</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>T5 and T6 screw interface designed for increased self retention and may reduce risk of stripping</p>\r\n",
        "textIsRich": "true"
      },
      "5": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Modular tray design allows customization options<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "6": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Color coded screws and instruments designed for ease of use and identification</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
