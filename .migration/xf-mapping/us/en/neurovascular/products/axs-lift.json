      "accordion_parsys2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "accPosId": 2,
        "text_169613730411356": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "text": "<p><span class=\"fontsize-1-25em\">With its large 0.074&quot; ID, the AXS Lift Intracranial Base Catheter provides space for varied treatment techniques while also providing the support needed for a range of therapeutic devices. All this through a small 7F catheter.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Intracranial access that’s broadly compatible for interventions</span></li>\n<li><span class=\"fontsize-1-25em\">Parallel or sequential microcatheter capabilities</span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Fri Mar 28 2025 19:02:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "cq:responsive": {
