    "experiencefragment_2000705350": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "carolyn.lee@stryker.com",
      "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
      "jcr:created": "Wed Feb 19 2025 01:07:21 GMT+0000",
      "text": "1) Atraumatic tip Gentle for distal navigation 2) Low profile outer diameter 7Fr compatible (0.097in OD) Low-profile OD minimizes puncture size 3) Large 0.074\" inner diameter Seamless compatibility with parallel techniques 4) Distal 15cm construction featuring nitinol round wire coils and ultra soft polymers Highly trackable and supportive intracranially 5) Proximal construction featuring nitinol round wire coils, stainless steel braid and stiffer polymers Pushable and supportive in the arch which eliminates the need for a guide Diameter x length 0.074 x 95cm 0.074 x 105cm 0.074 x 110cm",
      "jcr:lastModified": "Wed Feb 19 2025 01:07:47 GMT+0000",
      "sling:resourceType": "stryker/components/content/experienceFragment",
