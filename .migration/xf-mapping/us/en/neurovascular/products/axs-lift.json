            "text_169613730411356": {
              "jcr:primaryType": "nt:unstructured",
              "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
              "hideComponent": "false",
              "gradientDirection": "left-to-right",
              "text": "<p><span class=\"fontsize-1-25em\">AXS Lift's innovative technology gives you the reach of a high performance intermediate catheter with the support of a guide in one device.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Streamlined setup</span></li>\n<li><span class=\"fontsize-1-25em\">Reduces time from puncture to the cavernous by 29%</span></li>\n<li><span class=\"fontsize-1-25em\">Fewer catheters, fewer manipulations</span></li>\n</ul>\n",
              "jcr:lastModified": "Wed Jun 11 2025 21:02:38 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true",
              "cq:responsive": {
                "jcr:primaryType": "nt:unstructured"
              }
            }
          },
