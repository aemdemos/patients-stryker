          "hideComponent": "false",
          "jcr:created": "Fri Apr 04 2025 20:55:20 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Thin-wall, braided-reinforcement short sheath designed to fit our 9F system while maintaining the familiar workflow of an 8F closure.</span></p>\n",
