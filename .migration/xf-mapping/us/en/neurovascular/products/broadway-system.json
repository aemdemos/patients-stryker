              "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
              "jcr:created": "Fri Apr 04 2025 20:47:47 GMT+0000",
              "text": "<p><span class=\"fontsize-1-25em\">Broadway 8 Catheter's low profile 2.41mm distal outer diameter closely matches the average M1 diameter<sup>1</sup> to deliver a reliable fit in more patients.<sup>2</sup></span></p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-8em\">1. ASSIST Registry<br>\n 2. As compared to 0.088in super-bore catheters.</span></p>\n",
              "jcr:lastModified": "Thu May 01 2025 22:25:04 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            }
          },
