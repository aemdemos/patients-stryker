          "hideComponent": "false",
          "jcr:created": "Fri Apr 04 2025 20:57:53 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Engineered with our newest <b>36<span style=\"color: #ffb500;\">O</span>Max</b> laser technology, Echo provides a supportive base with a large 0.100in lumen for optimal delivery of Broadway 8.</span></p>\n",
