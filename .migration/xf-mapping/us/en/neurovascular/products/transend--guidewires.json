          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "jcr:created": "Wed Oct 18 2023 17:40:52 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><b>ICE - Hydrophilic Distal Selection</b></span></p>\n<p><span class=\"fontsize-1-25em\">ICE is a lubricious coating on the 39cm distal segment (distal 61cm in Transend .010) which is intended to facilitate advancement of the guidewire within the microcatheter and tortuous neurovasculature</span><br>\n</p>\n",
          "jcr:lastModified": "Wed Oct 18 2023 19:10:17 GMT+0000",
