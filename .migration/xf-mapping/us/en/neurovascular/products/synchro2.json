      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "leftPadding": "5",
          "topPadding": "5",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Jan 24 2025 22:05:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">1)</span>&nbsp;PTFE-coated proximal shaft&nbsp;</span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">to enhance tracking and manipulation of the guideware within the catheter.&nbsp;</span></span></span></span><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><br>\n</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">2)</span>&nbsp;Platinum/tungsten alloy coil tip&nbsp;</span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">to allow flouroscopic visualization.&nbsp;</span></span></span></span><br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">3)</span>&nbsp;Flat-ribbon core wire tip&nbsp;</span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">enhances shape retention.</span></span></span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">4)</span>&nbsp;Hydrophylic distal segment&nbsp;</span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">designed to offer easier navigation.</span></span></span></span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">5)&nbsp;<span style=\"color: #ffb500;\">Distal soft tip with GentleTip technology </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">achieved by ribbon tip steel core, small diameter grind and nitinol hypotube cut profile.</span></span></span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">6)<span style=\"color: #ffb500;\">&nbsp;Stainless steel core wire </span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">designed to offer stability and flexibility.&nbsp;</span></span></p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">7)</span>&nbsp;<span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">Pushability and torque control</span></span> </span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">transmitted through the 35cm nitinol microfabricated hypotube.&nbsp;</span></span></p>\n",
          "jcr:lastModified": "Fri Nov 14 2025 21:55:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "showDimensionalBox": "true",
          "textIsRich": "true",
          "leftMargin": "5"
        }
      }
    },
