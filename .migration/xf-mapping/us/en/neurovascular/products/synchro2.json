          "preset": "max_width_auto",
          "jcr:created": "Fri Jan 24 2025 22:01:43 GMT+0000",
          "alt": "Synchro 2 product hotspots",
          "srcFileRef": "/content/dam/stryker/neurovascular/products/synchro2/images/synchro2-hotspots.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Mar 20 2025 19:36:14 GMT+0000",
