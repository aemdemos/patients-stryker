          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "jcr:created": "Wed Oct 16 2024 15:58:50 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">The TARGET Registry</span> is an investigator-initiated prospective, multi center US registry of patients treated exclusively with Target 360 and Helical Detachable Coils led by Dr. Osama Zaidat at Mercy Health St. Vincent Hospital.</span></p>\n",
          "jcr:lastModified": "Wed Oct 16 2024 16:20:31 GMT+0000",
