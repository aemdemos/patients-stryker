      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_1858774412": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-73104d59b2@example.invalid",
          "jcr:lastModifiedBy": "user-73104d59b2@example.invalid",
          "jcr:created": "Wed Oct 16 2024 15:59:57 GMT+0000",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">The ULTRA Registry</span> is an investigator-initiated prospective, multicenter US registry of patients with small (&lt;5mm) intracranial aneurysms treated exclusively with Target Ultra and Nano Detachable Coils led by Dr. Gaurav Jindal at the University of Maryland.</span></p>\n",
          "jcr:lastModified": "Wed Oct 16 2024 16:20:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
