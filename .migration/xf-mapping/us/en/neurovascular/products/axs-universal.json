    "text_copy_copy_copy": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "3",
      "jcr:createdBy": "carolyn.lee@stryker.com",
      "leftPadding": "4",
      "topPadding": "4",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "hideComponent": "false",
      "rightMargin": "5",
      "jcr:created": "Fri Jan 24 2025 22:05:23 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">1)</span>&nbsp;More aspiration power to hold on to clot<sup>1</sup>&nbsp;</span><br>\n</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">2)</span>&nbsp;Adjustable vacuum power <br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">Vacuum regulator tailors the vacuum power as needed</span></span></span></span><br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">3)</span>&nbsp;Find clot&nbsp;<br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">ClotFinder Specimen Cup retains the clot for quick and easy identification of aspirated thrombus</span></span></span></span></p>\n<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">4)</span>&nbsp;Aspirate on-demand<br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span style=\"color: #000000;\"><span class=\"fontsize-1-25em\">The tubing clamp controls aspiration without turning the pump on or off</span></span></span></span></p>\n<p><span class=\"fontsize-8em\">1. Bench test results may not necessarily be indicative of clinical performance. Testing performed by Medela on behalf of Stryker.</span></p>\n",
      "jcr:lastModified": "Fri Feb 07 2025 17:52:55 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "4",
      "showDimensionalBox": "true",
      "textIsRich": "true",
      "leftMargin": "5"
    },
