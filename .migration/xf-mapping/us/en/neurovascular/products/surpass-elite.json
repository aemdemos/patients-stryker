      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "darek.jansen1@stryker.com",
          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Wed May 21 2025 17:12:35 GMT+0000",
          "alt": "Surpass Elite comparison details",
          "srcFileRef": "/content/dam/stryker/neurovascular/products/surpass-elite/Surpass Elite -comparison details.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed May 21 2025 17:13:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "darek.jansen1@stryker.com",
          "jcr:lastModifiedBy": "darek.jansen1@stryker.com",
          "jcr:created": "Wed May 21 2025 17:13:13 GMT+0000",
          "text": "<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">1. Enhanced material strength for a durable braid that doesn’t fatigue<br>\n <br>\n <br>\n</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">2. High mesh density device designed for maximized flow diversion<br>\n <br>\n <br>\n</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\">3. <span style=\"color: #ffb500;\">64</span> wire flow diversion with pure CoCr structural wires<br>\n <br>\n</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><br>\n4. Higher braid angle for opening with less manipulation<br>\n <br>\n</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><br>\n5. Higher durometer resheath pad</span></span><span class=\"futura-bold\"><sup>†</sup></span><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"> for a confident resheath without compromising proximal opening<br>\n <br>\n</span></span></p>\n<p><span class=\"fontsize-1-75em\"><span class=\"futura-bold\"><br>\n6. An optimized delivery system</span></span></p>\n<p>Bodiless petals and anatomy-specific, stainless-steel wire deliverable through <span class=\"futura-bold\">Excelsior XT-27 Microcatheter</span></p>\n",
          "jcr:lastModified": "Fri May 23 2025 14:44:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
