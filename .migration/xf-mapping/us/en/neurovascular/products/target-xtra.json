          "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td style=\"text-align: center;\"><b>Product number</b></td>\n<td style=\"text-align: center;\"><b>Description</b></td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT1508</td>\n<td style=\"text-align: center;\">1.5 mm x 8 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT1510</td>\n<td style=\"text-align: center;\">1.5 mm x 10 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT1512</td>\n<td style=\"text-align: center;\">1.5 mm x 12 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT1516</td>\n<td style=\"text-align: center;\">1.5 mm x 16 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2010</td>\n<td style=\"text-align: center;\">2.0 mm x 10 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2012</td>\n<td style=\"text-align: center;\">2.0 mm x 12 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2016</td>\n<td style=\"text-align: center;\">2.0 mm x 16 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2022</td>\n<td style=\"text-align: center;\">2.0 mm x 22 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2512</td>\n<td style=\"text-align: center;\">2.5 mm x 12 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2516<br>\n</td>\n<td style=\"text-align: center;\">2.5 mm x 16 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2522</td>\n<td style=\"text-align: center;\">2.5 mm x 22 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT2525</td>\n<td style=\"text-align: center;\">2.5 mm x 25 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT3016</td>\n<td style=\"text-align: center;\">3.0 mm x 16 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT3022</td>\n<td style=\"text-align: center;\">3.0 mm x 22 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr><tr><td style=\"text-align: center;\">TGVT3032</td>\n<td style=\"text-align: center;\">3.0 mm x 32 cm</td>\n<td style=\"text-align: center;\">&nbsp;</td>\n</tr></tbody></table>\n",
