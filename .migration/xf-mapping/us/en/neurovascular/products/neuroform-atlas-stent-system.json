      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "3",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "leftPadding": "5",
          "topPadding": "5",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "rightMargin": "5",
          "jcr:created": "Fri Jan 24 2025 22:05:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">Enhanced conformability<br>\n</span></span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Improved strut design for greater wall apposition</span></span></li>\n</ul>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\">Ease of use</span></span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">Designed for delivery through an 0.0165in (Excelsior SL-10) or 0.017in (Excelsior XT-17)&nbsp;Microcatheter</span></span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">Predictable stent re-crossability</span></span></span></li>\n</ul>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\">High deployment accuracy</span></span></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Low foreshortening</span></span></li>\n<li><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\">Superior radial force compared to closed cell and braided stents</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Tue Sep 16 2025 14:13:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "showDimensionalBox": "true",
          "textIsRich": "true",
          "leftMargin": "5"
        }
      }
    },
