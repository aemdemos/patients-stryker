    "table_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "cedu.ocson@stryker.com",
      "tableData": "<table width=\"75%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td>Stent diameter</td>\n<td>Stent length</td>\n<td>Unconstrained<br>\nstent diameter</td>\n<td>Recommended parent<br>\nvessel diameter</td>\n</tr><tr><td>3.0mm</td>\n<td>15mm</td>\n<td>3.5mm</td>\n<td>≥2.0 and &lt;3.0mm</td>\n</tr><tr><td>3.0mm</td>\n<td>21mm</td>\n<td>3.5mm</td>\n<td>≥2.0 and &lt;3.0mm</td>\n</tr><tr><td>3.0mm</td>\n<td>24mm</td>\n<td>3.5mm</td>\n<td>≥2.0 and &lt;3.0mm</td>\n</tr><tr><td>4.0mm</td>\n<td>15mm</td>\n<td>4.5mm</td>\n<td>≥3.0 and &lt;4.0mm</td>\n</tr><tr><td>4.0mm</td>\n<td>21mm</td>\n<td>4.5mm</td>\n<td>≥3.0 and &lt;4.0mm</td>\n</tr><tr><td>4.0mm</td>\n<td>24mm</td>\n<td>4.5mm</td>\n<td>≥3.0 and &lt;4.0mm</td>\n</tr><tr><td>4.0mm</td>\n<td>30mm</td>\n<td>4.5mm</td>\n<td>≥3.0 and &lt;4.0mm</td>\n</tr><tr><td>4.5mm</td>\n<td>15mm</td>\n<td>5.0mm</td>\n<td>≥4.0 and &lt;4.5mm</td>\n</tr><tr><td>4.5mm</td>\n<td>21mm</td>\n<td>5.0mm</td>\n<td>≥4.0 and &lt;4.5mm</td>\n</tr><tr><td>4.5mm</td>\n<td>30mm</td>\n<td>5.0mm</td>\n<td>≥4.0 and &lt;4.5mm</td>\n</tr><tr><td colspan=\"4\">Required microcatheter: Stryker 0.0165-0.017in (0.42-0.43mm).</td>\n</tr></tbody></table>\n",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
