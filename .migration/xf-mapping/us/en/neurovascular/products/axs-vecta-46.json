          "jcr:created": "Tue Jun 27 2023 20:23:06 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">(1) <span style=\"color: #4c7d7a;\">Soft atraumatic tip</span></span> – to go farther distal</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">(2) <span style=\"color: #4c7d7a;\">11cm distal flex zone</span></span> – for enhanced trackability</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">(3) <span style=\"color: #4c7d7a;\">25cm distal hydrophilic coating</span></span> – for ease of navigation</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">(4) <span style=\"color: #4c7d7a;\">Full-length PTFE liner</span></span> – for smooth therapy delivery</span></p>\n<p><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">(5) <span style=\"color: #4c7d7a;\">Nitinol cross coil proximal segment</span></span> – for optimal support and pushability</span></p>\n",
          "jcr:lastModified": "Fri Jun 30 2023 14:05:34 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
