          "hideComponent": "false",
          "jcr:created": "Fri Jan 24 2025 22:47:50 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-2em\">Detachment preparation</span></span></span></p>\n<ul>\n<li>Slide the InZone Detachment System funnel over the proximal end of the delivery wire until the wire is completely inserted</li>\n</ul>\n",
          "jcr:lastModified": "Mon Jan 27 2025 17:53:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
