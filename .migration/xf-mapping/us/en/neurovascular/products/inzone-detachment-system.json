          "jcr:created": "Fri Feb 21 2025 15:23:47 GMT+0000",
          "alt": "inzone-product",
          "srcFileRef": "/content/dam/stryker/neurovascular/products/inzone-detachment-system/images/inzone-hotspots-graphic.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Sep 23 2025 14:40:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy_copy_copy_": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "carolyn.lee@stryker.com",
          "leftPadding": "5",
          "topPadding": "5",
          "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
          "hideComponent": "false",
          "rightMargin": "5",
          "jcr:created": "Fri Jan 24 2025 22:05:23 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">1)</span>&nbsp;96% first press detachment rate<br>\n </span></span></span><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\">Designed for high detachment rate, the InZone Detachment System can smartly monitor the detachment status and optimize the current flow time to detach coils with one attempt for most cases.</span></span></p>\n<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">2)</span>&nbsp;94% signal accuracy<br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">The smart InZone Detachment System is designed to detect the detachment status with high signal accuracy.&nbsp;</span></span></span></span><br>\n</p>\n<p><span class=\"futura-bold\"><span class=\"fontsize-1-5em\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\">3)</span>&nbsp;User-friendly signal&nbsp;<br>\n </span></span></span><span style=\"color: #ffb500;\"><span class=\"urw-egyptienne\"><span class=\"fontsize-1-25em\"><span style=\"color: #000000;\">Reliable signal systems with user friendly beep sounds.</span></span></span></span></p>\n",
          "jcr:lastModified": "Fri Feb 28 2025 20:38:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "5",
          "showDimensionalBox": "true",
          "textIsRich": "true",
          "leftMargin": "5"
        }
      }
    },
    "text_copy": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "3",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "leftPadding": "8",
      "topPadding": "3",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Mon Jan 27 2025 22:05:14 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span style=\"color: #000000;\"><span style=\"color: #ffffff;\"><span class=\"fontsize-2-5em\"><span style=\"color: #000000;\"><span style=\"color: #ffffff;\">The only detachment device currently on the market that is designed to:</span></span></span></span></span></span></span></p>\n<ul>\n<li style=\"text-align: left;\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Detect if the coil is likely detached when the cycle is complete†</span></span></li>\n<li style=\"text-align: left;\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Detect challenging environmental conditions and respond dynamically</span></span></li>\n<li style=\"text-align: left;\"><span class=\"fontsize-1-5em\"><span class=\"urw-egyptienne\">Built-in memory recall of what occurred on the previous press</span></span></li>\n</ul>\n",
      "jcr:lastModified": "Fri Mar 14 2025 17:31:52 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "5",
      "backgroundColor": "rgb(182,114,25)",
      "gradientDirectionInverse": "true",
      "textIsRich": "true"
    },
    "text_230005421": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "2",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "topPadding": "2",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Fri Feb 28 2025 20:11:44 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><span class=\"fontsize-8em\">†&nbsp;Verify under fluoroscopy that the coil has detached by slowly pulling back on the delivery wire and monitoring the fluoro image to make sure the coil does not move</span></p>\n",
      "jcr:lastModified": "Fri Feb 28 2025 20:16:34 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
