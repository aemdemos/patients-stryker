    "cols2_1_3_2_3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-7065227e84@example.invalid",
      "jcr:lastModifiedBy": "user-7065227e84@example.invalid",
      "jcr:created": "Thu Apr 21 2022 17:51:50 GMT+0000",
      "jcr:lastModified": "Thu Apr 21 2022 17:51:50 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7065227e84@example.invalid",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Thu Apr 21 2022 17:51:54 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span style=\"color: #85458a;\">ASSIST Study</span></span></span></p>\n<ul>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Prospective, consecutive&nbsp;enrollment registry</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">All-comer patient population&nbsp;with anterior LVO</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Core lab adjudicated</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">71 sites in 11 countries</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Stryker’s Total Stroke products&nbsp;used on the 1st pass</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">Three technique arms</span></span></li>\n<li><span class=\"urw-egyptienne\"><span class=\"fontsize-1-5em\">SR Classic + BGC (N=247), SR Combination (N=695),&nbsp;Direct Aspiration (N=548)</span></span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Mon Oct 06 2025 21:38:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "table_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7065227e84@example.invalid",
          "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td>&nbsp;</td>\n<td><b>SR Classic + BGC</b></td>\n<td><b>SR Combination</b></td>\n<td><b>Direct Aspiration</b></td>\n</tr><tr><td><b>Pre-stroke mRS</b></td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr><tr><td>0-1</td>\n<td>81.6%</td>\n<td>82.0%</td>\n<td>88.4%</td>\n</tr><tr><td>0-2</td>\n<td>90.2%</td>\n<td>88.5%</td>\n<td>94.2%</td>\n</tr><tr><td><b>NIHSS at presentation²</b></td>\n<td>15</td>\n<td>14</td>\n<td>15</td>\n</tr><tr><td><b>Occlusion location</b></td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr><tr><td>Distal ICA</td>\n<td>15.4%</td>\n<td>18.5%</td>\n<td>28.5%</td>\n</tr><tr><td>M1</td>\n<td>58.7%</td>\n<td>48.9%</td>\n<td>54.7%</td>\n</tr><tr><td>M2</td>\n<td>25.5%</td>\n<td>30.8%</td>\n<td>16.4%</td>\n</tr><tr><td><b>Tandem occlusion</b></td>\n<td>10.5%</td>\n<td>15.5%</td>\n<td>14.2%</td>\n</tr><tr><td colspan=\"4\" style=\"text-align: center;\"><b>Results</b></td>\n</tr><tr><td><b>90-Day mRS</b></td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr><tr><td>0-1</td>\n<td>47.3%</td>\n<td>39.6%</td>\n<td>41.3%</td>\n</tr><tr><td>0-2</td>\n<td>59.1%</td>\n<td>52.7%</td>\n<td>54.0%</td>\n</tr><tr><td>sICH</td>\n<td>2.0%</td>\n<td>2.2%</td>\n<td>2.6%</td>\n</tr><tr><td><b>Embolization&nbsp;<span style=\"font-size: 0.8125rem;\">to new territory</span></b></td>\n<td>0.8%</td>\n<td>0.9%</td>\n<td>0.6%</td>\n</tr><tr><td><b>Stroke related mortality</b></td>\n<td>7.7%</td>\n<td>9.0%</td>\n<td>6.9%</td>\n</tr></tbody></table>\n",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Thu Apr 21 2022 17:57:05 GMT+0000",
          "jcr:lastModified": "Wed Dec 17 2025 23:01:57 GMT+0000",
