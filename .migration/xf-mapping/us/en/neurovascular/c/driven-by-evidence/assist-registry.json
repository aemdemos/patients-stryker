          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Thu Apr 21 2022 17:51:54 GMT+0000",
          "text": "<p><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span style=\"color: #85458a;\">Across all techniques</span></span></span><br>\n</p>\n<p>&nbsp;</p>\n<h2><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span style=\"color: #85458a;\">54.2%</span></span></span><br>\n<span class=\"urw-egyptienne\">90D mRS 0-2</span></h2>\n<h2><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span style=\"color: #85458a;\">42.4%</span></span></span><br>\n<span class=\"urw-egyptienne\">TICI 2c+ on first pass</span></h2>\n<h2><span class=\"futura-bold\"><span class=\"fontsize-2-5em\"><span style=\"color: #85458a;\">1.5</span></span></span><br>\n<span class=\"urw-egyptienne\">Mean # passes</span></h2>\n",
          "jcr:lastModified": "Mon Nov 03 2025 16:43:17 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "table_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-7065227e84@example.invalid",
          "tableData": "<table width=\"100%\" cellspacing=\"0\" cellpadding=\"1\" border=\"1\">\n<tbody><tr><td>&nbsp;</td>\n<td><b>SR Classic + BGC</b></td>\n<td><b>SR Combination</b></td>\n<td><b>Direct Aspiration</b></td>\n</tr><tr><td><b>90D mRS 0-2</b></td>\n<td>59.1%</td>\n<td>52.7%</td>\n<td>54.0%</td>\n</tr><tr><td><b>1st-pass eTICI</b></td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr><tr><td>2c+</td>\n<td>47.2%</td>\n<td>45.4%</td>\n<td>36.5%</td>\n</tr><tr><td>2b+</td>\n<td>71.7%</td>\n<td>73.7%</td>\n<td>62.2%</td>\n</tr><tr><td><b>Final eTICI</b></td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr><tr><td>2c+</td>\n<td>69.8%</td>\n<td>64.9%</td>\n<td>65.6%</td>\n</tr><tr><td>2b+</td>\n<td>97.1%</td>\n<td>96.2%</td>\n<td>96.9%</td>\n</tr><tr><td><b>Mean # passes</b></td>\n<td>1.4</td>\n<td>1.5</td>\n<td>1.4</td>\n</tr><tr><td><b>Median time to final reperfusion:</b> (minutes)</td>\n<td>29.2</td>\n<td>31.3</td>\n<td>27.1</td>\n</tr></tbody></table>\n",
          "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
          "jcr:created": "Thu Apr 21 2022 17:57:05 GMT+0000",
          "jcr:lastModified": "Wed Dec 17 2025 23:00:28 GMT+0000",
