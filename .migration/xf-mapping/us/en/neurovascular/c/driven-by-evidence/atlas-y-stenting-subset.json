        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f03ac58e27@example.invalid",
          "jcr:lastModifiedBy": "user-f03ac58e27@example.invalid",
          "jcr:created": "Wed Dec 07 2022 21:29:27 GMT+0000",
          "text": "<p>Results are based on retrospective subset analysis of a single-arm trial</p>\n<p>Source: Jadhav AP, Desai SM, Jovin TG et al. Y-Stent–Assisted Coiling of Wide-Necked Intracranial Aneurysms With the Neuroform Atlas Stent System.</p>\n<p>Stroke Vasc Interv Neurol. 2022;0:e000437</p>\n",
          "jcr:lastModified": "Wed Dec 07 2022 21:30:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
