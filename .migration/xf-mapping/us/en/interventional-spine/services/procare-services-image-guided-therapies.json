  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Get the most from your equipment&nbsp;investment</p>\r\n",
    "shortDescTop": "<p>With ProCare Services, we set a new standard for customer support. Our goal is to make it easier for you to get the most from your investment in equipment from Stryker. ProCare Services offer you peace of mind at a fixed cost.</p>\r\n",
    "jcr:lastModifiedBy": "user-f9c250736c@example.invalid",
    "jcr:lastModified": "Mon Sep 18 2017 16:15:31 GMT-0400",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "shortDescBottom": "<p>Our team has the proprietary knowledge, components and tools to care for your equipment from Stryker and keep it performing to the highest standards.</p>\r\n"
  },
