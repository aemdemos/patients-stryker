              "sling:resourceType": "stryker/components/content/accordion",
              "accordion_parsys1": {
                "jcr:primaryType": "nt:unstructured",
                "sling:resourceType": "wcm/foundation/components/parsys",
                "accPosId": 1,
                "text": {
                  "jcr:primaryType": "nt:unstructured",
                  "jcr:lastModifiedBy": "user-4a9aa678a2@example.invalid",
                  "text": "<ul>\n<li><span class=\"fontsize-1-25em\">Immediate high viscosity after mixing<sup><a href=\"#references\">3</a></sup>&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Controlled interdigitation and fill<sup><a href=\"#references\">1</a></sup></span></li>\n<li><span class=\"fontsize-1-25em\">Working time of approximately 18 minutes<sup><a href=\"#references\">3</a></sup>&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Set time 10.2 minutes at 37ºC<sup><a href=\"#references\">1</a></sup>&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Low creep rate<sup><a href=\"#references\">1</a></sup></span></li>\n<li><span class=\"fontsize-1-25em\">Increased viscosity improves visibility<sup><a href=\"#references\">1</a></sup></span></li>\n<li><span class=\"fontsize-1-25em\">30% barium sulfate concentration</span></li>\n</ul>\n",
                  "jcr:lastModified": "Mon Feb 02 2026 14:14:42 GMT+0000",
                  "sling:resourceType": "stryker/components/content/text",
                  "textIsRich": "true"
                }
              },
