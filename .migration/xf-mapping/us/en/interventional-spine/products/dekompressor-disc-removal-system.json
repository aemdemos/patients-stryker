  "pageshortdescription": {
    "jcr:primaryType": "nt:unstructured",
    "shortDescTitle": "<p>Features</p>\r\n",
    "shortDescTop": "<p>You may be able to use the removed material for disc biopsies. Multiple clinical studies show that percutaneous discectomies using our Dekompressor System are successful for 90% of patients.<a name=\"refNum3\" href=\"https://providers.strykerivs.com/products/dekompressor-disc-removal-system#ref3\" title=\"Goto Reference 3\"><sup>3</sup></a> This minimally invasive procedure reduces pressure on the nerve root by removing disc nucleus.</p>\r\n",
    "jcr:lastModifiedBy": "user-a6c55eaa2a@example.invalid",
    "hideComponent": "true",
    "jcr:lastModified": "Fri Aug 11 2023 18:02:28 GMT+0000",
    "sling:resourceType": "stryker/components/content/pageshortdescription",
    "textIsRich": [
      "true",
      "true",
      "true"
    ],
    "bulletList": {
      "jcr:primaryType": "nt:unstructured",
      "1": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Removes quantifiable disc material</p>\r\n",
        "textIsRich": "true"
      },
      "2": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>No capital equipment required<br>\r\n</p>\r\n",
        "textIsRich": "true"
      },
      "3": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>No thermal damage to the nerve root</p>\r\n",
        "textIsRich": "true"
      },
      "4": {
        "jcr:primaryType": "nt:unstructured",
        "bullet": "<p>Provides sample for biopsy</p>\r\n",
        "textIsRich": "true"
      }
    }
  },
