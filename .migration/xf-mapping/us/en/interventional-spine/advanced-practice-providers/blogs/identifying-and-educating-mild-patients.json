          "jcr:created": "Wed Aug 20 2025 17:13:50 GMT+0000",
          "alt": "Excess hypertrophic ligamentum flavum, a possible symptom seen in typical mild® patients",
          "srcFileRef": "/content/dam/stryker/ivs/news/app-blogs/identifying-and-educating mild® patients/images/mild_HLF-rev.png",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Nov 26 2025 20:44:47 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
