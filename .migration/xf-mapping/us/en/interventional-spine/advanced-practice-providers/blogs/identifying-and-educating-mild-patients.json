    "text_183546058": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "1",
      "jcr:createdBy": "user-4a9aa678a2@example.invalid",
      "topPadding": "0",
      "jcr:lastModifiedBy": "user-4a9aa678a2@example.invalid",
      "hideComponent": "false",
      "topMargin": "-2",
      "jcr:created": "Wed Aug 20 2025 15:26:44 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<ul>\n<li><span class=\"fontsize-1-25em\">At-home reconditioning walking program can be initiated immediately, as tolerated&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Assess outcomes at 2-weeks and 4-6 weeks, then monthly. Assess mobility and Quality of Life (QOL) improvements, such as:&nbsp;</span><ul>\n<li><span class=\"fontsize-1-25em\">Transfer ability: Getting in and out of the bed/seat/car&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Walking and standing times&nbsp;</span></li>\n<li><span class=\"fontsize-1-25em\">Activities of daily living: Ability to get dressed, take off shoes, household chores, and grocery shopping</span></li>\n</ul>\n</li>\n</ul>\n<p><span class=\"fontsize-1-25em\"><br>\nIf you would like a mild<sup>®</sup> Quick Reference Card for your office or to learn more about APP-specific educational opportunities, <b>please contact your local sales representative.</b></span></p>\n",
      "jcr:lastModified": "Wed Nov 26 2025 14:42:39 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true"
    },
