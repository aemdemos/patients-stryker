          "text": "<ul>\n<li><span class=\"fontsize-1-25em\"><a href=\"/content/dam/stryker/ivs/grants-and-donations/resources/submitting-a-grant-request.pdf\" target=\"_blank\">Submitting an educational grant request</a></span></li>\n<li><span class=\"fontsize-1-25em\"><a href=\"/content/dam/stryker/ivs/grants-and-donations/resources/submitting-a-charitable-donation-request.pdf\" target=\"_blank\">Submitting a charitable donation request</a></span></li>\n<li><span class=\"fontsize-1-25em\"><a href=\"/content/dam/stryker/ivs/grants-and-donations/resources/third-party-support.pdf\" target=\"_blank\">Industry support guidance</a></span></li>\n<li><a href=\"https://openpaymentsdata.cms.gov/\" target=\"_blank\"><span class=\"fontsize-1-25em\">CMS Transparency open payments</span></a></li>\n</ul>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><br>\n&nbsp;</p>\n",
