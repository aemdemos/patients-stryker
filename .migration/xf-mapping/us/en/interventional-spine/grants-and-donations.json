    "text": {
      "jcr:primaryType": "nt:unstructured",
      "bottomPadding": "2",
      "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
      "topPadding": "3",
      "jcr:lastModifiedBy": "user-4a9aa678a2@example.invalid",
      "hideComponent": "false",
      "topMargin": "2",
      "jcr:created": "Tue Aug 26 2025 14:53:29 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<h3><span class=\"fontsize-1-25em\">Together with our customers,<span class=\"futura-bold\"> <span style=\"color: #ffb500;\">we are driven to make healthcare better</span></span></span></h3>\n<p><span class=\"fontsize-1-25em\">This is Stryker's mission, accomplished by collaborating with our customers to develop innovative products and services that improve the lives of patients.</span></p>\n<p><span class=\"fontsize-1-25em\">At Stryker, we recognize the important role that medical education grants and charitable donations play in our mission, both in benefits to patient care and the advancement of medical technology, treatments and knowledge.</span></p>\n",
      "jcr:lastModified": "Wed Feb 18 2026 14:19:09 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "rightPadding": "5",
      "backgroundColor": "rgb(255,255,255)",
      "textIsRich": "true",
      "bottomMargin": "2"
    },
    "cols2": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
      "jcr:lastModifiedBy": "user-b3eaac8b1c@example.invalid",
      "jcr:created": "Tue Aug 26 2025 14:43:36 GMT+0000",
      "jcr:lastModified": "Tue Aug 26 2025 14:43:36 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_791904153": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "leftPadding": "5",
          "topPadding": "3",
          "jcr:lastModifiedBy": "user-4a9aa678a2@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Tue Aug 26 2025 14:55:16 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h3><span class=\"urw-egyptienne\"><span style=\"color: #ffffff;\"><span class=\"fontsize-1-25em\">Application process</span></span></span></h3>\n",
          "jcr:lastModified": "Mon Feb 02 2026 15:09:18 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "backgroundColor": "rgb(89,75,97)",
          "gradientDirectionInverse": "true",
          "textIsRich": "true"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "5",
          "jcr:createdBy": "user-b3eaac8b1c@example.invalid",
          "leftPadding": "7",
          "topPadding": "5",
          "jcr:lastModifiedBy": "user-4a9aa678a2@example.invalid",
          "hideComponent": "false",
          "topMargin": "3",
          "jcr:created": "Tue Aug 26 2025 14:44:01 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\">Factors our committee considers as part of the review process may include the following: independently developed content by a qualified medical education provider, audience, location and budget.</span></p>\n<p><span class=\"fontsize-1-25em\">On an annual basis, we receive hundreds of requests, and we aim to provide responsible support. Please note that due to finite resources, not every quality program will receive support.</span></p>\n<p><span class=\"fontsize-1-25em\">All support from Stryker is provided in accordance with <a href=\"https://www.advamed.org/member-center/resource-library/advamed-code-of-ethics/\" target=\"_blank\">AdvaMed Code of Ethics</a> on Interactions with Healthcare Professionals, Stryker corporate and divisional policies, and applicable federal and local laws.</span></p>\n",
          "jcr:lastModified": "Mon Feb 02 2026 15:09:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "rightPadding": "7",
          "showDimensionalBox": "true",
          "textIsRich": "true"
        }
      },
