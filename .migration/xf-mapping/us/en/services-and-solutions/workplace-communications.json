          "jcr:created": "Mon Aug 28 2023 14:32:26 GMT+0000",
          "alt": "teacher wearing Sync Badge is standing in classroom with students behind her ",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/Workplace-Comms_Education-hero_1200x680.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Apr 13 2026 22:10:06 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
