          "alt": "nurse wearing Vocera Smartbagde help patient in home",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/long-term-care_hero_1200x680.jpg",
          "borderColor": "rgba(76,125,122,1)",
