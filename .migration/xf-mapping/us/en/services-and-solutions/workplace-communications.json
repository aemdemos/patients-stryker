        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Mon Aug 28 2023 14:29:26 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Hands-free communication for veterinary hospitals</span></span></h2>\n<p><span class=\"fontsize-1-75em\"><span class=\"urw-egyptienne\">Connect your care teams quickly and efficiently</span></span></p>\n<p><span class=\"fontsize-1-25em\">Veterinary care hospitals are dynamic and often chaotic environments that demand hands-on client care while communicating on the go. Stryker's technology is wearable, hands-free communication for veterinary care environments. With our solutions, your care teams can connect quickly to communicate and collaborate more efficiently.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Save steps and time.</span></li>\n<li><span class=\"fontsize-1-25em\">Reach help quickly in an emergency.</span></li>\n<li><span class=\"fontsize-1-25em\">Communicate safely, even while wearing PPE.</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">Stryker's solutions enable fast hands-free communication, allowing staff to reach the right people at the right time without having to know names or numbers. Our flexible technology platform can scale across your entire operation, from a single department to multiple sites.</span></p>\n",
          "jcr:lastModified": "Mon Apr 13 2026 18:22:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
