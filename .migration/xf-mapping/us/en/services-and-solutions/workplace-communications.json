      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Mon Aug 28 2023 14:29:26 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Hands-free communication for long-term care communities</span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Equip staff to be connected, protected and responsive</span></span></p>\n<p><span class=\"fontsize-1-25em\">Make it easier for staff to reach each other across long-term care communities with Stryker’s lightweight, wearable badges. The Smartbadge and Sync Badge bring together voice calling, secure messaging, notifications and a panic button in one device.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Make calls and send secure texts without needing to know a name, extension or phone number.</span></li>\n<li><span class=\"fontsize-1-25em\">Say, &quot;Ok Vocera&quot; and then the name, group, department or role of the person you're trying to reach to connect quickly.</span></li>\n<li><span class=\"fontsize-1-25em\">Know who is and isn’t available with a near-real time directory view of staff in different functional areas across your facility.&nbsp;</span></li>\n</ul>\n<p><span class=\"fontsize-1-25em\">With our technology, staff can work smarter, not harder, spending less time and energy reaching people and more on fulfilling acts of caregiving. Residents can feel more at home thanks to quiet, discreet communication and more timely service.</span></p>\n",
          "jcr:lastModified": "Wed Apr 29 2026 16:18:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
        "curatedcta_copy": {
