      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Mon Aug 28 2023 15:25:19 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-5em\">Workflow <span class=\"futura-bold\">efficiency</span></span></h2>\n<ul>\n<li><span class=\"fontsize-1-25em\">Choose the right device for the role: Vocera communication software also runs on iOS® and Android™ smartphones. Equip each user with the appropriate device to meet the needs of their job.</span></li>\n<li><span class=\"fontsize-1-25em\">Respond to calls or texts without interrupting critical tasks or important interaction with others.<br>\n </span></li>\n<li><span class=\"fontsize-1-25em\">Say the name, group, department or role of the person you’re trying to reach to connect quickly. There’s no need to know a name, extension or phone number.</span></li>\n</ul>\n<h2><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Technology</span>&nbsp;and <span class=\"futura-bold\">integration</span></span><br>\n</h2>\n<p><span class=\"fontsize-1-25em\">Integrates with multiple emergency communication solutions including:</span></p>\n<ol>\n<li><span class=\"fontsize-1-25em\">Situational awareness technologies for life safety, security, environmental monitoring and mass notification.</span></li>\n<li><span class=\"fontsize-1-25em\">Critical event management solutions that rapidly pinpoint threats and automate response.</span></li>\n<li><span class=\"fontsize-1-25em\">Solutions for access control.</span></li>\n</ol>\n",
          "jcr:lastModified": "Mon Apr 13 2026 18:30:56 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
