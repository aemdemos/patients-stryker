              "hideComponent": "false",
              "topMargin": "3",
              "gradientDirection": "left-to-right",
              "text": "<h1><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\">Workplace communications</span></span></span></h1>\n<h1>Help your team stay connected and safe</h1>\n<p><span class=\"fontsize-1-25em\">In workplaces where safety is a priority, team members using Stryker's wearable, hands-free communication devices help everyone stay connected. Within your facility or beyond, communicate quickly with the right person at the right time. Explore our solutions for education, long-term care, veterinary hospitals and hospitality.</span></p>\n<p>&nbsp;</p>\n",
              "jcr:lastModified": "Wed Oct 09 2024 12:56:30 GMT+0000",
              "sling:resourceType": "stryker/components/content/text",
              "textIsRich": "true"
            },
