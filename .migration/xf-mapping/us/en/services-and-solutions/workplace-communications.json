          "alt": "Hotel guest services standing at front desk wearing Vocera Smartbadge",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/workplace-communications_hospitality_hero_1200x680.jpg",
          "borderColor": "rgba(76,125,122,1)",
