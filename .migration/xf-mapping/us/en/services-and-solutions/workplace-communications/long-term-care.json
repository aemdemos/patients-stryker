      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Fri Jan 05 2024 21:05:23 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h4><span class=\"urw-egyptienne\"><span class=\"fontsize-2vw\">“The integration of Stryker’s Vocera technology with our life-safety system is like having our own 911 center. It lets us respond to urgent resident needs faster and more intelligently.”</span></span></h4>\r\n<p style=\"text-align: right;\"><span class=\"fontsize-1-5-vw\"><span class=\"futura-bold\">Karen Kemp</span><br>\r\n IT Application Support Manager, Covia</span></p>\r\n<h4>&nbsp;</h4>\r\n",
      "jcr:lastModified": "Tue Feb 06 2024 16:31:56 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgb(237,238,236)",
