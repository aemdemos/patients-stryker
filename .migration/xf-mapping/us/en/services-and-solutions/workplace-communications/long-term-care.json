      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Nurse hugging patient both smiling",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/long-term-care_nurse-hugging-patient.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Apr 19 2024 14:10:41 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Create a quiet, home-like environment</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Minimize or eliminate noise from nurse call systems or intercoms.<br>\n</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Staff can call each other directly and use an earpiece or handset mode to allow more discreet conversations.</span></li>\n<li><span class=\"fontsize-1-25em\">Speak safely with isolated residents and bring family into the conversation.</span></li>\n<li><span class=\"fontsize-1-25em\">Residents can feel more at home thanks to quiet, discreet communication and more timely service from staff.<br>\n </span>&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Mon Jan 22 2024 18:09:50 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "largeheadline_copy": {
      "jcr:primaryType": "nt:unstructured",
