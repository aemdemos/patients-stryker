    "cols": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Fri Jan 05 2024 21:14:14 GMT+0000",
      "jcr:lastModified": "Fri Jan 05 2024 21:14:14 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "jcr:created": "Fri Jan 05 2024 21:14:20 GMT+0000",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Help your staff <span style=\"color: #323232;\"><span style=\"color: #ffb500;\">work smarter, not harder</span></span></span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Creating a better experience for them and the residents they serve</span></span></p>\n<p><span class=\"fontsize-1-25em\">Staff at long-term care and senior living communities do the type of work they do because they care about residents, yet they spend a great deal of time just trying to locate each other, leaving less time for the fulfilling aspects of caregiving. Employees need to be able to collaborate efficiently and get help quickly for their own safety and that of residents.</span></p>\n",
          "jcr:lastModified": "Fri Apr 19 2024 14:07:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_copy_2124941498": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Feb 06 2024 16:29:53 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 16:29:53 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Long-term care nurse sitting on sofa with patient wearing Vocera badges",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/long-term-care_nurse-patient-seated.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Apr 19 2024 14:08:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Communicate easily with individuals or groups</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Save steps and time by connecting quickly with nurses, certified nursing assistants and staff members without needing to know names, extensions or phone numbers.</span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Know who is and isn’t available with a near-real time directory view of staff in different functional areas across your facility.</span></li>\n<li><span class=\"fontsize-1-25em\">Call or page people inside or outside the facility – anyone, anywhere – and receive a direct call back. <br>\n </span>&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Thu Feb 22 2024 12:54:04 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Feb 06 2024 16:29:53 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 16:29:53 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Male nurse wearing a Vocera Smartbadge providing care to a senior living patient ",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/long-term-care_nurse-with-patient-walking-holding-hands.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Apr 19 2024 14:10:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Deliver alarms and notifications to the right people at the right time</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Vocera technology integrates with pendant, nurse call and wander-alert systems, and more.</span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Our technology can route notifications from these systems to the right team members who can respond quickly based on their proximity and availability.</span></li>\n<li><span class=\"fontsize-1-25em\">Notifications include the patient’s name, location and type of event.</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Feb 22 2024 12:50:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Feb 06 2024 16:29:53 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 16:29:53 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-9846ac1203@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Retirement community security guard responding to a call on the Vocera Smartbadge",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/hospitality_security-guard.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Fri Apr 19 2024 14:10:32 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Reach help quickly in an emergency</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Safety for residents and employees at long-term care and senior living communities depends upon having fast access to help. The Smartbadge has a built-in panic button intended for emergencies and active threats. Press it to discreetly broadcast to a response group.<br>\n</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Response group members will see the name and location of who’s sending the broadcast.</span></li>\n<li><span class=\"fontsize-1-25em\">They can hear what’s happening and communicate directly with that person if the situation allows it.</span></li>\n<li><span class=\"fontsize-1-25em\">Staff can use the Smartbadge to make a straight call to 911.</span><br>\n&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Tue Feb 20 2024 13:44:27 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
