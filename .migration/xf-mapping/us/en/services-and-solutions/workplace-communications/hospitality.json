      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Help reduce costs and enhance operational efficiency</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Unify communication software, an array of end-user devices and interoperability with systems for ticketing, customer relationship management, property management and more through a single vendor.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Our unified platform allows hotel systems and communication devices to talk to one another.</span><br>\n</li>\n<li><span class=\"fontsize-1-25em\">Scale from one property to many with a consistent software user experience.</span></li>\n<li><span data-rte-class=\"rte-temp\"><span data-rte-class=\"rte-temp\"><span class=\"fontsize-1-25em\">Connect multiple sites together and use analytics to monitor communication traffic.</span></span></span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jan 19 2024 19:02:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
