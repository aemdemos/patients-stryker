      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "-2",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Fri Jan 19 2024 18:43:15 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span style=\"color: #ffb500;\"><span class=\"fontsize-1-5em\"><span style=\"color: #000000;\">Experience our </span>communication solutions for hospitality</span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">Our hands-free communication devices bring together communication, work-order ticket management and a wearable panic button in one device. Our devices can be worn discreetly underneath a coat or uniform and used with or without a wired or Bluetooth headset.</span></p>\n",
          "jcr:lastModified": "Tue Apr 14 2026 14:28:43 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Tue Feb 06 2024 15:50:31 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 15:50:31 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "carolyn.lee@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Hotel housekeeping team member wearing a Vocera Smartbadge",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/smartbadge_hospitality_720x480.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Apr 07 2026 16:57:08 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Communicate with staff throughout the property</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Make calls and send secure texts without needing to know a name, extension or phone number. Communicate quickly, hands-free, without having to interrupt what you’re doing. Use a wired or Bluetooth headset to communicate discreetly.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Press the Call button on the Smartbadge or Sync Badge, or say “OK Vocera” and state the name, group, department or role of the person you’re trying to reach to connect quickly.</span></li>\n<li><span class=\"fontsize-1-25em\">For example, say, “Call front desk,” or “Call housekeeping,” or “Broadcast to maintenance staff.”</span></li>\n<li><span class=\"fontsize-1-25em\">See who’s available with a real-time directory view of staff across your property.</span><br>\n&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Tue Apr 14 2026 14:28:33 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_368481379": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Tue Feb 06 2024 16:51:17 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 16:51:17 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
