          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Hotel manager wearing Vocera Smartbadge in hotel lobby",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/hotel-manager-looking-at-phone.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Sep 11 2024 12:50:07 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text_170912017": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Integrate communication with hotel management systems</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Integrate Vocera technology with your PBX and systems for ticketing, customer relationship management (CRM) and property management. Streamline housekeeping and maintenance workflow and allow faster response to guests’ needs.</span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Enable delivery of service order notifications directly to the right staff member.</span></li>\n<li><span class=\"fontsize-1-25em\">Service requests include details such as the request, time and room number.</span></li>\n<li><span class=\"fontsize-1-25em\">Use a single device to respond to requests and close the loop, enhancing efficiency.<br>\n </span>&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Tue Feb 20 2024 13:33:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_1225090204": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "chris.kleckner@stryker.com",
      "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
      "jcr:created": "Tue Feb 06 2024 15:51:11 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 15:51:11 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "katie.boertman@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Hotel security guard wearing Vocera Smartbadge",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/hospitality_security-guard.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Wed Sep 11 2024 12:50:13 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Reach help quickly in an emergency</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Press the dedicated panic button on the Smartbadge or Sync Badge to quickly reach security personnel.</span><br>\n</p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Response group members will see the name and location of who’s sending the broadcast.</span></li>\n<li><span class=\"fontsize-1-25em\">They can hear what’s happening and communicate directly with that person if the situation allows it.</span></li>\n<li><span class=\"fontsize-1-25em\">Staff can use the Smartbadge or Sync Badge to make a call straight to 911.<br>\n </span></li>\n</ul>\n",
          "jcr:lastModified": "Tue Apr 14 2026 14:22:16 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_2131789202": {
      "jcr:primaryType": "nt:unstructured",
