          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Hotel manager greeting guests and wearing a Vocera Smartbadge",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/workplace-communications_hospitality_hero_720x480.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Apr 14 2026 14:20:28 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
