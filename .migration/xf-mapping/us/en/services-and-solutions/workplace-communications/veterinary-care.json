      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Fri Jan 05 2024 22:29:01 GMT+0000",
      "jcr:lastModified": "Fri Jan 05 2024 22:29:01 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "bottomPadding": "2",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "topPadding": "2",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "hideComponent": "false",
          "jcr:created": "Fri Jan 05 2024 22:29:07 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"futura-bold\"><span class=\"fontsize-1-5em\">Help veterinary care teams <span style=\"color: #ffb500;\">work smarter, not harder</span></span></span></h2>\n<p><span class=\"urw-egyptienne\"><span class=\"fontsize-1-75em\">Creating a better experience for them and the patients and clients they care about</span></span></p>\n<p><span class=\"fontsize-1-25em\">Effective veterinary care team communication can affect how clients perceive the veterinary practice and their pets’ care. It helps veterinary teams work together more efficiently and provide safer care.<sup>1</sup> Our flexible technology platform can scale across your entire operation, from a single department to multiple sites.</span></p>\n",
          "jcr:lastModified": "Tue Feb 06 2024 16:33:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Feb 06 2024 16:33:20 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 16:33:20 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Doctor with two nurses talking in hallway",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/veterinary-care_doctor-with-two-nurses-talking-in-hallway.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Jan 22 2024 20:22:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Communicate easily with individuals or groups</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Save steps and time by reaching individuals and groups fast without needing to know names or numbers. If your hands are on the patient and you’re wearing scrubs and gloves, you can communicate quickly, hands-free.<br>\n</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Press the Call button on the Smartbadge (or say, “OK Vocera”) and say the name, group, department or role of the person you’re trying to reach to connect directly.</span></li>\n<li><span class=\"fontsize-1-25em\">For example, say, “Broadcast to Triage Team,” or “Call Vet Tech,” or “Call Front Desk.”</span></li>\n<li><span class=\"fontsize-1-25em\">See who’s available with a near-real time directory view of staff in different functional areas across your facility.</span><br>\n&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Thu Feb 22 2024 12:54:21 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_867060529": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
      "jcr:created": "Tue Feb 06 2024 16:33:32 GMT+0000",
      "jcr:lastModified": "Tue Feb 06 2024 16:33:32 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "Nurse looking at Smartbadge",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/veterinary-care_tech-looking-at-smartbadge.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Jan 22 2024 20:22:58 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Accelerate triage</span></span></h3>\n<p><span class=\"fontsize-1-25em\">Facilitate communication and coordination between clients and staff inside and outside the facility to accelerate triage.<br>\n</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Reach team members throughout the facility for assistance if a client arrives with an animal in distress.</span></li>\n<li><span class=\"fontsize-1-25em\">Organize surgical teams rapidly and contact clients promptly when a decision is needed about proceeding with treatment.</span></li>\n<li><span class=\"fontsize-1-25em\">Staff can call each other directly and use an earpiece or handset mode to allow more discreet conversations and a quieter environment.<br>\n </span>&nbsp;</li>\n</ul>\n",
          "jcr:lastModified": "Mon Jan 22 2024 18:20:39 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
    "cols2_1_3_2_3_1847123045": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-f123ca2978@example.invalid",
      "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
