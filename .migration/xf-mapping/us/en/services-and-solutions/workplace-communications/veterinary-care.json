      "jcr:lastModified": "Tue Feb 06 2024 16:33:37 GMT+0000",
      "sling:resourceType": "stryker/components/content/columncontrol/cols2_1-3_2-3",
      "col1": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Fri Jan 05 2024 20:45:08 GMT+0000",
          "alt": "security guard running down hall",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/hospitality_security-guard.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Mon Jan 22 2024 19:57:02 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-f123ca2978@example.invalid",
          "jcr:lastModifiedBy": "user-f123ca2978@example.invalid",
          "jcr:created": "Fri Jan 05 2024 20:46:06 GMT+0000",
          "text": "<h3><span class=\"futura-bold\"><span class=\"fontsize-1-25em\">Reach help fast in an emergency or threat</span></span></h3>\n<p><span class=\"fontsize-1-25em\">The Smartbadge has a built-in panic button intended for emergencies and active threats. Press it to discreetly broadcast to a response group.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Response group members will see the name and location of who’s sending the broadcast.</span></li>\n<li><span class=\"fontsize-1-25em\">They can hear what’s happening and communicate directly with that person if the situation allows it.</span></li>\n<li><span class=\"fontsize-1-25em\">Staff can use the Smartbadge to make a straight call to 911.</span><br>\n</li>\n</ul>\n",
          "jcr:lastModified": "Mon Jan 22 2024 18:20:48 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
