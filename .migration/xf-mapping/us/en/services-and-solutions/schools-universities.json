          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "jcr:created": "Wed Aug 21 2024 18:49:35 GMT+0000",
          "text": "<h2><span class=\"fontsize-1-25em\"><span class=\"futura-bold\">Help enhance safety with AEDs and response with Vocera Smartbadges</span></span></h2>\n<p><span class=\"fontsize-1-25em\">On every school and university campus, student and staff safety is non-negotiable. Our AEDs and Smartbadges empower your team with the tools they need to help coordinate a response in any emergency. From life-saving interventions to near-real time communication, we’re here to help you stay prepared and protected when it matters most.</span></p>\n",
          "jcr:lastModified": "Tue Oct 07 2025 19:48:03 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
