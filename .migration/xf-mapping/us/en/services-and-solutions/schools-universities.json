          "jcr:created": "Wed Aug 21 2024 18:50:41 GMT+0000",
          "alt": "School employees wearing Vocera Smartbadges ",
          "srcFileRef": "/content/dam/stryker/acute-care/vocera/workplace-communication-solutions/education_secondary_855x450.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Oct 22 2024 19:49:15 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Wed Aug 21 2024 18:53:31 GMT+0000",
          "text": "<h2><span class=\"futura-bold\">Communication solutions for schools</span></h2>\n<p><span class=\"fontsize-1-25em\">Stryker's communication solution, the Smartbadge, equips staff to communicate quickly and broadly for routine daily communications – and features a discreet panic button, enabling fast, appropriate action in an emergency.</span><br>\n</p>\n<p><span class=\"fontsize-1-25em\"><a href=\"/content/stryker/us/en/acute-care/vocera/workplace-communications/education.html\"><span class=\"standalone-link\">Learn More</span></a></span></p>\n",
          "jcr:lastModified": "Fri Sep 27 2024 13:15:19 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
