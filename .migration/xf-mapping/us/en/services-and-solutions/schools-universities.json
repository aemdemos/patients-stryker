          "preset": "max_width_1440",
          "jcr:created": "Wed Aug 21 2024 18:50:41 GMT+0000",
          "alt": "An accessible Stryker AED hangs in a school hallway ",
          "srcFileRef": "/content/dam/stryker/ems/community-public-safety/education/EC_Community-Public-Safety_AEDs-in-Education_Hero_855x450.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Tue Oct 22 2024 19:48:45 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "chris.kleckner@stryker.com",
          "jcr:lastModifiedBy": "chris.kleckner@stryker.com",
          "jcr:created": "Wed Aug 21 2024 18:53:31 GMT+0000",
          "text": "<h2><span class=\"futura-bold\">AEDs in education</span></h2>\n<p><span class=\"fontsize-1-25em\">Sudden cardiac arrest can happen anywhere, even in schools and campuses. Our AEDs are designed to be ready at a moment’s notice, giving staff and students a chance when seconds count. Quick intervention before paramedics arrive can make all the difference.</span></p>\n<p><span class=\"fontsize-1-25em\"><a href=\"/content/stryker/us/en/emergency-care/community-public-safety/education.html\"><span class=\"standalone-link\">Learn More</span></a></span></p>\n",
          "jcr:lastModified": "Wed Oct 16 2024 17:29:49 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
