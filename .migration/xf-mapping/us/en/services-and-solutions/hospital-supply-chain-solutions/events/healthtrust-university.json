          "jcr:created": "Thu Jun 25 2026 21:44:30 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-25em\">Our simplified approach.&nbsp;<br>\n <span class=\"futura-bold\">Your goals in mind.</span></span></h2>\n",
          "jcr:lastModified": "Fri Jun 26 2026 16:14:53 GMT+0000",
