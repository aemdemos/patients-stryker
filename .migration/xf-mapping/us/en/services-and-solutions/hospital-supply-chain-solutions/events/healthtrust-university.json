          "hideComponent": "false",
          "topMargin": "2",
          "jcr:created": "Wed Mar 26 2025 21:24:32 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><b>Looking to maximize your HealthTrust contract? Visit Stryker at booth #1119</b> to explore our contracted product portfolio, as well as learn how we can support your ambulatory surgery center new build solutions.</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><a href=\"#contact\">Schedule dedicated time</a> with our team to discuss products on contract or where you are in your ASC new build journey, and learn how we can help support you.</span></li>\n</ul>\n<ul>\n<li><span class=\"fontsize-1-25em\"><a href=\"https://forms.office.com/r/TNb9Hdmgva\">Join Stryker at Tamayo</a> on Tuesday, July 21, to connect with your peers and our team while discussing solutions that elevate excellence.</span></li>\n</ul>\n",
          "jcr:lastModified": "Fri Jul 17 2026 15:57:25 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true",
          "bottomMargin": "4"
