          "jcr:lastModifiedBy": "kristian.bocage@stryker.com",
          "hideComponent": "false",
          "jcr:created": "Wed Mar 26 2025 21:24:32 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<h2><span class=\"fontsize-1-25em\"><span class=\"urw-egyptienne\"><span class=\"futura-bold\">Powering supply chain heroes&nbsp;</span></span></span></h2>\n<p><span class=\"fontsize-1-25em\">Every day, healthcare supply chain leaders step up as heroes — navigating disruptions, protecting product availability and ensuring clinicians have what they need to deliver care. Stryker is proud to support that mission as the first-ever recipient of the Healthcare Industry Resilience Collaborative <a href=\"https://view.stryker.com/viewer/2ef0a2cb8c066dd840f0b7d1021e0e3f\"><span style=\"color: #1c5687;\">(HIRC) Gold Resiliency Badge</span></a> — recognizing our adaptability and performance within the healthcare supply chain.&nbsp;</span></p>\n<p><span class=\"fontsize-1-25em\"><b>Stop by booth #1204 to see how Stryker helps power today’s supply chain heroes, and how we can help you build even greater resilience.</b></span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\"><a href=\"https://www.stryker.com/us/en/services-and-solutions/hospital-supply-chain-solutions/events/ahrmm.html#contact\"><span style=\"color: #1c5687;\">Schedule dedicated time</span></a> with our team to discuss supply chain and reprocessing</span></li>\n<li><span class=\"fontsize-1-25em\"><a href=\"https://www.stryker.com/us/en/services-and-solutions/hospital-supply-chain-solutions/events/ahrmm.html#contact\"><span style=\"color: #1c5687;\">Join us for a rooftop happy hour</span></a> on Monday, July 27 at Tenfold Rooftop from 6-8 p.m. to celebrate you, our supply chain heroes!</span></li>\n</ul>\n",
          "jcr:lastModified": "Thu Jun 25 2026 17:59:26 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        },
