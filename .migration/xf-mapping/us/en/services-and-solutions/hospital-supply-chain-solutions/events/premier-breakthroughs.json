              "line2": "<p><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\">Oct 6-8, 2026 | National Harbor, MD</span></span></span></p>\r\n<p><span class=\"fontsize-1-5-vw\"><span style=\"color: rgb(255,255,255);\"><span style=\"color: rgb(0,0,0);\"> </span></span></span></p>\r\n",
