          "jcr:created": "Wed Mar 26 2025 21:24:32 GMT+0000",
          "gradientDirection": "left-to-right",
          "text": "<p><span class=\"fontsize-1-25em\"><b><span style=\"color: #1c5687;\">Join us for a Stryker Experience on Tuesday, September 22, from 6:30-9:00 p.m.</span></b> for an interactive experience with your supply chain and hospital administration peers. Learn more about Stryker’s solutions for:​</span></p>\n<ul>\n<li><span class=\"fontsize-1-25em\">Supply chain resiliency and operational efficiency​</span></li>\n<li><span class=\"fontsize-1-25em\">Ambulatory Surgery Center opportunities ​</span></li>\n<li><span class=\"fontsize-1-25em\">Connected care innovations​</span></li>\n<li><span class=\"fontsize-1-25em\">Financial solutions and capital planning​</span></li>\n<li><span class=\"fontsize-1-25em\">Neurotechnology programs​</span></li>\n</ul>\n",
          "jcr:lastModified": "Mon Aug 31 2026 18:29:48 GMT+0000",
