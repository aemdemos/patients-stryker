          "jcr:created": "Fri Oct 31 2025 17:06:25 GMT+0000",
          "gradientDirection": "left-to-right",
          "line1": "<span class=\"futura-bold\"><span class=\"fontsize-2vw\">Program offerings</span></span>",
          "line2": "<span class=\"fontsize-1-5-vw\">We offer numerous payment structures that can be customized to meet budgetary needs and help to build long-term financial stability.</span>",
          "jcr:lastModified": "Fri Oct 31 2025 17:45:07 GMT+0000",
