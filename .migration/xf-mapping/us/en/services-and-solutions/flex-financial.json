      "jcr:created": "Fri Oct 31 2025 16:56:32 GMT+0000",
      "gradientDirection": "left-to-right",
      "line1": "<h1><span class=\"futura-bold\"><span style=\"color: rgb(255,181,0);\"><span class=\"fontsize-4vw\"><span class=\"fontsize-5vw\"><span style=\"color: rgb(0,0,0);\">Flex Financial</span></span></span></span></span></h1>\r\n",
      "line2": "<h2><span class=\"fontsize-3vw\">Add <span style=\"color: rgb(255,181,0);\"><span class=\"futura-bold\">flexibility</span></span> to your budget</span></h2>\r\n",
      "jcr:lastModified": "Tue Nov 11 2025 17:42:05 GMT+0000",
      "sling:resourceType": "stryker/components/content/largeheadline",
      "backgroundColor": "rgba(255,255,255,1)",
      "textIsRich": [
        "true",
        "true"
      ]
    },
    "text": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "courtney.dickens@stryker.com",
      "jcr:lastModifiedBy": "courtney.dickens@stryker.com",
      "hideComponent": "false",
      "jcr:created": "Fri Oct 31 2025 17:04:30 GMT+0000",
      "gradientDirection": "left-to-right",
      "text": "<p><b><span class=\"futura-bold\"><span class=\"fontsize-1-75em\">Overview</span></span></b></p>\n<p><span class=\"fontsize-1-5em\">It’s become extremely important to keep cash on hand, and we know that clinical demands don't go away. Get the equipment you need now and keep your cash for emergencies.</span></p>\n<p><span class=\"fontsize-1-5em\">Through Stryker’s Flex Financial, we provide comprehensive solutions that make it easier to meet your clinical and financial goals. We offer flexibility beyond a cash purchase, enabling you to acquire our full portfolio of products.</span></p>\n",
      "jcr:lastModified": "Fri Oct 31 2025 17:11:27 GMT+0000",
      "sling:resourceType": "stryker/components/content/text",
      "textIsRich": "true",
      "bottomMargin": "4"
    },
