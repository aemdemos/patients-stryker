        "text": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-e2eca0ceb5@example.invalid",
          "jcr:lastModifiedBy": "user-e2eca0ceb5@example.invalid",
          "jcr:created": "Thu Feb 16 2023 16:27:27 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Collections&nbsp;</span></span></p>\n<p><span class=\"urw-egyptienne\">Devices are collected at the hospital utilizing Stryker’s advanced collection system. Containers are placed in convenient usage areas and are regularly shipped by Stryker staff to our reprocessing facility.</span></p>\n",
          "jcr:lastModified": "Thu Feb 16 2023 16:28:42 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col2": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-e2eca0ceb5@example.invalid",
          "jcr:lastModifiedBy": "user-e2eca0ceb5@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Thu Feb 16 2023 16:33:34 GMT+0000",
          "alt": "inspection image",
          "srcFileRef": "/content/dam/stryker/sustainability/reprocessing-and-remanufacturing-/images/sorting image.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Feb 16 2023 16:43:46 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-e2eca0ceb5@example.invalid",
          "jcr:lastModifiedBy": "user-e2eca0ceb5@example.invalid",
          "jcr:created": "Thu Feb 16 2023 16:27:27 GMT+0000",
          "text": "<p><span style=\"font-size: 21px;\"><b><span class=\"futura-bold\">Sorting&nbsp;</span></b></span></p>\n<p><span class=\"urw-egyptienne\">Once collection containers have arrived at our reprocessing facility, contents are sorted to isolate reprocessable devices from devices that cannot be reprocessed.</span><br>\n</p>\n",
          "jcr:lastModified": "Thu Feb 16 2023 16:30:00 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      },
      "col3": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "wcm/foundation/components/parsys",
        "standaloneimage_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-e2eca0ceb5@example.invalid",
          "jcr:lastModifiedBy": "user-e2eca0ceb5@example.invalid",
          "preset": "max_width_1440",
          "jcr:created": "Thu Feb 16 2023 16:33:34 GMT+0000",
          "alt": "inspection image",
          "srcFileRef": "/content/dam/stryker/sustainability/reprocessing-and-remanufacturing-/images/reprocessing image.jpg",
          "borderColor": "rgba(76,125,122,1)",
          "jcr:lastModified": "Thu Feb 16 2023 16:44:31 GMT+0000",
          "sling:resourceType": "stryker/components/content/standaloneimage",
          "enableBorder": "false"
        },
        "text_copy": {
          "jcr:primaryType": "nt:unstructured",
          "jcr:createdBy": "user-e2eca0ceb5@example.invalid",
          "jcr:lastModifiedBy": "user-e2eca0ceb5@example.invalid",
          "jcr:created": "Thu Feb 16 2023 16:27:27 GMT+0000",
          "text": "<p><span class=\"fontsize-1-5em\"><span class=\"futura-bold\">Reprocessing&nbsp;</span></span></p>\n<p><span class=\"urw-egyptienne\">Devices are cleaned and disassembled by our highly trained staff. Parts are individually inspected and, depending on the device, may be replaced. Some devices go through more elaborate reprocessing procedures.</span><br>\n</p>\n",
          "jcr:lastModified": "Fri Feb 24 2023 18:44:22 GMT+0000",
          "sling:resourceType": "stryker/components/content/text",
          "textIsRich": "true"
        }
      }
    },
