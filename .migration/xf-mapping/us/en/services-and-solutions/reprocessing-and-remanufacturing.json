    "section_title_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-e2eca0ceb5@example.invalid",
      "description": "There are many steps involved in reprocessing single-use medical devices. Reprocessors must obtain a 510(k) clearance for each product and comply with the same medical device regulations as the original manufacturers. \r\n",
      "jcr:lastModifiedBy": "user-e2eca0ceb5@example.invalid",
      "deepLinkingId": "reprcoessed",
      "jcr:created": "Thu Feb 16 2023 16:49:00 GMT+0000",
      "title": "What is reprocessing? ",
      "jcr:lastModified": "Thu Aug 03 2023 19:20:21 GMT+0000",
      "sling:resourceType": "stryker/components/content/section-title"
    },
    "cols3_copy": {
      "jcr:primaryType": "nt:unstructured",
      "jcr:createdBy": "user-e2eca0ceb5@example.invalid",
