{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\" \"templates/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:breakpoints",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "test:a11y": "node tests/a11y/run.js",
    "test:a11y:keyboard": "node tests/a11y/run-keyboard.js",
    "test:a11y:keyboard:report": "node tests/a11y/report-keyboard.js",
    "postinstall": "playwright install chromium",
    "build:fragment-index": "node tools/importer/build-fragment-index.js",
    "lint:breakpoints": "node tools/check-breakpoints.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@babel/eslint-parser": "7.29.7",
    "@playwright/test": "^1.44.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0"
  },
  "dependencies": {
    "lint": "^1.2.2"
  }
}
