      {
        "component": "aem-content",
        "name": "mobileImage",
        "label": "Mobile Image (Dynamic Media link, optional)",
        "description": "Paste the direct Dynamic Media (Scene7) image URL for small screens. Do not upload from DAM.",
        "condition": {
          "or": [
            {
              "in": [
                "fullbleed",
                {
                  "var": "classes"
                }
              ]
            },
            {
              "in": [
                "banner",
                {
                  "var": "classes"
                }
              ]
            },
            {
              "in": [
                "band",
                {
                  "var": "classes"
                }
              ]
            }
          ]
        }
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "mobileImageAlt",
        "label": "Mobile Image Alt",
        "value": "",
        "condition": {
          "or": [
            {
              "in": [
                "fullbleed",
                {
                  "var": "classes"
                }
              ]
            },
            {
              "in": [
                "banner",
                {
                  "var": "classes"
                }
              ]
            },
            {
              "in": [
                "band",
