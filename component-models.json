    "id": "columns",
    "fields": [
      {
        "component": "number",
        "valueType": "number",
        "name": "columns",
        "label": "Number of Columns",
        "value": 2,
        "validation": {
          "numberMin": 1,
          "numberMax": 3
        }
      },
      {
        "component": "multiselect",
        "name": "classes",
        "label": "Layout",
        "valueType": "string",
        "options": [
