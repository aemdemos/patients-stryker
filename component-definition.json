{
  "groups": [
    {
      "title": "Default Content",
      "id": "default",
      "components": [
        {
          "title": "Text",
          "id": "text",
          "model": "text",
          "plugins": {
            "da": {
              "name": "text",
              "type": "text"
            }
          }
        },
        {
          "title": "Image",
          "id": "image",
          "model": "image",
          "plugins": {
            "da": {
              "name": "image",
              "type": "image",
              "fields": [
                {
                  "name": "image",
                  "selector": "img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "img[alt]"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "title": "Sections",
      "id": "sections",
      "components": [
        {
          "title": "Section",
          "id": "section",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>"
            }
          },
          "filter": "section",
          "model": "section"
        }
      ]
    },
    {
      "title": "Blocks",
      "id": "blocks",
      "components": [
        {
          "title": "Accordion",
          "id": "accordion",
          "model": "accordion",
          "filter": "accordion",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Accordion Item",
          "id": "accordion-item",
          "model": "accordion-item",
          "plugins": {
            "da": {
              "name": "accordion-item",
              "rows": 2,
              "columns": 0,
              "fields": [
                {
                  "name": "title",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "content",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Cards",
          "id": "cards",
          "model": "cards",
          "filter": "cards",
          "plugins": {
            "da": {
              "name": "cards",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Card",
          "id": "card",
          "model": "card",
          "plugins": {
            "da": {
              "name": "card",
              "unsafeHTML": "<div class=\"card\"><div><p><a href=\"\">Image alt</a></p></div><div><h3>Title</h3><p>Card text</p></div></div>",
              "fields": [
                {
                  "name": "image",
                  "selector": "div:nth-child(1) a[href]"
                },
                {
                  "name": "imageAlt",
                  "selector": "div:nth-child(1) a"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Columns",
          "id": "columns",
          "model": "columns",
          "filter": "columns",
          "plugins": {
            "da": {
              "name": "columns",
              "rows": 1,
              "columns": 2,
              "behaviour": "columns"
            }
          }
        },
        {
          "title": "Columns Row",
          "id": "columns-row",
          "model": "columns-row",
          "filter": "columns-row",
          "plugins": {
            "da": {
              "name": "columns-row",
              "behaviour": "columns-row"
            }
          }
        },
        {
          "title": "Columns Cell",
          "id": "columns-cell",
          "model": "columns-cell",
          "filter": "columns-cell",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>",
              "behaviour": "columns-cell"
            }
          }
        },
        {
          "title": "Fragment",
          "id": "fragment",
          "model": "fragment",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"fragment\"><div><div><p><a href=\"\">Fragment URL</a></p></div></div></div>",
              "fields": [
                {
                  "name": "url",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "urlText",
                  "selector": "div>div>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Hero",
          "id": "hero",
          "model": "hero",
          "plugins": {
            "da": {
              "name": "Hero",
              "unsafeHTML": "<div class=\"hero\"><div><div><p><a href=\"\">Desktop image alt</a></p></div></div><div><div><p><a href=\"\">Mobile image alt</a></p></div></div><div><div><h1>Heading</h1><p>Supporting copy</p></div></div></div>",
              "fields": [
                {
                  "name": "desktopImage",
                  "selector": "div:nth-child(1) a[href]"
                },
                {
                  "name": "desktopImageAlt",
                  "selector": "div:nth-child(1) a"
                },
                {
                  "name": "mobileImage",
                  "selector": "div:nth-child(2) a[href]"
                },
                {
                  "name": "mobileImageAlt",
                  "selector": "div:nth-child(2) a"
                },
                {
                  "name": "content",
                  "selector": "div:nth-child(3)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Icon List",
          "id": "icon-list",
          "model": "icon-list",
          "filter": "icon-list",
          "plugins": {
            "da": {
              "name": "icon-list",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Icon List (tile)",
          "id": "icon-list-tile",
          "model": "icon-list-tile",
          "filter": "icon-list",
          "plugins": {
            "da": {
              "name": "Icon List (tile)",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Icon List Item",
          "id": "icon-list-item",
          "model": "icon-list-item",
          "plugins": {
            "da": {
              "name": "icon-list-item",
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "icon",
                  "selector": "div:nth-child(1)>picture>img[src]"
                },
                {
                  "name": "iconAlt",
                  "selector": "div:nth-child(1)>picture>img[alt]"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Panel",
          "id": "panel",
          "model": "panel",
          "filter": "panel",
          "plugins": {
            "da": {
              "name": "panel",
              "rows": 1,
              "columns": 1
            }
          }
        },
        {
          "title": "Panel Item",
          "id": "panel-item",
          "model": "panel-item",
          "plugins": {
            "da": {
              "name": "panel-item",
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "text",
                  "selector": "div:nth-child(1)"
                }
              ]
            }
          }
        },
        {
          "title": "Statistics",
          "id": "statistics",
          "model": "statistics",
          "filter": "statistics",
          "plugins": {
            "da": {
              "name": "statistics",
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Statistic",
          "id": "statistic",
          "model": "statistic",
          "plugins": {
            "da": {
              "name": "statistic",
              "rows": 1,
              "columns": 3,
              "fields": [
                {
                  "name": "color",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "value",
                  "selector": "div:nth-child(2) > p"
                },
                {
                  "name": "description",
                  "selector": "div:nth-child(3)"
                }
              ]
            }
          }
        },
        {
          "title": "Sticky Nav",
          "id": "sticky-nav",
          "model": "sticky-nav",
          "filter": "sticky-nav",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Sticky Nav Item",
          "id": "sticky-nav-item",
          "model": "sticky-nav-item",
          "plugins": {
            "da": {
              "name": "sticky-nav-item",
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "label",
                  "selector": "div:nth-child(1) > p"
                },
                {
                  "name": "target",
                  "selector": "div:nth-child(2) > p"
                }
              ]
            }
          }
        },
        {
          "title": "Tabs",
          "id": "tabs",
          "model": "tabs",
          "filter": "tabs",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2
            }
          }
        },
        {
          "title": "Tab",
          "id": "tab",
          "model": "tab",
          "plugins": {
            "da": {
              "name": "tab",
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "label",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "content",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Video",
          "id": "video",
          "model": "video",
          "plugins": {
            "da": {
              "name": "Video",
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "link",
                  "selector": "a[href]"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}