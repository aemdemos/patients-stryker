{
  "definitions": [
    {
      "title": "DM Image",
      "id": "dm-image",
      "model": "dm-image",
      "plugins": {
        "da": {
          "name": "dm-image",
          "unsafeHTML": "<img src=\"\" alt=\"\">",
          "fields": [
            { "name": "dmImage", "selector": "img[src]" },
            { "name": "dmImageAlt", "selector": "img[alt]" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "dm-image",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "dmImage",
          "label": "Dynamic Media Image URL",
          "description": "Paste the Dynamic Media asset URL (e.g. https://media-assets.stryker.com/is/image/stryker/NAME?$preset$). Rendered as a responsive <picture> at load."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "dmImageAlt",
          "label": "Alt Text",
          "description": "Accessible description of the image."
        }
      ]
    }
  ]
}
