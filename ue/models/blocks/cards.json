{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "model": "cards",
      "filter": "cards",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1
        }
      }
    },
    {
      "title": "Card-cta",
      "id": "card-cta",
      "model": "card-cta",
      "plugins": {
        "da": {
          "name": "card-cta",
          "unsafeHTML": "<div><p></p></div>",
          "fields": [
            { "name": "text", "selector": "div:nth-child(1)" }
          ]
        }
      }
    },
    {
      "title": "Card-img",
      "id": "card-img",
      "model": "card-img",
      "plugins": {
        "da": {
          "name": "card-img",
          "unsafeHTML": "<div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\" alt=\"\"></picture></div><div><p></p></div>",
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Style",
          "options": [
            { "name": "CTA", "value": "cta" },
            { "name": "Default", "value": "default" }
          ]
        }
      ]
    },
    {
      "id": "card-cta",
      "fields": [
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "card-img",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards",
      "components": [
        "card-cta",
        "card-img"
      ]
    }
  ]
}
