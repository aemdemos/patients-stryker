{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "model": "cards",
      "filter": "cards",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Card",
      "id": "card",
      "model": "card",
      "plugins": {
        "da": {
          "name": "card",
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>a[href]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>a" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Style",
          "options": [
            { "name": "Resources", "value": "resources" },
            { "name": "CTA", "value": "cta" }
          ]
        }
      ]
    },
    {
      "id": "card",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Variant",
          "valueType": "string",
          "options": [
            {
              "name": "No Image",
              "value": "noimg"
            }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "image",
          "label": "Image URL",
          "condition": { "!": { "in": ["noimg", { "var": "classes" }] } }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt (link text)",
          "condition": { "!": { "in": ["noimg", { "var": "classes" }] } }
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string",
          "multi": false
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards",
      "components": [
        "card"
      ]
    }
  ]
}
