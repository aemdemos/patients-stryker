{
  "definitions": [
    {
      "title": "Cards",
      "id": "cards",
      "model": "cards",
      "filter": "cards",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1
        }
      }
    },
    {
      "title": "Card-cta",
      "id": "card-cta",
      "model": "card-cta",
      "plugins": {
        "da": {
          "name": "card-cta",
          "rows": 1,
          "columns": 1,
          "fields": [
            { "name": "text", "selector": "div:only-child" }
          ]
        }
      }
    },
    {
      "title": "Card-media",
      "id": "card-media",
      "model": "card-media",
      "plugins": {
        "da": {
          "name": "card-media",
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "Style",
          "options": [
            { "name": "CTA Style", "value": "cta" },
            { "name": "Border Style", "value": "border" },
            { "name": "Media Style", "value": "media" }
          ]
        },
        {
          "component": "array",
          "name": "children",
          "label": "Card List",
          "valueType": ["card-cta", "card-media"]
        }
      ]
    },
    {
      "id": "card-cta",
      "fields": [
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "card-media",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "cards",
      "components": [
        "card-cta",
        "card-media"
      ]
    }
  ]
}
