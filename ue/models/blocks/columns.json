{
  "definitions": [
    {
      "title": "Columns",
      "id": "columns",
      "model": "columns",
      "filter": "columns",
      "plugins": {
        "da": {
          "name": "columns",
          "rows": 1,
          "columns": 2,
          "behaviour": "columns"
        }
      }
    },
    {
      "title": "Columns Row",
      "id": "columns-row",
      "model": "columns-row",
      "filter": "columns-row",
      "plugins": {
        "da": {
          "name": "columns-row",
          "behaviour": "columns-row"
        }
      }
    },
    {
      "title": "Columns Cell",
      "id": "columns-cell",
      "model": "columns-cell",
      "filter": "columns-cell",
      "plugins": {
        "da": {
          "name": "columns-cell",
          "behaviour": "columns-cell",
          "row": 1,
          "columns": 1,
          "fields": [
            { "name": "image", "selector": "p:nth-child(1)>a[href]" },
            { "name": "imageAlt", "selector": "p:nth-child(1)>a" },
            { "name": "text", "selector": "p:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "columns",
      "fields": [
        {
          "component": "number",
          "valueType": "number",
          "name": "columns",
          "label": "Number of Columns",
          "value": 2,
          "validation": {
            "numberMin": 1,
            "numberMax": 4
          }
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Layout",
          "valueType": "string",
          "options": [
            { "name": "50-50 Layout", "value": "columns-50-50" },
            { "name": "70-30 Layout", "value": "columns-70-30" },
            { "name": "Icon Grid", "value": "columns-icon-grid" }
          ],
          "condition": { "==": [{ "var": "columns" }, 2] }
        }
      ]
    },
    {
      "id": "columns-row",
      "fields": []
    },
    {
      "id": "columns-cell",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "image",
          "label": "Image (Dynamic Media link)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt",
          "multi": false
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "columns",
      "components": [
        "columns-row"
      ]
    },
    {
      "id": "columns-row",
      "components": []
    },
    {
      "id": "columns-cell",
      "components": []
    }
  ]
}
