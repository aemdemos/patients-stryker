{
  "definitions": [
    {
      "title": "Columns",
      "id": "columns",
      "model": "columns",
      "filter": "columns",
      "plugins": {
        "da": {
          "name": "columns",
          "rows": 1,
          "columns": 2,
          "behaviour": "columns"
        }
      }
    },
    {
      "title": "Columns Row",
      "id": "columns-row",
      "model": "columns-row",
      "filter": "columns-row",
      "plugins": {
        "da": {
          "name": "columns-row",
          "behaviour": "columns-row"
        }
      }
    },
    {
      "title": "Columns Row Image",
      "id": "columns-row-image",
      "model": "columns-row-image",
      "filter": "columns-row-image",
      "plugins": {
        "da": {
          "name": "columns-row-image",
          "behaviour": "columns-row"
        }
      }
    },
    {
      "title": "Columns Row Text",
      "id": "columns-row-text",
      "model": "columns-row-text",
      "filter": "columns-row-text",
      "plugins": {
        "da": {
          "name": "columns-row-text",
          "behaviour": "columns-row"
        }
      }
    },
    {
      "title": "Columns Cell",
      "id": "columns-cell",
      "model": "columns-cell",
      "filter": "columns-cell",
      "plugins": {
        "da": {
          "name": "columns-cell"
        }
      }
    },
    {
      "title": "DM Image",
      "id": "dm-image",
      "model": "dm-image",
      "plugins": {
        "da": {
          "name": "DM Image",
          "unsafeHTML": "<p><a href=\"\">Image alt</a></p>",
          "fields": [
            { "name": "image", "selector": "a[href]" },
            { "name": "imageAlt", "selector": "a" }
          ]
        }
      }
    },
    {
      "title": "Columns Cell Image",
      "id": "columns-cell-image",
      "model": "columns-cell-image",
      "plugins": {
        "da": {
          "name": "Columns Cell Image",
          "unsafeHTML": "<div class=\"columns-cell-image\"><p><a href=\"\">Image alt</a></p></div>",
          "fields": [
            { "name": "image", "selector": "div.columns-cell-image>p:nth-child(1)>a[href]" },
            { "name": "imageAlt", "selector": "div.columns-cell-image>p:nth-child(1)>a" }
          ]
        }
      }
    },
    {
      "title": "Columns Cell Text",
      "id": "columns-cell-text",
      "model": "columns-cell-text",
      "plugins": {
        "da": {
          "name": "Columns Cell Text",
          "fields": [
            { "name": "text", "selector": "p:nth-child(1) ~ *" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "columns",
      "fields": [
        {
          "component": "number",
          "valueType": "number",
          "name": "columns",
          "label": "Number of Columns",
          "value": 2,
          "validation": {
            "numberMin": 1,
            "numberMax": 4
          }
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Layout",
          "valueType": "string",
          "options": [
            { "name": "50-50 Layout", "value": "columns-50-50" },
            { "name": "70-30 Layout", "value": "columns-70-30" },
            { "name": "Icon Grid", "value": "columns-icon-grid" }
          ],
          "condition": { "==": [{ "var": "columns" }, 2] }
        }
      ]
    },
    {
      "id": "columns-row",
      "fields": []
    },
    {
      "id": "columns-row-image",
      "fields": []
    },
    {
      "id": "columns-row-text",
      "fields": []
    },
    {
      "id": "columns-cell",
      "fields": []
    },
    {
      "id": "dm-image",
      "fields": [
        { "component": "text", "valueType": "string", "name": "image", "label": "Image (Dynamic Media link)" },
        { "component": "text", "valueType": "string", "name": "imageAlt", "label": "Image Alt", "multi": false }
      ]
    },
    {
      "id": "columns-cell-image",
      "fields": [
        { "component": "text", "valueType": "string", "name": "image", "label": "Image (Dynamic Media link)" },
        { "component": "text", "valueType": "string", "name": "imageAlt", "label": "Image Alt", "multi": false }
      ]
    },
    {
      "id": "columns-cell-text",
      "fields": [
        { "component": "aem-content", "name": "text", "label": "Text" }
      ]
    }
  ],
  "filters": [
    {
      "id": "columns",
      "components": ["columns-row", "columns-row-image", "columns-row-text"]
    },
    {
      "id": "columns-row",
      "components": []
    },
    {
      "id": "columns-cell",
      "components": ["text", "dm-image"]
    },
    {
      "id": "columns-row-image",
      "components": ["columns-cell-image"]
    },
    {
      "id": "columns-row-text",
      "components": ["columns-cell-text"]
    }
  ]
}
