{
  "definitions": [
    {
      "title": "Hero",
      "id": "hero",
      "model": "hero",
      "plugins": {
        "da": {
          "name": "Hero",
          "unsafeHTML": "<div class=\"hero\"><div><p><a href=\"\">Desktop image URL</a></p><p>Desktop image alt</p></div><div><p><a href=\"\">Mobile image URL</a></p><p>Mobile image alt</p></div><div><h1>Heading</h1><p>Supporting copy</p></div></div>",
          "fields": [
            { "name": "desktopImage", "selector": "div:nth-child(1) > p:nth-of-type(1) a[href]" },
            { "name": "desktopImageAlt", "selector": "div:nth-child(1) > p:nth-of-type(2)" },
            { "name": "mobileImage", "selector": "div:nth-child(2) > p:nth-of-type(1) a[href]" },
            { "name": "mobileImageAlt", "selector": "div:nth-child(2) > p:nth-of-type(2)" },
            { "name": "content", "selector": "div:nth-child(3)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "hero",
      "fields": [
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Variant",
          "valueType": "string",
          "options": [
            {
              "name": "Fullbleed",
              "value": "fullbleed"
            },
            {
              "name": "Band",
              "value": "band"
            },
            {
              "name": "Banner",
              "value": "banner"
            },
            {
              "name": "Poster",
              "value": "poster"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "desktopImage",
          "label": "Desktop Image (Dynamic Media link)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "desktopImageAlt",
          "label": "Desktop Image Alt",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "mobileImage",
          "label": "Mobile Image (Dynamic Media link, optional)",
          "condition": { "or": [
            { "in": ["fullbleed", { "var": "classes" }] },
            { "in": ["banner", { "var": "classes" }] },
            { "in": ["band", { "var": "classes" }] }
          ] }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "mobileImageAlt",
          "label": "Mobile Image Alt",
          "value": "",
          "condition": { "or": [
            { "in": ["fullbleed", { "var": "classes" }] },
            { "in": ["banner", { "var": "classes" }] },
            { "in": ["band", { "var": "classes" }] }
          ] }
        },
        {
          "component": "richtext",
          "name": "content",
          "label": "Content",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": []
}
