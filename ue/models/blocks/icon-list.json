{
  "definitions": [
    {
      "title": "Icon List",
      "id": "icon-list",
      "model": "icon-list",
      "filter": "icon-list",
      "plugins": {
        "da": {
          "name": "icon-list",
          "unsafeHTML": "<div class=\"icon-list\"><div><div><p><a href=\"\">Icon alt</a></p></div><div>Caption</div></div></div>"
        }
      }
    },
    {
      "title": "Icon List (tile)",
      "id": "icon-list-tile",
      "model": "icon-list-tile",
      "filter": "icon-list",
      "plugins": {
        "da": {
          "name": "Icon List (tile)",
          "unsafeHTML": "<div class=\"icon-list tile\"><div><div><p><a href=\"\">Icon alt</a></p></div><div>Caption</div></div></div>"
        }
      }
    },
    {
      "title": "Icon List Item",
      "id": "icon-list-item",
      "model": "icon-list-item",
      "plugins": {
        "da": {
          "name": "icon-list-item",
          "unsafeHTML": "<div class=\"icon-list-item\"><div><p><a href=\"\">Icon alt</a></p></div><div>Caption</div></div>",
          "fields": [
            { "name": "icon", "selector": "div:nth-child(1)>p>a[href]" },
            { "name": "iconAlt", "selector": "div:nth-child(1)>p>a" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "icon-list",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "value": "cols-4",
          "label": "Layout/Variant",
          "valueType": "string",
          "options": [
            { "name": "4-columnar / Default", "value": "cols-4" },
            { "name": "5-columnar / Tiles", "value": "tile" },
            { "name": "6-columnar / Label", "value": "cols-6 label" }
          ]
        }
      ]
    },
    {
      "id": "icon-list-tile",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "value": "tile",
          "label": "Columns",
          "valueType": "string",
          "options": [
            { "name": "5 columns (default)", "value": "tile" }
          ]
        }
      ]
    },
    {
      "id": "icon-list-item",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "iconAlt",
          "label": "Icon Alt",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "icon",
          "label": "Icon (Dynamic Media link)",
          "required": true
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "icon-list",
      "components": [
        "icon-list-item"
      ]
    }
  ]
}
