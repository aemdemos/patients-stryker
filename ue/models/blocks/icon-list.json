{
  "definitions": [
    {
      "title": "Icon List",
      "id": "icon-list",
      "model": "icon-list",
      "filter": "icon-list",
      "plugins": {
        "da": {
          "name": "icon-list",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Icon List Item",
      "id": "icon-list-item",
      "model": "icon-list-item",
      "plugins": {
        "da": {
          "name": "icon-list-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "icon", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "iconAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "icon-list",
      "fields": [
        {
          "component": "select",
          "name": "classes_layout",
          "value": "cols-4",
          "label": "Columnar Layout",
          "valueType": "string",
          "options": [
            { "name": "4 columns", "value": "cols-4" },
            { "name": "5 columns", "value": "cols-5" },
            { "name": "6 columns", "value": "cols-6" }
          ]
        },
        {
          "component": "select",
          "name": "classes_variant_tile",
          "value": "",
          "label": "Variant",
          "valueType": "string",
          "condition": { "===": [{ "var": "classes_layout" }, "cols-5"] },
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Tile", "value": "tile" }
          ]
        },
        {
          "component": "select",
          "name": "classes_variant_label",
          "value": "",
          "label": "Variant",
          "valueType": "string",
          "condition": { "===": [{ "var": "classes_layout" }, "cols-6"] },
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Label", "value": "label" }
          ]
        }
      ]
    },
    {
      "id": "icon-list-item",
      "fields": [
        {
          "component": "reference",
          "name": "icon",
          "label": "Icon",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "iconAlt",
          "label": "Icon Alt Text",
          "value": "",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "text",
          "value": "",
          "label": "Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "icon-list",
      "components": [
        "icon-list-item"
      ]
    }
  ]
}
